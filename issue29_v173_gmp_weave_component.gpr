with "gnatcoll_gmp.gpr";

-- QA-only direct test of the production GMP full-weave count/unrank package.
-- No Normative_Oracle or Calendar_Date unit is imported by the test main.
project Issue29_V173_GMP_Weave_Component is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj_v173";
   for Exec_Dir use "bin_v173";
   for Main use ("issue29_v173_gmp_weave_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Issue29_V173_GMP_Weave_Component;
