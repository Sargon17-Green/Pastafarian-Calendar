HOST=0.0.0.0
PORT=8080
# Production / multi-replica cache:
PASTAFARI_REDIS_URL=redis://redis:6379
# If Redis is omitted, a persistent file cache is used by default:
# PASTAFARI_CACHE_FILE=/data/stage59.json
PASTAFARI_CORS_ORIGIN=*
PASTAFARI_REQUEST_TIMEOUT_MS=300000
# Optional conservative namespace override. Normally the SHA-256 fingerprint of src/index.js is used.
# PASTAFARI_SEMANTIC_FINGERPRINT=
