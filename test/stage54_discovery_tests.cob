>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE54-DISCOVERY-TESTS.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 OP PIC X(16).
01 ACTION-NAME PIC X(16) VALUE "DISTANCE-PATCH".
01 TXT PIC X(8192).
01 TXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 STATUS-CODE PIC 9(4) COMP-5 VALUE 0.
01 COMPARE-CODE PIC S9(4) COMP-5 VALUE 0.
01 MESSAGE-TEXT PIC X(160).
01 PHASE-NAME PIC X(40).
01 ORIENTATION PIC 9(4) COMP-5.
01 J PIC 9(4) COMP-5.
01 SLOT-NUM PIC 9(4) COMP-5.
01 MAKE-SLOT PIC 9(4) COMP-5.
01 SELECTED-SLOT PIC 9(4) COMP-5.
01 ROUND-NUM PIC 9(4) COMP-5.
01 PEER PIC 9(4) COMP-5.
01 NODE-NUM PIC 9(4) COMP-5.
01 POS-NUM PIC 9(4) COMP-5.
01 PIECE-LEN PIC 9(4) COMP-5.
01 CHUNK-COUNT PIC 9(4) COMP-5.
01 EXPECTED-HEAP PIC 9(18) COMP-5.
01 EXPECTED-DIGIT PIC 9(9) COMP-5.
01 SMALL-VALUE PIC S9(4) COMP-5.
01 SMALL-DIGIT PIC 9.
01 M-SIGN PIC S9(4) COMP-5.
01 T-SIGN PIC S9(4) COMP-5.
01 BIG-SLOT PIC 9(4) COMP-5.
01 SMALL-SLOT PIC 9(4) COMP-5.
01 COUNT-WALK PIC 9.
01 PTR USAGE POINTER.
01 PREVIOUS-PTR USAGE POINTER.
01 SCHEDULE-LITERAL PIC X(10) VALUE "3142534512".
01 SCHEDULE-TABLE REDEFINES SCHEDULE-LITERAL.
   05 SCHEDULE-SLOT PIC 9 OCCURS 10 TIMES.
01 CNT-RUNS PIC 9(9) COMP-5 VALUE 0.
01 CNT-PASS PIC 9(9) COMP-5 VALUE 0.
01 CNT-INITIAL-OWNERS PIC 9(9) COMP-5 VALUE 0.
01 CNT-ROUNDS PIC 9(9) COMP-5 VALUE 0.
01 CNT-REJECTS PIC 9(9) COMP-5 VALUE 0.
01 CNT-FITS PIC 9(9) COMP-5 VALUE 0.
01 CNT-ROUND-OWNER-CHECKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-FREE-SURVIVORS PIC 9(9) COMP-5 VALUE 0.
01 CNT-REUSE-SURVIVORS PIC 9(9) COMP-5 VALUE 0.
01 CNT-REPLACEMENT-OWNERS PIC 9(9) COMP-5 VALUE 0.
01 CNT-REPLACEMENT-FITS PIC 9(9) COMP-5 VALUE 0.
01 CNT-OWNER-WALKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-CHUNK-CHECKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-HEAP-ZERO PIC 9(9) COMP-5 VALUE 0.
01 CNT-HEAP-SAMPLES PIC 9(9) COMP-5 VALUE 0.
01 CNT-TARGET-3 PIC 9(9) COMP-5 VALUE 0.
01 CNT-TARGET-4 PIC 9(9) COMP-5 VALUE 0.
01 CNT-TARGET-5 PIC 9(9) COMP-5 VALUE 0.
01 CNT-UNEXPECTED-FAILURES PIC 9(9) COMP-5 VALUE 0.
01 OWNERS.
   05 OWNER-SLOT OCCURS 7 TIMES.
      10 O-SIGN PIC S9(4) COMP-5.
      10 O-CHUNKS PIC 9(18) COMP-5.
      10 O-HEAD USAGE POINTER.
      10 O-TAIL USAGE POINTER.
01 EXPECTATIONS.
   05 EXPECTATION OCCURS 7 TIMES.
      10 E-SIGN PIC S9(4) COMP-5.
      10 E-WIDTH PIC 9(4) COMP-5.
      10 E-TEXT PIC X(8193).
      10 SNAP-VALID PIC 9.
      10 S-HEAD USAGE POINTER.
      10 S-TAIL USAGE POINTER.
      10 S-NODE USAGE POINTER OCCURS 911 TIMES.
01 NODE-VIEW BASED.
   05 N-DIGIT PIC 9(9) COMP-5.
   05 N-PREV USAGE POINTER.
   05 N-NEXT USAGE POINTER.
   05 N-ARENA USAGE POINTER.
01 ARG-A BASED.
   05 ARG-A-SIGN PIC S9(4) COMP-5.
   05 ARG-A-CHUNKS PIC 9(18) COMP-5.
   05 ARG-A-HEAD USAGE POINTER.
   05 ARG-A-TAIL USAGE POINTER.
01 ARG-B BASED.
   05 ARG-B-SIGN PIC S9(4) COMP-5.
   05 ARG-B-CHUNKS PIC 9(18) COMP-5.
   05 ARG-B-HEAD USAGE POINTER.
   05 ARG-B-TAIL USAGE POINTER.
01 ARG-O BASED.
   05 ARG-O-SIGN PIC S9(4) COMP-5.
   05 ARG-O-CHUNKS PIC 9(18) COMP-5.
   05 ARG-O-HEAD USAGE POINTER.
   05 ARG-O-TAIL USAGE POINTER.
01 EMPTY-A.
   05 EMPTY-A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-A-HEAD USAGE POINTER.
   05 EMPTY-A-TAIL USAGE POINTER.
01 EMPTY-B.
   05 EMPTY-B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-B-HEAD USAGE POINTER.
   05 EMPTY-B-TAIL USAGE POINTER.
01 EMPTY-OUT.
   05 EMPTY-OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-OUT-HEAD USAGE POINTER.
   05 EMPTY-OUT-TAIL USAGE POINTER.
01 EMPTY-REM.
   05 EMPTY-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-REM-HEAD USAGE POINTER.
   05 EMPTY-REM-TAIL USAGE POINTER.
PROCEDURE DIVISION.
MAIN.
    SET EMPTY-A-HEAD EMPTY-A-TAIL EMPTY-B-HEAD EMPTY-B-TAIL
        EMPTY-OUT-HEAD EMPTY-OUT-TAIL
        EMPTY-REM-HEAD EMPTY-REM-TAIL TO NULL
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        MOVE 0 TO O-SIGN(SLOT-NUM) O-CHUNKS(SLOT-NUM)
            SNAP-VALID(SLOT-NUM)
        SET O-HEAD(SLOT-NUM) O-TAIL(SLOT-NUM) TO NULL
    END-PERFORM
    PERFORM VARYING ORIENTATION FROM 0 BY 1
        UNTIL ORIENTATION > 3
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > 5
            PERFORM RUN-CASE
        END-PERFORM
    END-PERFORM
    DISPLAY "STAGE54_RUNS=" CNT-RUNS
    DISPLAY "STAGE54_PASS=" CNT-PASS
    DISPLAY "STAGE54_INITIAL_OWNERS=" CNT-INITIAL-OWNERS
    DISPLAY "STAGE54_ROUNDS=" CNT-ROUNDS
    DISPLAY "STAGE54_REJECTS=" CNT-REJECTS
    DISPLAY "STAGE54_FITS=" CNT-FITS
    DISPLAY "STAGE54_ROUND_OWNER_CHECKS=" CNT-ROUND-OWNER-CHECKS
    DISPLAY "STAGE54_FREE_SURVIVORS=" CNT-FREE-SURVIVORS
    DISPLAY "STAGE54_REUSE_SURVIVORS=" CNT-REUSE-SURVIVORS
    DISPLAY "STAGE54_REPLACEMENT_OWNERS=" CNT-REPLACEMENT-OWNERS
    DISPLAY "STAGE54_REPLACEMENT_FITS=" CNT-REPLACEMENT-FITS
    DISPLAY "STAGE54_OWNER_WALKS=" CNT-OWNER-WALKS
    DISPLAY "STAGE54_CHUNK_CHECKS=" CNT-CHUNK-CHECKS
    DISPLAY "STAGE54_HEAP_ZERO=" CNT-HEAP-ZERO
    DISPLAY "STAGE54_HEAP_SAMPLES=" CNT-HEAP-SAMPLES
    DISPLAY "STAGE54_TARGET_3=" CNT-TARGET-3
    DISPLAY "STAGE54_TARGET_4=" CNT-TARGET-4
    DISPLAY "STAGE54_TARGET_5=" CNT-TARGET-5
    DISPLAY "STAGE54_UNEXPECTED_FAILURES=" CNT-UNEXPECTED-FAILURES
    MOVE "final counters" TO PHASE-NAME
    IF        CNT-RUNS NOT = 20
    OR        CNT-PASS NOT = 20
    OR        CNT-INITIAL-OWNERS NOT = 100
    OR        CNT-ROUNDS NOT = 200
    OR        CNT-REJECTS NOT = 120
    OR        CNT-FITS NOT = 80
    OR        CNT-ROUND-OWNER-CHECKS NOT = 1000
    OR        CNT-FREE-SURVIVORS NOT = 80
    OR        CNT-REUSE-SURVIVORS NOT = 80
    OR        CNT-REPLACEMENT-OWNERS NOT = 20
    OR        CNT-REPLACEMENT-FITS NOT = 20
    OR        CNT-OWNER-WALKS NOT = 1280
    OR        CNT-CHUNK-CHECKS NOT = 1166080
    OR        CNT-HEAP-ZERO NOT = 20
    OR        CNT-HEAP-SAMPLES NOT = 280
    OR        CNT-TARGET-3 NOT = 7
    OR        CNT-TARGET-4 NOT = 7
    OR        CNT-TARGET-5 NOT = 6
    OR        CNT-UNEXPECTED-FAILURES NOT = 0
        PERFORM FAIL-NOW
    END-IF
    DISPLAY "STAGE54_HEAP_MEASURED=YES"
    DISPLAY "RESULT=PASS_STAGE54_MIXED_FIVE_LIVE_NATIVE"
    MOVE 0 TO RETURN-CODE
    STOP RUN.

RUN-CASE.
    ADD 1 TO CNT-RUNS
    DISPLAY "STAGE54_CASE=" CNT-RUNS
    MOVE 1 TO M-SIGN
    IF ORIENTATION >= 2 MOVE -1 TO M-SIGN END-IF
    MOVE 6 TO BIG-SLOT
    MOVE 7 TO SMALL-SLOT
    IF FUNCTION MOD(ORIENTATION, 2) = 1
        MOVE 7 TO BIG-SLOT
        MOVE 6 TO SMALL-SLOT
    END-IF
    PERFORM VARYING MAKE-SLOT FROM 1 BY 1 UNTIL MAKE-SLOT > 5
        EVALUATE MAKE-SLOT
            WHEN 1 COMPUTE SMALL-VALUE = J + 1
            WHEN 2 MOVE 1 TO SMALL-VALUE
            WHEN 3 MOVE 0 TO SMALL-VALUE
            WHEN 4 COMPUTE SMALL-VALUE = 0 - J
            WHEN 5 COMPUTE SMALL-VALUE = 0 - J - 1
        END-EVALUATE
        MOVE MAKE-SLOT TO SLOT-NUM
        MOVE 1 TO E-SIGN(SLOT-NUM)
        IF SLOT-NUM <= 2
            MOVE 8192 TO E-WIDTH(SLOT-NUM)
            MOVE ALL "9" TO E-TEXT(SLOT-NUM)
            IF SLOT-NUM = 1
                COMPUTE SMALL-DIGIT = 9 - J
                MOVE SMALL-DIGIT TO E-TEXT(SLOT-NUM)(8192:1)
            END-IF
        ELSE
            MOVE 8193 TO E-WIDTH(SLOT-NUM)
            MOVE ALL "0" TO E-TEXT(SLOT-NUM)
            MOVE "1" TO E-TEXT(SLOT-NUM)(1:1)
            EVALUATE SLOT-NUM
                WHEN 4 COMPUTE SMALL-DIGIT = J
                WHEN 5 COMPUTE SMALL-DIGIT = J + 1
                WHEN OTHER MOVE 0 TO SMALL-DIGIT
            END-EVALUATE
            MOVE SMALL-DIGIT TO E-TEXT(SLOT-NUM)(8193:1)
        END-IF
        PERFORM MAKE-OWNER
    END-PERFORM
    MOVE "initial five owners" TO PHASE-NAME
    MOVE 1 TO COUNT-WALK
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        PERFORM WALK-OWNER
        ADD 1 TO CNT-INITIAL-OWNERS
    END-PERFORM
    MOVE 4555 TO EXPECTED-HEAP
    PERFORM CHECK-HEAP
    PERFORM VARYING ROUND-NUM FROM 1 BY 1 UNTIL ROUND-NUM > 10
        MOVE "serialize scheduled owner" TO PHASE-NAME
        MOVE SCHEDULE-SLOT(ROUND-NUM) TO SLOT-NUM
        PERFORM SERIALIZE-OWNER
        IF E-WIDTH(SLOT-NUM) = 8192
            ADD 1 TO CNT-FITS
        ELSE
            ADD 1 TO CNT-REJECTS
        END-IF
        MOVE "preserve all after serialization" TO PHASE-NAME
        PERFORM VARYING SLOT-NUM FROM 1 BY 1
            UNTIL SLOT-NUM > 5
            PERFORM WALK-OWNER
            ADD 1 TO CNT-ROUND-OWNER-CHECKS
        END-PERFORM
        PERFORM CHECK-HEAP
        ADD 1 TO CNT-ROUNDS
    END-PERFORM
    COMPUTE SELECTED-SLOT = 3 + FUNCTION MOD(CNT-RUNS - 1, 3)
    MOVE SELECTED-SLOT TO SLOT-NUM
    MOVE "free selected owner" TO PHASE-NAME
    PERFORM FREE-OWNER
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF SLOT-NUM NOT = SELECTED-SLOT
            PERFORM WALK-OWNER
            ADD 1 TO CNT-FREE-SURVIVORS
        END-IF
    END-PERFORM
    MOVE 3644 TO EXPECTED-HEAP
    PERFORM CHECK-HEAP
    MOVE SELECTED-SLOT TO MAKE-SLOT SLOT-NUM
    MOVE 2 TO SMALL-VALUE
    MOVE 8192 TO E-WIDTH(SLOT-NUM)
    MOVE 1 TO E-SIGN(SLOT-NUM)
    MOVE ALL "9" TO E-TEXT(SLOT-NUM)
    MOVE "8" TO E-TEXT(SLOT-NUM)(8192:1)
    PERFORM MAKE-OWNER
    MOVE "serialize replacement" TO PHASE-NAME
    MOVE SELECTED-SLOT TO SLOT-NUM
    PERFORM SERIALIZE-OWNER
    ADD 1 TO CNT-REPLACEMENT-FITS
    MOVE 1 TO COUNT-WALK
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        PERFORM WALK-OWNER
        IF SLOT-NUM = SELECTED-SLOT
            ADD 1 TO CNT-REPLACEMENT-OWNERS
        ELSE
            ADD 1 TO CNT-REUSE-SURVIVORS
        END-IF
    END-PERFORM
    MOVE 4555 TO EXPECTED-HEAP
    PERFORM CHECK-HEAP
    EVALUATE SELECTED-SLOT
        WHEN 3 ADD 1 TO CNT-TARGET-3
        WHEN 4 ADD 1 TO CNT-TARGET-4
        WHEN 5 ADD 1 TO CNT-TARGET-5
    END-EVALUATE
    MOVE "final cleanup" TO PHASE-NAME
    MOVE 0 TO COUNT-WALK
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        PERFORM WALK-OWNER
        PERFORM FREE-OWNER
    END-PERFORM
    MOVE 0 TO EXPECTED-HEAP
    PERFORM CHECK-HEAP
    ADD 1 TO CNT-HEAP-ZERO CNT-PASS.

MAKE-OWNER.
    MOVE 0 TO COUNT-WALK
    MOVE "initialize input owners" TO PHASE-NAME
    MOVE BIG-SLOT TO SLOT-NUM
    MOVE M-SIGN TO E-SIGN(SLOT-NUM)
    MOVE 8192 TO E-WIDTH(SLOT-NUM)
    MOVE ALL "9" TO E-TEXT(SLOT-NUM)
    PERFORM INIT-OWNER
    MOVE SMALL-SLOT TO SLOT-NUM
    MOVE 0 TO T-SIGN
    IF SMALL-VALUE > 0 MOVE M-SIGN TO T-SIGN END-IF
    IF SMALL-VALUE < 0 COMPUTE T-SIGN = 0 - M-SIGN END-IF
    COMPUTE SMALL-DIGIT = FUNCTION ABS(SMALL-VALUE)
    MOVE T-SIGN TO E-SIGN(SLOT-NUM)
    MOVE 1 TO E-WIDTH(SLOT-NUM)
    MOVE SPACES TO E-TEXT(SLOT-NUM)
    MOVE SMALL-DIGIT TO E-TEXT(SLOT-NUM)(1:1)
    PERFORM INIT-OWNER
    MOVE "distance call" TO PHASE-NAME
    MOVE MAKE-SLOT TO SLOT-NUM
    PERFORM ASSERT-EMPTY
    SET ADDRESS OF ARG-A TO ADDRESS OF OWNER-SLOT(6)
    SET ADDRESS OF ARG-B TO ADDRESS OF OWNER-SLOT(7)
    SET ADDRESS OF ARG-O TO ADDRESS OF OWNER-SLOT(MAKE-SLOT)
    MOVE 0 TO STATUS-CODE
    MOVE SPACES TO MESSAGE-TEXT
    CALL "MONSTER-DISTANCE" USING ACTION-NAME
        ARG-A ARG-B ARG-O STATUS-CODE MESSAGE-TEXT
    IF STATUS-CODE NOT = 0
       OR MESSAGE-TEXT NOT = "PATCH03:DISTANCE-PATCH"
        PERFORM FAIL-NOW
    END-IF
    MOVE "verify input and output chains" TO PHASE-NAME
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        IF SLOT-NUM = MAKE-SLOT OR SLOT-NUM >= 6
           OR SNAP-VALID(SLOT-NUM) = 1
            PERFORM WALK-OWNER
        END-IF
    END-PERFORM
    *> Different tails in individually validated acyclic chains
    *> exclude shared nodes. Never free a suspect chain.
    MOVE "check distinct ownership" TO PHASE-NAME
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        IF O-TAIL(SLOT-NUM) NOT = NULL
            PERFORM VARYING PEER FROM 1 BY 1 UNTIL PEER >= SLOT-NUM
                IF O-TAIL(SLOT-NUM) = O-TAIL(PEER)
                    PERFORM FAIL-NOW
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM
    MOVE 6 TO SLOT-NUM
    PERFORM FREE-OWNER
    MOVE 7 TO SLOT-NUM
    PERFORM WALK-OWNER
    PERFORM FREE-OWNER.

INIT-OWNER.
    PERFORM ASSERT-EMPTY
    MOVE E-TEXT(SLOT-NUM)(1:8192) TO TXT
    MOVE E-WIDTH(SLOT-NUM) TO TXT-LEN
    MOVE "INIT-TEXT" TO OP
    MOVE 0 TO STATUS-CODE
    SET ADDRESS OF ARG-O TO ADDRESS OF OWNER-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        EMPTY-A EMPTY-B ARG-O EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 PERFORM FAIL-NOW END-IF
    IF E-SIGN(SLOT-NUM) = -1
        IF O-SIGN(SLOT-NUM) NOT = 1
           OR O-HEAD(SLOT-NUM) = NULL
            PERFORM FAIL-NOW
        END-IF
        MOVE -1 TO O-SIGN(SLOT-NUM)
    END-IF
    PERFORM WALK-OWNER.

ASSERT-EMPTY.
    IF O-SIGN(SLOT-NUM) NOT = 0 OR O-CHUNKS(SLOT-NUM) NOT = 0
       OR O-HEAD(SLOT-NUM) NOT = NULL OR O-TAIL(SLOT-NUM) NOT = NULL
       OR SNAP-VALID(SLOT-NUM) NOT = 0
        PERFORM FAIL-NOW
    END-IF.

WALK-OWNER.
    IF O-SIGN(SLOT-NUM) NOT = E-SIGN(SLOT-NUM)
        PERFORM FAIL-NOW
    END-IF
    IF E-SIGN(SLOT-NUM) = 0
        IF O-CHUNKS(SLOT-NUM) NOT = 0
           OR O-HEAD(SLOT-NUM) NOT = NULL
           OR O-TAIL(SLOT-NUM) NOT = NULL
            PERFORM FAIL-NOW
        END-IF
        MOVE 1 TO SNAP-VALID(SLOT-NUM)
        EXIT PARAGRAPH
    END-IF
    COMPUTE CHUNK-COUNT = FUNCTION INTEGER(
        (E-WIDTH(SLOT-NUM) + 8) / 9)
    IF CHUNK-COUNT < 1 OR CHUNK-COUNT > 911
       OR O-CHUNKS(SLOT-NUM) NOT = CHUNK-COUNT
       OR O-HEAD(SLOT-NUM) = NULL OR O-TAIL(SLOT-NUM) = NULL
        PERFORM FAIL-NOW
    END-IF
    IF CHUNK-COUNT > 1 AND O-HEAD(SLOT-NUM) = O-TAIL(SLOT-NUM)
        PERFORM FAIL-NOW
    END-IF
    IF SNAP-VALID(SLOT-NUM) = 1
        IF O-HEAD(SLOT-NUM) NOT = S-HEAD(SLOT-NUM)
           OR O-TAIL(SLOT-NUM) NOT = S-TAIL(SLOT-NUM)
            PERFORM FAIL-NOW
        END-IF
    ELSE
        SET S-HEAD(SLOT-NUM) TO O-HEAD(SLOT-NUM)
        SET S-TAIL(SLOT-NUM) TO O-TAIL(SLOT-NUM)
    END-IF
    IF SNAP-VALID(SLOT-NUM) = 0
        DISPLAY "STAGE54_FIRST_WALK=" CNT-RUNS ":" SLOT-NUM
    END-IF
    SET PTR TO O-HEAD(SLOT-NUM)
    SET PREVIOUS-PTR TO NULL
    MOVE 1 TO POS-NUM
    COMPUTE PIECE-LEN = E-WIDTH(SLOT-NUM) - 9 * (CHUNK-COUNT - 1)
    PERFORM VARYING NODE-NUM FROM 1 BY 1 UNTIL NODE-NUM > CHUNK-COUNT
        IF PTR = NULL PERFORM FAIL-NOW END-IF
        IF SNAP-VALID(SLOT-NUM) = 1
            IF PTR NOT = S-NODE(SLOT-NUM, NODE-NUM)
                PERFORM FAIL-NOW
            END-IF
        ELSE
            SET S-NODE(SLOT-NUM, NODE-NUM) TO PTR
        END-IF
        SET ADDRESS OF NODE-VIEW TO PTR
        IF N-PREV NOT = PREVIOUS-PTR OR N-ARENA NOT = NULL
            PERFORM FAIL-NOW
        END-IF
        COMPUTE EXPECTED-DIGIT = FUNCTION NUMVAL(
            E-TEXT(SLOT-NUM)(POS-NUM:PIECE-LEN))
        IF N-DIGIT NOT = EXPECTED-DIGIT
            PERFORM FAIL-NOW
        END-IF
        IF NODE-NUM = CHUNK-COUNT
            IF PTR NOT = O-TAIL(SLOT-NUM) OR N-NEXT NOT = NULL
                PERFORM FAIL-NOW
            END-IF
        ELSE
            IF PTR = O-TAIL(SLOT-NUM) OR N-NEXT = NULL
                PERFORM FAIL-NOW
            END-IF
        END-IF
        SET PREVIOUS-PTR TO PTR
        SET PTR TO N-NEXT
        ADD PIECE-LEN TO POS-NUM
        MOVE 9 TO PIECE-LEN
        IF COUNT-WALK = 1 AND SLOT-NUM <= 5
            ADD 1 TO CNT-CHUNK-CHECKS
        END-IF
    END-PERFORM
    MOVE 1 TO SNAP-VALID(SLOT-NUM)
    IF COUNT-WALK = 1 AND SLOT-NUM <= 5
        ADD 1 TO CNT-OWNER-WALKS
    END-IF.

SERIALIZE-OWNER.
    MOVE "TO-TEXT" TO OP
    MOVE SPACES TO TXT
    MOVE 0 TO TXT-LEN STATUS-CODE
    SET ADDRESS OF ARG-A TO ADDRESS OF OWNER-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        ARG-A EMPTY-B EMPTY-OUT EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF E-WIDTH(SLOT-NUM) = 8192
        IF STATUS-CODE NOT = 0 OR TXT-LEN NOT = 8192
           OR TXT NOT = E-TEXT(SLOT-NUM)(1:8192)
            PERFORM FAIL-NOW
        END-IF
    ELSE
        IF STATUS-CODE NOT = 45 OR TXT-LEN NOT = 0
            PERFORM FAIL-NOW
        END-IF
    END-IF.

FREE-OWNER.
    MOVE "FREE-A" TO OP
    MOVE 0 TO STATUS-CODE
    SET ADDRESS OF ARG-A TO ADDRESS OF OWNER-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        ARG-A EMPTY-B EMPTY-OUT EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 PERFORM FAIL-NOW END-IF
    MOVE 0 TO SNAP-VALID(SLOT-NUM)
    PERFORM ASSERT-EMPTY.

CHECK-HEAP.
    MOVE "HEAP-LIVE" TO OP
    MOVE 0 TO TXT-LEN STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        EMPTY-A EMPTY-B EMPTY-OUT EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR TXT-LEN NOT = EXPECTED-HEAP
        PERFORM FAIL-NOW
    END-IF
    ADD 1 TO CNT-HEAP-SAMPLES.

FAIL-NOW.
    ADD 1 TO CNT-UNEXPECTED-FAILURES
    DISPLAY "STAGE54_FAILURE=" FUNCTION TRIM(PHASE-NAME)
        " case=" CNT-RUNS " slot=" SLOT-NUM
        " node=" NODE-NUM " status=" STATUS-CODE
        " text-len=" TXT-LEN " expected-heap=" EXPECTED-HEAP
    DISPLAY "STAGE54_UNEXPECTED_FAILURES=" CNT-UNEXPECTED-FAILURES
    MOVE 1 TO RETURN-CODE
    STOP RUN.
