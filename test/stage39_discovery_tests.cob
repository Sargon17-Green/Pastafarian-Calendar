>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE39-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-RUNS PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-INTERLEAVED PIC 9(4) COMP-5 VALUE 0.
01 WS-ISOLATED PIC 9(4) COMP-5 VALUE 0.
01 WS-INITIAL PIC 9(4) COMP-5 VALUE 0.
01 WS-REINITIALIZED PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST-T PIC 9(4) COMP-5 VALUE 0.
01 WS-SAVED-O-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-O-HEAD USAGE POINTER.
01 WS-SAVED-O-TAIL USAGE POINTER.
01 WS-SAVED-OB-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-OB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-OB-HEAD USAGE POINTER.
01 WS-SAVED-OB-TAIL USAGE POINTER.
01 WS-C-LITERAL PIC X(8192) VALUE SPACES.
01 WS-T-LITERAL PIC X(8192) VALUE SPACES.
01 WS-TEMP PIC X(8192) VALUE SPACES.
01 WS-EXPECTED PIC X(8192) VALUE SPACES.
01 WS-EXPECTED-B PIC X(8192) VALUE SPACES.
01 WS-SAVED-C-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-C-HEAD USAGE POINTER.
01 WS-SAVED-C-TAIL USAGE POINTER.
01 WS-SAVED-T-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-T-HEAD USAGE POINTER.
01 WS-SAVED-T-TAIL USAGE POINTER.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-OUTPUT-B.
   05 OB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 OB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 OB-HEAD USAGE POINTER.
   05 OB-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

01 WS-BOUNDARY-INDEX PIC 9(4) COMP-5 VALUE 0.
01 WS-DIGIT-CASE PIC 9(4) COMP-5 VALUE 0.
01 WS-N PIC 9(4) COMP-5 VALUE 0.
01 WS-SECOND-LAST PIC 9(4) COMP-5 VALUE 0.
PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL
        OB-HEAD OB-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    *> Stage39: results remain owned after replacing original inputs.
    PERFORM VARYING WS-BOUNDARY-INDEX FROM 1 BY 1
        UNTIL WS-BOUNDARY-INDEX > 4
        EVALUATE WS-BOUNDARY-INDEX
            WHEN 1 MOVE 3 TO WS-N
            WHEN 2 MOVE 9 TO WS-N
            WHEN 3 MOVE 320 TO WS-N
            WHEN 4 MOVE 8192 TO WS-N
        END-EVALUATE
        PERFORM VARYING WS-DIGIT-CASE FROM 1 BY 1
            UNTIL WS-DIGIT-CASE > 6
            PERFORM PREPARE-VALID
            PERFORM RUN-PAIR
        END-PERFORM
    END-PERFORM

    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
        DISPLAY "STAGE39_HEAP_MEASURED=YES"
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE39_HEAP_PROBE_FAILED=" WS-STATUS
    END-IF
    DISPLAY "STAGE39_INITIAL_SUCCESSES=" WS-INITIAL
    DISPLAY "STAGE39_INTERLEAVED_SUCCESSES=" WS-INTERLEAVED
    DISPLAY "STAGE39_ISOLATED_OUTPUTS=" WS-ISOLATED
    DISPLAY "STAGE39_REINITIALIZED_PAIRS=" WS-REINITIALIZED
    DISPLAY "STAGE39_RUNS=" WS-RUNS
    DISPLAY "STAGE39_PASS=" WS-PASS
    DISPLAY "STAGE39_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE39_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 24 AND WS-PASS = 24
       AND WS-INITIAL = 24 AND WS-INTERLEAVED = 24
       AND WS-ISOLATED = 24 AND WS-REINITIALIZED = 24
       AND WS-FAIL = 0 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE39_INPUT_LIFETIME_ISOLATION_DISCOVERY_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE39_INPUT_LIFETIME_ISOLATION_DISCOVERY_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

PREPARE-VALID.
    MOVE SPACES TO WS-C-LITERAL WS-T-LITERAL
                   WS-EXPECTED WS-EXPECTED-B
    MOVE ALL "0" TO WS-C-LITERAL(1:WS-N)
    MOVE "1" TO WS-C-LITERAL(1:1)
    COMPUTE WS-LAST-T = WS-N - 1
    COMPUTE WS-SECOND-LAST = WS-N - 2
    MOVE ALL "9" TO WS-T-LITERAL(1:WS-LAST-T)
    *> Independent family X=10**(n-1)+(5*j+2)
    *> and Y=10**(n-1)-(2*j+5); oracle is 7*j+8.
    EVALUATE WS-DIGIT-CASE
        WHEN 1
            MOVE "07" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "93" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "15" TO WS-EXPECTED
        WHEN 2
            MOVE "12" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "91" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "22" TO WS-EXPECTED
        WHEN 3
            MOVE "17" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "89" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "29" TO WS-EXPECTED
        WHEN 4
            MOVE "22" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "87" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "36" TO WS-EXPECTED
        WHEN 5
            MOVE "27" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "85" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "43" TO WS-EXPECTED
        WHEN 6
            MOVE "32" TO WS-C-LITERAL(WS-LAST-T:2)
            MOVE "83" TO WS-T-LITERAL(WS-SECOND-LAST:2)
            MOVE "50" TO WS-EXPECTED
    END-EVALUATE
    EVALUATE WS-DIGIT-CASE
        WHEN 1 MOVE "16" TO WS-EXPECTED-B
        WHEN 2 MOVE "23" TO WS-EXPECTED-B
        WHEN 3 MOVE "30" TO WS-EXPECTED-B
        WHEN 4 MOVE "37" TO WS-EXPECTED-B
        WHEN 5 MOVE "44" TO WS-EXPECTED-B
        WHEN 6 MOVE "51" TO WS-EXPECTED-B
    END-EVALUATE
    IF WS-DIGIT-CASE = 2 OR 4 OR 6
        MOVE WS-C-LITERAL TO WS-TEMP
        MOVE WS-T-LITERAL TO WS-C-LITERAL
        MOVE WS-TEMP TO WS-T-LITERAL
    END-IF.

RUN-PAIR.
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
              O-SIGN O-CHUNKS OB-SIGN OB-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL
        OB-HEAD OB-TAIL TO NULL
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS = 0
        PERFORM SNAPSHOT-INPUTS
        PERFORM RUN-ONE
    ELSE
        ADD 1 TO WS-RUNS
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE39_INPUT_INIT_FAILED=" WS-STATUS
    END-IF
    IF O-HEAD NOT = NULL
        PERFORM FREE-OUTPUT
    END-IF
    IF OB-HEAD NOT = NULL
        PERFORM FREE-SECOND
    END-IF
    PERFORM RELEASE-PAIR.

INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.


SNAPSHOT-INPUTS.
    MOVE C-SIGN TO WS-SAVED-C-SIGN
    MOVE C-CHUNKS TO WS-SAVED-C-CHUNKS
    SET WS-SAVED-C-HEAD TO C-HEAD
    SET WS-SAVED-C-TAIL TO C-TAIL
    MOVE T-SIGN TO WS-SAVED-T-SIGN
    MOVE T-CHUNKS TO WS-SAVED-T-CHUNKS
    SET WS-SAVED-T-HEAD TO T-HEAD
    SET WS-SAVED-T-TAIL TO T-TAIL
    MOVE O-SIGN TO WS-SAVED-O-SIGN
    MOVE O-CHUNKS TO WS-SAVED-O-CHUNKS
    SET WS-SAVED-O-HEAD TO O-HEAD
    SET WS-SAVED-O-TAIL TO O-TAIL.

RUN-ONE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-STATUS WS-CASE-FAIL
    MOVE SPACES TO WS-MESSAGE
    *> First result remains live across input release/reinitialization.
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    IF WS-STATUS = 0 AND
       WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
        PERFORM CHECK-OUTPUT-TEXT
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-INITIAL END-IF
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_FIRST_CALL_FAILED=" WS-RUNS
    END-IF
    PERFORM CHECK-INPUTS
    *> Retain A, dispose of C/T, and initialize a distinct pair.
    PERFORM RELEASE-PAIR
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL TO NULL
    EVALUATE WS-DIGIT-CASE
        WHEN 1 WHEN 3 WHEN 5
            MOVE "8" TO WS-C-LITERAL(WS-N:1)
        WHEN 2 MOVE "0" TO WS-C-LITERAL(WS-N:1)
        WHEN 4 MOVE "6" TO WS-C-LITERAL(WS-N:1)
        WHEN 6 MOVE "2" TO WS-C-LITERAL(WS-N:1)
    END-EVALUATE
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_INPUT_REINIT_FAILED=" WS-RUNS
    ELSE
        PERFORM SNAPSHOT-INPUTS
        PERFORM CHECK-OUTPUT-TEXT
        IF WS-CASE-FAIL = 0
            ADD 1 TO WS-REINITIALIZED
        END-IF
        PERFORM RUN-SECOND
    END-IF.

RUN-SECOND.
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT-B
        WS-STATUS WS-MESSAGE
    IF WS-STATUS = 0 AND
       WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
        PERFORM CHECK-SECOND-TEXT
        IF O-HEAD = NULL OR OB-HEAD = NULL
           OR O-HEAD = OB-HEAD
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE39_SHARED_OUTPUT_HEAD=" WS-RUNS
        END-IF
        IF WS-CASE-FAIL = 0
            ADD 1 TO WS-INTERLEAVED
        END-IF
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_SECOND_CALL_FAILED=" WS-RUNS
    END-IF
    PERFORM CHECK-OUTPUT-TEXT
    PERFORM CHECK-INPUTS
    MOVE OB-SIGN TO WS-SAVED-OB-SIGN
    MOVE OB-CHUNKS TO WS-SAVED-OB-CHUNKS
    SET WS-SAVED-OB-HEAD TO OB-HEAD
    SET WS-SAVED-OB-TAIL TO OB-TAIL
    *> Freeing A must not change different result B.
    IF O-HEAD NOT = NULL
        PERFORM FREE-OUTPUT
    ELSE
        MOVE 1 TO WS-CASE-FAIL
    END-IF
    PERFORM CHECK-SECOND-INTEGRITY
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-ISOLATED
    END-IF
    *> B remains valid after A is released.
    PERFORM CHECK-INPUTS
    IF O-HEAD NOT = NULL
        PERFORM FREE-OUTPUT
    END-IF
    IF OB-HEAD NOT = NULL
        PERFORM FREE-SECOND
    END-IF
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
    END-IF.

CHECK-OUTPUT-TEXT.
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-LEN NOT =
       FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED))
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_OUTPUT_LENGTH_FAILED=" WS-RUNS
    ELSE
        IF WS-TEXT(1:WS-LEN) NOT =
           FUNCTION TRIM(WS-EXPECTED)
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE39_OUTPUT_ORACLE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CHECK-SECOND-TEXT.
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-B WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-LEN NOT =
       FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED-B))
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_SECOND_LENGTH_FAILED=" WS-RUNS
    ELSE
        IF WS-TEXT(1:WS-LEN) NOT =
           FUNCTION TRIM(WS-EXPECTED-B)
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE39_SECOND_ORACLE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CHECK-SECOND-INTEGRITY.
    IF OB-SIGN NOT = WS-SAVED-OB-SIGN
       OR OB-CHUNKS NOT = WS-SAVED-OB-CHUNKS
       OR OB-HEAD NOT = WS-SAVED-OB-HEAD
       OR OB-TAIL NOT = WS-SAVED-OB-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_SECOND_METADATA_MUTATED=" WS-RUNS
    END-IF
    PERFORM CHECK-SECOND-TEXT.

CHECK-INPUTS.
    IF C-SIGN NOT = WS-SAVED-C-SIGN
       OR C-CHUNKS NOT = WS-SAVED-C-CHUNKS
       OR C-HEAD NOT = WS-SAVED-C-HEAD
       OR C-TAIL NOT = WS-SAVED-C-TAIL
       OR T-SIGN NOT = WS-SAVED-T-SIGN
       OR T-CHUNKS NOT = WS-SAVED-T-CHUNKS
       OR T-HEAD NOT = WS-SAVED-T-HEAD
       OR T-TAIL NOT = WS-SAVED-T-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_INPUT_MUTATED=" WS-RUNS
    END-IF.

FREE-OUTPUT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN NOT = 0
       OR O-CHUNKS NOT = 0 OR O-HEAD NOT = NULL
       OR O-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_OUTPUT_FREE_FAILED=" WS-RUNS
    END-IF.

FREE-SECOND.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-B WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR OB-SIGN NOT = 0
       OR OB-CHUNKS NOT = 0 OR OB-HEAD NOT = NULL
       OR OB-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE39_SECOND_FREE_FAILED=" WS-RUNS
    END-IF.

RELEASE-PAIR.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE39_C_FREE_FAILED=" WS-STATUS
    END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE39_T_FREE_FAILED=" WS-STATUS
    END-IF.
END PROGRAM STAGE39-DISCOVERY-TESTS.
