>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. ORACLE-BIGINT.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 BI-OP PIC X(16).
01 BI-TEXT PIC X(8192).
01 BI-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 BI-ZERO.
   05 BI-ZERO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-ZERO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-ZERO-HEAD USAGE POINTER.
   05 BI-ZERO-TAIL USAGE POINTER.
01 BI-ONE.
   05 BI-ONE-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-ONE-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-ONE-HEAD USAGE POINTER.
   05 BI-ONE-TAIL USAGE POINTER.
01 BI-M.
   05 BI-M-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-M-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-M-HEAD USAGE POINTER.
   05 BI-M-TAIL USAGE POINTER.
01 BI-X.
   05 BI-X-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-X-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-X-HEAD USAGE POINTER.
   05 BI-X-TAIL USAGE POINTER.
01 BI-Y.
   05 BI-Y-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-Y-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-Y-HEAD USAGE POINTER.
   05 BI-Y-TAIL USAGE POINTER.
01 BI-TMP.
   05 BI-TMP-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-TMP-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-TMP-HEAD USAGE POINTER.
   05 BI-TMP-TAIL USAGE POINTER.
01 BI-REM.
   05 BI-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-REM-HEAD USAGE POINTER.
   05 BI-REM-TAIL USAGE POINTER.
01 BI-CMP PIC S9(4) COMP-5 VALUE 0.
01 BI-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-EDIT PIC -9(18).
01 WS-EDIT-TEXT PIC X(32).
01 WS-OUT-SMALL PIC S9(18) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-ACTION PIC X(16).
01 LK-A.
   05 LK-A-SIGN PIC S9(4) COMP-5.
   05 LK-A-CHUNKS PIC 9(18) COMP-5.
   05 LK-A-HEAD USAGE POINTER.
   05 LK-A-TAIL USAGE POINTER.
01 LK-B.
   05 LK-B-SIGN PIC S9(4) COMP-5.
   05 LK-B-CHUNKS PIC 9(18) COMP-5.
   05 LK-B-HEAD USAGE POINTER.
   05 LK-B-TAIL USAGE POINTER.
01 LK-OUT.
   05 LK-OUT-SIGN PIC S9(4) COMP-5.
   05 LK-OUT-CHUNKS PIC 9(18) COMP-5.
   05 LK-OUT-HEAD USAGE POINTER.
   05 LK-OUT-TAIL USAGE POINTER.
01 LK-SCALAR PIC S9(18) COMP-5.
01 LK-CMP PIC S9(4) COMP-5.
01 LK-SMALL PIC S9(18) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-A LK-B LK-OUT LK-SCALAR LK-CMP LK-SMALL LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS LK-CMP LK-SMALL BI-STATUS BI-CMP
    SET BI-ZERO-HEAD BI-ZERO-TAIL BI-ONE-HEAD BI-ONE-TAIL BI-M-HEAD BI-M-TAIL
        BI-X-HEAD BI-X-TAIL BI-Y-HEAD BI-Y-TAIL BI-TMP-HEAD BI-TMP-TAIL BI-REM-HEAD BI-REM-TAIL TO NULL

    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "COPY"
            PERFORM COPY-A-TO-OUT
        WHEN "FROM-SMALL"
            PERFORM BUILD-SCALAR-INTO-OUT
        WHEN "ADD"
            PERFORM BINARY-ADD
        WHEN "SUB"
            PERFORM BINARY-SUB
        WHEN "MUL"
            PERFORM BINARY-MUL
        WHEN "SQUARE"
            PERFORM SQUARE-A
        WHEN "ABS"
            PERFORM COPY-A-TO-OUT
            IF LK-OUT-SIGN < 0 MOVE 1 TO LK-OUT-SIGN END-IF
        WHEN "ADD-SMALL"
            PERFORM BUILD-SCALAR-INTO-Y
            PERFORM BINARY-ADD-WITH-Y
        WHEN "MUL-SMALL"
            PERFORM BUILD-SCALAR-INTO-Y
            PERFORM BINARY-MUL-WITH-Y
        WHEN "CMP"
            PERFORM COMPARE-A-B
        WHEN "CMP-SMALL"
            PERFORM BUILD-SCALAR-INTO-Y
            PERFORM COMPARE-A-Y
        WHEN "MOD"
            PERFORM LOAD-LK-B-INTO-Y
            PERFORM MOD-A-Y
        WHEN "MOD-M"
            PERFORM BUILD-M-INTO-Y
            PERFORM MOD-A-Y
        WHEN "MOD-SMALL"
            PERFORM BUILD-SCALAR-INTO-Y
            PERFORM MOD-A-Y
            IF LK-STATUS = 0
                MOVE LK-OUT-SIGN TO LK-A-SIGN
                MOVE LK-OUT-CHUNKS TO LK-A-CHUNKS
                SET LK-A-HEAD TO LK-OUT-HEAD
                SET LK-A-TAIL TO LK-OUT-TAIL
                PERFORM A-TO-SMALL
            END-IF
        WHEN "DIV"
            PERFORM BINARY-DIV
        WHEN "SAVE"
            PERFORM SAVE-A
        WHEN "TO-SMALL"
            PERFORM A-TO-SMALL
        WHEN "FREE"
            PERFORM FREE-A
        WHEN OTHER
            MOVE 80 TO LK-STATUS
    END-EVALUATE
    GOBACK.

LOAD-LK-A-INTO-X.
    MOVE LK-A-SIGN TO BI-X-SIGN
    MOVE LK-A-CHUNKS TO BI-X-CHUNKS
    SET BI-X-HEAD TO LK-A-HEAD
    SET BI-X-TAIL TO LK-A-TAIL.

LOAD-LK-B-INTO-Y.
    MOVE LK-B-SIGN TO BI-Y-SIGN
    MOVE LK-B-CHUNKS TO BI-Y-CHUNKS
    SET BI-Y-HEAD TO LK-B-HEAD
    SET BI-Y-TAIL TO LK-B-TAIL.

EXPORT-TMP-OUT.
    MOVE BI-TMP-SIGN TO LK-OUT-SIGN
    MOVE BI-TMP-CHUNKS TO LK-OUT-CHUNKS
    SET LK-OUT-HEAD TO BI-TMP-HEAD
    SET LK-OUT-TAIL TO BI-TMP-TAIL.

COPY-A-TO-OUT.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "COPY" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

BUILD-SCALAR-INTO-OUT.
    MOVE LK-SCALAR TO WS-EDIT
    MOVE FUNCTION TRIM(WS-EDIT) TO BI-TEXT
    MOVE FUNCTION LENGTH(FUNCTION TRIM(BI-TEXT)) TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

BUILD-SCALAR-INTO-Y.
    MOVE LK-SCALAR TO WS-EDIT
    MOVE FUNCTION TRIM(WS-EDIT) TO BI-TEXT
    MOVE FUNCTION LENGTH(FUNCTION TRIM(BI-TEXT)) TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0
        MOVE BI-TMP-SIGN TO BI-Y-SIGN
        MOVE BI-TMP-CHUNKS TO BI-Y-CHUNKS
        SET BI-Y-HEAD TO BI-TMP-HEAD
        SET BI-Y-TAIL TO BI-TMP-TAIL
    END-IF.

BUILD-M-INTO-Y.
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0
        MOVE BI-TMP-SIGN TO BI-Y-SIGN
        MOVE BI-TMP-CHUNKS TO BI-Y-CHUNKS
        SET BI-Y-HEAD TO BI-TMP-HEAD
        SET BI-Y-TAIL TO BI-TMP-TAIL
    END-IF.

BINARY-ADD.
    PERFORM LOAD-LK-A-INTO-X
    PERFORM LOAD-LK-B-INTO-Y
    PERFORM BINARY-ADD-WITH-Y.

BINARY-ADD-WITH-Y.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "ADD" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

BINARY-SUB.
    PERFORM LOAD-LK-A-INTO-X
    PERFORM LOAD-LK-B-INTO-Y
    MOVE "SUB" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

BINARY-MUL.
    PERFORM LOAD-LK-A-INTO-X
    PERFORM LOAD-LK-B-INTO-Y
    PERFORM BINARY-MUL-WITH-Y.

BINARY-MUL-WITH-Y.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "MUL" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

BINARY-DIV.
    PERFORM LOAD-LK-A-INTO-X
    PERFORM LOAD-LK-B-INTO-Y
    MOVE "DIVMOD" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

SQUARE-A.
    PERFORM LOAD-LK-A-INTO-X
    MOVE LK-A-SIGN TO BI-Y-SIGN
    MOVE LK-A-CHUNKS TO BI-Y-CHUNKS
    SET BI-Y-HEAD TO LK-A-HEAD
    SET BI-Y-TAIL TO LK-A-TAIL
    MOVE "MUL" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

COMPARE-A-B.
    PERFORM LOAD-LK-A-INTO-X
    PERFORM LOAD-LK-B-INTO-Y
    MOVE "CMP" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 MOVE BI-CMP TO LK-CMP END-IF.

COMPARE-A-Y.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "CMP" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 MOVE BI-CMP TO LK-CMP END-IF.

MOD-A-Y.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "MOD-EUCLID" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

SAVE-A.
    *> SAVE(x) = 1 + regularMod(x - 1, M)。
    MOVE -1 TO LK-SCALAR
    PERFORM BUILD-SCALAR-INTO-Y
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM BINARY-ADD-WITH-Y
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE LK-OUT-SIGN TO BI-X-SIGN
    MOVE LK-OUT-CHUNKS TO BI-X-CHUNKS
    SET BI-X-HEAD TO LK-OUT-HEAD
    SET BI-X-TAIL TO LK-OUT-TAIL
    PERFORM BUILD-M-INTO-Y
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE "MOD-EUCLID" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE BI-TMP-SIGN TO BI-X-SIGN
    MOVE BI-TMP-CHUNKS TO BI-X-CHUNKS
    SET BI-X-HEAD TO BI-TMP-HEAD
    SET BI-X-TAIL TO BI-TMP-TAIL
    MOVE 1 TO LK-SCALAR
    PERFORM BUILD-SCALAR-INTO-Y
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE "ADD" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0 PERFORM EXPORT-TMP-OUT END-IF.

A-TO-SMALL.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "TO-TEXT" TO BI-OP
    MOVE SPACES TO BI-TEXT
    MOVE 0 TO BI-TEXT-LEN
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    IF BI-TEXT-LEN > 18
        MOVE 81 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION NUMVAL(BI-TEXT(1:BI-TEXT-LEN)) TO WS-OUT-SMALL
    MOVE WS-OUT-SMALL TO LK-SMALL.

FREE-A.
    PERFORM LOAD-LK-A-INTO-X
    MOVE "FREE-A" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-X BI-Y BI-TMP BI-REM BI-CMP BI-STATUS
    PERFORM CHECK-BI-STATUS
    IF LK-STATUS = 0
        MOVE BI-X-SIGN TO LK-A-SIGN
        MOVE BI-X-CHUNKS TO LK-A-CHUNKS
        SET LK-A-HEAD TO BI-X-HEAD
        SET LK-A-TAIL TO BI-X-TAIL
    END-IF.

CHECK-BI-STATUS.
    IF BI-STATUS NOT = 0 MOVE BI-STATUS TO LK-STATUS END-IF.
END PROGRAM ORACLE-BIGINT.
