>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-ASK.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-T1.
   05 T1-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T1-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T1-HEAD USAGE POINTER.
   05 T1-TAIL USAGE POINTER.
01 WS-T2.
   05 T2-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T2-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T2-HEAD USAGE POINTER.
   05 T2-TAIL USAGE POINTER.
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-POS PIC 9 COMP-5 VALUE 0.
01 WS-NEXT-POS PIC 9 COMP-5 VALUE 0.
01 WS-NEXT-ID PIC 9 COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-BOWLS.
   05 LK-BOWL OCCURS 6 TIMES.
      10 LB-SIGN PIC S9(4) COMP-5.
      10 LB-CHUNKS PIC 9(18) COMP-5.
      10 LB-HEAD USAGE POINTER.
      10 LB-TAIL USAGE POINTER.
01 LK-ORDER46.
   05 LK-ORDER-ID OCCURS 6 TIMES PIC 9 COMP-5.
01 LK-BOWL-ID PIC 9 COMP-5.
01 LK-SEAL PIC S9(18) COMP-5.
01 LK-FIRST.
   05 LF-SIGN PIC S9(4) COMP-5.
   05 LF-CHUNKS PIC 9(18) COMP-5.
   05 LF-HEAD USAGE POINTER.
   05 LF-TAIL USAGE POINTER.
01 LK-STEP PIC S9 COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-BOWLS LK-ORDER46 LK-BOWL-ID LK-SEAL LK-FIRST LK-STEP LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS WS-POS
    SET Z-HEAD Z-TAIL TO NULL
    PERFORM VARYING WS-NEXT-POS FROM 1 BY 1 UNTIL WS-NEXT-POS > 6
        IF LK-ORDER-ID(WS-NEXT-POS) = LK-BOWL-ID
            MOVE WS-NEXT-POS TO WS-POS
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF WS-POS = 0
        MOVE 91 TO LK-STATUS
        GOBACK
    END-IF
    COMPUTE WS-NEXT-POS = WS-POS + 1
    IF WS-NEXT-POS > 6 MOVE 1 TO WS-NEXT-POS END-IF
    MOVE LK-ORDER-ID(WS-NEXT-POS) TO WS-NEXT-ID

    *> first = SAVE((bowl[id] + seal + 181)^2 + 179*bowl[next] + seal)
    MOVE LK-BOWL(LK-BOWL-ID) TO WS-A
    COMPUTE WS-SCALAR = LK-SEAL + 181
    PERFORM ADD-SMALL-A
    MOVE WS-OUT TO WS-A
    PERFORM SQUARE-A
    MOVE WS-OUT TO WS-T1
    MOVE LK-BOWL(WS-NEXT-ID) TO WS-A MOVE 179 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
    MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
    MOVE LK-SEAL TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
    PERFORM SAVE-A
    MOVE WS-OUT TO LK-FIRST

    *> directionNumber = SAVE((first + seal + 1 + 193)^2 + 193*first + 197*bowl[6])
    MOVE LK-FIRST TO WS-A
    COMPUTE WS-SCALAR = LK-SEAL + 194
    PERFORM ADD-SMALL-A
    MOVE WS-OUT TO WS-A
    PERFORM SQUARE-A
    MOVE WS-OUT TO WS-T1
    MOVE LK-FIRST TO WS-A MOVE 193 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
    MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T1
    MOVE LK-BOWL(6) TO WS-A MOVE 197 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
    MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
    PERFORM SAVE-A
    MOVE WS-OUT TO WS-A
    MOVE 2 TO WS-SCALAR
    MOVE "MOD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    IF WS-SMALL = 1
        MOVE 1 TO LK-STEP
    ELSE
        MOVE -1 TO LK-STEP
    END-IF
    GOBACK.

ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-SMALL-A.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SQUARE-A.
    MOVE "SQUARE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SAVE-A.
    MOVE "SAVE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-ASK.


IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-CHOOSE-RANK.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-M.
   05 M-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 M-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 M-HEAD USAGE POINTER.
   05 M-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-X.
   05 X-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 X-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 X-HEAD USAGE POINTER.
   05 X-TAIL USAGE POINTER.
01 WS-LIMIT.
   05 LIM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 LIM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 LIM-HEAD USAGE POINTER.
   05 LIM-TAIL USAGE POINTER.
01 WS-SPACE.
   05 SP-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 SP-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 SP-HEAD USAGE POINTER.
   05 SP-TAIL USAGE POINTER.
01 WS-WEIGHT.
   05 WT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WT-HEAD USAGE POINTER.
   05 WT-TAIL USAGE POINTER.
01 WS-WIDE.
   05 W-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 W-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 W-HEAD USAGE POINTER.
   05 W-TAIL USAGE POINTER.
01 WS-DIGIT.
   05 D-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 D-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 D-HEAD USAGE POINTER.
   05 D-TAIL USAGE POINTER.
01 WS-TERM.
   05 TM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 TM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 TM-HEAD USAGE POINTER.
   05 TM-TAIL USAGE POINTER.
01 WS-QUOT.
   05 Q-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Q-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Q-HEAD USAGE POINTER.
   05 Q-TAIL USAGE POINTER.
01 WS-OP PIC X(16).
01 WS-NAME PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-PLACES PIC 9(9) COMP-5 VALUE 0.
01 WS-J PIC 9(9) COMP-5 VALUE 0.
01 WS-DONE PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-FIRST.
   05 LF-SIGN PIC S9(4) COMP-5.
   05 LF-CHUNKS PIC 9(18) COMP-5.
   05 LF-HEAD USAGE POINTER.
   05 LF-TAIL USAGE POINTER.
01 LK-STEP PIC S9 COMP-5.
01 LK-N.
   05 LN-SIGN PIC S9(4) COMP-5.
   05 LN-CHUNKS PIC 9(18) COMP-5.
   05 LN-HEAD USAGE POINTER.
   05 LN-TAIL USAGE POINTER.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-FIRST LK-STEP LK-N LK-RANK LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL TO NULL
    IF LN-SIGN <= 0
        MOVE 92 TO LK-STATUS
        GOBACK
    END-IF
    MOVE "M" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-M WS-STATUS
    PERFORM CHECK-STATUS
    IF LK-STATUS NOT = 0 GOBACK END-IF

    MOVE LK-N TO WS-A MOVE WS-M TO WS-B PERFORM CMP-A-B
    IF WS-CMP <= 0
        PERFORM SHORT-PICK
    ELSE
        PERFORM WIDE-PICK
    END-IF
    GOBACK.

SHORT-PICK.
    *> limit = floor(M/N) * N
    MOVE WS-M TO WS-A MOVE LK-N TO WS-B PERFORM DIV-A-B MOVE WS-OUT TO WS-QUOT
    MOVE WS-QUOT TO WS-A MOVE LK-N TO WS-B PERFORM MUL-A-B MOVE WS-OUT TO WS-LIMIT
    MOVE LK-FIRST TO WS-X
    MOVE 0 TO WS-DONE
    PERFORM UNTIL WS-DONE = 1
        MOVE WS-X TO WS-A MOVE WS-LIMIT TO WS-B PERFORM CMP-A-B
        IF WS-CMP <= 0
            MOVE WS-X TO WS-A
            PERFORM RANK-MOD-N
            MOVE 1 TO WS-DONE
        ELSE
            MOVE WS-X TO WS-A MOVE LK-STEP TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-X
        END-IF
    END-PERFORM.

WIDE-PICK.
    MOVE 1 TO WS-PLACES
    MOVE WS-M TO WS-SPACE
    MOVE 0 TO WS-DONE
    PERFORM UNTIL WS-DONE = 1
        MOVE WS-SPACE TO WS-A MOVE LK-N TO WS-B PERFORM CMP-A-B
        IF WS-CMP >= 0
            MOVE 1 TO WS-DONE
        ELSE
            MOVE WS-SPACE TO WS-A MOVE WS-M TO WS-B PERFORM MUL-A-B MOVE WS-OUT TO WS-SPACE
            ADD 1 TO WS-PLACES
        END-IF
    END-PERFORM
    MOVE 1 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-WIDE
    MOVE WS-OUT TO WS-WEIGHT
    MOVE LK-FIRST TO WS-X
    MOVE 0 TO WS-J
    PERFORM UNTIL WS-J >= WS-PLACES
        MOVE WS-X TO WS-A MOVE -1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-DIGIT
        MOVE WS-DIGIT TO WS-A MOVE WS-WEIGHT TO WS-B PERFORM MUL-A-B MOVE WS-OUT TO WS-TERM
        MOVE WS-WIDE TO WS-A MOVE WS-TERM TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-WIDE
        MOVE WS-WEIGHT TO WS-A MOVE WS-M TO WS-B PERFORM MUL-A-B MOVE WS-OUT TO WS-WEIGHT
        MOVE WS-X TO WS-A MOVE LK-STEP TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
        PERFORM SAVE-A MOVE WS-OUT TO WS-X
        ADD 1 TO WS-J
    END-PERFORM
    MOVE WS-SPACE TO WS-A MOVE LK-N TO WS-B PERFORM DIV-A-B MOVE WS-OUT TO WS-QUOT
    MOVE WS-QUOT TO WS-A MOVE LK-N TO WS-B PERFORM MUL-A-B MOVE WS-OUT TO WS-LIMIT
    MOVE 0 TO WS-DONE
    PERFORM UNTIL WS-DONE = 1
        MOVE WS-WIDE TO WS-A MOVE WS-LIMIT TO WS-B PERFORM CMP-A-B
        IF WS-CMP <= 0
            MOVE WS-WIDE TO WS-A
            PERFORM RANK-MOD-N
            MOVE 1 TO WS-DONE
        ELSE
            *> w = 1 + regularMod(w - 1 + step, space)
            MOVE WS-WIDE TO WS-A MOVE -1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            MOVE LK-STEP TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            MOVE WS-SPACE TO WS-B PERFORM MOD-A-B MOVE WS-OUT TO WS-A
            MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-WIDE
        END-IF
    END-PERFORM.

RANK-MOD-N.
    *> rank = 1 + regularMod(value - 1, N)
    MOVE -1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
    MOVE LK-N TO WS-B PERFORM MOD-A-B MOVE WS-OUT TO WS-A
    MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A
    MOVE WS-OUT TO LK-RANK.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SAVE-A.
    MOVE "SAVE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-A-B.
    MOVE "MUL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
DIV-A-B.
    MOVE "DIV" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MOD-A-B.
    MOVE "MOD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-CHOOSE-RANK.
