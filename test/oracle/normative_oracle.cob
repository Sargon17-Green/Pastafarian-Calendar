01 WS-SEAL PIC S9(18) COMP-5 VALUE 0.
01 WS-STEP PIC S9 COMP-5 VALUE 0.
01 WS-GATE-GAPS PIC 9(4) COMP-5 VALUE 0.
01 WS-CUTLET-COUNT PIC 9(4) COMP-5 VALUE 0.
01 WS-CUTLET-CANDIDATES PIC 9(4) COMP-5 VALUE 0.
01 WS-REQUIRED PIC S9(4) COMP-5 VALUE -1.
01 WS-YEAR-LENGTH PIC 9(9) COMP-5 VALUE 0.
01 WS-MIN-MONTHS PIC 9(4) COMP-5 VALUE 0.
01 WS-MAX-MONTHS PIC 9(4) COMP-5 VALUE 0.
01 WS-MONTH-COUNT PIC 9(4) COMP-5 VALUE 0.
01 WS-BOUND-LO PIC 9(4) COMP-5 VALUE 4.
01 WS-BOUND-HI PIC 9(4) COMP-5 VALUE 123.
01 WS-WEAVE-LEN PIC 9(9) COMP-5 VALUE 0.
01 WS-I PIC 9(9) COMP-5 VALUE 0.
01 WS-K PIC 9(4) COMP-5 VALUE 0.
01 WS-RANK-SMALL PIC 9(9) COMP-5 VALUE 0.
01 WS-YEAR-OFFSET PIC 9(4) COMP-5 VALUE 0.
01 WS-CHOSEN-CUTLET PIC 9(4) COMP-5 VALUE 0.
01 WS-CHOSEN-MONTH PIC 9(4) COMP-5 VALUE 0.
01 WS-DAY-IN-CUTLET PIC 9(4) COMP-5 VALUE 0.
01 WS-DAY-IN-MONTH PIC 9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-C-DAY.
   05 LCD-SIGN PIC S9(4) COMP-5.
   05 LCD-CHUNKS PIC 9(18) COMP-5.
   05 LCD-HEAD USAGE POINTER.
   05 LCD-TAIL USAGE POINTER.
01 LK-T-DAY.
   05 LTD-SIGN PIC S9(4) COMP-5.
   05 LTD-CHUNKS PIC 9(18) COMP-5.
   05 LTD-HEAD USAGE POINTER.
   05 LTD-TAIL USAGE POINTER.
01 LK-YEAR-NUMBER.
   05 LYN-SIGN PIC S9(4) COMP-5.
   05 LYN-CHUNKS PIC 9(18) COMP-5.
   05 LYN-HEAD USAGE POINTER.
   05 LYN-TAIL USAGE POINTER.
01 LK-CUTLET-NAME PIC X(96).
01 LK-DAY-IN-CUTLET PIC 9(4) COMP-5.
01 LK-MONTH-NAME PIC X(96).
01 LK-DAY-IN-MONTH PIC 9(4) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-C-DAY LK-T-DAY LK-YEAR-NUMBER LK-CUTLET-NAME LK-DAY-IN-CUTLET LK-MONTH-NAME LK-DAY-IN-MONTH LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS LK-DAY-IN-CUTLET LK-DAY-IN-MONTH
    MOVE SPACES TO LK-CUTLET-NAME LK-MONTH-NAME
    SET Z-HEAD Z-TAIL TO NULL

    MOVE "FIND" TO WS-YEAR-ACTION
    CALL "NORMATIVE-YEAR" USING WS-YEAR-ACTION LK-C-DAY LK-T-DAY WS-DUMMY-YEAR WS-YEAR WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF

    MOVE WY-CLOSE-INDEX TO WS-A MOVE WY-OPEN-INDEX TO WS-B PERFORM SUB-A-B MOVE WS-OUT TO WS-A PERFORM TO-SMALL-A
    MOVE WS-SMALL TO WS-GATE-GAPS
    MOVE WY-CLOSE-DAY TO WS-A MOVE WY-OPEN-DAY TO WS-B PERFORM SUB-A-B MOVE WS-OUT TO WS-A PERFORM TO-SMALL-A
    MOVE WS-SMALL TO WS-YEAR-LENGTH
    IF WS-YEAR-LENGTH < 252 OR WS-YEAR-LENGTH > 5778 MOVE 170 TO LK-STATUS GOBACK END-IF

    MOVE WY-OPEN-DAY TO WS-A MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-FIRST-DAY
    CALL "NORMATIVE-SAUCE" USING LK-C-DAY WS-FIRST-DAY WS-BOWLS WS-ORDER WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF

    PERFORM CHOOSE-CUTLETS
    IF LK-STATUS NOT = 0 GOBACK END-IF
    PERFORM MATERIALIZE-CUTLETS
    IF LK-STATUS NOT = 0 GOBACK END-IF
    PERFORM CHOOSE-MONTHS
    IF LK-STATUS NOT = 0 GOBACK END-IF
    PERFORM RESOLVE-FINAL-FIVE
    GOBACK.

CHOOSE-CUTLETS.
    MOVE 0 TO WS-CUTLET-CANDIDATES
    PERFORM VARYING WS-K FROM 6 BY 1 UNTIL WS-K > 17
        IF WS-K <= WS-GATE-GAPS ADD 1 TO WS-CUTLET-CANDIDATES END-IF
    END-PERFORM
    IF WS-CUTLET-CANDIDATES < 1 MOVE 171 TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-CUTLET-CANDIDATES TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-N
    MOVE 2 TO WS-BOWL-ID MOVE 20 TO WS-SEAL PERFORM PICK-RANK
    PERFORM RANK-TO-SMALL
    COMPUTE WS-CUTLET-COUNT = 5 + WS-RANK-SMALL

    MOVE -1 TO WS-REQUIRED
    MOVE "EXACT" TO WS-GATE-ACTION
    CALL "NORMATIVE-GATES" USING WS-GATE-ACTION LK-C-DAY WS-GATE-IDX WS-GATE-DAY WS-FOUND WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    IF WS-FOUND = 1
        MOVE WS-GATE-IDX TO WS-A MOVE WY-OPEN-INDEX TO WS-B PERFORM CMP-A-B
        IF WS-CMP > 0
            MOVE WS-GATE-IDX TO WS-A MOVE WY-CLOSE-INDEX TO WS-B PERFORM CMP-A-B
            IF WS-CMP < 0
                MOVE WS-GATE-IDX TO WS-A MOVE WY-OPEN-INDEX TO WS-B PERFORM SUB-A-B MOVE WS-OUT TO WS-A PERFORM TO-SMALL-A
                MOVE WS-SMALL TO WS-REQUIRED
            END-IF
        END-IF
    END-IF

    CALL "NORMATIVE-CUTLET-PARTITION" USING WS-GATE-GAPS WS-CUTLET-COUNT WS-REQUIRED WS-ZERO WS-COUNT WS-CUTLET-PARTS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-COUNT TO WS-N MOVE 2 TO WS-BOWL-ID MOVE 21 TO WS-SEAL PERFORM PICK-RANK
    CALL "NORMATIVE-CUTLET-PARTITION" USING WS-GATE-GAPS WS-CUTLET-COUNT WS-REQUIRED WS-RANK WS-COUNT WS-CUTLET-PARTS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF

    MOVE 17 TO WS-MASTER-COUNT
    CALL "NORMATIVE-NAME-UNRANK" USING WS-MASTER-COUNT WS-CUTLET-COUNT WS-ZERO WS-COUNT WS-CUTLET-IDS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-COUNT TO WS-N MOVE 5 TO WS-BOWL-ID MOVE 22 TO WS-SEAL PERFORM PICK-RANK
    CALL "NORMATIVE-NAME-UNRANK" USING WS-MASTER-COUNT WS-CUTLET-COUNT WS-RANK WS-COUNT WS-CUTLET-IDS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

MATERIALIZE-CUTLETS.
    MOVE WY-OPEN-INDEX TO WS-CURSOR-IDX
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-CUTLET-COUNT
        MOVE WS-CURSOR-IDX TO WS-A MOVE WS-CUTLET-PART(WS-K) TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-CLOSE-IDX
        MOVE "INDEX" TO WS-GATE-ACTION
        CALL "NORMATIVE-GATES" USING WS-GATE-ACTION WS-CURSOR-IDX WS-GATE-IDX WS-GATE-DAY WS-FOUND WS-STATUS
        IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PERFORM END-IF
        MOVE WS-GATE-DAY TO WS-A MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WSC-FIRST-DAY(WS-K)
        CALL "NORMATIVE-GATES" USING WS-GATE-ACTION WS-CLOSE-IDX WS-GATE-IDX WS-GATE-DAY WS-FOUND WS-STATUS
        IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PERFORM END-IF
        MOVE WS-GATE-DAY TO WSC-LAST-DAY(WS-K)
        MOVE WS-CUTLET-ID(WS-K) TO WSC-NAME-ID(WS-K)
        MOVE WS-CLOSE-IDX TO WS-CURSOR-IDX
    END-PERFORM.

CHOOSE-MONTHS.
    COMPUTE WS-MIN-MONTHS = (WS-YEAR-LENGTH + 122) / 123
    COMPUTE WS-MAX-MONTHS = WS-YEAR-LENGTH / 4
    IF WS-MAX-MONTHS > 47 MOVE 47 TO WS-MAX-MONTHS END-IF
    IF WS-MIN-MONTHS < 3 OR WS-MIN-MONTHS > WS-MAX-MONTHS MOVE 172 TO LK-STATUS EXIT PARAGRAPH END-IF
    COMPUTE WS-SCALAR = WS-MAX-MONTHS - WS-MIN-MONTHS + 1
    PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-N
    MOVE 3 TO WS-BOWL-ID MOVE 30 TO WS-SEAL PERFORM PICK-RANK PERFORM RANK-TO-SMALL
    COMPUTE WS-MONTH-COUNT = WS-MIN-MONTHS + WS-RANK-SMALL - 1

    MOVE 4 TO WS-SCALAR
    CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-YEAR-LENGTH WS-MONTH-COUNT WS-BOUND-LO WS-BOUND-HI WS-ZERO WS-COUNT WS-MONTH-LENGTHS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-COUNT TO WS-N MOVE 3 TO WS-BOWL-ID MOVE 31 TO WS-SEAL PERFORM PICK-RANK
    CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-YEAR-LENGTH WS-MONTH-COUNT WS-BOUND-LO WS-BOUND-HI WS-RANK WS-COUNT WS-MONTH-LENGTHS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF

    CALL "NORMATIVE-WEAVING" USING WS-MONTH-COUNT WS-MONTH-LENGTHS WS-ZERO WS-COUNT WS-WEAVE WS-WEAVE-LEN WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-COUNT TO WS-N MOVE 4 TO WS-BOWL-ID MOVE 32 TO WS-SEAL PERFORM PICK-RANK
    CALL "NORMATIVE-WEAVING" USING WS-MONTH-COUNT WS-MONTH-LENGTHS WS-RANK WS-COUNT WS-WEAVE WS-WEAVE-LEN WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF

    MOVE 47 TO WS-MASTER-COUNT
    CALL "NORMATIVE-NAME-UNRANK" USING WS-MASTER-COUNT WS-MONTH-COUNT WS-ZERO WS-COUNT WS-MONTH-IDS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-COUNT TO WS-N MOVE 5 TO WS-BOWL-ID MOVE 33 TO WS-SEAL PERFORM PICK-RANK
    CALL "NORMATIVE-NAME-UNRANK" USING WS-MASTER-COUNT WS-MONTH-COUNT WS-RANK WS-COUNT WS-MONTH-IDS WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

RESOLVE-FINAL-FIVE.
    MOVE 0 TO WS-CHOSEN-CUTLET
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-CUTLET-COUNT
        MOVE LK-T-DAY TO WS-A MOVE WSC-FIRST-DAY(WS-K) TO WS-B PERFORM CMP-A-B
        IF WS-CMP >= 0
            MOVE LK-T-DAY TO WS-A MOVE WSC-LAST-DAY(WS-K) TO WS-B PERFORM CMP-A-B
            IF WS-CMP <= 0
                MOVE WS-K TO WS-CHOSEN-CUTLET
                EXIT PERFORM
            END-IF
        END-IF
    END-PERFORM
    IF WS-CHOSEN-CUTLET = 0 MOVE 173 TO LK-STATUS EXIT PARAGRAPH END-IF

    MOVE LK-T-DAY TO WS-A MOVE WSC-FIRST-DAY(WS-CHOSEN-CUTLET) TO WS-B PERFORM SUB-A-B MOVE WS-OUT TO WS-A
    MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A PERFORM TO-SMALL-A
    MOVE WS-SMALL TO WS-DAY-IN-CUTLET

    MOVE LK-T-DAY TO WS-A MOVE WS-FIRST-DAY TO WS-B PERFORM SUB-A-B MOVE WS-OUT TO WS-A PERFORM TO-SMALL-A
    MOVE WS-SMALL TO WS-YEAR-OFFSET
    COMPUTE WS-I = WS-YEAR-OFFSET + 1
    IF WS-I < 1 OR WS-I > WS-WEAVE-LEN MOVE 174 TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-WEAVE-ID(WS-I) TO WS-CHOSEN-MONTH
    MOVE 0 TO WS-DAY-IN-MONTH
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-I
        IF WS-WEAVE-ID(WS-K) = WS-CHOSEN-MONTH ADD 1 TO WS-DAY-IN-MONTH END-IF
    END-PERFORM

    MOVE WY-NUMBER TO LK-YEAR-NUMBER
    MOVE WS-DAY-IN-CUTLET TO LK-DAY-IN-CUTLET
    MOVE WS-DAY-IN-MONTH TO LK-DAY-IN-MONTH

    MOVE "CUTLET" TO WS-CATALOG-KIND
    MOVE WSC-NAME-ID(WS-CHOSEN-CUTLET) TO WS-K
    CALL "SOURCE-LANGUAGE-CATALOG" USING WS-CATALOG-ACTION WS-CATALOG-KIND WS-K WS-CATALOG-VERSION WS-CATALOG-TEXT WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-CATALOG-TEXT TO LK-CUTLET-NAME

    MOVE "MONTH" TO WS-CATALOG-KIND
    MOVE WS-MONTH-ID(WS-CHOSEN-MONTH) TO WS-K
    CALL "SOURCE-LANGUAGE-CATALOG" USING WS-CATALOG-ACTION WS-CATALOG-KIND WS-K WS-CATALOG-VERSION WS-CATALOG-TEXT WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-CATALOG-TEXT TO LK-MONTH-NAME.

PICK-RANK.
    CALL "NORMATIVE-ASK" USING WS-BOWLS WS-ORDER WS-BOWL-ID WS-SEAL WS-FIRST WS-STEP WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    CALL "NORMATIVE-CHOOSE-RANK" USING WS-FIRST WS-STEP WS-N WS-RANK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
RANK-TO-SMALL.
    MOVE WS-RANK TO WS-A PERFORM TO-SMALL-A MOVE WS-SMALL TO WS-RANK-SMALL.
MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
TO-SMALL-A.
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-ORACLE.
