>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-GATE-GAP.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-FOUNDATION.
   05 F-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 F-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 F-HEAD USAGE POINTER.
   05 F-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-N.
   05 N-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 N-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 N-HEAD USAGE POINTER.
   05 N-TAIL USAGE POINTER.
01 WS-RANK.
   05 R-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 R-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 R-HEAD USAGE POINTER.
   05 R-TAIL USAGE POINTER.
01 WS-FIRST.
   05 FI-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 FI-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 FI-HEAD USAGE POINTER.
   05 FI-TAIL USAGE POINTER.
01 WS-BOWLS.
   05 WS-BOWL OCCURS 6 TIMES.
      10 BW-SIGN PIC S9(4) COMP-5.
      10 BW-CHUNKS PIC 9(18) COMP-5.
      10 BW-HEAD USAGE POINTER.
      10 BW-TAIL USAGE POINTER.
01 WS-ORDER.
   05 WS-ORDER-ID OCCURS 6 TIMES PIC 9 COMP-5.
01 WS-NAME PIC X(16).
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-STEP PIC S9 COMP-5 VALUE 0.
01 WS-BOWL-ID PIC 9 COMP-5 VALUE 1.
01 WS-SEAL PIC S9(18) COMP-5 VALUE 1.

LINKAGE SECTION.
01 LK-SIGNED-STEP.
   05 LS-SIGN PIC S9(4) COMP-5.
   05 LS-CHUNKS PIC 9(18) COMP-5.
   05 LS-HEAD USAGE POINTER.
   05 LS-TAIL USAGE POINTER.
01 LK-GAP PIC 9(4) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-SIGNED-STEP LK-GAP LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL TO NULL
    IF LS-SIGN = 0 MOVE 150 TO LK-STATUS GOBACK END-IF
    MOVE "FOUNDATION" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-FOUNDATION WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF

    MOVE LK-SIGNED-STEP TO WS-A
    MOVE "ABS" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    MOVE WS-OUT TO WS-B
    MOVE WS-FOUNDATION TO WS-A
    IF LS-SIGN > 0
        MOVE "ADD" TO WS-OP
    ELSE
        MOVE "SUB" TO WS-OP
    END-IF
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    MOVE WS-OUT TO WS-A

    CALL "NORMATIVE-SAUCE" USING WS-FOUNDATION WS-A WS-BOWLS WS-ORDER WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    CALL "NORMATIVE-ASK" USING WS-BOWLS WS-ORDER WS-BOWL-ID WS-SEAL WS-FIRST WS-STEP WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF

    MOVE 922 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-N WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    CALL "NORMATIVE-CHOOSE-RANK" USING WS-FIRST WS-STEP WS-N WS-RANK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    MOVE WS-RANK TO WS-A
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    COMPUTE LK-GAP = 41 + WS-SMALL
    GOBACK.
END PROGRAM NORMATIVE-GATE-GAP.


IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-GATES.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 GATE-READY PIC 9 VALUE 0.
01 GATE-LIVE-NODES PIC 9(18) COMP-5 VALUE 0.
01 MIN-PTR USAGE POINTER.
01 MAX-PTR USAGE POINTER.
01 ZERO-PTR USAGE POINTER.
01 GATE-NODE BASED.
   05 GN-INDEX.
      10 GNI-SIGN PIC S9(4) COMP-5.
      10 GNI-CHUNKS PIC 9(18) COMP-5.
      10 GNI-HEAD USAGE POINTER.
      10 GNI-TAIL USAGE POINTER.
   05 GN-DAY.
      10 GND-SIGN PIC S9(4) COMP-5.
      10 GND-CHUNKS PIC 9(18) COMP-5.
      10 GND-HEAD USAGE POINTER.
      10 GND-TAIL USAGE POINTER.
   05 GN-PREV USAGE POINTER.
   05 GN-NEXT USAGE POINTER.

LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-OLD-INDEX.
   05 OI-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 OI-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 OI-HEAD USAGE POINTER.
   05 OI-TAIL USAGE POINTER.
01 WS-OLD-DAY.
   05 OD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 OD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 OD-HEAD USAGE POINTER.
   05 OD-TAIL USAGE POINTER.
01 WS-NEW-INDEX.
   05 NI-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 NI-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 NI-HEAD USAGE POINTER.
   05 NI-TAIL USAGE POINTER.
01 WS-NEW-DAY.
   05 ND-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ND-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ND-HEAD USAGE POINTER.
   05 ND-TAIL USAGE POINTER.
01 WS-NAME PIC X(16).
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-GAP PIC 9(4) COMP-5 VALUE 0.
01 WS-PTR USAGE POINTER.
01 WS-NEXT-PTR USAGE POINTER.
01 WS-NEW-PTR USAGE POINTER.

LINKAGE SECTION.
01 LK-ACTION PIC X(16).
01 LK-QUERY.
   05 LQ-SIGN PIC S9(4) COMP-5.
   05 LQ-CHUNKS PIC 9(18) COMP-5.
   05 LQ-HEAD USAGE POINTER.
   05 LQ-TAIL USAGE POINTER.
01 LK-OUT-INDEX.
   05 LOI-SIGN PIC S9(4) COMP-5.
   05 LOI-CHUNKS PIC 9(18) COMP-5.
   05 LOI-HEAD USAGE POINTER.
   05 LOI-TAIL USAGE POINTER.
01 LK-OUT-DAY.
   05 LOD-SIGN PIC S9(4) COMP-5.
   05 LOD-CHUNKS PIC 9(18) COMP-5.
   05 LOD-HEAD USAGE POINTER.
   05 LOD-TAIL USAGE POINTER.
01 LK-FOUND PIC 9 COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-QUERY LK-OUT-INDEX LK-OUT-DAY LK-FOUND LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS LK-FOUND
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL TO NULL
    IF FUNCTION TRIM(LK-ACTION) = "RESET"
        PERFORM FREE-GATES
        GOBACK
    END-IF
    IF FUNCTION TRIM(LK-ACTION) = "ASSERT-EMPTY"
        IF GATE-READY = 0 AND GATE-LIVE-NODES = 0
            MOVE 0 TO LK-STATUS
        ELSE
            MOVE 154 TO LK-STATUS
        END-IF
        GOBACK
    END-IF
    IF FUNCTION TRIM(LK-ACTION) NOT = "INDEX"
       AND FUNCTION TRIM(LK-ACTION) NOT = "AT-BEFORE"
       AND FUNCTION TRIM(LK-ACTION) NOT = "AT-AFTER"
       AND FUNCTION TRIM(LK-ACTION) NOT = "EXACT"
        MOVE 151 TO LK-STATUS
        GOBACK
    END-IF
    IF GATE-READY = 0 PERFORM INITIALIZE-GATES END-IF
    IF LK-STATUS NOT = 0 GOBACK END-IF

    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "INDEX"
            PERFORM ENSURE-QUERY-INDEX
            IF LK-STATUS = 0 PERFORM FIND-QUERY-INDEX END-IF
        WHEN "AT-BEFORE"
            PERFORM ENSURE-COVER-DAY
            IF LK-STATUS = 0 PERFORM FIND-AT-BEFORE END-IF
        WHEN "AT-AFTER"
            PERFORM ENSURE-COVER-DAY
            IF LK-STATUS = 0 PERFORM FIND-AT-AFTER END-IF
        WHEN "EXACT"
            PERFORM ENSURE-COVER-DAY
            IF LK-STATUS = 0 PERFORM FIND-AT-BEFORE END-IF
            IF LK-STATUS = 0
                MOVE LK-OUT-DAY TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
                IF WS-CMP = 0 MOVE 1 TO LK-FOUND ELSE MOVE 0 TO LK-FOUND END-IF
            END-IF
        WHEN OTHER
            MOVE 151 TO LK-STATUS
    END-EVALUATE
    IF LK-STATUS NOT = 0 PERFORM FREE-GATES END-IF
    GOBACK.

INITIALIZE-GATES.
    MOVE "FOUNDATION" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-NEW-DAY WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE 0 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-NEW-INDEX WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    ALLOCATE GATE-NODE INITIALIZED
    ADD 1 TO GATE-LIVE-NODES
    MOVE WS-NEW-INDEX TO GN-INDEX
    MOVE WS-NEW-DAY TO GN-DAY
    SET GN-PREV GN-NEXT TO NULL
    SET WS-NEW-PTR TO ADDRESS OF GATE-NODE
    SET MIN-PTR MAX-PTR ZERO-PTR TO WS-NEW-PTR
    MOVE 1 TO GATE-READY.

ENSURE-QUERY-INDEX.
    PERFORM UNTIL LK-STATUS NOT = 0
        SET ADDRESS OF GATE-NODE TO MAX-PTR
        MOVE LK-QUERY TO WS-A MOVE GN-INDEX TO WS-B PERFORM CMP-A-B
        IF WS-CMP > 0
            PERFORM EXPAND-FORWARD
        ELSE
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM UNTIL LK-STATUS NOT = 0
        SET ADDRESS OF GATE-NODE TO MIN-PTR
        MOVE LK-QUERY TO WS-A MOVE GN-INDEX TO WS-B PERFORM CMP-A-B
        IF WS-CMP < 0
            PERFORM EXPAND-BACKWARD
        ELSE
            EXIT PERFORM
        END-IF
    END-PERFORM.

ENSURE-COVER-DAY.
    PERFORM UNTIL LK-STATUS NOT = 0
        SET ADDRESS OF GATE-NODE TO MIN-PTR
        MOVE GN-DAY TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
        IF WS-CMP > 0
            PERFORM EXPAND-BACKWARD
        ELSE
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM UNTIL LK-STATUS NOT = 0
        SET ADDRESS OF GATE-NODE TO MAX-PTR
        MOVE GN-DAY TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
        IF WS-CMP < 0
            PERFORM EXPAND-FORWARD
        ELSE
            EXIT PERFORM
        END-IF
    END-PERFORM.

EXPAND-FORWARD.
    SET ADDRESS OF GATE-NODE TO MAX-PTR
    MOVE GN-INDEX TO WS-OLD-INDEX
    MOVE GN-DAY TO WS-OLD-DAY
    MOVE WS-OLD-INDEX TO WS-A MOVE 1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-NEW-INDEX
    CALL "NORMATIVE-GATE-GAP" USING WS-NEW-INDEX WS-GAP WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-OLD-DAY TO WS-A MOVE WS-GAP TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-NEW-DAY
    SET WS-PTR TO MAX-PTR
    ALLOCATE GATE-NODE INITIALIZED
    ADD 1 TO GATE-LIVE-NODES
    MOVE WS-NEW-INDEX TO GN-INDEX
    MOVE WS-NEW-DAY TO GN-DAY
    SET GN-PREV TO WS-PTR
    SET GN-NEXT TO NULL
    SET WS-NEW-PTR TO ADDRESS OF GATE-NODE
    SET ADDRESS OF GATE-NODE TO WS-PTR
    SET GN-NEXT TO WS-NEW-PTR
    SET MAX-PTR TO WS-NEW-PTR.

EXPAND-BACKWARD.
    SET ADDRESS OF GATE-NODE TO MIN-PTR
    MOVE GN-INDEX TO WS-OLD-INDEX
    MOVE GN-DAY TO WS-OLD-DAY
    MOVE WS-OLD-INDEX TO WS-A MOVE -1 TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-NEW-INDEX
    CALL "NORMATIVE-GATE-GAP" USING WS-NEW-INDEX WS-GAP WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS EXIT PARAGRAPH END-IF
    MOVE WS-OLD-DAY TO WS-A MOVE 0 TO WS-SCALAR
    COMPUTE WS-SCALAR = 0 - WS-GAP
    PERFORM ADD-SMALL-A
    MOVE WS-OUT TO WS-NEW-DAY
    SET WS-PTR TO MIN-PTR.
    ALLOCATE GATE-NODE INITIALIZED
    ADD 1 TO GATE-LIVE-NODES
    MOVE WS-NEW-INDEX TO GN-INDEX
    MOVE WS-NEW-DAY TO GN-DAY
    SET GN-PREV TO NULL
    SET GN-NEXT TO WS-PTR
    SET WS-NEW-PTR TO ADDRESS OF GATE-NODE
    SET ADDRESS OF GATE-NODE TO WS-PTR
    SET GN-PREV TO WS-NEW-PTR
    SET MIN-PTR TO WS-NEW-PTR.

FIND-QUERY-INDEX.
    SET WS-PTR TO MIN-PTR
    PERFORM UNTIL WS-PTR = NULL OR LK-FOUND = 1
        SET ADDRESS OF GATE-NODE TO WS-PTR
        MOVE GN-INDEX TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
        IF WS-CMP = 0
            MOVE GN-INDEX TO LK-OUT-INDEX
            MOVE GN-DAY TO LK-OUT-DAY
            MOVE 1 TO LK-FOUND
        ELSE
            SET WS-PTR TO GN-NEXT
        END-IF
    END-PERFORM
    IF LK-FOUND = 0 MOVE 152 TO LK-STATUS END-IF.

FIND-AT-BEFORE.
    SET WS-PTR TO MIN-PTR
    PERFORM UNTIL LK-FOUND = 1
        SET ADDRESS OF GATE-NODE TO WS-PTR
        SET WS-NEXT-PTR TO GN-NEXT
        IF WS-NEXT-PTR = NULL
            MOVE GN-INDEX TO LK-OUT-INDEX
            MOVE GN-DAY TO LK-OUT-DAY
            MOVE 1 TO LK-FOUND
        ELSE
            SET ADDRESS OF GATE-NODE TO WS-NEXT-PTR
            MOVE GN-DAY TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
            IF WS-CMP > 0
                SET ADDRESS OF GATE-NODE TO WS-PTR
                MOVE GN-INDEX TO LK-OUT-INDEX
                MOVE GN-DAY TO LK-OUT-DAY
                MOVE 1 TO LK-FOUND
            ELSE
                SET WS-PTR TO WS-NEXT-PTR
            END-IF
        END-IF
    END-PERFORM.

FIND-AT-AFTER.
    PERFORM FIND-AT-BEFORE
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF.
    MOVE LK-OUT-DAY TO WS-A MOVE LK-QUERY TO WS-B PERFORM CMP-A-B
    IF WS-CMP = 0 EXIT PARAGRAPH END-IF
    SET ADDRESS OF GATE-NODE TO WS-PTR
    SET WS-NEXT-PTR TO GN-NEXT
    IF WS-NEXT-PTR = NULL
        MOVE 153 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET ADDRESS OF GATE-NODE TO WS-NEXT-PTR
    MOVE GN-INDEX TO LK-OUT-INDEX
    MOVE GN-DAY TO LK-OUT-DAY
    MOVE 1 TO LK-FOUND.

ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

FREE-GATES.
    SET WS-PTR TO MIN-PTR.
    PERFORM UNTIL WS-PTR = NULL
        SET ADDRESS OF GATE-NODE TO WS-PTR
        SET WS-NEXT-PTR TO GN-NEXT
        MOVE GN-INDEX TO WS-A
        MOVE "FREE" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF
        MOVE GN-DAY TO WS-A
        MOVE "FREE" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF
        FREE WS-PTR
        SUBTRACT 1 FROM GATE-LIVE-NODES
        SET WS-PTR TO WS-NEXT-PTR
    END-PERFORM
    SET MIN-PTR MAX-PTR ZERO-PTR TO NULL
    MOVE 0 TO GATE-READY GATE-LIVE-NODES.
END PROGRAM NORMATIVE-GATES.
