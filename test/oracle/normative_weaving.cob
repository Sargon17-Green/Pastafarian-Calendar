01 WS-LIVE-ARENA PIC S9(18) COMP-5 VALUE 0.
01 WS-LIVE-CHUNKS PIC S9(18) COMP-5 VALUE 0.
01 WS-NEXT-DIAG-LIVE PIC S9(18) COMP-5 VALUE 250000.
01 WS-SAFE-LIVE-LIMIT PIC S9(18) COMP-5 VALUE 2000000.
*> Fix 21 性能探针：每 250 个 S 记录一次操作数/结果 chunk 规模；不参与规范分支。
01 WS-NEXT-PERF-S PIC 9(9) COMP-5 VALUE 0.
01 WS-PERF-WAYS-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-PERF-DEEP-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-PERF-ARENA-O1-HITS PIC S9(18) COMP-5 VALUE 0.
01 WS-PERF-ARENA-SCAN-STEPS PIC S9(18) COMP-5 VALUE 0.
01 WS-PERF-MUL-SMALL-HITS PIC S9(18) COMP-5 VALUE 0.
01 WS-PERF-DIV-SMALL-HITS PIC S9(18) COMP-5 VALUE 0.
01 WS-PERF-MUL-FWD-HITS PIC S9(18) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-ACTION PIC X(12).
01 LK-M PIC 9(4) COMP-5.
01 LK-LENGTHS.
   05 LK-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-REMAINING.
   05 LK-REM OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-OPENED PIC 9(4) COMP-5.
01 LK-CLOSED PIC 9(4) COMP-5.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-M LK-LENGTHS LK-REMAINING LK-OPENED LK-CLOSED LK-COUNT LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS WS-BASE-OWNED WS-FACTOR-OWNED
        WS-WAYS-OWNED WS-TERM-OWNED WS-ONE-OWNED
    MOVE 250000 TO WS-NEXT-DIAG-LIVE
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        A-HEAD A-TAIL B-HEAD B-TAIL O-HEAD O-TAIL
        BS-HEAD BS-TAIL FC-HEAD FC-TAIL WY-HEAD WY-TAIL
        TM-HEAD TM-TAIL ON-HEAD ON-TAIL TO NULL
    PERFORM ENSURE-CACHE-INITIALIZED

    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "RESET"
            PERFORM RESET-CACHE
            GOBACK
        WHEN "ASSERT-EMPTY"
            IF CACHE-VALID = 0 AND CACHE-A-LIMIT = 0 AND CACHE-B-LIMIT = 0
                MOVE 0 TO LK-STATUS
            ELSE
                MOVE 131 TO LK-STATUS
            END-IF
            GOBACK
        WHEN "FACTOR"
            MOVE WS-ZERO TO LK-COUNT
            PERFORM VALIDATE-STATE
            IF LK-STATUS = 0 PERFORM CALCULATE-BASE-LENGTH END-IF
            IF LK-STATUS = 0 PERFORM ENSURE-FUTURE-CACHE END-IF
            IF LK-STATUS = 0 PERFORM EXPORT-CURRENT-FACTOR END-IF
            GOBACK
        WHEN "COUNT"
            MOVE WS-ZERO TO LK-COUNT
            PERFORM VALIDATE-STATE
            IF LK-STATUS = 0 PERFORM BUILD-ACTIVE-BASE-COUNT END-IF
            IF LK-STATUS = 0 PERFORM ENSURE-FUTURE-CACHE END-IF
            IF LK-STATUS = 0 PERFORM COMBINE-BASE-AND-FUTURE END-IF
            IF LK-STATUS NOT = 0 MOVE WS-ZERO TO LK-COUNT END-IF
            PERFORM CLEAN-LOCAL-VALUES
            GOBACK
        WHEN OTHER
            MOVE 130 TO LK-STATUS
            GOBACK
    END-EVALUATE.

ENSURE-CACHE-INITIALIZED.
    IF CACHE-INITIALIZED = 1 EXIT PARAGRAPH END-IF
    MOVE 0 TO CACHE-VALID CACHE-M CACHE-OPENED CACHE-CURRENT-ID CACHE-NEXT-ID
        CACHE-A-LIMIT CACHE-B-LIMIT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 47
        MOVE 0 TO CACHE-LENGTH(WS-I)
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5779
        MOVE WS-ZERO TO CACHE-A-ITEM(WS-I) CACHE-B-ITEM(WS-I)
    END-PERFORM
    MOVE 1 TO CACHE-INITIALIZED.

VALIDATE-STATE.
    IF LK-M < 1 OR LK-M > 47
        MOVE 132 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    IF LK-CLOSED > LK-OPENED OR LK-OPENED > LK-M
        MOVE 132 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-BASE-LEN
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        IF LK-LENGTH(WS-I) < 1 OR LK-LENGTH(WS-I) > 5778
            MOVE 132 TO LK-STATUS
            EXIT PERFORM
        END-IF
        IF LK-REM(WS-I) > LK-LENGTH(WS-I)
            MOVE 132 TO LK-STATUS
            EXIT PERFORM
        END-IF
        IF WS-I <= LK-CLOSED
            IF LK-REM(WS-I) NOT = 0
                MOVE 132 TO LK-STATUS
                EXIT PERFORM
            END-IF
        ELSE
            IF WS-I <= LK-OPENED
                IF LK-REM(WS-I) < 1 OR LK-REM(WS-I) >= LK-LENGTH(WS-I)
                    MOVE 132 TO LK-STATUS
                    EXIT PERFORM
                END-IF
            ELSE
                IF LK-REM(WS-I) NOT = LK-LENGTH(WS-I)
                    MOVE 132 TO LK-STATUS
                    EXIT PERFORM
                END-IF
            END-IF
        END-IF
    END-PERFORM.

CALCULATE-BASE-LENGTH.
    MOVE 0 TO WS-BASE-LEN
    COMPUTE WS-I = LK-CLOSED + 1
    PERFORM UNTIL WS-I > LK-OPENED
        ADD LK-REM(WS-I) TO WS-BASE-LEN
        ADD 1 TO WS-I
    END-PERFORM
    IF WS-BASE-LEN > 5778 MOVE 132 TO LK-STATUS END-IF.

BUILD-ACTIVE-BASE-COUNT.
    PERFORM CALCULATE-BASE-LENGTH
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-BASE
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-BASE-OWNED

    MOVE 0 TO WS-PREFIX-LEN
    COMPUTE WS-I = LK-CLOSED + 1
    PERFORM UNTIL WS-I > LK-OPENED OR LK-STATUS NOT = 0
        ADD LK-REM(WS-I) TO WS-PREFIX-LEN
        COMPUTE WS-N = WS-PREFIX-LEN - 1
        COMPUTE WS-K = LK-REM(WS-I) - 1
        PERFORM BUILD-BINOMIAL
        IF LK-STATUS = 0
            MOVE WS-BASE TO WS-A
            MOVE WS-FACTOR TO WS-B
            PERFORM MUL-A-B-OUT
        END-IF
        IF LK-STATUS = 0
            PERFORM FREE-BASE
            PERFORM FREE-FACTOR
            MOVE WS-OUT TO WS-BASE
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-BASE-OWNED
        END-IF
        ADD 1 TO WS-I
    END-PERFORM.

BUILD-BINOMIAL.
    IF WS-FACTOR-OWNED = 1 PERFORM FREE-FACTOR END-IF
    IF WS-K > WS-N
        MOVE 133 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-K-EFFECTIVE = WS-N - WS-K
    IF WS-K < WS-K-EFFECTIVE MOVE WS-K TO WS-K-EFFECTIVE END-IF

    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-FACTOR
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-FACTOR-OWNED

    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-K-EFFECTIVE OR LK-STATUS NOT = 0
        COMPUTE WS-SCALAR = WS-N - WS-K-EFFECTIVE + WS-J
        MOVE WS-FACTOR TO WS-A
        PERFORM MUL-A-SMALL-OUT
        IF LK-STATUS = 0
            PERFORM FREE-FACTOR
            MOVE WS-OUT TO WS-FACTOR
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-FACTOR-OWNED
        END-IF
        IF LK-STATUS = 0
            MOVE WS-J TO WS-SCALAR
            MOVE WS-FACTOR TO WS-A
            PERFORM DIV-A-SMALL-OUT
        END-IF
        IF LK-STATUS = 0
            PERFORM FREE-FACTOR
            MOVE WS-OUT TO WS-FACTOR
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-FACTOR-OWNED
        END-IF
    END-PERFORM.

ENSURE-FUTURE-CACHE.
    MOVE 0 TO WS-CACHE-MATCH
    IF CACHE-VALID = 1 AND CACHE-M = LK-M AND CACHE-OPENED = LK-OPENED
        MOVE 1 TO WS-CACHE-MATCH
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M OR WS-CACHE-MATCH = 0
            IF CACHE-LENGTH(WS-I) NOT = LK-LENGTH(WS-I)
                MOVE 0 TO WS-CACHE-MATCH
            END-IF
        END-PERFORM
    END-IF
    IF WS-CACHE-MATCH = 1 EXIT PARAGRAPH END-IF
    PERFORM BUILD-FUTURE-CACHE.

BUILD-FUTURE-CACHE.
    PERFORM RESET-CACHE-DATA
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE 250000 TO WS-NEXT-DIAG-LIVE

    MOVE LK-M TO CACHE-M
    MOVE LK-OPENED TO CACHE-OPENED
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        MOVE LK-LENGTH(WS-I) TO CACHE-LENGTH(WS-I)
    END-PERFORM

    MOVE 0 TO WS-PREFIX(1)
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        COMPUTE WS-PREFIX(WS-I + 1) = WS-PREFIX(WS-I) + LK-LENGTH(WS-I)
    END-PERFORM
    IF WS-PREFIX(LK-M + 1) > 5778
        MOVE 132 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF

    COMPUTE WS-TARGET-K = LK-OPENED + 1
    IF WS-TARGET-K > LK-M
        MOVE 0 TO CACHE-CURRENT-ID CACHE-NEXT-ID
        MOVE 1 TO CACHE-VALID
        EXIT PARAGRAPH
    END-IF

    MOVE 0 TO WS-DEEP-ID
    MOVE 1 TO WS-OUTPUT-ID
    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-ONE
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-ONE-OWNED

    MOVE LK-M TO WS-K-INDEX
    PERFORM UNTIL WS-K-INDEX < WS-TARGET-K OR LK-STATUS NOT = 0
        PERFORM CLEAR-OUTPUT-TABLE
        IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
        MOVE WS-PREFIX(WS-K-INDEX) TO WS-MAX-S
        MOVE LK-LENGTH(WS-K-INDEX) TO WS-N
        PERFORM BUILD-ONE-FUTURE-VECTOR
        IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
        IF WS-DEEP-ID NOT = 0 PERFORM FREE-DEEP-TABLE END-IF

        IF WS-K-INDEX = WS-TARGET-K
            MOVE WS-OUTPUT-ID TO CACHE-CURRENT-ID
            MOVE 0 TO CACHE-NEXT-ID
            EXIT PERFORM
        END-IF
        MOVE WS-OUTPUT-ID TO WS-DEEP-ID
        IF WS-OUTPUT-ID = 1 MOVE 2 TO WS-OUTPUT-ID ELSE MOVE 1 TO WS-OUTPUT-ID END-IF
        SUBTRACT 1 FROM WS-K-INDEX
    END-PERFORM

    IF LK-STATUS = 0
        MOVE 1 TO CACHE-VALID
    ELSE
        PERFORM RESET-CACHE-DATA
    END-IF
    IF WS-ONE-OWNED = 1 PERFORM FREE-ONE END-IF.

BUILD-ONE-FUTURE-VECTOR.
    IF WS-WAYS-OWNED = 1 PERFORM FREE-WAYS END-IF
    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-WAYS
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-WAYS-OWNED

    MOVE 0 TO WS-S WS-NEXT-PERF-S
    PERFORM UNTIL WS-S > WS-MAX-S OR LK-STATUS NOT = 0
        PERFORM CHECK-MEMORY-GUARD
        IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
        COMPUTE WS-DEEP-S = WS-N - 1 + WS-S
        PERFORM LOAD-DEEP-FACTOR
        IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
        IF WS-S >= WS-NEXT-PERF-S
            MOVE WY-CHUNKS TO WS-PERF-WAYS-CHUNKS
            MOVE B-CHUNKS TO WS-PERF-DEEP-CHUNKS
        END-IF
        MOVE WS-WAYS TO WS-A
        PERFORM MUL-A-B-OUT
        IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
        IF WS-DEEP-ID NOT = 0 PERFORM FREE-DEEP-CELL END-IF
        MOVE WS-OUT TO WS-TERM
        MOVE WS-ZERO TO WS-OUT
        MOVE 1 TO WS-TERM-OWNED
        IF WS-S >= WS-NEXT-PERF-S
            PERFORM READ-ARENA-INDEX-STATS
            IF LK-STATUS NOT = 0 EXIT PERFORM END-IF
            DISPLAY "WEAVING_PERF_POINT K=" WS-K-INDEX
                " S=" WS-S
                " MAX_S=" WS-MAX-S
                " WAYS_CHUNKS=" WS-PERF-WAYS-CHUNKS
                " DEEP_CHUNKS=" WS-PERF-DEEP-CHUNKS
                " TERM_CHUNKS=" TM-CHUNKS
                " LIVE=" WS-LIVE-BLOCKS
                " ARENA_O1_HITS=" WS-PERF-ARENA-O1-HITS
                " ARENA_SCAN_STEPS=" WS-PERF-ARENA-SCAN-STEPS
                " MUL_SMALL_FAST_HITS=" WS-PERF-MUL-SMALL-HITS
                " DIV_SMALL_FAST_HITS=" WS-PERF-DIV-SMALL-HITS
                " MUL_FWD_HITS=" WS-PERF-MUL-FWD-HITS
            ADD 250 TO WS-NEXT-PERF-S
        END-IF

        COMPUTE WS-IDX = WS-S + 1
        IF WS-S = 0
            PERFORM STORE-TERM-IN-OUTPUT
        ELSE
            COMPUTE WS-DEEP-IDX = WS-S
            PERFORM LOAD-OUTPUT-PREVIOUS
            MOVE WS-TERM TO WS-B
            PERFORM ADD-A-B-OUT
            IF LK-STATUS = 0
                PERFORM FREE-TERM
                PERFORM STORE-OUT-IN-OUTPUT
            END-IF
        END-IF

        IF LK-STATUS = 0 AND WS-S < WS-MAX-S
            COMPUTE WS-SCALAR = WS-N + WS-S - 1
            MOVE WS-WAYS TO WS-A
            PERFORM MUL-A-SMALL-OUT
            IF LK-STATUS = 0
                PERFORM FREE-WAYS
                MOVE WS-OUT TO WS-WAYS
                MOVE WS-ZERO TO WS-OUT
                MOVE 1 TO WS-WAYS-OWNED
            END-IF
            IF LK-STATUS = 0
                COMPUTE WS-SCALAR = WS-S + 1
                MOVE WS-WAYS TO WS-A
                PERFORM DIV-A-SMALL-OUT
            END-IF
            IF LK-STATUS = 0
                PERFORM FREE-WAYS
                MOVE WS-OUT TO WS-WAYS
                MOVE WS-ZERO TO WS-OUT
                MOVE 1 TO WS-WAYS-OWNED
            END-IF
        END-IF
        ADD 1 TO WS-S
    END-PERFORM
    IF WS-WAYS-OWNED = 1 PERFORM FREE-WAYS END-IF
    IF WS-TERM-OWNED = 1 PERFORM FREE-TERM END-IF.

LOAD-DEEP-FACTOR.
    IF WS-DEEP-ID = 0
        MOVE WS-ONE TO WS-B
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DEEP-IDX = WS-DEEP-S + 1
    IF WS-DEEP-ID = 1
        IF WS-DEEP-IDX > CACHE-A-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-A-ITEM(WS-DEEP-IDX) TO WS-B
    ELSE
        IF WS-DEEP-IDX > CACHE-B-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-B-ITEM(WS-DEEP-IDX) TO WS-B
    END-IF.

FREE-DEEP-CELL.
    COMPUTE WS-DEEP-IDX = WS-DEEP-S + 1
    IF WS-DEEP-ID = 1
        IF CA-HEAD(WS-DEEP-IDX) NOT = NULL
            MOVE CACHE-A-ITEM(WS-DEEP-IDX) TO WS-A
            PERFORM FREE-A-VALUE
            MOVE WS-ZERO TO CACHE-A-ITEM(WS-DEEP-IDX)
        END-IF
    ELSE
        IF CB-HEAD(WS-DEEP-IDX) NOT = NULL
            MOVE CACHE-B-ITEM(WS-DEEP-IDX) TO WS-A
            PERFORM FREE-A-VALUE
            MOVE WS-ZERO TO CACHE-B-ITEM(WS-DEEP-IDX)
        END-IF
    END-IF.

FREE-DEEP-TABLE.
    IF WS-DEEP-ID = 1
        PERFORM FREE-TABLE-A
    ELSE
        IF WS-DEEP-ID = 2 PERFORM FREE-TABLE-B END-IF
    END-IF.

LOAD-OUTPUT-PREVIOUS.
    IF WS-OUTPUT-ID = 1
        MOVE CACHE-A-ITEM(WS-DEEP-IDX) TO WS-A
    ELSE
        MOVE CACHE-B-ITEM(WS-DEEP-IDX) TO WS-A
    END-IF.

STORE-TERM-IN-OUTPUT.
    IF WS-OUTPUT-ID = 1
        MOVE WS-TERM TO CACHE-A-ITEM(WS-IDX)
        IF WS-IDX > CACHE-A-LIMIT MOVE WS-IDX TO CACHE-A-LIMIT END-IF
    ELSE
        MOVE WS-TERM TO CACHE-B-ITEM(WS-IDX)
        IF WS-IDX > CACHE-B-LIMIT MOVE WS-IDX TO CACHE-B-LIMIT END-IF
    END-IF
    MOVE WS-ZERO TO WS-TERM
    MOVE 0 TO WS-TERM-OWNED.

STORE-OUT-IN-OUTPUT.
    IF WS-OUTPUT-ID = 1
        MOVE WS-OUT TO CACHE-A-ITEM(WS-IDX)
        IF WS-IDX > CACHE-A-LIMIT MOVE WS-IDX TO CACHE-A-LIMIT END-IF
    ELSE
        MOVE WS-OUT TO CACHE-B-ITEM(WS-IDX)
        IF WS-IDX > CACHE-B-LIMIT MOVE WS-IDX TO CACHE-B-LIMIT END-IF
    END-IF
    MOVE WS-ZERO TO WS-OUT.

CLEAR-OUTPUT-TABLE.
    IF WS-OUTPUT-ID = 1
        PERFORM FREE-TABLE-A
    ELSE
        PERFORM FREE-TABLE-B
    END-IF.

EXPORT-CURRENT-FACTOR.
    IF CACHE-CURRENT-ID = 0
        MOVE 1 TO WS-SCALAR
        PERFORM MAKE-SMALL-OUT
        IF LK-STATUS = 0
            MOVE WS-OUT TO LK-COUNT
            MOVE WS-ZERO TO WS-OUT
        END-IF
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-IDX = WS-BASE-LEN + 1
    IF CACHE-CURRENT-ID = 1
        IF WS-IDX > CACHE-A-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-A-ITEM(WS-IDX) TO WS-A
    ELSE
        IF WS-IDX > CACHE-B-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-B-ITEM(WS-IDX) TO WS-A
    END-IF
    PERFORM COPY-A-OUT
    IF LK-STATUS = 0
        MOVE WS-OUT TO LK-COUNT
        MOVE WS-ZERO TO WS-OUT
    END-IF.

COMBINE-BASE-AND-FUTURE.
    IF CACHE-CURRENT-ID = 0
        MOVE WS-BASE TO LK-COUNT
        MOVE WS-ZERO TO WS-BASE
        MOVE 0 TO WS-BASE-OWNED
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-IDX = WS-BASE-LEN + 1
    IF CACHE-CURRENT-ID = 1
        IF WS-IDX > CACHE-A-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-A-ITEM(WS-IDX) TO WS-B
    ELSE
        IF WS-IDX > CACHE-B-LIMIT MOVE 134 TO LK-STATUS EXIT PARAGRAPH END-IF
        MOVE CACHE-B-ITEM(WS-IDX) TO WS-B
    END-IF
    MOVE WS-BASE TO WS-A
    PERFORM MUL-A-B-OUT
    IF LK-STATUS = 0
        MOVE WS-OUT TO LK-COUNT
        MOVE WS-ZERO TO WS-OUT
    END-IF.

RESET-CACHE.
    PERFORM RESET-CACHE-DATA
    MOVE 0 TO CACHE-VALID CACHE-M CACHE-OPENED CACHE-CURRENT-ID CACHE-NEXT-ID
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 47
        MOVE 0 TO CACHE-LENGTH(WS-I)
    END-PERFORM.

RESET-CACHE-DATA.
    PERFORM FREE-TABLE-A
    PERFORM FREE-TABLE-B
    MOVE 0 TO CACHE-A-LIMIT CACHE-B-LIMIT CACHE-CURRENT-ID CACHE-NEXT-ID CACHE-VALID.

FREE-TABLE-A.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CACHE-A-LIMIT
        IF CA-HEAD(WS-I) NOT = NULL
            MOVE CACHE-A-ITEM(WS-I) TO WS-A
            PERFORM FREE-A-VALUE
            MOVE WS-ZERO TO CACHE-A-ITEM(WS-I)
        END-IF
    END-PERFORM
    MOVE 0 TO CACHE-A-LIMIT.

FREE-TABLE-B.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CACHE-B-LIMIT
        IF CB-HEAD(WS-I) NOT = NULL
            MOVE CACHE-B-ITEM(WS-I) TO WS-A
            PERFORM FREE-A-VALUE
            MOVE WS-ZERO TO CACHE-B-ITEM(WS-I)
        END-IF
    END-PERFORM
    MOVE 0 TO CACHE-B-LIMIT.


CHECK-MEMORY-GUARD.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-LIVE-BLOCKS
    IF WS-LIVE-BLOCKS >= WS-NEXT-DIAG-LIVE
        PERFORM READ-HEAP-BREAKDOWN
        IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
        IF LK-STATUS = 0
            DISPLAY "WEAVING_HEAP_PROBE K=" WS-K-INDEX
                " S=" WS-S
                " MAX_S=" WS-MAX-S
                " DEEP_ID=" WS-DEEP-ID
                " OUTPUT_ID=" WS-OUTPUT-ID
                " CACHE_A_LIMIT=" CACHE-A-LIMIT
                " CACHE_B_LIMIT=" CACHE-B-LIMIT
                " LIVE=" WS-LIVE-BLOCKS
                " CHUNKS=" WS-LIVE-CHUNKS
                " ARENA=" WS-LIVE-ARENA
            PERFORM UNTIL WS-NEXT-DIAG-LIVE > WS-LIVE-BLOCKS
                ADD 250000 TO WS-NEXT-DIAG-LIVE
            END-PERFORM
        END-IF
    END-IF
    IF WS-LIVE-BLOCKS >= WS-SAFE-LIVE-LIMIT
        IF LK-STATUS = 0 PERFORM READ-HEAP-BREAKDOWN END-IF
        IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
        IF LK-STATUS = 0
            DISPLAY "WEAVING_HEAP_GUARD K=" WS-K-INDEX
                " S=" WS-S
                " MAX_S=" WS-MAX-S
                " DEEP_ID=" WS-DEEP-ID
                " OUTPUT_ID=" WS-OUTPUT-ID
                " CACHE_A_LIMIT=" CACHE-A-LIMIT
                " CACHE_B_LIMIT=" CACHE-B-LIMIT
                " LIVE=" WS-LIVE-BLOCKS
                " CHUNKS=" WS-LIVE-CHUNKS
                " ARENA=" WS-LIVE-ARENA
        END-IF
        MOVE 135 TO LK-STATUS
    END-IF.

READ-HEAP-BREAKDOWN.
    MOVE "HEAP-ARENA-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-LIVE-ARENA

    MOVE "HEAP-CHUNK-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-LIVE-CHUNKS.

READ-ARENA-INDEX-STATS.
    MOVE "ARENA-O1-HITS" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-PERF-ARENA-O1-HITS

    MOVE "ARENA-SCAN-STEPS" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-PERF-ARENA-SCAN-STEPS

    MOVE "MUL-SMALL-HITS" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-PERF-MUL-SMALL-HITS

    MOVE "DIV-SMALL-HITS" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-PERF-DIV-SMALL-HITS

    MOVE "MUL-FWD-HITS" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SMALL TO WS-PERF-MUL-FWD-HITS.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

COPY-A-OUT.
    MOVE "COPY" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

ADD-A-B-OUT.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

MUL-A-B-OUT.
    MOVE "MUL-FWD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

MUL-A-SMALL-OUT.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

DIV-A-SMALL-OUT.
    MOVE "DIV-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

FREE-A-VALUE.
    IF A-HEAD = NULL
        MOVE WS-ZERO TO WS-A
        EXIT PARAGRAPH
    END-IF
    MOVE LK-STATUS TO WS-SAVED-STATUS
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-SAVED-STATUS = 0 AND WS-STATUS NOT = 0 MOVE WS-STATUS TO WS-SAVED-STATUS END-IF
    MOVE WS-SAVED-STATUS TO LK-STATUS
    MOVE WS-ZERO TO WS-A WS-DUMMY-OUT.

FREE-BASE.
    IF WS-BASE-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-BASE TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-BASE
    MOVE 0 TO WS-BASE-OWNED.

FREE-FACTOR.
    IF WS-FACTOR-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-FACTOR TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-FACTOR
    MOVE 0 TO WS-FACTOR-OWNED.

FREE-WAYS.
    IF WS-WAYS-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-WAYS TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-WAYS
    MOVE 0 TO WS-WAYS-OWNED.

FREE-TERM.
    IF WS-TERM-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-TERM TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-TERM
    MOVE 0 TO WS-TERM-OWNED.

FREE-ONE.
    IF WS-ONE-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-ONE TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-ONE
    MOVE 0 TO WS-ONE-OWNED.

CLEAN-LOCAL-VALUES.
    IF WS-BASE-OWNED = 1 PERFORM FREE-BASE END-IF
    IF WS-FACTOR-OWNED = 1 PERFORM FREE-FACTOR END-IF
    IF WS-WAYS-OWNED = 1 PERFORM FREE-WAYS END-IF
    IF WS-TERM-OWNED = 1 PERFORM FREE-TERM END-IF
    IF WS-ONE-OWNED = 1 PERFORM FREE-ONE END-IF
    IF O-HEAD NOT = NULL
        MOVE WS-OUT TO WS-A
        PERFORM FREE-A-VALUE
        MOVE WS-ZERO TO WS-OUT
    END-IF.
END PROGRAM NORMATIVE-WEAVING-COUNT.

IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-WEAVING.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-RANK.
   05 RR-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 RR-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 RR-HEAD USAGE POINTER.
   05 RR-TAIL USAGE POINTER.
01 WS-BLOCK.
   05 BL-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BL-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BL-HEAD USAGE POINTER.
   05 BL-TAIL USAGE POINTER.
01 WS-STATE-GROUP.
   05 WS-STATE-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
01 WS-CHILD-STATE.
   05 WS-CHILD-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
01 WS-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-CHILD-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CHILD-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-ACTION PIC X(12).
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-J PIC 9(4) COMP-5 VALUE 0.
01 WS-POS PIC 9(9) COMP-5 VALUE 0.
01 WS-TOTAL-LENGTH PIC 9(9) COMP-5 VALUE 0.
01 WS-LEGAL PIC 9 VALUE 0.
01 WS-ALREADY-OPENED PIC 9 VALUE 0.
01 WS-WILL-CLOSE PIC 9 VALUE 0.
01 WS-RANK-OWNED PIC 9 VALUE 0.
01 WS-BLOCK-OWNED PIC 9 VALUE 0.
01 WS-COUNT-EXPORTED PIC 9 VALUE 0.
01 WS-SAVED-STATUS PIC 9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-M PIC 9(4) COMP-5.
01 LK-LENGTHS.
   05 LK-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-WEAVE.
   05 LK-WEAVE-ID OCCURS 5778 TIMES PIC 9(4) COMP-5.
01 LK-WEAVE-LEN PIC 9(9) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-M LK-LENGTHS LK-RANK LK-COUNT LK-WEAVE LK-WEAVE-LEN LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS LK-WEAVE-LEN WS-TOTAL-LENGTH WS-RANK-OWNED WS-BLOCK-OWNED WS-COUNT-EXPORTED
    SET Z-HEAD Z-TAIL TO NULL
    MOVE WS-ZERO TO LK-COUNT
    IF LK-M < 1 OR LK-M > 47 MOVE 140 TO LK-STATUS GO TO WEAVING-LEAVE END-IF

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        IF LK-LENGTH(WS-I) < 1
            MOVE 140 TO LK-STATUS GO TO WEAVING-LEAVE
        END-IF
        ADD LK-LENGTH(WS-I) TO WS-TOTAL-LENGTH
        MOVE LK-LENGTH(WS-I) TO WS-STATE-REMAINING(WS-I)
    END-PERFORM
    IF WS-TOTAL-LENGTH > 5778 MOVE 140 TO LK-STATUS GO TO WEAVING-LEAVE END-IF

    MOVE "RESET" TO WS-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-STATE-GROUP WS-OPENED WS-CLOSED WS-BLOCK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GO TO WEAVING-LEAVE END-IF
    MOVE "COUNT" TO WS-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-STATE-GROUP WS-OPENED WS-CLOSED WS-BLOCK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GO TO WEAVING-LEAVE END-IF
    MOVE WS-BLOCK TO LK-COUNT
    MOVE 1 TO WS-COUNT-EXPORTED
    MOVE WS-ZERO TO WS-BLOCK
    IF LR-SIGN = 0 GO TO WEAVING-LEAVE END-IF

    MOVE LK-RANK TO WS-A MOVE LK-COUNT TO WS-B PERFORM CMP-A-B
    IF WS-CMP > 0 OR LR-SIGN < 0 MOVE 141 TO LK-STATUS GO TO WEAVING-LEAVE END-IF
    MOVE LK-RANK TO WS-RANK
    MOVE 1 TO WS-POS.

UNRANK-LOOP.
    IF WS-POS > WS-TOTAL-LENGTH
        MOVE WS-TOTAL-LENGTH TO LK-WEAVE-LEN
        GO TO WEAVING-LEAVE
    END-IF
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > LK-M
        PERFORM TEST-LEGAL-MOVE
        IF WS-LEGAL = 1
            PERFORM BUILD-CHILD-STATE
            MOVE "COUNT" TO WS-ACTION
            CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-CHILD-STATE WS-CHILD-OPENED WS-CHILD-CLOSED WS-BLOCK WS-STATUS
            IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GO TO WEAVING-LEAVE END-IF
            MOVE 1 TO WS-BLOCK-OWNED
            MOVE WS-RANK TO WS-A MOVE WS-BLOCK TO WS-B PERFORM CMP-A-B
            IF WS-CMP > 0
                PERFORM SUB-A-B
                IF LK-STATUS NOT = 0 GO TO WEAVING-LEAVE END-IF
                IF WS-RANK-OWNED = 1 PERFORM FREE-RANK-VALUE END-IF
                PERFORM FREE-BLOCK-VALUE
                MOVE WS-OUT TO WS-RANK
                MOVE 1 TO WS-RANK-OWNED
            ELSE
                PERFORM FREE-BLOCK-VALUE
                MOVE WS-J TO LK-WEAVE-ID(WS-POS)
                PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
                    MOVE WS-CHILD-REMAINING(WS-I) TO WS-STATE-REMAINING(WS-I)
                END-PERFORM
                MOVE WS-CHILD-OPENED TO WS-OPENED
                MOVE WS-CHILD-CLOSED TO WS-CLOSED
                ADD 1 TO WS-POS
                GO TO UNRANK-LOOP
            END-IF
        END-IF
    END-PERFORM
    MOVE 142 TO LK-STATUS.
WEAVING-LEAVE.
    IF WS-BLOCK-OWNED = 1 PERFORM FREE-BLOCK-VALUE END-IF
    IF WS-RANK-OWNED = 1 PERFORM FREE-RANK-VALUE END-IF
    PERFORM RESET-CACHE-LOCAL
    IF LK-STATUS NOT = 0 AND WS-COUNT-EXPORTED = 1
        PERFORM FREE-EXPORTED-COUNT
    END-IF
    GOBACK.

TEST-LEGAL-MOVE.
    MOVE 0 TO WS-LEGAL WS-ALREADY-OPENED WS-WILL-CLOSE
    IF WS-STATE-REMAINING(WS-J) = 0 EXIT PARAGRAPH END-IF
    IF WS-STATE-REMAINING(WS-J) < LK-LENGTH(WS-J) MOVE 1 TO WS-ALREADY-OPENED END-IF
    IF WS-ALREADY-OPENED = 0 AND WS-J NOT = WS-OPENED + 1 EXIT PARAGRAPH END-IF
    IF WS-STATE-REMAINING(WS-J) = 1 MOVE 1 TO WS-WILL-CLOSE END-IF
    IF WS-WILL-CLOSE = 1 AND WS-J NOT = WS-CLOSED + 1 EXIT PARAGRAPH END-IF
    MOVE 1 TO WS-LEGAL.

BUILD-CHILD-STATE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        MOVE WS-STATE-REMAINING(WS-I) TO WS-CHILD-REMAINING(WS-I)
    END-PERFORM
    MOVE WS-OPENED TO WS-CHILD-OPENED
    MOVE WS-CLOSED TO WS-CHILD-CLOSED
    IF WS-CHILD-REMAINING(WS-J) = LK-LENGTH(WS-J)
        MOVE WS-J TO WS-CHILD-OPENED
    END-IF
    SUBTRACT 1 FROM WS-CHILD-REMAINING(WS-J)
    IF WS-CHILD-REMAINING(WS-J) = 0 MOVE WS-J TO WS-CHILD-CLOSED END-IF.

CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

FREE-RANK-VALUE.
    MOVE WS-RANK TO WS-A
    MOVE "FREE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF
    MOVE WS-ZERO TO WS-RANK
    MOVE 0 TO WS-RANK-OWNED.

FREE-BLOCK-VALUE.
    MOVE WS-BLOCK TO WS-A
    MOVE "FREE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF
    MOVE WS-ZERO TO WS-BLOCK
    MOVE 0 TO WS-BLOCK-OWNED.

RESET-CACHE-LOCAL.
    MOVE LK-STATUS TO WS-SAVED-STATUS
    MOVE "RESET" TO WS-ACTION
    MOVE 0 TO WS-STATUS
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-STATE-GROUP WS-OPENED WS-CLOSED WS-BLOCK WS-STATUS
    IF WS-SAVED-STATUS = 0 AND WS-STATUS NOT = 0 MOVE WS-STATUS TO WS-SAVED-STATUS END-IF
    MOVE WS-SAVED-STATUS TO LK-STATUS.

FREE-EXPORTED-COUNT.
    MOVE LK-STATUS TO WS-SAVED-STATUS
    MOVE LK-COUNT TO WS-A
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    MOVE WS-ZERO TO LK-COUNT WS-A
    MOVE 0 TO WS-COUNT-EXPORTED
    IF WS-SAVED-STATUS = 0 AND WS-STATUS NOT = 0 MOVE WS-STATUS TO WS-SAVED-STATUS END-IF
    MOVE WS-SAVED-STATUS TO LK-STATUS.
END PROGRAM NORMATIVE-WEAVING.
