>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-WEAVING-COUNT RECURSIVE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 MEMO-HEAD USAGE POINTER.
01 MEMO-NODE BASED.
   05 MN-M PIC 9(4) COMP-5.
   05 MN-OPENED PIC 9(4) COMP-5.
   05 MN-CLOSED PIC 9(4) COMP-5.
   05 MN-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
   05 MN-COUNT.
      10 MNC-SIGN PIC S9(4) COMP-5.
      10 MNC-CHUNKS PIC 9(18) COMP-5.
      10 MNC-HEAD USAGE POINTER.
      10 MNC-TAIL USAGE POINTER.
   05 MN-NEXT USAGE POINTER.

LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-CHILD-COUNT.
   05 CC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 CC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 CC-HEAD USAGE POINTER.
   05 CC-TAIL USAGE POINTER.
01 WS-CHILD-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
01 WS-CHILD-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CHILD-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-OP PIC X(16).
01 WS-SELF-ACTION PIC X(12).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-J PIC 9(4) COMP-5 VALUE 0.
01 WS-ALL-ZERO PIC 9 VALUE 1.
01 WS-LEGAL PIC 9 VALUE 0.
01 WS-ALREADY-OPENED PIC 9 VALUE 0.
01 WS-WILL-CLOSE PIC 9 VALUE 0.
01 WS-MEMO-PTR USAGE POINTER.
01 WS-MEMO-NEXT USAGE POINTER.
01 WS-MATCH PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-ACTION PIC X(12).
01 LK-M PIC 9(4) COMP-5.
01 LK-LENGTHS.
   05 LK-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-REMAINING.
   05 LK-REM OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-OPENED PIC 9(4) COMP-5.
01 LK-CLOSED PIC 9(4) COMP-5.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-M LK-LENGTHS LK-REMAINING LK-OPENED LK-CLOSED LK-COUNT LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS
    SET Z-HEAD Z-TAIL TO NULL
    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "RESET"
            PERFORM FREE-MEMO
            GOBACK
        WHEN "COUNT"
            PERFORM COUNT-STATE
            GOBACK
        WHEN OTHER
            MOVE 130 TO LK-STATUS
            GOBACK
    END-EVALUATE.

COUNT-STATE.
    MOVE 1 TO WS-ALL-ZERO
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        IF LK-REM(WS-I) NOT = 0 MOVE 0 TO WS-ALL-ZERO END-IF
    END-PERFORM
    IF WS-ALL-ZERO = 1
        MOVE 1 TO WS-SCALAR
        PERFORM MAKE-SMALL-OUT
        MOVE WS-OUT TO LK-COUNT
        EXIT PARAGRAPH
    END-IF

    PERFORM MEMO-LOOKUP
    IF WS-MATCH = 1 EXIT PARAGRAPH END-IF

    MOVE WS-ZERO TO WS-A
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > LK-M
        PERFORM TEST-LEGAL-MOVE
        IF WS-LEGAL = 1
            PERFORM BUILD-CHILD-STATE
            MOVE "COUNT" TO WS-SELF-ACTION
            CALL "NORMATIVE-WEAVING-COUNT" USING WS-SELF-ACTION LK-M LK-LENGTHS WS-CHILD-REMAINING WS-CHILD-OPENED WS-CHILD-CLOSED WS-CHILD-COUNT WS-STATUS
            IF WS-STATUS NOT = 0
                MOVE WS-STATUS TO LK-STATUS
                EXIT PERFORM
            END-IF
            MOVE WS-CHILD-COUNT TO WS-B
            PERFORM ADD-A-B
            MOVE WS-OUT TO WS-A
        END-IF
    END-PERFORM
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-A TO LK-COUNT
    PERFORM MEMO-INSERT.

TEST-LEGAL-MOVE.
    MOVE 0 TO WS-LEGAL WS-ALREADY-OPENED WS-WILL-CLOSE
    IF LK-REM(WS-J) = 0 EXIT PARAGRAPH END-IF
    IF LK-REM(WS-J) < LK-LENGTH(WS-J) MOVE 1 TO WS-ALREADY-OPENED END-IF
    IF WS-ALREADY-OPENED = 0 AND WS-J NOT = LK-OPENED + 1 EXIT PARAGRAPH END-IF
    IF LK-REM(WS-J) = 1 MOVE 1 TO WS-WILL-CLOSE END-IF
    IF WS-WILL-CLOSE = 1 AND WS-J NOT = LK-CLOSED + 1 EXIT PARAGRAPH END-IF
    MOVE 1 TO WS-LEGAL.

BUILD-CHILD-STATE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        MOVE LK-REM(WS-I) TO WS-CHILD-REMAINING(WS-I)
    END-PERFORM
    MOVE LK-OPENED TO WS-CHILD-OPENED
    MOVE LK-CLOSED TO WS-CHILD-CLOSED
    IF WS-CHILD-REMAINING(WS-J) = LK-LENGTH(WS-J)
        MOVE WS-J TO WS-CHILD-OPENED
    END-IF
    SUBTRACT 1 FROM WS-CHILD-REMAINING(WS-J)
    IF WS-CHILD-REMAINING(WS-J) = 0
        MOVE WS-J TO WS-CHILD-CLOSED
    END-IF.

MEMO-LOOKUP.
    MOVE 0 TO WS-MATCH
    SET WS-MEMO-PTR TO MEMO-HEAD
    PERFORM UNTIL WS-MEMO-PTR = NULL
        SET ADDRESS OF MEMO-NODE TO WS-MEMO-PTR
        MOVE 1 TO WS-MATCH
        IF MN-M NOT = LK-M OR MN-OPENED NOT = LK-OPENED OR MN-CLOSED NOT = LK-CLOSED
            MOVE 0 TO WS-MATCH
        END-IF
        IF WS-MATCH = 1
            PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
                IF MN-REMAINING(WS-I) NOT = LK-REM(WS-I)
                    MOVE 0 TO WS-MATCH
                    EXIT PERFORM
                END-IF
            END-PERFORM
        END-IF
        IF WS-MATCH = 1
            MOVE MN-COUNT TO LK-COUNT
            EXIT PERFORM
        END-IF
        SET WS-MEMO-PTR TO MN-NEXT
    END-PERFORM.

MEMO-INSERT.
    ALLOCATE MEMO-NODE INITIALIZED
    MOVE LK-M TO MN-M
    MOVE LK-OPENED TO MN-OPENED
    MOVE LK-CLOSED TO MN-CLOSED
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        MOVE LK-REM(WS-I) TO MN-REMAINING(WS-I)
    END-PERFORM
    MOVE LK-COUNT TO MN-COUNT
    SET MN-NEXT TO MEMO-HEAD
    SET MEMO-HEAD TO ADDRESS OF MEMO-NODE.

FREE-MEMO.
    SET WS-MEMO-PTR TO MEMO-HEAD
    PERFORM UNTIL WS-MEMO-PTR = NULL
        SET ADDRESS OF MEMO-NODE TO WS-MEMO-PTR
        SET WS-MEMO-NEXT TO MN-NEXT
        MOVE MN-COUNT TO WS-A
        MOVE "FREE" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF
        FREE WS-MEMO-PTR
        SET WS-MEMO-PTR TO WS-MEMO-NEXT
    END-PERFORM
    SET MEMO-HEAD TO NULL.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-WEAVING-COUNT.


IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-WEAVING.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-RANK.
   05 RR-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 RR-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 RR-HEAD USAGE POINTER.
   05 RR-TAIL USAGE POINTER.
01 WS-BLOCK.
   05 BL-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BL-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BL-HEAD USAGE POINTER.
   05 BL-TAIL USAGE POINTER.
01 WS-STATE-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
01 WS-CHILD-REMAINING OCCURS 47 TIMES PIC 9(4) COMP-5.
01 WS-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-CHILD-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CHILD-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-ACTION PIC X(12).
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-J PIC 9(4) COMP-5 VALUE 0.
01 WS-POS PIC 9(9) COMP-5 VALUE 0.
01 WS-TOTAL-LENGTH PIC 9(9) COMP-5 VALUE 0.
01 WS-LEGAL PIC 9 VALUE 0.
01 WS-ALREADY-OPENED PIC 9 VALUE 0.
01 WS-WILL-CLOSE PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-M PIC 9(4) COMP-5.
01 LK-LENGTHS.
   05 LK-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-WEAVE.
   05 LK-WEAVE-ID OCCURS 5778 TIMES PIC 9(4) COMP-5.
01 LK-WEAVE-LEN PIC 9(9) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-M LK-LENGTHS LK-RANK LK-COUNT LK-WEAVE LK-WEAVE-LEN LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS LK-WEAVE-LEN WS-TOTAL-LENGTH
    SET Z-HEAD Z-TAIL TO NULL
    IF LK-M < 1 OR LK-M > 47 MOVE 140 TO LK-STATUS GOBACK END-IF

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        IF LK-LENGTH(WS-I) < 1
            MOVE 140 TO LK-STATUS GOBACK
        END-IF
        ADD LK-LENGTH(WS-I) TO WS-TOTAL-LENGTH
        MOVE LK-LENGTH(WS-I) TO WS-STATE-REMAINING(WS-I)
    END-PERFORM
    IF WS-TOTAL-LENGTH > 5778 MOVE 140 TO LK-STATUS GOBACK END-IF

    MOVE "RESET" TO WS-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-STATE-REMAINING WS-OPENED WS-CLOSED WS-BLOCK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    MOVE "COUNT" TO WS-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-STATE-REMAINING WS-OPENED WS-CLOSED WS-BLOCK WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
    MOVE WS-BLOCK TO LK-COUNT
    IF LR-SIGN = 0 GOBACK END-IF

    MOVE LK-RANK TO WS-A MOVE LK-COUNT TO WS-B PERFORM CMP-A-B
    IF WS-CMP > 0 OR LR-SIGN < 0 MOVE 141 TO LK-STATUS GOBACK END-IF
    MOVE LK-RANK TO WS-RANK
    MOVE 1 TO WS-POS

UNRANK-LOOP.
    IF WS-POS > WS-TOTAL-LENGTH
        MOVE WS-TOTAL-LENGTH TO LK-WEAVE-LEN
        GOBACK
    END-IF
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > LK-M
        PERFORM TEST-LEGAL-MOVE
        IF WS-LEGAL = 1
            PERFORM BUILD-CHILD-STATE
            MOVE "COUNT" TO WS-ACTION
            CALL "NORMATIVE-WEAVING-COUNT" USING WS-ACTION LK-M LK-LENGTHS WS-CHILD-REMAINING WS-CHILD-OPENED WS-CHILD-CLOSED WS-BLOCK WS-STATUS
            IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF
            MOVE WS-RANK TO WS-A MOVE WS-BLOCK TO WS-B PERFORM CMP-A-B
            IF WS-CMP > 0
                PERFORM SUB-A-B
                MOVE WS-OUT TO WS-RANK
            ELSE
                MOVE WS-J TO LK-WEAVE-ID(WS-POS)
                PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
                    MOVE WS-CHILD-REMAINING(WS-I) TO WS-STATE-REMAINING(WS-I)
                END-PERFORM
                MOVE WS-CHILD-OPENED TO WS-OPENED
                MOVE WS-CHILD-CLOSED TO WS-CLOSED
                ADD 1 TO WS-POS
                GO TO UNRANK-LOOP
            END-IF
        END-IF
    END-PERFORM
    MOVE 142 TO LK-STATUS
    GOBACK.

TEST-LEGAL-MOVE.
    MOVE 0 TO WS-LEGAL WS-ALREADY-OPENED WS-WILL-CLOSE
    IF WS-STATE-REMAINING(WS-J) = 0 EXIT PARAGRAPH END-IF
    IF WS-STATE-REMAINING(WS-J) < LK-LENGTH(WS-J) MOVE 1 TO WS-ALREADY-OPENED END-IF
    IF WS-ALREADY-OPENED = 0 AND WS-J NOT = WS-OPENED + 1 EXIT PARAGRAPH END-IF
    IF WS-STATE-REMAINING(WS-J) = 1 MOVE 1 TO WS-WILL-CLOSE END-IF
    IF WS-WILL-CLOSE = 1 AND WS-J NOT = WS-CLOSED + 1 EXIT PARAGRAPH END-IF
    MOVE 1 TO WS-LEGAL.

BUILD-CHILD-STATE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LK-M
        MOVE WS-STATE-REMAINING(WS-I) TO WS-CHILD-REMAINING(WS-I)
    END-PERFORM
    MOVE WS-OPENED TO WS-CHILD-OPENED
    MOVE WS-CLOSED TO WS-CHILD-CLOSED
    IF WS-CHILD-REMAINING(WS-J) = LK-LENGTH(WS-J)
        MOVE WS-J TO WS-CHILD-OPENED
    END-IF
    SUBTRACT 1 FROM WS-CHILD-REMAINING(WS-J)
    IF WS-CHILD-REMAINING(WS-J) = 0 MOVE WS-J TO WS-CHILD-CLOSED END-IF.

CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-WEAVING.
