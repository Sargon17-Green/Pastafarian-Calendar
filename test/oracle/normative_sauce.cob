    MOVE 24 TO WS-FACT-V(2)
    MOVE 6 TO WS-FACT-V(3)
    MOVE 2 TO WS-FACT-V(4)
    MOVE 1 TO WS-FACT-V(5)
    MOVE 1 TO WS-FACT-V(6)

    MOVE 17 TO BP(1)
    MOVE 19 TO BP(2)
    MOVE 23 TO BP(3)
    MOVE 29 TO BP(4)
    MOVE 31 TO BP(5)
    MOVE 37 TO BP(6)

    MOVE 1 TO SSP(1)
    MOVE 2 TO SSP(2)
    MOVE 3 TO SSP(3)
    MOVE 4 TO SSP(4)
    MOVE 5 TO SSP(5)
    MOVE 1 TO SSP(6)

    MOVE 1 TO HSK(1)
    MOVE 2 TO HSK(2)
    MOVE 3 TO HSK(3)
    MOVE 4 TO HSK(4)
    MOVE 5 TO HSK(5)
    MOVE 1 TO HSK(6)
    MOVE 2 TO HSK(7)

    MOVE 3 TO HC-A(1) MOVE 4 TO HC-B(1) MOVE 6 TO HC-C(1) MOVE 8 TO HC-D(1)
    MOVE 5 TO HC-A(2) MOVE 7 TO HC-B(2) MOVE 10 TO HC-C(2) MOVE 12 TO HC-D(2)
    MOVE 7 TO HC-A(3) MOVE 10 TO HC-B(3) MOVE 14 TO HC-C(3) MOVE 16 TO HC-D(3)
    MOVE 9 TO HC-A(4) MOVE 13 TO HC-B(4) MOVE 18 TO HC-C(4) MOVE 20 TO HC-D(4)
    MOVE 11 TO HC-A(5) MOVE 16 TO HC-B(5) MOVE 22 TO HC-C(5) MOVE 24 TO HC-D(5)
    MOVE 13 TO HC-A(6) MOVE 19 TO HC-B(6) MOVE 26 TO HC-C(6) MOVE 28 TO HC-D(6)
    MOVE 15 TO HC-A(7) MOVE 22 TO HC-B(7) MOVE 30 TO HC-C(7) MOVE 32 TO HC-D(7)

    MOVE 3 TO GR-A(1) MOVE 5 TO GR-B(1) MOVE 7 TO GR-C(1) MOVE 11 TO GR-D(1) MOVE 1 TO GR-KIND(1)
    MOVE 5 TO GR-A(2) MOVE 7 TO GR-B(2) MOVE 11 TO GR-C(2) MOVE 13 TO GR-D(2) MOVE 2 TO GR-KIND(2)
    MOVE 7 TO GR-A(3) MOVE 11 TO GR-B(3) MOVE 13 TO GR-C(3) MOVE 17 TO GR-D(3) MOVE 3 TO GR-KIND(3)
    MOVE 11 TO GR-A(4) MOVE 13 TO GR-B(4) MOVE 17 TO GR-C(4) MOVE 19 TO GR-D(4) MOVE 4 TO GR-KIND(4)
    MOVE 13 TO GR-A(5) MOVE 17 TO GR-B(5) MOVE 19 TO GR-C(5) MOVE 23 TO GR-D(5) MOVE 5 TO GR-KIND(5)
    MOVE 17 TO GR-A(6) MOVE 19 TO GR-B(6) MOVE 23 TO GR-C(6) MOVE 29 TO GR-D(6) MOVE 1 TO GR-KIND(6)
    MOVE 19 TO GR-A(7) MOVE 23 TO GR-B(7) MOVE 29 TO GR-C(7) MOVE 31 TO GR-D(7) MOVE 2 TO GR-KIND(7)
    MOVE 23 TO GR-A(8) MOVE 29 TO GR-B(8) MOVE 31 TO GR-C(8) MOVE 37 TO GR-D(8) MOVE 3 TO GR-KIND(8)
    MOVE 29 TO GR-A(9) MOVE 31 TO GR-B(9) MOVE 37 TO GR-C(9) MOVE 41 TO GR-D(9) MOVE 4 TO GR-KIND(9)
    MOVE 31 TO GR-A(10) MOVE 37 TO GR-B(10) MOVE 41 TO GR-C(10) MOVE 43 TO GR-D(10) MOVE 5 TO GR-KIND(10)
    MOVE 37 TO GR-A(11) MOVE 41 TO GR-B(11) MOVE 43 TO GR-C(11) MOVE 47 TO GR-D(11) MOVE 1 TO GR-KIND(11).

BUILD-COUNTS.
    MOVE -15055671 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-FOUNDATION WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF

    MOVE LK-C-DAY TO WS-A
    PERFORM DAY-COUNT-A
    MOVE WS-OUT TO WS-ACTION-COUNT

    MOVE LK-T-DAY TO WS-A
    PERFORM DAY-COUNT-A
    MOVE WS-OUT TO WS-TARGET-COUNT

    MOVE LK-T-DAY TO WS-A
    MOVE LK-C-DAY TO WS-B
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    IF WS-CMP < 0 MOVE 1 TO WS-DIRECTION END-IF
    IF WS-CMP = 0 MOVE 2 TO WS-DIRECTION END-IF
    IF WS-CMP > 0 MOVE 3 TO WS-DIRECTION END-IF

    MOVE LK-T-DAY TO WS-A
    MOVE LK-C-DAY TO WS-B
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    MOVE WS-OUT TO WS-A
    MOVE "ABS" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    MOVE WS-OUT TO WS-A
    MOVE 1 TO WS-SCALAR
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    MOVE WS-OUT TO WS-DISTANCE-COUNT

    MOVE WS-ACTION-COUNT TO WS-A
    MOVE WS-TARGET-COUNT TO WS-B
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    MOVE WS-OUT TO WS-CONNECTION-COUNT.

DAY-COUNT-A.
    MOVE WS-FOUNDATION TO WS-B
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    IF WS-CMP = 0
        MOVE 1 TO WS-SCALAR
        MOVE "FROM-SMALL" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP > 0
        MOVE WS-FOUNDATION TO WS-B
        MOVE "SUB" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
        MOVE WS-OUT TO WS-A
        MOVE 2 TO WS-SCALAR
        MOVE "MUL-SMALL" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
        MOVE WS-OUT TO WS-A
        MOVE 1 TO WS-SCALAR
        MOVE "ADD-SMALL" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
    ELSE
        MOVE WS-A TO WS-B
        MOVE WS-FOUNDATION TO WS-A
        MOVE "SUB" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
        MOVE WS-OUT TO WS-A
        MOVE 2 TO WS-SCALAR
        MOVE "MUL-SMALL" TO WS-OP
        CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        PERFORM CHECK-STATUS
    END-IF.

BUILD-STONES.
    MOVE 17 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-STONE-W(1)
    MOVE 29 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-STONE-B(1)
    MOVE 43 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-STONE-S(1)
    MOVE 71 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-STONE-M(1)
    MOVE 101 TO WS-SCALAR PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-STONE-R(1)

    PERFORM VARYING WS-I FROM 2 BY 1 UNTIL WS-I > 46
        *> 小麦：SAVE(w^2 + 3b + i)
        MOVE WS-STONE-W(WS-I - 1) TO WS-A PERFORM SQUARE-A MOVE WS-OUT TO WS-T1
        MOVE WS-STONE-B(WS-I - 1) TO WS-A MOVE 3 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-I TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A PERFORM SAVE-A MOVE WS-OUT TO WS-STONE-W(WS-I)

        *> 大麦：SAVE(b^2 + 5s + w)
        MOVE WS-STONE-B(WS-I - 1) TO WS-A PERFORM SQUARE-A MOVE WS-OUT TO WS-T1
        MOVE WS-STONE-S(WS-I - 1) TO WS-A MOVE 5 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-W(WS-I - 1) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A PERFORM SAVE-A MOVE WS-OUT TO WS-STONE-B(WS-I)

        *> 盐：SAVE(s^2 + 7m + b)
        MOVE WS-STONE-S(WS-I - 1) TO WS-A PERFORM SQUARE-A MOVE WS-OUT TO WS-T1
        MOVE WS-STONE-M(WS-I - 1) TO WS-A MOVE 7 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-B(WS-I - 1) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A PERFORM SAVE-A MOVE WS-OUT TO WS-STONE-S(WS-I)

        *> 苦石：SAVE(m^2 + 11r + s)
        MOVE WS-STONE-M(WS-I - 1) TO WS-A PERFORM SQUARE-A MOVE WS-OUT TO WS-T1
        MOVE WS-STONE-R(WS-I - 1) TO WS-A MOVE 11 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-S(WS-I - 1) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A PERFORM SAVE-A MOVE WS-OUT TO WS-STONE-M(WS-I)

        *> 红石：SAVE(r^2 + 13w + m)
        MOVE WS-STONE-R(WS-I - 1) TO WS-A PERFORM SQUARE-A MOVE WS-OUT TO WS-T1
        MOVE WS-STONE-W(WS-I - 1) TO WS-A MOVE 13 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-T1 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-M(WS-I - 1) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A PERFORM SAVE-A MOVE WS-OUT TO WS-STONE-R(WS-I)
    END-PERFORM.

BUILD-HIDDEN.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 7
        MOVE WS-ACTION-COUNT TO WS-A
        MOVE WS-TARGET-COUNT TO WS-B
        PERFORM ADD-A-B
        MOVE WS-OUT TO WS-A
        MOVE HC-A(WS-K) TO WS-SCALAR
        *> 先重算 a*target，从 action 开始，避免任何未定义累加顺序。
        MOVE WS-TARGET-COUNT TO WS-A PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T1
        MOVE WS-ACTION-COUNT TO WS-A MOVE WS-T1 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-DISTANCE-COUNT TO WS-A MOVE HC-B(WS-K) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T2
        MOVE WS-OUT TO WS-T2
        MOVE WS-ACTION-COUNT TO WS-A MOVE WS-T1 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T3
        MOVE WS-T3 TO WS-A MOVE WS-T2 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T3
        MOVE WS-CONNECTION-COUNT TO WS-A MOVE HC-C(WS-K) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
        MOVE WS-T3 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T3
        MOVE WS-DIRECTION TO WS-SCALAR MOVE WS-ZERO TO WS-A PERFORM MAKE-SMALL-OUT MOVE WS-OUT TO WS-A
        MOVE HC-D(WS-K) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T5
        MOVE WS-T3 TO WS-A MOVE WS-T5 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A

        MOVE WS-STONE-W(WS-K) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-B(WS-K) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-S(WS-K) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-M(WS-K) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        MOVE WS-STONE-R(WS-K) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
        PERFORM SAVE-A
        MOVE WS-OUT TO WS-A

        PERFORM VARYING WS-G FROM 1 BY 1 UNTIL WS-G > 7
            MOVE WS-A TO WS-T1
            PERFORM SQUARE-A
            MOVE WS-OUT TO WS-T2
            MOVE WS-T1 TO WS-A MOVE 3 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T3
            MOVE WS-T2 TO WS-A MOVE WS-T3 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
            MOVE HSK(WS-G) TO WS-STONE-KIND
            PERFORM LOAD-STONE-KIND-K-INTO-B
            PERFORM ADD-A-B
            MOVE WS-OUT TO WS-A
            MOVE WS-G TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-A
        END-PERFORM
        MOVE WS-A TO WS-HIDDEN-V(WS-K)
    END-PERFORM.

BUILD-VISIBLE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 46
        MOVE 1 TO WS-J PERFORM LOAD-PRIOR-INTO-T1
        MOVE 3 TO WS-J PERFORM LOAD-PRIOR-INTO-T2
        MOVE 7 TO WS-J PERFORM LOAD-PRIOR-INTO-T3

        MOVE WS-ZERO TO WS-T5

        MOVE WS-STONE-W(WS-I) TO WS-A
        MOVE WS-ACTION-COUNT TO WS-B
        PERFORM MUL-A-B
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-STONE-B(WS-I) TO WS-A
        MOVE WS-TARGET-COUNT TO WS-B
        PERFORM MUL-A-B
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-STONE-S(WS-I) TO WS-A
        MOVE WS-DISTANCE-COUNT TO WS-B
        PERFORM MUL-A-B
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-STONE-M(WS-I) TO WS-A
        MOVE WS-CONNECTION-COUNT TO WS-B
        PERFORM MUL-A-B
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-DIRECTION TO WS-SCALAR
        PERFORM MAKE-SMALL-OUT
        MOVE WS-OUT TO WS-B
        MOVE WS-STONE-R(WS-I) TO WS-A
        PERFORM MUL-A-B
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-T5 TO WS-A MOVE WS-T1 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-T2 TO WS-A MOVE 3 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-T3 TO WS-A MOVE 5 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-T5 TO WS-A MOVE WS-I TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
        PERFORM SAVE-A
        MOVE WS-OUT TO WS-A

        PERFORM VARYING WS-G FROM 1 BY 1 UNTIL WS-G > 11
            MOVE WS-A TO WS-T4
            PERFORM SQUARE-A
            MOVE WS-OUT TO WS-T5

            MOVE WS-T4 TO WS-A MOVE GR-A(WS-G) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-B
            MOVE WS-T5 TO WS-A PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T1 TO WS-A MOVE GR-B(WS-G) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-B
            MOVE WS-T5 TO WS-A PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T2 TO WS-A MOVE GR-C(WS-G) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-B
            MOVE WS-T5 TO WS-A PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T3 TO WS-A MOVE GR-D(WS-G) TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-B
            MOVE WS-T5 TO WS-A PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T5 TO WS-A
            MOVE GR-KIND(WS-G) TO WS-STONE-KIND
            PERFORM LOAD-STONE-KIND-I-INTO-B
            PERFORM ADD-A-B
            MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-A
        END-PERFORM
        MOVE WS-A TO WS-DROP(WS-I)
    END-PERFORM.

BUILD-INITIAL-BOWLS.
    PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
        MOVE WS-ACTION-COUNT TO WS-T5

        MOVE WS-TARGET-COUNT TO WS-A
        MOVE WS-ID TO WS-SCALAR
        PERFORM MUL-SMALL-A
        MOVE WS-OUT TO WS-T4
        MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

        MOVE WS-T5 TO WS-A MOVE WS-DISTANCE-COUNT TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
        MOVE WS-T5 TO WS-A MOVE WS-CONNECTION-COUNT TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
        MOVE WS-T5 TO WS-A MOVE WS-DIRECTION TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-T5
        COMPUTE WS-SCALAR = BP(WS-ID) * BP(WS-ID)
        MOVE WS-T5 TO WS-A PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
        PERFORM SQUARE-A
        MOVE WS-OUT TO WS-A
        MOVE WS-ID TO WS-SCALAR
        PERFORM ADD-SMALL-A
        MOVE WS-OUT TO WS-A
        PERFORM SAVE-A
        MOVE WS-OUT TO WS-BOWL(WS-ID)
    END-PERFORM.

APPLY-DROPS-TO-BOWLS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 46
        MOVE WS-DROP(WS-I) TO WS-A
        PERFORM ORDER-FROM-A

        PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
            MOVE WS-BOWL(WS-ID) TO WS-OLD-BOWL(WS-ID)
            MOVE WS-ZERO TO WS-POUR(WS-ID)
        END-PERFORM

        PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 3
            MOVE WS-DROP(WS-I) TO WS-A
            PERFORM SQUARE-A
            MOVE WS-OUT TO WS-T5

            EVALUATE WS-POS
                WHEN 1 MOVE WS-STONE-W(WS-I) TO WS-A MOVE 3 TO WS-COEFF
                WHEN 2 MOVE WS-STONE-B(WS-I) TO WS-A MOVE 5 TO WS-COEFF
                WHEN 3 MOVE WS-STONE-S(WS-I) TO WS-A MOVE 7 TO WS-COEFF
            END-EVALUATE
            MOVE WS-OLD-BOWL(WS-ORDER-ID(WS-POS)) TO WS-B
            PERFORM MUL-A-B
            MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
            COMPUTE WS-SCALAR = WS-COEFF * WS-I
            MOVE WS-T5 TO WS-A PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-POUR(WS-POS)
        END-PERFORM

        PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 6
            MOVE WS-ORDER-ID(WS-POS) TO WS-ID
            COMPUTE WS-J = WS-POS - 1
            IF WS-J < 1 MOVE 6 TO WS-J END-IF
            MOVE WS-ORDER-ID(WS-J) TO WS-PREV-ID
            COMPUTE WS-J = WS-POS + 1
            IF WS-J > 6 MOVE 1 TO WS-J END-IF
            MOVE WS-ORDER-ID(WS-J) TO WS-NEXT-ID

            MOVE WS-OLD-BOWL(WS-ID) TO WS-T5

            MOVE WS-OLD-BOWL(WS-PREV-ID) TO WS-A MOVE 2 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-OLD-BOWL(WS-NEXT-ID) TO WS-A MOVE 3 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T5 TO WS-A MOVE WS-POUR(WS-POS) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
            MOVE WS-T5 TO WS-A MOVE WS-DROP(WS-I) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T5 TO WS-A
            MOVE SSP(WS-POS) TO WS-STONE-KIND
            PERFORM LOAD-STONE-KIND-I-INTO-B
            PERFORM ADD-A-B
            MOVE WS-OUT TO WS-T5

            MOVE WS-T5 TO WS-A
            PERFORM SQUARE-A
            MOVE WS-OUT TO WS-T5

            MOVE WS-OLD-BOWL(WS-PREV-ID) TO WS-A
            MOVE WS-OLD-BOWL(WS-NEXT-ID) TO WS-B
            PERFORM MUL-A-B
            MOVE WS-OUT TO WS-A
            MOVE 5 TO WS-SCALAR
            PERFORM MUL-SMALL-A
            MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            COMPUTE WS-SCALAR = WS-I * WS-POS
            MOVE WS-T5 TO WS-A PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-NEXT-BOWL(WS-ID)
        END-PERFORM

        PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
            MOVE WS-NEXT-BOWL(WS-ID) TO WS-BOWL(WS-ID)
        END-PERFORM

        IF WS-I = 46
            PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 6
                MOVE WS-ORDER-ID(WS-POS) TO WS-ORDER46-ID(WS-POS)
            END-PERFORM
        END-IF
    END-PERFORM.

POST-STIR-12.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
        PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
            MOVE WS-BOWL(WS-ID) TO WS-OLD-BOWL(WS-ID)
        END-PERFORM

        MOVE WS-ZERO TO WS-T5
        PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
            MOVE WS-T5 TO WS-A MOVE WS-OLD-BOWL(WS-ID) TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
        END-PERFORM
        COMPUTE WS-SCALAR = 149 * WS-I
        MOVE WS-T5 TO WS-A PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-A
        PERFORM SAVE-A
        MOVE WS-OUT TO WS-T3

        MOVE WS-T3 TO WS-A
        PERFORM ORDER-FROM-A

        PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 6
            MOVE WS-ORDER-ID(WS-POS) TO WS-ID
            COMPUTE WS-J = WS-POS - 1
            IF WS-J < 1 MOVE 6 TO WS-J END-IF
            MOVE WS-ORDER-ID(WS-J) TO WS-PREV-ID
            COMPUTE WS-J = WS-POS + 1
            IF WS-J > 6 MOVE 1 TO WS-J END-IF
            MOVE WS-ORDER-ID(WS-J) TO WS-NEXT-ID

            MOVE WS-OLD-BOWL(WS-ID) TO WS-T5

            MOVE WS-OLD-BOWL(WS-PREV-ID) TO WS-A MOVE 3 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-OLD-BOWL(WS-NEXT-ID) TO WS-A MOVE 5 TO WS-SCALAR PERFORM MUL-SMALL-A MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5

            MOVE WS-T5 TO WS-A MOVE WS-T3 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-T5
            MOVE WS-T5 TO WS-A MOVE WS-I TO WS-SCALAR PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-T5
            COMPUTE WS-SCALAR = WS-POS * WS-POS
            MOVE WS-T5 TO WS-A PERFORM ADD-SMALL-A MOVE WS-OUT TO WS-T5
            MOVE WS-T5 TO WS-A
            PERFORM SQUARE-A
            MOVE WS-OUT TO WS-T5


            MOVE WS-OLD-BOWL(WS-PREV-ID) TO WS-A
            MOVE WS-OLD-BOWL(WS-NEXT-ID) TO WS-B
            PERFORM MUL-A-B
            MOVE WS-OUT TO WS-A
            MOVE 7 TO WS-SCALAR
            PERFORM MUL-SMALL-A
            MOVE WS-OUT TO WS-T4
            MOVE WS-T5 TO WS-A MOVE WS-T4 TO WS-B PERFORM ADD-A-B MOVE WS-OUT TO WS-A
            PERFORM SAVE-A
            MOVE WS-OUT TO WS-NEXT-BOWL(WS-ID)
        END-PERFORM

        PERFORM VARYING WS-ID FROM 1 BY 1 UNTIL WS-ID > 6
            MOVE WS-NEXT-BOWL(WS-ID) TO WS-BOWL(WS-ID)
        END-PERFORM
    END-PERFORM.

LOAD-PRIOR-INTO-T1.
    COMPUTE WS-SLOT = WS-I - WS-J
    IF WS-SLOT >= 1
        MOVE WS-DROP(WS-SLOT) TO WS-T1
    ELSE
        COMPUTE WS-HIDDEN-K = 1 - WS-SLOT
        MOVE WS-HIDDEN-V(WS-HIDDEN-K) TO WS-T1
    END-IF.
LOAD-PRIOR-INTO-T2.
    COMPUTE WS-SLOT = WS-I - WS-J
    IF WS-SLOT >= 1
        MOVE WS-DROP(WS-SLOT) TO WS-T2
    ELSE
        COMPUTE WS-HIDDEN-K = 1 - WS-SLOT
        MOVE WS-HIDDEN-V(WS-HIDDEN-K) TO WS-T2
    END-IF.
LOAD-PRIOR-INTO-T3.
    COMPUTE WS-SLOT = WS-I - WS-J
    IF WS-SLOT >= 1
        MOVE WS-DROP(WS-SLOT) TO WS-T3
    ELSE
        COMPUTE WS-HIDDEN-K = 1 - WS-SLOT
        MOVE WS-HIDDEN-V(WS-HIDDEN-K) TO WS-T3
    END-IF.

LOAD-STONE-KIND-K-INTO-B.
    EVALUATE WS-STONE-KIND
        WHEN 1 MOVE WS-STONE-W(WS-K) TO WS-B
        WHEN 2 MOVE WS-STONE-B(WS-K) TO WS-B
        WHEN 3 MOVE WS-STONE-S(WS-K) TO WS-B
        WHEN 4 MOVE WS-STONE-M(WS-K) TO WS-B
        WHEN 5 MOVE WS-STONE-R(WS-K) TO WS-B
    END-EVALUATE.
LOAD-STONE-KIND-I-INTO-B.
    EVALUATE WS-STONE-KIND
        WHEN 1 MOVE WS-STONE-W(WS-I) TO WS-B
        WHEN 2 MOVE WS-STONE-B(WS-I) TO WS-B
        WHEN 3 MOVE WS-STONE-S(WS-I) TO WS-B
        WHEN 4 MOVE WS-STONE-M(WS-I) TO WS-B
        WHEN 5 MOVE WS-STONE-R(WS-I) TO WS-B
    END-EVALUATE.

ORDER-FROM-A.
    MOVE WS-A TO WS-T4
    MOVE WS-T4 TO WS-A
    MOVE -1 TO WS-SCALAR
    PERFORM ADD-SMALL-A
    MOVE WS-OUT TO WS-A
    MOVE 720 TO WS-SCALAR
    MOVE "MOD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS
    COMPUTE WS-RANK = WS-SMALL + 1
    COMPUTE WS-RANK0 = WS-RANK - 1
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
        MOVE WS-J TO WS-REM-ID(WS-J)
    END-PERFORM
    MOVE 6 TO WS-SLOTS
    PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > 6
        MOVE WS-FACT-V(WS-POS) TO WS-BLOCK
        COMPUTE WS-Q = WS-RANK0 / WS-BLOCK
        COMPUTE WS-RANK0 = FUNCTION MOD(WS-RANK0, WS-BLOCK)
        COMPUTE WS-REMOVE-POS = WS-Q + 1
        MOVE WS-REM-ID(WS-REMOVE-POS) TO WS-ORDER-ID(WS-POS)
        PERFORM VARYING WS-J FROM WS-REMOVE-POS BY 1 UNTIL WS-J >= WS-SLOTS
            MOVE WS-REM-ID(WS-J + 1) TO WS-REM-ID(WS-J)
        END-PERFORM
        SUBTRACT 1 FROM WS-SLOTS
    END-PERFORM.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SQUARE-A.
    MOVE "SQUARE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-A-B.
    MOVE "MUL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-SMALL-A.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SAVE-A.
    MOVE "SAVE" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-SAUCE.
