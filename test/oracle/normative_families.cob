LINKAGE SECTION.
01 LK-TOTAL PIC 9(9) COMP-5.
01 LK-SLOTS PIC 9(4) COMP-5.
01 LK-LO PIC 9(4) COMP-5.
01 LK-HI PIC 9(4) COMP-5.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-VALUES.
   05 LK-VALUE OCCURS 47 TIMES PIC 9(4) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-TOTAL LK-SLOTS LK-LO LK-HI LK-RANK LK-COUNT LK-VALUES LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS WS-COUNT-OWNED WS-TOTAL-COUNT-OWNED
        WS-RANK-OWNED WS-SUM-OWNED WS-COMB-A-OWNED WS-COMB-B-OWNED
        WS-TERM-OWNED WS-BINOMIAL-OWNED
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        A-HEAD A-TAIL B-HEAD B-TAIL O-HEAD O-TAIL
        CR-HEAD CR-TAIL TC-HEAD TC-TAIL RW-HEAD RW-TAIL SU-HEAD SU-TAIL
        C1-HEAD C1-TAIL C2-HEAD C2-TAIL TM-HEAD TM-TAIL
        BN-HEAD BN-TAIL TO NULL
    MOVE WS-ZERO TO LK-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 47
        MOVE 0 TO LK-VALUE(WS-I)
    END-PERFORM

    IF LK-TOTAL > 5778 OR LK-SLOTS > 47 OR LK-LO < 1 OR LK-HI < LK-LO
        MOVE 110 TO LK-STATUS
        GOBACK
    END-IF

    MOVE LK-TOTAL TO WS-TOTAL-WORK
    MOVE LK-SLOTS TO WS-SLOTS-WORK
    PERFORM COUNT-COMPLETIONS
    IF LK-STATUS NOT = 0
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF

    IF LR-SIGN = 0
        MOVE WS-COUNT-RESULT TO LK-COUNT
        MOVE WS-ZERO TO WS-COUNT-RESULT
        MOVE 0 TO WS-COUNT-OWNED
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF

    MOVE LK-RANK TO WS-A
    MOVE WS-COUNT-RESULT TO WS-B
    PERFORM CMP-A-B
    IF LK-STATUS NOT = 0 OR LR-SIGN < 0 OR WS-CMP > 0
        IF LK-STATUS = 0 MOVE 111 TO LK-STATUS END-IF
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF

    *> 非零 rank 的总数先留在本过程；只有 unrank 全部成功后才转交。
    MOVE WS-COUNT-RESULT TO WS-TOTAL-COUNT
    MOVE WS-ZERO TO WS-COUNT-RESULT
    MOVE 0 TO WS-COUNT-OWNED
    MOVE 1 TO WS-TOTAL-COUNT-OWNED
    MOVE LK-RANK TO WS-RANK-WORK
    MOVE LK-TOTAL TO WS-REM-LEFT
    MOVE LK-SLOTS TO WS-SLOTS-LEFT

    PERFORM VARYING WS-POS FROM 1 BY 1
        UNTIL WS-POS > LK-SLOTS OR LK-STATUS NOT = 0
        MOVE 0 TO WS-SELECTED
        PERFORM VARYING WS-X FROM LK-LO BY 1
            UNTIL WS-X > LK-HI OR WS-SELECTED = 1 OR LK-STATUS NOT = 0
            COMPUTE WS-CAND-TOTAL = WS-REM-LEFT - WS-X
            COMPUTE WS-SLOTS-WORK = WS-SLOTS-LEFT - 1
            MOVE WS-CAND-TOTAL TO WS-TOTAL-WORK
            PERFORM COUNT-COMPLETIONS
            IF LK-STATUS = 0
                MOVE WS-RANK-WORK TO WS-A
                MOVE WS-COUNT-RESULT TO WS-B
                PERFORM CMP-A-B
            END-IF
            IF LK-STATUS = 0
                IF WS-CMP > 0
                    PERFORM SUB-A-B
                    IF LK-STATUS = 0
                        IF WS-RANK-OWNED = 1 PERFORM FREE-RANK END-IF
                        MOVE WS-OUT TO WS-RANK-WORK
                        MOVE WS-ZERO TO WS-OUT
                        MOVE 1 TO WS-RANK-OWNED
                    END-IF
                ELSE
                    MOVE WS-X TO LK-VALUE(WS-POS)
                    MOVE WS-CAND-TOTAL TO WS-REM-LEFT
                    SUBTRACT 1 FROM WS-SLOTS-LEFT
                    MOVE 1 TO WS-SELECTED
                END-IF
            END-IF
            IF WS-COUNT-OWNED = 1 PERFORM FREE-COUNT END-IF
        END-PERFORM
        IF WS-SELECTED = 0 AND LK-STATUS = 0 MOVE 112 TO LK-STATUS END-IF
    END-PERFORM

    IF LK-STATUS = 0 AND (WS-SLOTS-LEFT NOT = 0 OR WS-REM-LEFT NOT = 0)
        MOVE 112 TO LK-STATUS
    END-IF
    IF LK-STATUS = 0
        MOVE WS-TOTAL-COUNT TO LK-COUNT
        MOVE WS-ZERO TO WS-TOTAL-COUNT
        MOVE 0 TO WS-TOTAL-COUNT-OWNED
    END-IF
    PERFORM CLEAN-LOCAL-VALUES
    GOBACK.

COUNT-COMPLETIONS.
    IF WS-COUNT-OWNED = 1 PERFORM FREE-COUNT END-IF
    MOVE WS-ZERO TO WS-COUNT-RESULT

    IF WS-SLOTS-WORK = 0
        IF WS-TOTAL-WORK = 0
            MOVE 1 TO WS-SCALAR
            PERFORM MAKE-SMALL-OUT
            IF LK-STATUS = 0
                MOVE WS-OUT TO WS-COUNT-RESULT
                MOVE WS-ZERO TO WS-OUT
                MOVE 1 TO WS-COUNT-OWNED
            END-IF
        END-IF
        EXIT PARAGRAPH
    END-IF

    COMPUTE WS-Z = WS-TOTAL-WORK - (WS-SLOTS-WORK * LK-LO)
    COMPUTE WS-UPPER = LK-HI - LK-LO
    IF WS-Z < 0
        EXIT PARAGRAPH
    END-IF
    IF WS-Z > WS-SLOTS-WORK * WS-UPPER
        EXIT PARAGRAPH
    END-IF

    COMPUTE WS-J-MAX = WS-Z / (WS-UPPER + 1)
    MOVE WS-ZERO TO WS-SUM-BI
    MOVE 0 TO WS-SUM-OWNED

    PERFORM VARYING WS-J FROM 0 BY 1
        UNTIL WS-J > WS-J-MAX OR LK-STATUS NOT = 0
        MOVE WS-SLOTS-WORK TO WS-BIN-N
        MOVE WS-J TO WS-BIN-K
        PERFORM BUILD-BINOMIAL
        IF LK-STATUS = 0
            MOVE WS-BINOMIAL TO WS-COMB-A
            MOVE WS-ZERO TO WS-BINOMIAL
            MOVE 0 TO WS-BINOMIAL-OWNED
            MOVE 1 TO WS-COMB-A-OWNED
        END-IF

        IF LK-STATUS = 0
            COMPUTE WS-TOP = WS-Z - (WS-J * (WS-UPPER + 1))
                + WS-SLOTS-WORK - 1
            IF WS-TOP < 0
                MOVE 113 TO LK-STATUS
            ELSE
                MOVE WS-TOP TO WS-BIN-N
                COMPUTE WS-BIN-K = WS-SLOTS-WORK - 1
                PERFORM BUILD-BINOMIAL
            END-IF
        END-IF
        IF LK-STATUS = 0
            MOVE WS-BINOMIAL TO WS-COMB-B
            MOVE WS-ZERO TO WS-BINOMIAL
            MOVE 0 TO WS-BINOMIAL-OWNED
            MOVE 1 TO WS-COMB-B-OWNED
            MOVE WS-COMB-A TO WS-A
            MOVE WS-COMB-B TO WS-B
            PERFORM MUL-A-B
        END-IF
        IF LK-STATUS = 0
            MOVE WS-OUT TO WS-TERM
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-TERM-OWNED
            IF WS-SUM-OWNED = 0
                IF FUNCTION MOD(WS-J, 2) = 0
                    MOVE WS-TERM TO WS-SUM-BI
                    MOVE WS-ZERO TO WS-TERM
                    MOVE 0 TO WS-TERM-OWNED
                    MOVE 1 TO WS-SUM-OWNED
                ELSE
                    *> 此分支理论上不会在 j=0 发生；保留显式错误边界。
                    MOVE 113 TO LK-STATUS
                END-IF
            ELSE
                MOVE WS-SUM-BI TO WS-A
                MOVE WS-TERM TO WS-B
                IF FUNCTION MOD(WS-J, 2) = 0
                    PERFORM ADD-A-B
                ELSE
                    PERFORM SUB-A-B
                END-IF
                IF LK-STATUS = 0
                    PERFORM FREE-SUM
                    MOVE WS-OUT TO WS-SUM-BI
                    MOVE WS-ZERO TO WS-OUT
                    MOVE 1 TO WS-SUM-OWNED
                END-IF
            END-IF
        END-IF
        IF WS-COMB-A-OWNED = 1 PERFORM FREE-COMB-A END-IF
        IF WS-COMB-B-OWNED = 1 PERFORM FREE-COMB-B END-IF
        IF WS-TERM-OWNED = 1 PERFORM FREE-TERM END-IF
    END-PERFORM

    IF LK-STATUS = 0
        IF WS-SUM-OWNED = 1
            MOVE WS-SUM-BI TO WS-COUNT-RESULT
            MOVE WS-ZERO TO WS-SUM-BI
            MOVE 0 TO WS-SUM-OWNED
            MOVE 1 TO WS-COUNT-OWNED
        END-IF
    END-IF.

BUILD-BINOMIAL.
    IF WS-BINOMIAL-OWNED = 1 PERFORM FREE-BINOMIAL END-IF
    MOVE WS-ZERO TO WS-BINOMIAL
    IF WS-BIN-K > WS-BIN-N
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-BIN-KE = WS-BIN-N - WS-BIN-K
    IF WS-BIN-K < WS-BIN-KE MOVE WS-BIN-K TO WS-BIN-KE END-IF

    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-BINOMIAL
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-BINOMIAL-OWNED

    PERFORM VARYING WS-I FROM 1 BY 1
        UNTIL WS-I > WS-BIN-KE OR LK-STATUS NOT = 0
        COMPUTE WS-SCALAR = WS-BIN-N - WS-BIN-KE + WS-I
        MOVE WS-BINOMIAL TO WS-A
        PERFORM MUL-A-SMALL
        IF LK-STATUS = 0
            PERFORM FREE-BINOMIAL
            MOVE WS-OUT TO WS-BINOMIAL
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-BINOMIAL-OWNED
            MOVE WS-I TO WS-SCALAR
            MOVE WS-BINOMIAL TO WS-A
            PERFORM DIV-A-SMALL
        END-IF
        IF LK-STATUS = 0
            PERFORM FREE-BINOMIAL
            MOVE WS-OUT TO WS-BINOMIAL
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-BINOMIAL-OWNED
        END-IF
    END-PERFORM.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-A-B.
    MOVE "MUL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-A-SMALL.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
DIV-A-SMALL.
    MOVE "DIV-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

FREE-A-VALUE.
    IF A-HEAD = NULL
        MOVE WS-ZERO TO WS-A
        EXIT PARAGRAPH
    END-IF
    MOVE LK-STATUS TO WS-SAVED-STATUS
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-SAVED-STATUS = 0 AND WS-STATUS NOT = 0
        MOVE WS-STATUS TO WS-SAVED-STATUS
    END-IF
    MOVE WS-SAVED-STATUS TO LK-STATUS
    MOVE WS-ZERO TO WS-A WS-DUMMY-OUT.

FREE-COUNT.
    IF WS-COUNT-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-COUNT-RESULT TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-COUNT-RESULT
    MOVE 0 TO WS-COUNT-OWNED.
FREE-TOTAL-COUNT.
    IF WS-TOTAL-COUNT-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-TOTAL-COUNT TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-TOTAL-COUNT
    MOVE 0 TO WS-TOTAL-COUNT-OWNED.
FREE-RANK.
    IF WS-RANK-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-RANK-WORK TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-RANK-WORK
    MOVE 0 TO WS-RANK-OWNED.
FREE-SUM.
    IF WS-SUM-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-SUM-BI TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-SUM-BI
    MOVE 0 TO WS-SUM-OWNED.
FREE-COMB-A.
    IF WS-COMB-A-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-COMB-A TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-COMB-A
    MOVE 0 TO WS-COMB-A-OWNED.
FREE-COMB-B.
    IF WS-COMB-B-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-COMB-B TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-COMB-B
    MOVE 0 TO WS-COMB-B-OWNED.
FREE-TERM.
    IF WS-TERM-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-TERM TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-TERM
    MOVE 0 TO WS-TERM-OWNED.
FREE-BINOMIAL.
    IF WS-BINOMIAL-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-BINOMIAL TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-BINOMIAL
    MOVE 0 TO WS-BINOMIAL-OWNED.

CLEAN-LOCAL-VALUES.
    IF WS-COUNT-OWNED = 1 PERFORM FREE-COUNT END-IF
    IF WS-TOTAL-COUNT-OWNED = 1 PERFORM FREE-TOTAL-COUNT END-IF
    IF WS-RANK-OWNED = 1 PERFORM FREE-RANK END-IF
    IF WS-SUM-OWNED = 1 PERFORM FREE-SUM END-IF
    IF WS-COMB-A-OWNED = 1 PERFORM FREE-COMB-A END-IF
    IF WS-COMB-B-OWNED = 1 PERFORM FREE-COMB-B END-IF
    IF WS-TERM-OWNED = 1 PERFORM FREE-TERM END-IF
    IF WS-BINOMIAL-OWNED = 1 PERFORM FREE-BINOMIAL END-IF
    IF O-HEAD NOT = NULL
        MOVE WS-OUT TO WS-A
        PERFORM FREE-A-VALUE
        MOVE WS-ZERO TO WS-OUT
    END-IF.
END PROGRAM NORMATIVE-BOUNDED-COMPOSITION.

IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-CUTLET-PARTITION.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-TOTAL-COUNT.
   05 TC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 TC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 TC-HEAD USAGE POINTER.
   05 TC-TAIL USAGE POINTER.
01 WS-BLOCK.
   05 BL-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BL-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BL-HEAD USAGE POINTER.
   05 BL-TAIL USAGE POINTER.
01 WS-RANK-WORK.
   05 RW-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 RW-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 RW-HEAD USAGE POINTER.
   05 RW-TAIL USAGE POINTER.
01 WS-BINOMIAL.
   05 BN-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BN-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BN-HEAD USAGE POINTER.
   05 BN-TAIL USAGE POINTER.
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-SAVED-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-X PIC 9(4) COMP-5 VALUE 0.
01 WS-MAX-X PIC 9(4) COMP-5 VALUE 0.
01 WS-NEW-CUM PIC 9(4) COMP-5 VALUE 0.
01 WS-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-REM-LEFT PIC 9(4) COMP-5 VALUE 0.
01 WS-SLOTS-LEFT PIC 9(4) COMP-5 VALUE 0.
01 WS-NEXT-REM PIC 9(4) COMP-5 VALUE 0.
01 WS-NEXT-SLOTS PIC 9(4) COMP-5 VALUE 0.
01 WS-HIT-NOW PIC 9 COMP-5 VALUE 0.
01 WS-NEXT-HIT PIC 9 COMP-5 VALUE 0.
01 WS-PARENT-HIT PIC 9 COMP-5 VALUE 0.
01 WS-CURRENT-CUM PIC 9(4) COMP-5 VALUE 0.
01 WS-DISTANCE PIC S9(4) COMP-5 VALUE 0.
01 WS-BIN-N PIC 9(4) COMP-5 VALUE 0.
01 WS-BIN-K PIC 9(4) COMP-5 VALUE 0.
01 WS-BIN-KE PIC 9(4) COMP-5 VALUE 0.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-SELECTED PIC 9 VALUE 0.
01 WS-TOTAL-COUNT-OWNED PIC 9 VALUE 0.
01 WS-BLOCK-OWNED PIC 9 VALUE 0.
01 WS-RANK-OWNED PIC 9 VALUE 0.
01 WS-BINOMIAL-OWNED PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-G PIC 9(4) COMP-5.
01 LK-K PIC 9(4) COMP-5.
01 LK-REQUIRED PIC S9(4) COMP-5.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-PARTS.
   05 LK-PART OCCURS 17 TIMES PIC 9(4) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-G LK-K LK-REQUIRED LK-RANK LK-COUNT LK-PARTS LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS WS-TOTAL-COUNT-OWNED
        WS-BLOCK-OWNED WS-RANK-OWNED WS-BINOMIAL-OWNED
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        A-HEAD A-TAIL B-HEAD B-TAIL O-HEAD O-TAIL
        TC-HEAD TC-TAIL BL-HEAD BL-TAIL RW-HEAD RW-TAIL
        BN-HEAD BN-TAIL TO NULL
    MOVE WS-ZERO TO LK-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 17
        MOVE 0 TO LK-PART(WS-I)
    END-PERFORM

    IF LK-G > 137 OR LK-K < 1 OR LK-K > 17 OR LK-G < LK-K
        MOVE 120 TO LK-STATUS
        GOBACK
    END-IF
    IF LK-REQUIRED >= LK-G
        MOVE 120 TO LK-STATUS
        GOBACK
    END-IF

    MOVE LK-G TO WS-REM-LEFT
    MOVE LK-K TO WS-SLOTS-LEFT
    IF LK-REQUIRED < 0 MOVE 1 TO WS-HIT-NOW ELSE MOVE 0 TO WS-HIT-NOW END-IF
    PERFORM COUNT-CURRENT-STATE
    IF LK-STATUS NOT = 0
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF
    MOVE WS-BLOCK TO WS-TOTAL-COUNT
    MOVE WS-ZERO TO WS-BLOCK
    MOVE 0 TO WS-BLOCK-OWNED
    MOVE 1 TO WS-TOTAL-COUNT-OWNED

    IF LR-SIGN = 0
        MOVE WS-TOTAL-COUNT TO LK-COUNT
        MOVE WS-ZERO TO WS-TOTAL-COUNT
        MOVE 0 TO WS-TOTAL-COUNT-OWNED
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF

    MOVE LK-RANK TO WS-A
    MOVE WS-TOTAL-COUNT TO WS-B
    PERFORM CMP-A-B
    IF LK-STATUS NOT = 0 OR LR-SIGN < 0 OR WS-CMP > 0
        IF LK-STATUS = 0 MOVE 121 TO LK-STATUS END-IF
        PERFORM CLEAN-LOCAL-VALUES
        GOBACK
    END-IF

    MOVE LK-RANK TO WS-RANK-WORK
    MOVE LK-G TO WS-REM-LEFT
    MOVE LK-K TO WS-SLOTS-LEFT
    IF LK-REQUIRED < 0 MOVE 1 TO WS-HIT-NOW ELSE MOVE 0 TO WS-HIT-NOW END-IF

    PERFORM VARYING WS-POS FROM 1 BY 1
        UNTIL WS-POS > LK-K OR LK-STATUS NOT = 0
        COMPUTE WS-MAX-X = WS-REM-LEFT - (WS-SLOTS-LEFT - 1)
        MOVE 0 TO WS-SELECTED
        PERFORM VARYING WS-X FROM 1 BY 1
            UNTIL WS-X > WS-MAX-X OR WS-SELECTED = 1 OR LK-STATUS NOT = 0
            COMPUTE WS-NEW-CUM = LK-G - WS-REM-LEFT + WS-X
            MOVE WS-HIT-NOW TO WS-PARENT-HIT WS-NEXT-HIT
            IF LK-REQUIRED >= 0 AND WS-HIT-NOW = 0
                IF WS-NEW-CUM = LK-REQUIRED
                    MOVE 1 TO WS-NEXT-HIT
                ELSE
                    IF WS-NEW-CUM > LK-REQUIRED
                        CONTINUE
                    END-IF
                END-IF
            END-IF
            IF NOT (LK-REQUIRED >= 0 AND WS-HIT-NOW = 0
                AND WS-NEW-CUM > LK-REQUIRED)
                COMPUTE WS-NEXT-REM = WS-REM-LEFT - WS-X
                COMPUTE WS-NEXT-SLOTS = WS-SLOTS-LEFT - 1
                MOVE WS-NEXT-REM TO WS-REM-LEFT
                MOVE WS-NEXT-SLOTS TO WS-SLOTS-LEFT
                MOVE WS-NEXT-HIT TO WS-HIT-NOW
                PERFORM COUNT-CURRENT-STATE
                *> 恢复父状态；分支计数只读子状态。
                ADD WS-X TO WS-REM-LEFT
                ADD 1 TO WS-SLOTS-LEFT
                MOVE WS-PARENT-HIT TO WS-HIT-NOW
                IF LK-STATUS = 0
                    MOVE WS-RANK-WORK TO WS-A
                    MOVE WS-BLOCK TO WS-B
                    PERFORM CMP-A-B
                END-IF
                IF LK-STATUS = 0
                    IF WS-CMP > 0
                        PERFORM SUB-A-B
                        IF LK-STATUS = 0
                            IF WS-RANK-OWNED = 1 PERFORM FREE-RANK END-IF
                            MOVE WS-OUT TO WS-RANK-WORK
                            MOVE WS-ZERO TO WS-OUT
                            MOVE 1 TO WS-RANK-OWNED
                        END-IF
                    ELSE
                        MOVE WS-X TO LK-PART(WS-POS)
                        SUBTRACT WS-X FROM WS-REM-LEFT
                        SUBTRACT 1 FROM WS-SLOTS-LEFT
                        MOVE WS-NEXT-HIT TO WS-HIT-NOW
                        MOVE 1 TO WS-SELECTED
                    END-IF
                END-IF
                IF WS-BLOCK-OWNED = 1 PERFORM FREE-BLOCK END-IF
            END-IF
        END-PERFORM
        IF WS-SELECTED = 0 AND LK-STATUS = 0 MOVE 122 TO LK-STATUS END-IF
    END-PERFORM

    IF LK-STATUS = 0 AND (WS-REM-LEFT NOT = 0 OR WS-SLOTS-LEFT NOT = 0)
        MOVE 122 TO LK-STATUS
    END-IF
    IF LK-STATUS = 0
        MOVE WS-TOTAL-COUNT TO LK-COUNT
        MOVE WS-ZERO TO WS-TOTAL-COUNT
        MOVE 0 TO WS-TOTAL-COUNT-OWNED
    END-IF
    PERFORM CLEAN-LOCAL-VALUES
    GOBACK.

COUNT-CURRENT-STATE.
    IF WS-BLOCK-OWNED = 1 PERFORM FREE-BLOCK END-IF
    MOVE WS-ZERO TO WS-BLOCK
    IF WS-SLOTS-LEFT = 0
        IF WS-REM-LEFT = 0
            IF LK-REQUIRED < 0 OR WS-HIT-NOW = 1
                MOVE 1 TO WS-SCALAR
                PERFORM MAKE-SMALL-OUT
                IF LK-STATUS = 0
                    MOVE WS-OUT TO WS-BLOCK
                    MOVE WS-ZERO TO WS-OUT
                    MOVE 1 TO WS-BLOCK-OWNED
                END-IF
            END-IF
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-REM-LEFT < WS-SLOTS-LEFT EXIT PARAGRAPH END-IF

    IF LK-REQUIRED < 0 OR WS-HIT-NOW = 1
        COMPUTE WS-BIN-N = WS-REM-LEFT - 1
        COMPUTE WS-BIN-K = WS-SLOTS-LEFT - 1
        PERFORM BUILD-BINOMIAL
    ELSE
        COMPUTE WS-CURRENT-CUM = LK-G - WS-REM-LEFT
        COMPUTE WS-DISTANCE = LK-REQUIRED - WS-CURRENT-CUM
        IF WS-DISTANCE <= 0 OR WS-DISTANCE >= WS-REM-LEFT
            EXIT PARAGRAPH
        END-IF
        IF WS-SLOTS-LEFT < 2 EXIT PARAGRAPH END-IF
        COMPUTE WS-BIN-N = WS-REM-LEFT - 2
        COMPUTE WS-BIN-K = WS-SLOTS-LEFT - 2
        PERFORM BUILD-BINOMIAL
    END-IF
    IF LK-STATUS = 0 AND WS-BINOMIAL-OWNED = 1
        MOVE WS-BINOMIAL TO WS-BLOCK
        MOVE WS-ZERO TO WS-BINOMIAL
        MOVE 0 TO WS-BINOMIAL-OWNED
        MOVE 1 TO WS-BLOCK-OWNED
    END-IF.

BUILD-BINOMIAL.
    IF WS-BINOMIAL-OWNED = 1 PERFORM FREE-BINOMIAL END-IF
    MOVE WS-ZERO TO WS-BINOMIAL
    IF WS-BIN-K > WS-BIN-N EXIT PARAGRAPH END-IF
    COMPUTE WS-BIN-KE = WS-BIN-N - WS-BIN-K
    IF WS-BIN-K < WS-BIN-KE MOVE WS-BIN-K TO WS-BIN-KE END-IF
    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-OUT TO WS-BINOMIAL
    MOVE WS-ZERO TO WS-OUT
    MOVE 1 TO WS-BINOMIAL-OWNED
    PERFORM VARYING WS-I FROM 1 BY 1
        UNTIL WS-I > WS-BIN-KE OR LK-STATUS NOT = 0
        COMPUTE WS-SCALAR = WS-BIN-N - WS-BIN-KE + WS-I
        MOVE WS-BINOMIAL TO WS-A
        PERFORM MUL-A-SMALL
        IF LK-STATUS = 0
            PERFORM FREE-BINOMIAL
            MOVE WS-OUT TO WS-BINOMIAL
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-BINOMIAL-OWNED
            MOVE WS-I TO WS-SCALAR
            MOVE WS-BINOMIAL TO WS-A
            PERFORM DIV-A-SMALL
        END-IF
        IF LK-STATUS = 0
            PERFORM FREE-BINOMIAL
            MOVE WS-OUT TO WS-BINOMIAL
            MOVE WS-ZERO TO WS-OUT
            MOVE 1 TO WS-BINOMIAL-OWNED
        END-IF
    END-PERFORM.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-A-SMALL.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
DIV-A-SMALL.
    MOVE "DIV-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.

FREE-A-VALUE.
    IF A-HEAD = NULL
        MOVE WS-ZERO TO WS-A
        EXIT PARAGRAPH
    END-IF
    MOVE LK-STATUS TO WS-SAVED-STATUS
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-DUMMY-OUT
        WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-SAVED-STATUS = 0 AND WS-STATUS NOT = 0
        MOVE WS-STATUS TO WS-SAVED-STATUS
    END-IF
    MOVE WS-SAVED-STATUS TO LK-STATUS
    MOVE WS-ZERO TO WS-A WS-DUMMY-OUT.
FREE-TOTAL-COUNT.
    IF WS-TOTAL-COUNT-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-TOTAL-COUNT TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-TOTAL-COUNT
    MOVE 0 TO WS-TOTAL-COUNT-OWNED.
FREE-BLOCK.
    IF WS-BLOCK-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-BLOCK TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-BLOCK
    MOVE 0 TO WS-BLOCK-OWNED.
FREE-RANK.
    IF WS-RANK-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-RANK-WORK TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-RANK-WORK
    MOVE 0 TO WS-RANK-OWNED.
FREE-BINOMIAL.
    IF WS-BINOMIAL-OWNED = 0 EXIT PARAGRAPH END-IF
    MOVE WS-BINOMIAL TO WS-A
    PERFORM FREE-A-VALUE
    MOVE WS-ZERO TO WS-BINOMIAL
    MOVE 0 TO WS-BINOMIAL-OWNED.
CLEAN-LOCAL-VALUES.
    IF WS-TOTAL-COUNT-OWNED = 1 PERFORM FREE-TOTAL-COUNT END-IF
    IF WS-BLOCK-OWNED = 1 PERFORM FREE-BLOCK END-IF
    IF WS-RANK-OWNED = 1 PERFORM FREE-RANK END-IF
    IF WS-BINOMIAL-OWNED = 1 PERFORM FREE-BINOMIAL END-IF
    IF O-HEAD NOT = NULL
        MOVE WS-OUT TO WS-A
        PERFORM FREE-A-VALUE
        MOVE WS-ZERO TO WS-OUT
    END-IF.
END PROGRAM NORMATIVE-CUTLET-PARTITION.
