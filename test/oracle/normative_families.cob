01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-S PIC 9(4) COMP-5 VALUE 0.
01 WS-R PIC 9(4) COMP-5 VALUE 0.
01 WS-H PIC 9 COMP-5 VALUE 0.
01 WS-X PIC 9(4) COMP-5 VALUE 0.
01 WS-MAX-X PIC 9(4) COMP-5 VALUE 0.
01 WS-NEW-CUM PIC 9(4) COMP-5 VALUE 0.
01 WS-NEXT-HIT PIC 9 COMP-5 VALUE 0.
01 WS-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-REM-LEFT PIC 9(4) COMP-5 VALUE 0.
01 WS-SLOTS-LEFT PIC 9(4) COMP-5 VALUE 0.
01 WS-HIT-NOW PIC 9 COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-G PIC 9(4) COMP-5.
01 LK-K PIC 9(4) COMP-5.
01 LK-REQUIRED PIC S9(4) COMP-5.
01 LK-RANK.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-COUNT.
   05 LC-SIGN PIC S9(4) COMP-5.
   05 LC-CHUNKS PIC 9(18) COMP-5.
   05 LC-HEAD USAGE POINTER.
   05 LC-TAIL USAGE POINTER.
01 LK-PARTS.
   05 LK-PART OCCURS 17 TIMES PIC 9(4) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-G LK-K LK-REQUIRED LK-RANK LK-COUNT LK-PARTS LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS
    SET Z-HEAD Z-TAIL TO NULL
    IF LK-G > 137 OR LK-K < 1 OR LK-K > 17 OR LK-G < LK-K
        MOVE 120 TO LK-STATUS GOBACK
    END-IF
    IF LK-REQUIRED >= LK-G MOVE 120 TO LK-STATUS GOBACK END-IF
    PERFORM BUILD-CP-DP
    COMPUTE WS-S = LK-K + 1
    COMPUTE WS-R = LK-G + 1
    IF LK-REQUIRED < 0
        MOVE CP-HIT(WS-S, WS-R, 2) TO LK-COUNT
        MOVE 1 TO WS-HIT-NOW
    ELSE
        MOVE CP-HIT(WS-S, WS-R, 1) TO LK-COUNT
        MOVE 0 TO WS-HIT-NOW
    END-IF
    IF LR-SIGN = 0 GOBACK END-IF
    MOVE LK-RANK TO WS-A MOVE LK-COUNT TO WS-B PERFORM CMP-A-B
    IF WS-CMP > 0 OR LR-SIGN < 0 MOVE 121 TO LK-STATUS GOBACK END-IF

    MOVE LK-RANK TO WS-RANK
    MOVE LK-G TO WS-REM-LEFT
    MOVE LK-K TO WS-SLOTS-LEFT
    PERFORM VARYING WS-POS FROM 1 BY 1 UNTIL WS-POS > LK-K
        COMPUTE WS-MAX-X = WS-REM-LEFT - (WS-SLOTS-LEFT - 1)
        PERFORM VARYING WS-X FROM 1 BY 1 UNTIL WS-X > WS-MAX-X
            COMPUTE WS-NEW-CUM = LK-G - WS-REM-LEFT + WS-X
            MOVE WS-HIT-NOW TO WS-NEXT-HIT
            IF LK-REQUIRED >= 0 AND WS-HIT-NOW = 0 AND WS-NEW-CUM = LK-REQUIRED
                MOVE 1 TO WS-NEXT-HIT
            END-IF
            IF NOT (LK-REQUIRED >= 0 AND WS-HIT-NOW = 0 AND WS-NEW-CUM > LK-REQUIRED)
                COMPUTE WS-S = WS-SLOTS-LEFT
                COMPUTE WS-R = WS-REM-LEFT - WS-X + 1
                COMPUTE WS-H = WS-NEXT-HIT + 1
                MOVE CP-HIT(WS-S, WS-R, WS-H) TO WS-B
                MOVE WS-RANK TO WS-A
                PERFORM CMP-A-B
                IF WS-CMP > 0
                    PERFORM SUB-A-B
                    MOVE WS-OUT TO WS-RANK
                ELSE
                    MOVE WS-X TO LK-PART(WS-POS)
                    SUBTRACT WS-X FROM WS-REM-LEFT
                    SUBTRACT 1 FROM WS-SLOTS-LEFT
                    MOVE WS-NEXT-HIT TO WS-HIT-NOW
                    EXIT PERFORM
                END-IF
            END-IF
        END-PERFORM
    END-PERFORM
    GOBACK.

BUILD-CP-DP.
    PERFORM VARYING WS-S FROM 0 BY 1 UNTIL WS-S > LK-K
        PERFORM VARYING WS-R FROM 0 BY 1 UNTIL WS-R > LK-G
            MOVE WS-ZERO TO CP-HIT(WS-S + 1, WS-R + 1, 1)
            MOVE WS-ZERO TO CP-HIT(WS-S + 1, WS-R + 1, 2)
        END-PERFORM
    END-PERFORM

    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-SMALL-OUT
    IF LK-REQUIRED < 0
        MOVE WS-OUT TO CP-HIT(1, 1, 1)
        MOVE WS-OUT TO CP-HIT(1, 1, 2)
    ELSE
        MOVE WS-OUT TO CP-HIT(1, 1, 2)
    END-IF

    PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > LK-K
        PERFORM VARYING WS-R FROM 0 BY 1 UNTIL WS-R > LK-G
            PERFORM VARYING WS-H FROM 0 BY 1 UNTIL WS-H > 1
                MOVE WS-ZERO TO WS-A
                IF WS-R >= WS-S
                    COMPUTE WS-MAX-X = WS-R - (WS-S - 1)
                    PERFORM VARYING WS-X FROM 1 BY 1 UNTIL WS-X > WS-MAX-X
                        COMPUTE WS-NEW-CUM = LK-G - WS-R + WS-X
                        MOVE WS-H TO WS-NEXT-HIT
                        IF LK-REQUIRED >= 0 AND WS-H = 0 AND WS-NEW-CUM = LK-REQUIRED
                            MOVE 1 TO WS-NEXT-HIT
                        END-IF
                        IF NOT (LK-REQUIRED >= 0 AND WS-H = 0 AND WS-NEW-CUM > LK-REQUIRED)
                            COMPUTE WS-POS = WS-S
                            COMPUTE WS-REM-LEFT = WS-R - WS-X + 1
                            COMPUTE WS-SLOTS-LEFT = WS-NEXT-HIT + 1
                            MOVE CP-HIT(WS-POS, WS-REM-LEFT, WS-SLOTS-LEFT) TO WS-B
                            PERFORM ADD-A-B
                            MOVE WS-OUT TO WS-A
                        END-IF
                    END-PERFORM
                END-IF
                COMPUTE WS-POS = WS-S + 1
                COMPUTE WS-REM-LEFT = WS-R + 1
                COMPUTE WS-SLOTS-LEFT = WS-H + 1
                MOVE WS-A TO CP-HIT(WS-POS, WS-REM-LEFT, WS-SLOTS-LEFT)
            END-PERFORM
        END-PERFORM
    END-PERFORM.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-CUTLET-PARTITION.
