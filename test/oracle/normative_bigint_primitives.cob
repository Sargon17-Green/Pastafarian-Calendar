>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-BIGINT-PRIMITIVES.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 BI-OP PIC X(16).
01 BI-TEXT PIC X(8192).
01 BI-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 BI-A.
   05 BI-A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-A-HEAD USAGE POINTER.
   05 BI-A-TAIL USAGE POINTER.
01 BI-B.
   05 BI-B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-B-HEAD USAGE POINTER.
   05 BI-B-TAIL USAGE POINTER.
01 BI-OUT.
   05 BI-OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-OUT-HEAD USAGE POINTER.
   05 BI-OUT-TAIL USAGE POINTER.
01 BI-REM.
   05 BI-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-REM-HEAD USAGE POINTER.
   05 BI-REM-TAIL USAGE POINTER.
01 BI-CMP PIC S9(4) COMP-5 VALUE 0.
01 BI-STATUS PIC 9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-ACTION PIC X(16).
01 LK-INPUT-TEXT PIC X(8192).
01 LK-INPUT-LEN PIC 9(18) COMP-5.
01 LK-OUTPUT-TEXT PIC X(8192).
01 LK-OUTPUT-LEN PIC 9(18) COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-INPUT-TEXT LK-INPUT-LEN LK-OUTPUT-TEXT LK-OUTPUT-LEN LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS LK-OUTPUT-LEN BI-STATUS BI-CMP
    MOVE SPACES TO LK-OUTPUT-TEXT BI-TEXT
    SET BI-A-HEAD BI-A-TAIL BI-B-HEAD BI-B-TAIL BI-OUT-HEAD BI-OUT-TAIL BI-REM-HEAD BI-REM-TAIL TO NULL

    MOVE "ARENA-BEGIN" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        GOBACK
    END-IF

    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "SAVE"
            PERFORM LOAD-INPUT-A
            IF LK-STATUS = 0
                PERFORM COMPUTE-SAVE
            END-IF
        WHEN OTHER
            MOVE 70 TO LK-STATUS
    END-EVALUATE
    MOVE "ARENA-END" TO BI-OP
    MOVE 0 TO BI-STATUS
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF LK-STATUS = 0 AND BI-STATUS NOT = 0 MOVE BI-STATUS TO LK-STATUS END-IF
    GOBACK.

LOAD-INPUT-A.
    MOVE LK-INPUT-TEXT TO BI-TEXT
    MOVE LK-INPUT-LEN TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL.

COMPUTE-SAVE.
    *> SAVE(x) = 1 + regularMod(x - 1, 2^127 - 1).
    MOVE "1" TO BI-TEXT
    MOVE 1 TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-B-SIGN
    MOVE BI-OUT-CHUNKS TO BI-B-CHUNKS
    SET BI-B-HEAD TO BI-OUT-HEAD
    SET BI-B-TAIL TO BI-OUT-TAIL

    MOVE "SUB" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL

    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-B-SIGN
    MOVE BI-OUT-CHUNKS TO BI-B-CHUNKS
    SET BI-B-HEAD TO BI-OUT-HEAD
    SET BI-B-TAIL TO BI-OUT-TAIL

    MOVE "MOD-EUCLID" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL

    MOVE "1" TO BI-TEXT
    MOVE 1 TO BI-TEXT-LEN
    MOVE "INIT-TEXT" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-B-SIGN
    MOVE BI-OUT-CHUNKS TO BI-B-CHUNKS
    SET BI-B-HEAD TO BI-OUT-HEAD
    SET BI-B-TAIL TO BI-OUT-TAIL

    MOVE "ADD" TO BI-OP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL

    MOVE "TO-TEXT" TO BI-OP
    MOVE SPACES TO BI-TEXT
    MOVE 0 TO BI-TEXT-LEN
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        MOVE BI-STATUS TO LK-STATUS
    ELSE
        MOVE BI-TEXT TO LK-OUTPUT-TEXT
        MOVE BI-TEXT-LEN TO LK-OUTPUT-LEN
    END-IF.
END PROGRAM NORMATIVE-BIGINT-PRIMITIVES.
