>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-BASIC.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-FOUNDATION.
   05 F-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 F-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 F-HEAD USAGE POINTER.
   05 F-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-NAME PIC X(16).
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-ACTION PIC X(16).
01 LK-C-DAY.
   05 LCD-SIGN PIC S9(4) COMP-5.
   05 LCD-CHUNKS PIC 9(18) COMP-5.
   05 LCD-HEAD USAGE POINTER.
   05 LCD-TAIL USAGE POINTER.
01 LK-T-DAY.
   05 LTD-SIGN PIC S9(4) COMP-5.
   05 LTD-CHUNKS PIC 9(18) COMP-5.
   05 LTD-HEAD USAGE POINTER.
   05 LTD-TAIL USAGE POINTER.
01 LK-C-COUNT.
   05 LCC-SIGN PIC S9(4) COMP-5.
   05 LCC-CHUNKS PIC 9(18) COMP-5.
   05 LCC-HEAD USAGE POINTER.
   05 LCC-TAIL USAGE POINTER.
01 LK-T-COUNT.
   05 LTC-SIGN PIC S9(4) COMP-5.
   05 LTC-CHUNKS PIC 9(18) COMP-5.
   05 LTC-HEAD USAGE POINTER.
   05 LTC-TAIL USAGE POINTER.
01 LK-DISTANCE.
   05 LD-SIGN PIC S9(4) COMP-5.
   05 LD-CHUNKS PIC 9(18) COMP-5.
   05 LD-HEAD USAGE POINTER.
   05 LD-TAIL USAGE POINTER.
01 LK-CONNECTION.
   05 LCN-SIGN PIC S9(4) COMP-5.
   05 LCN-CHUNKS PIC 9(18) COMP-5.
   05 LCN-HEAD USAGE POINTER.
   05 LCN-TAIL USAGE POINTER.
01 LK-DIRECTION PIC 9 COMP-5.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-ACTION LK-C-DAY LK-T-DAY LK-C-COUNT LK-T-COUNT LK-DISTANCE LK-CONNECTION LK-DIRECTION LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS WS-STATUS LK-DIRECTION
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL TO NULL
    MOVE "FOUNDATION" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-FOUNDATION WS-STATUS
    IF WS-STATUS NOT = 0 MOVE WS-STATUS TO LK-STATUS GOBACK END-IF

    EVALUATE FUNCTION TRIM(LK-ACTION)
        WHEN "DAY-COUNT"
            MOVE LK-T-DAY TO WS-A
            PERFORM DAY-COUNT-A
            IF LK-STATUS = 0 MOVE WS-OUT TO LK-T-COUNT END-IF
        WHEN "WORK-COUNTS"
            MOVE LK-C-DAY TO WS-A
            PERFORM DAY-COUNT-A
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO LK-C-COUNT

            MOVE LK-T-DAY TO WS-A
            PERFORM DAY-COUNT-A
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO LK-T-COUNT

            MOVE LK-T-DAY TO WS-A
            MOVE LK-C-DAY TO WS-B
            PERFORM SUB-A-B
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO WS-A
            PERFORM ABS-A
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO WS-A
            MOVE 1 TO WS-SCALAR
            PERFORM ADD-SMALL-A
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO LK-DISTANCE

            MOVE LK-C-COUNT TO WS-A
            MOVE LK-T-COUNT TO WS-B
            PERFORM ADD-A-B
            IF LK-STATUS NOT = 0 GOBACK END-IF
            MOVE WS-OUT TO LK-CONNECTION

            MOVE LK-T-DAY TO WS-A
            MOVE LK-C-DAY TO WS-B
            PERFORM CMP-A-B
            IF WS-CMP < 0 MOVE 1 TO LK-DIRECTION END-IF
            IF WS-CMP = 0 MOVE 2 TO LK-DIRECTION END-IF
            IF WS-CMP > 0 MOVE 3 TO LK-DIRECTION END-IF
        WHEN OTHER
            MOVE 90 TO LK-STATUS
    END-EVALUATE
    GOBACK.

DAY-COUNT-A.
    MOVE WS-A TO WS-B
    MOVE WS-FOUNDATION TO WS-A
    PERFORM CMP-A-B
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    IF WS-CMP = 0
        MOVE 1 TO WS-SCALAR
        PERFORM MAKE-SMALL-OUT
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP < 0
        *> day > FOUNDATION: 2*(day-FOUNDATION)+1
        MOVE WS-B TO WS-A
        MOVE WS-FOUNDATION TO WS-B
        PERFORM SUB-A-B
        MOVE WS-OUT TO WS-A
        MOVE 2 TO WS-SCALAR
        PERFORM MUL-SMALL-A
        MOVE WS-OUT TO WS-A
        MOVE 1 TO WS-SCALAR
        PERFORM ADD-SMALL-A
    ELSE
        *> day < FOUNDATION: 2*(FOUNDATION-day)
        MOVE WS-FOUNDATION TO WS-A
        PERFORM SUB-A-B
        MOVE WS-OUT TO WS-A
        MOVE 2 TO WS-SCALAR
        PERFORM MUL-SMALL-A
    END-IF.

MAKE-SMALL-OUT.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-SMALL-A.
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
MUL-SMALL-A.
    MOVE "MUL-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ADD-A-B.
    MOVE "ADD" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
SUB-A-B.
    MOVE "SUB" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
ABS-A.
    MOVE "ABS" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CMP-A-B.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM CHECK-STATUS.
CHECK-STATUS.
    IF WS-STATUS NOT = 0 AND LK-STATUS = 0 MOVE WS-STATUS TO LK-STATUS END-IF.
END PROGRAM NORMATIVE-BASIC.
