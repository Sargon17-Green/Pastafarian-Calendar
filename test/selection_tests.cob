>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. SELECTION-TESTS.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 WS-M.
   05 M-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 M-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 M-HEAD USAGE POINTER.
   05 M-TAIL USAGE POINTER.
01 WS-FIRST.
   05 F-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 F-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 F-HEAD USAGE POINTER.
   05 F-TAIL USAGE POINTER.
01 WS-N.
   05 N-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 N-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 N-HEAD USAGE POINTER.
   05 N-TAIL USAGE POINTER.
01 WS-RANK.
   05 R-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 R-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 R-HEAD USAGE POINTER.
   05 R-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-OP PIC X(16).
01 WS-NAME PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-STEP PIC S9 COMP-5 VALUE 1.
01 WS-RUN PIC 9(4) COMP-5 VALUE 0.
01 WS-FAILED PIC 9(4) COMP-5 VALUE 0.
01 WS-ARENA-OPEN PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        M-HEAD M-TAIL F-HEAD F-TAIL N-HEAD N-TAIL R-HEAD R-TAIL O-HEAD O-TAIL TO NULL
    PERFORM BEGIN-ARENA
    IF WS-STATUS = 0
        MOVE "M" TO WS-NAME
        CALL "ORACLE-CONSTANTS" USING WS-NAME WS-M WS-STATUS
        PERFORM ASSERT-STATUS
        PERFORM TEST-N-ONE
        PERFORM TEST-N-M
        PERFORM TEST-SHORT-REJECTION
        PERFORM TEST-WIDE-M-PLUS-ONE
    ELSE
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法启动选择测试的任意精度作用域。"
    END-IF
    PERFORM END-ARENA
    ADD WS-RUN TO LK-RUN
    ADD WS-FAILED TO LK-FAILED
    GOBACK.

BEGIN-ARENA.
    MOVE "ARENA-BEGIN" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS = 0 MOVE 1 TO WS-ARENA-OPEN END-IF.

END-ARENA.
    IF WS-ARENA-OPEN = 0 EXIT PARAGRAPH END-IF
    IF WS-STATUS NOT = 0 MOVE 0 TO WS-STATUS END-IF
    MOVE "ARENA-END" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 选择测试的任意精度作用域未能干净关闭。"
        MOVE 0 TO WS-STATUS
    END-IF
    MOVE 0 TO WS-ARENA-OPEN.

TEST-N-ONE.
    MOVE 1 TO WS-SCALAR
    PERFORM MAKE-N-SMALL
    MOVE WS-M TO WS-FIRST
    MOVE -1 TO WS-STEP
    PERFORM CHOOSE
    MOVE WS-RANK TO WS-OUT
    PERFORM OUT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = 1
        ADD 1 TO WS-FAILED
        DISPLAY "失败: N=1 的短选择没有返回秩 1。"
    END-IF.

TEST-N-M.
    MOVE WS-M TO WS-N
    MOVE WS-M TO WS-FIRST
    MOVE 1 TO WS-STEP
    PERFORM CHOOSE
    MOVE WS-RANK TO WS-OUT
    MOVE WS-N TO WS-M
    PERFORM COMPARE-OUT-M
    ADD 1 TO WS-RUN
    IF WS-CMP NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: N=M 且 first=M 时没有返回秩 M。"
    END-IF
    MOVE "M" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-M WS-STATUS
    PERFORM ASSERT-STATUS.

TEST-SHORT-REJECTION.
    MOVE 3 TO WS-SCALAR
    PERFORM MAKE-N-SMALL
    MOVE WS-M TO WS-FIRST
    MOVE 1 TO WS-STEP
    PERFORM CHOOSE
    MOVE WS-RANK TO WS-OUT
    PERFORM OUT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = 1
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 短选择在 M 被拒绝后没有沿同一答案环到 1。"
    END-IF.

TEST-WIDE-M-PLUS-ONE.
    MOVE WS-M TO WS-OUT
    MOVE 1 TO WS-SCALAR
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-N WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS
    MOVE 1 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-FIRST WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS
    MOVE 1 TO WS-STEP
    PERFORM CHOOSE
    MOVE WS-RANK TO WS-OUT
    MOVE WS-N TO WS-M
    PERFORM COMPARE-OUT-M
    ADD 1 TO WS-RUN
    IF WS-CMP NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: N=M+1 的宽选择首个构造值没有返回秩 M+1。"
    END-IF
    MOVE "M" TO WS-NAME
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-M WS-STATUS
    PERFORM ASSERT-STATUS.

MAKE-N-SMALL.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-N WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS.

CHOOSE.
    MOVE 0 TO WS-STATUS
    CALL "NORMATIVE-CHOOSE-RANK" USING WS-FIRST WS-STEP WS-N WS-RANK WS-STATUS
    PERFORM ASSERT-STATUS.

OUT-TO-SMALL.
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS.

COMPARE-OUT-M.
    MOVE "CMP" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-M WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS.

ASSERT-STATUS.
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 选择边界测试收到非零状态 " WS-STATUS
        MOVE 0 TO WS-STATUS
    END-IF.
END PROGRAM SELECTION-TESTS.
