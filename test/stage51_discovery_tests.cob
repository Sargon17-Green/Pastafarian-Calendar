PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL P-HEAD P-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL
        IO-HEAD IO-TAIL FB-HEAD FB-TAIL TO NULL
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        SET O-HEAD(WS-SLOT) O-TAIL(WS-SLOT)
            S-HEAD(WS-SLOT) S-TAIL(WS-SLOT) TO NULL
    END-PERFORM
    PERFORM VARYING WS-WIDTH-ID FROM 1 BY 1
        UNTIL WS-WIDTH-ID > 5
        EVALUATE WS-WIDTH-ID
            WHEN 1 MOVE 3 TO WS-N
            WHEN 2 MOVE 9 TO WS-N
            WHEN 3 MOVE 128 TO WS-N
            WHEN 4 MOVE 320 TO WS-N
            WHEN 5 MOVE 8192 TO WS-N
        END-EVALUATE
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 5
            PERFORM PREPARE-CASE
            PERFORM PREPARE-MUTATED
            PERFORM RUN-CASE
        END-PERFORM
    END-PERFORM
    PERFORM PROBE-TO-TEXT-OVERFLOW
    PERFORM MEASURE-HEAP
    DISPLAY "STAGE51_INITIAL_OWNERS=" WS-INITIAL
    DISPLAY "STAGE51_INPUT_REBUILDS=" WS-INPUT-REBUILDS
    DISPLAY "STAGE51_PRESERVED_AFTER_INPUT_CHANGE="
        WS-PRESERVED-OUTPUTS
    DISPLAY "STAGE51_SURVIVORS_AFTER_FREE=" WS-SURVIVORS-FREE
    DISPLAY "STAGE51_SURVIVORS_AFTER_REUSE=" WS-SURVIVORS-REUSE
    DISPLAY "STAGE51_REPLACEMENT_OWNERS=" WS-NEW-OUTPUTS
    DISPLAY "STAGE51_RESTORED_OWNERS=" WS-RESTORED-OUTPUTS
    DISPLAY "STAGE51_RESTORED_SNAPSHOTS=" WS-RESTORED-SNAPSHOTS
    DISPLAY "STAGE51_OCCUPIED_REJECTS=" WS-OCCUPIED-REJECTS
    DISPLAY "STAGE51_INVALID_SIGN_REJECTS="
        WS-INVALID-SIGN-REJECTS
    DISPLAY "STAGE51_INIT_VALIDATION_REJECTS="
        WS-INIT-VALIDATION-REJECTS
    IF WS-INIT-VALIDATION-REJECTS = 75 AND WS-FAIL = 0
        DISPLAY "STAGE51_INIT_VALIDATION_GATE=PASS"
    ELSE
        DISPLAY "STAGE51_INIT_VALIDATION_GATE=FAIL"
    END-IF
    DISPLAY "STAGE51_TO_TEXT_REJECTS=" WS-TO-REJECTS
    DISPLAY "STAGE51_TO_TEXT_OVERFLOW_REJECTS="
        WS-OVERFLOW-REJECTS
    IF WS-OVERFLOW-REJECTS = 1 AND WS-OVERFLOW-FAIL = 0
       AND WS-FAIL = 0
        DISPLAY "STAGE51_TO_TEXT_OVERFLOW_GATE=PASS"
    ELSE
        DISPLAY "STAGE51_TO_TEXT_OVERFLOW_GATE=FAIL"
    END-IF
    DISPLAY "STAGE51_FREE_A_REJECTS=" WS-FREE-REJECTS
    IF WS-FREE-REJECTS = 50 AND WS-FAIL = 0
        DISPLAY "STAGE51_FREE_A_GATE=PASS"
    ELSE
        DISPLAY "STAGE51_FREE_A_GATE=FAIL"
    END-IF
    IF WS-TO-REJECTS = 50 AND WS-FAIL = 0
        DISPLAY "STAGE51_TO_TEXT_GATE=PASS"
    ELSE
        DISPLAY "STAGE51_TO_TEXT_GATE=FAIL"
    END-IF
    DISPLAY "STAGE51_PRESERVED_AFTER_REJECT=" WS-REJECT-PRESERVED
    DISPLAY "STAGE51_TARGET_SLOT_1=" WS-TARGET-COUNT(1)
    DISPLAY "STAGE51_TARGET_SLOT_2=" WS-TARGET-COUNT(2)
    DISPLAY "STAGE51_TARGET_SLOT_3=" WS-TARGET-COUNT(3)
    DISPLAY "STAGE51_TARGET_SLOT_4=" WS-TARGET-COUNT(4)
    DISPLAY "STAGE51_TARGET_SLOT_5=" WS-TARGET-COUNT(5)
    DISPLAY "STAGE51_FINAL_CLEANUP=" WS-FINAL-CLEANUP
    DISPLAY "STAGE51_RUNS=" WS-RUNS
    DISPLAY "STAGE51_PASS=" WS-PASS
    DISPLAY "STAGE51_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE51_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 25 AND WS-PASS = 25 AND WS-FAIL = 0
       AND WS-INITIAL = 125 AND WS-INPUT-REBUILDS = 100
       AND WS-PRESERVED-OUTPUTS = 125
       AND WS-SURVIVORS-FREE = 100
       AND WS-SURVIVORS-REUSE = 100
       AND WS-NEW-OUTPUTS = 25
       AND WS-RESTORED-OUTPUTS = 25
       AND WS-RESTORED-SNAPSHOTS = 125
       AND WS-OCCUPIED-REJECTS = 25
       AND WS-INVALID-SIGN-REJECTS = 25
       AND WS-INIT-VALIDATION-REJECTS = 75
       AND WS-TO-REJECTS = 50
       AND WS-OVERFLOW-REJECTS = 1
       AND WS-OVERFLOW-FAIL = 0
       AND WS-FREE-REJECTS = 50
       AND WS-REJECT-PRESERVED = 125
       AND WS-TARGET-COUNT(1) = 5
       AND WS-TARGET-COUNT(2) = 5
       AND WS-TARGET-COUNT(3) = 5
       AND WS-TARGET-COUNT(4) = 5
       AND WS-TARGET-COUNT(5) = 5
       AND WS-FINAL-CLEANUP = 25 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE51_FIVE_SAME_SIGN_CANCELLATION_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE51_FIVE_SAME_SIGN_CANCELLATION_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.
PREPARE-MUTATED.
    *> At width 8192, sign is in descriptor, not INIT-TEXT.
    MOVE SPACES TO WS-MUT-C WS-MUT-T
    MOVE WS-BASE-C TO WS-MUT-C
    MOVE WS-BASE-T TO WS-MUT-T
    COMPUTE WS-LAST-TWO = 2 * WS-J + 3
    MOVE WS-LAST-TWO TO WS-MUT-C(WS-X-POS:2).
RUN-CASE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-CASE-FAIL WS-MUTATED WS-REVERSE-PAIR
    MOVE WS-BASE-C TO WS-C-LITERAL
    MOVE WS-BASE-T TO WS-T-LITERAL
    PERFORM INITIALIZE-PAIR
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-SLOT FROM 1 BY 1
            UNTIL WS-SLOT > 5
            PERFORM SET-EXPECTED
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-DISTINCT
        IF WS-CASE-FAIL = 0
            PERFORM PROBE-INVALID-SIGN
        END-IF
        IF WS-CASE-FAIL = 0
            PERFORM PROBE-INIT-VALIDATION
        END-IF
        IF WS-CASE-FAIL = 0
            PERFORM PROBE-TO-TEXT-VALIDATION
        END-IF
        IF WS-CASE-FAIL = 0
            PERFORM PROBE-FREE-A-VALIDATION
        END-IF
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL = 0 ADD 5 TO WS-INITIAL END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM RELEASE-PAIR-ORDER
        MOVE 1 TO WS-MUTATED
        MOVE WS-MUT-C TO WS-C-LITERAL
        MOVE WS-MUT-T TO WS-T-LITERAL
        PERFORM INITIALIZE-PAIR
        IF WS-CASE-FAIL = 0
            ADD 2 TO WS-INPUT-REBUILDS
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
            IF WS-CASE-FAIL = 0
                ADD 5 TO WS-PRESERVED-OUTPUTS
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        COMPUTE WS-SELECTED =
            FUNCTION MOD(WS-RUNS - 1, 5) + 1
        ADD 1 TO WS-TARGET-COUNT(WS-SELECTED)
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM PROBE-OCCUPIED
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM RELEASE-RESULT
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-FOUR
            IF WS-CASE-FAIL = 0
                ADD 4 TO WS-SURVIVORS-FREE
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM SET-EXPECTED
        PERFORM PRODUCE-SLOT
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
            IF WS-CASE-FAIL = 0
                ADD 4 TO WS-SURVIVORS-REUSE
                ADD 1 TO WS-NEW-OUTPUTS
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE 1 TO WS-REVERSE-PAIR
        PERFORM RELEASE-PAIR-ORDER
        MOVE 0 TO WS-MUTATED
        MOVE WS-BASE-C TO WS-C-LITERAL
        MOVE WS-BASE-T TO WS-T-LITERAL
        PERFORM INITIALIZE-PAIR
        IF WS-CASE-FAIL = 0
            ADD 2 TO WS-INPUT-REBUILDS
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM RELEASE-RESULT
        IF WS-CASE-FAIL = 0
            PERFORM SET-EXPECTED
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-DISTINCT
                PERFORM CHECK-INPUT-PRESERVED
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-RESTORED-OUTPUTS
                    ADD 5 TO WS-RESTORED-SNAPSHOTS
                END-IF
            END-IF
        END-IF
    END-IF
    PERFORM CLEANUP-CASE
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE51_CASE_FAILED=" WS-RUNS
    END-IF.

INITIALIZE-PAIR.
    IF C-HEAD NOT = NULL OR T-HEAD NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_DIRTY_INPUT_PAIR=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-C
    IF WS-STATUS NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_C_INIT_FAILED=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-T
    IF WS-STATUS NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_T_INIT_FAILED=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-MUTATED
        WHEN 0
            IF C-SIGN NOT = 1 OR T-SIGN NOT = 1
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE51_POSITIVE_SIGN_FAILED=" WS-RUNS
            END-IF
        WHEN 1
            IF C-SIGN NOT = -1 OR T-SIGN NOT = -1
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE51_NEGATIVE_SIGN_FAILED=" WS-RUNS
            END-IF
    END-EVALUATE
    IF WS-CASE-FAIL NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM SNAPSHOT-INPUTS
    PERFORM CHECK-INPUT-PRESERVED.

SNAPSHOT-INPUTS.
    MOVE C-SIGN TO CB-SIGN
    MOVE C-CHUNKS TO CB-CHUNKS
    SET CB-HEAD TO C-HEAD
    SET CB-TAIL TO C-TAIL
    MOVE T-SIGN TO TB-SIGN
    MOVE T-CHUNKS TO TB-CHUNKS
    SET TB-HEAD TO T-HEAD
    SET TB-TAIL TO T-TAIL.

SET-EXPECTED.
    MOVE SPACES TO WS-EXPECTED(WS-SLOT)
    IF WS-MUTATED = 0
        COMPUTE WS-LAST-TWO = WS-J + WS-SLOT
    ELSE
        COMPUTE WS-LAST-TWO = 3 * WS-J + 3 + WS-SLOT
    END-IF
    MOVE WS-LAST-TWO TO WS-EXPECTED-EDIT
    MOVE FUNCTION TRIM(WS-EXPECTED-EDIT)
        TO WS-EXPECTED(WS-SLOT).
PREPARE-PROBE.
    *> Five C+k owners, then signed C'-k owner magnitudes.
    MOVE SPACES TO WS-PROBE-LITERAL
    IF WS-MUTATED = 0
        MOVE WS-BASE-C TO WS-PROBE-LITERAL
        COMPUTE WS-LAST-TWO = WS-SLOT - 1
    ELSE
        MOVE WS-MUT-C TO WS-PROBE-LITERAL
        COMPUTE WS-LAST-TWO = 2 * WS-J + 2 + WS-SLOT
    END-IF
    MOVE WS-LAST-TWO TO WS-PROBE-LITERAL(WS-X-POS:2).
INIT-PROBE.
    IF P-HEAD NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_PROBE_DIRTY=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(WS-PROBE-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-PROBE-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-PROBE-C WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR P-HEAD = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_PROBE_INIT_FAILED=" WS-RUNS
    ELSE
        IF WS-MUTATED = 1 MOVE -1 TO P-SIGN END-IF
    END-IF.


PRODUCE-SLOT.
    PERFORM PREPARE-PROBE
    PERFORM INIT-PROBE
    IF WS-CASE-FAIL = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-PROBE-C WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 0 AND
            WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
            PERFORM SNAPSHOT-SLOT
            PERFORM CHECK-SLOT
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_PATCH_CALL_FAILED="
                WS-RUNS ":" WS-SLOT ":" WS-STATUS
        END-IF
    END-IF
    PERFORM RELEASE-PROBE
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-INPUT-PRESERVED
    END-IF.

PROBE-INVALID-SIGN.
    *> Exercise real invalid-sign rejection with five live owners.
    *> This is not allocation-failure injection or a mock.
    IF P-SIGN NOT = 0 OR P-CHUNKS NOT = 0
       OR P-HEAD NOT = NULL OR P-TAIL NOT = NULL
       OR EO-SIGN NOT = 0 OR EO-CHUNKS NOT = 0
       OR EO-HEAD NOT = NULL OR EO-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INVALID_SIGN_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE 2 TO P-SIGN
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-PROBE-C WS-T-INPUT
        WS-EMPTY-OUT WS-STATUS WS-MESSAGE
    MOVE 0 TO P-SIGN
    IF WS-STATUS NOT = 22
       OR P-CHUNKS NOT = 0 OR P-HEAD NOT = NULL
       OR P-TAIL NOT = NULL
       OR EO-SIGN NOT = 0 OR EO-CHUNKS NOT = 0
       OR EO-HEAD NOT = NULL OR EO-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INVALID_SIGN_REJECT_FAILED="
            WS-RUNS ":" WS-STATUS
    ELSE
        ADD 1 TO WS-INVALID-SIGN-REJECTS
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
    END-IF.

PROBE-INIT-VALIDATION.
    *> Real parser rejects, not allocator-fault injection.
    PERFORM CHECK-INIT-SCRATCH
    IF WS-CASE-FAIL NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM MEASURE-HEAP
    IF WS-STATUS NOT = 0 OR WS-HEAP = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INIT_HEAP_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-HEAP TO WS-INIT-HEAP-BASE
    PERFORM VARYING WS-INIT-PROBE-ID FROM 1 BY 1
        UNTIL WS-INIT-PROBE-ID > 3
        MOVE SPACES TO WS-TEXT
        EVALUATE WS-INIT-PROBE-ID
            WHEN 1
                MOVE "1#" TO WS-TEXT
                MOVE 2 TO WS-LEN
                MOVE 44 TO WS-INIT-EXPECTED-STATUS
            WHEN 2
                MOVE 0 TO WS-LEN
                MOVE 43 TO WS-INIT-EXPECTED-STATUS
            WHEN 3
                MOVE "-" TO WS-TEXT
                MOVE 1 TO WS-LEN
                MOVE 44 TO WS-INIT-EXPECTED-STATUS
        END-EVALUATE
        MOVE "INIT-TEXT" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
            WS-INIT-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = WS-INIT-EXPECTED-STATUS
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_INIT_REJECT_STATUS_FAILED="
                WS-RUNS ":" WS-INIT-PROBE-ID ":" WS-STATUS
        END-IF
        PERFORM CHECK-INIT-SCRATCH
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM MEASURE-HEAP
        IF WS-STATUS NOT = 0
           OR WS-HEAP NOT = WS-INIT-HEAP-BASE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_INIT_HEAP_CHANGED="
                WS-RUNS ":" WS-INIT-PROBE-ID
        END-IF
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        ADD 1 TO WS-INIT-VALIDATION-REJECTS
    END-PERFORM.

PROBE-TO-TEXT-VALIDATION.
    *> Nonzero sign, no chunks or pointers: no dereference.
    *> Zero sign instead normalizes; never corrupt live owners.
    IF BT-SIGN NOT = 0 OR BT-CHUNKS NOT = 0
       OR BT-HEAD NOT = NULL OR BT-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_TO_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM MEASURE-HEAP
    IF WS-STATUS NOT = 0 OR WS-HEAP = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_TO_HEAP_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-HEAP TO WS-TO-BASE
    PERFORM VARYING WS-TO-CASE FROM 1 BY 1
        UNTIL WS-TO-CASE > 2
        IF WS-TO-CASE = 1
            MOVE 1 TO WS-TO-SIGN
        ELSE
            MOVE -1 TO WS-TO-SIGN
        END-IF
        MOVE WS-TO-SIGN TO BT-SIGN
        MOVE 0 TO BT-CHUNKS WS-STATUS
        SET BT-HEAD BT-TAIL TO NULL
        MOVE ALL "X" TO WS-TEXT
        MOVE 999 TO WS-LEN
        MOVE "TO-TEXT" TO WS-OP
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-TO-BAD WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 49 OR WS-LEN NOT = 0
           OR WS-TEXT NOT = SPACES
           OR BT-SIGN NOT = WS-TO-SIGN
           OR BT-CHUNKS NOT = 0 OR BT-HEAD NOT = NULL
           OR BT-TAIL NOT = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_TO_REJECT_FAILED="
                WS-RUNS ":" WS-TO-CASE ":" WS-STATUS
        END-IF
        MOVE 0 TO BT-SIGN
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM MEASURE-HEAP
        IF WS-STATUS NOT = 0 OR WS-HEAP NOT = WS-TO-BASE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_TO_HEAP_CHANGED="
                WS-RUNS ":" WS-TO-CASE
        END-IF
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        ADD 1 TO WS-TO-REJECTS
    END-PERFORM.

PROBE-FREE-A-VALIDATION.
    *> Invalid metadata on a separate NULL-only descriptor.
    *> The service returns 49 before dereference; FREE-H1
    *> then sees NULL and never frees a live owner.
    IF FB-SIGN NOT = 0 OR FB-CHUNKS NOT = 0
       OR FB-HEAD NOT = NULL OR FB-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_FREE_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-INIT-SCRATCH
    IF WS-CASE-FAIL NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM MEASURE-HEAP
    IF WS-STATUS NOT = 0 OR WS-HEAP = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_FREE_HEAP_PRECONDITION=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE WS-HEAP TO WS-FREE-BASE
    PERFORM VARYING WS-FREE-CASE FROM 1 BY 1
        UNTIL WS-FREE-CASE > 2
        IF WS-FREE-CASE = 1
            MOVE 1 TO WS-FREE-SIGN
        ELSE
            MOVE -1 TO WS-FREE-SIGN
        END-IF
        MOVE WS-FREE-SIGN TO FB-SIGN
        MOVE 0 TO FB-CHUNKS WS-STATUS
        SET FB-HEAD FB-TAIL TO NULL
        MOVE "FREE-A" TO WS-OP
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-FREE-BAD WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 49 OR FB-SIGN NOT = 0
           OR FB-CHUNKS NOT = 0
           OR FB-HEAD NOT = NULL OR FB-TAIL NOT = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_FREE_REJECT_FAILED="
                WS-RUNS ":" WS-FREE-CASE ":" WS-STATUS
        END-IF
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM CHECK-INIT-SCRATCH
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        PERFORM MEASURE-HEAP
        IF WS-STATUS NOT = 0
           OR WS-HEAP NOT = WS-FREE-BASE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_FREE_HEAP_CHANGED="
                WS-RUNS ":" WS-FREE-CASE
        END-IF
        IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        ADD 1 TO WS-FREE-REJECTS
    END-PERFORM.

CHECK-INIT-SCRATCH.
    IF EA-SIGN NOT = 0 OR EA-CHUNKS NOT = 0
       OR EA-HEAD NOT = NULL OR EA-TAIL NOT = NULL
       OR EB-SIGN NOT = 0 OR EB-CHUNKS NOT = 0
       OR EB-HEAD NOT = NULL OR EB-TAIL NOT = NULL
       OR ER-SIGN NOT = 0 OR ER-CHUNKS NOT = 0
       OR ER-HEAD NOT = NULL OR ER-TAIL NOT = NULL
       OR EO-SIGN NOT = 0 OR EO-CHUNKS NOT = 0
       OR EO-HEAD NOT = NULL OR EO-TAIL NOT = NULL
       OR IO-SIGN NOT = 0 OR IO-CHUNKS NOT = 0
       OR IO-HEAD NOT = NULL OR IO-TAIL NOT = NULL
       OR P-SIGN NOT = 0 OR P-CHUNKS NOT = 0
       OR P-HEAD NOT = NULL OR P-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INIT_SCRATCH_MUTATED=" WS-RUNS
    END-IF.

PROBE-OCCUPIED.
    PERFORM PREPARE-PROBE
    PERFORM INIT-PROBE
    IF WS-CASE-FAIL = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-PROBE-C WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 175
            ADD 1 TO WS-OCCUPIED-REJECTS
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_OCCUPIED_STATUS_FAILED="
                WS-RUNS ":" WS-STATUS
        END-IF
    END-IF
    PERFORM RELEASE-PROBE
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL = 0
            ADD 5 TO WS-REJECT-PRESERVED
        END-IF
    END-IF.

RELEASE-PROBE.
    IF P-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-PROBE-C WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR P-HEAD NOT = NULL
           OR P-TAIL NOT = NULL OR P-SIGN NOT = 0
           OR P-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_PROBE_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CHECK-FOUR.
    MOVE 0 TO WS-LIVE
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            ADD 1 TO WS-LIVE
            IF WS-SLOT = WS-SELECTED
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-PERFORM
    IF WS-LIVE NOT = 4
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_FOUR_SURVIVORS_FAILED=" WS-RUNS
    END-IF
    PERFORM CHECK-SURVIVORS.

RELEASE-PAIR-ORDER.
    IF WS-REVERSE-PAIR = 0
        IF WS-J = 1 OR 3 OR 5
            PERFORM RELEASE-C
            PERFORM RELEASE-T
        ELSE
            PERFORM RELEASE-T
            PERFORM RELEASE-C
        END-IF
    ELSE
        IF WS-J = 1 OR 3 OR 5
            PERFORM RELEASE-T
            PERFORM RELEASE-C
        ELSE
            PERFORM RELEASE-C
            PERFORM RELEASE-T
        END-IF
    END-IF.

RELEASE-C.
    IF C-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR C-HEAD NOT = NULL
           OR C-TAIL NOT = NULL OR C-SIGN NOT = 0
           OR C-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_C_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

RELEASE-T.
    IF T-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR T-HEAD NOT = NULL
           OR T-TAIL NOT = NULL OR T-SIGN NOT = 0
           OR T-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_T_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CLEANUP-CASE.
    IF IO-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-INIT-OUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_INIT_UNEXPECTED_OUT_FREE_FAILED="
                WS-RUNS
        END-IF
    END-IF
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM RELEASE-RESULT
        END-IF
    END-PERFORM
    PERFORM RELEASE-PROBE
    PERFORM RELEASE-C
    PERFORM RELEASE-T
    *> Unconditionally verify descriptors, including NULL-head cases.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-SIGN(WS-SLOT) NOT = 0
           OR O-CHUNKS(WS-SLOT) NOT = 0
           OR O-HEAD(WS-SLOT) NOT = NULL
           OR O-TAIL(WS-SLOT) NOT = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_DIRTY_OUTPUT_AFTER_CLEANUP="
                WS-RUNS ":" WS-SLOT
        END-IF
    END-PERFORM
    IF C-SIGN NOT = 0 OR C-CHUNKS NOT = 0
       OR C-HEAD NOT = NULL OR C-TAIL NOT = NULL
       OR T-SIGN NOT = 0 OR T-CHUNKS NOT = 0
       OR T-HEAD NOT = NULL OR T-TAIL NOT = NULL
       OR P-SIGN NOT = 0 OR P-CHUNKS NOT = 0
       OR P-HEAD NOT = NULL OR P-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_DIRTY_INPUT_AFTER_CLEANUP=" WS-RUNS
    END-IF
    IF IO-SIGN NOT = 0 OR IO-CHUNKS NOT = 0
       OR IO-HEAD NOT = NULL OR IO-TAIL NOT = NULL
       OR FB-SIGN NOT = 0 OR FB-CHUNKS NOT = 0
       OR FB-HEAD NOT = NULL OR FB-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INIT_OUT_DIRTY_AFTER_CLEANUP=" WS-RUNS
    END-IF
    PERFORM MEASURE-HEAP
    IF WS-STATUS NOT = 0 OR WS-HEAP NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_HEAP_FAILED=" WS-RUNS
    END-IF
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-FINAL-CLEANUP
    END-IF.

MEASURE-HEAP.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
        DISPLAY "STAGE51_HEAP_MEASURED=YES"
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_HEAP_PROBE_FAILED=" WS-STATUS
    END-IF.

PREPARE-CASE.
    *> Full-width, same-sign C=2*10^(n-1), T=C-j.
    MOVE SPACES TO WS-BASE-C WS-BASE-T
    MOVE ALL "0" TO WS-BASE-C(1:WS-N)
    MOVE ALL "0" TO WS-BASE-T(1:WS-N)
    MOVE "2" TO WS-BASE-C(1:1)
    MOVE "1" TO WS-BASE-T(1:1)
    COMPUTE WS-LAST-Y = WS-N - 1
    COMPUTE WS-X-POS = WS-N - 1
    COMPUTE WS-Y-POS = WS-N - 2
    MOVE ALL "9" TO WS-BASE-T(2:WS-Y-POS)
    COMPUTE WS-LAST-DIGIT = 10 - WS-J
    MOVE WS-LAST-DIGIT TO WS-BASE-T(WS-N:1).
INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-MUTATED = 1
        MOVE -1 TO C-SIGN
    END-IF.


INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-MUTATED = 1
        MOVE -1 TO T-SIGN
    END-IF.


CHECK-INPUT-PRESERVED.
    IF C-SIGN NOT = CB-SIGN OR C-CHUNKS NOT = CB-CHUNKS
       OR C-HEAD NOT = CB-HEAD OR C-TAIL NOT = CB-TAIL
       OR T-SIGN NOT = TB-SIGN OR T-CHUNKS NOT = TB-CHUNKS
       OR T-HEAD NOT = TB-HEAD OR T-TAIL NOT = TB-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_INPUT_METADATA_FAILED=" WS-RUNS
    END-IF
    IF WS-CASE-FAIL = 0
        *> Serialize magnitude while temporarily positive, then restore.
        IF WS-MUTATED = 1 MOVE 1 TO C-SIGN END-IF
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-MUTATED = 1 MOVE -1 TO C-SIGN END-IF
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
            FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
            MOVE 1 TO WS-CASE-FAIL
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
                FUNCTION TRIM(WS-C-LITERAL)
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        IF WS-MUTATED = 1 MOVE 1 TO T-SIGN END-IF
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-MUTATED = 1 MOVE -1 TO T-SIGN END-IF
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
            FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
            MOVE 1 TO WS-CASE-FAIL
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
                FUNCTION TRIM(WS-T-LITERAL)
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-IF
    IF C-SIGN NOT = CB-SIGN OR T-SIGN NOT = TB-SIGN
        MOVE 1 TO WS-CASE-FAIL
    END-IF
    IF WS-CASE-FAIL NOT = 0
        DISPLAY "STAGE51_INPUT_PRESERVATION_FAILED=" WS-RUNS
    END-IF.


SNAPSHOT-SLOT.
    MOVE O-SIGN(WS-SLOT) TO S-SIGN(WS-SLOT)
    MOVE O-CHUNKS(WS-SLOT) TO S-CHUNKS(WS-SLOT)
    SET S-HEAD(WS-SLOT) TO O-HEAD(WS-SLOT)
    SET S-TAIL(WS-SLOT) TO O-TAIL(WS-SLOT).


CHECK-SLOT.
    IF O-HEAD(WS-SLOT) = NULL
       OR O-SIGN(WS-SLOT) NOT = S-SIGN(WS-SLOT)
       OR O-CHUNKS(WS-SLOT) NOT = S-CHUNKS(WS-SLOT)
       OR O-HEAD(WS-SLOT) NOT = S-HEAD(WS-SLOT)
       OR O-TAIL(WS-SLOT) NOT = S-TAIL(WS-SLOT)
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_METADATA_FAILED=" WS-RUNS ":" WS-SLOT
    END-IF
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-LEN NOT =
           FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED(WS-SLOT)))
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_TEXT_LENGTH_FAILED=" WS-RUNS ":" WS-SLOT
    ELSE
        IF WS-TEXT(1:WS-LEN) NOT =
               FUNCTION TRIM(WS-EXPECTED(WS-SLOT))
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_ORACLE_FAILED=" WS-RUNS ":" WS-SLOT
        END-IF
    END-IF.



CHECK-SURVIVORS.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM VARYING WS-PEER FROM 1 BY 1
                UNTIL WS-PEER >= WS-SLOT
                IF O-HEAD(WS-PEER) NOT = NULL AND
                   O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                    MOVE 1 TO WS-CASE-FAIL
                    DISPLAY "STAGE51_SHARED_LIVE_HEAD=" WS-RUNS
                END-IF
            END-PERFORM
            PERFORM CHECK-SLOT
        END-IF
    END-PERFORM.


CHECK-DISTINCT.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE51_NULL_HEAD_FAILED=" WS-RUNS
        END-IF
        PERFORM VARYING WS-PEER FROM 1 BY 1
            UNTIL WS-PEER >= WS-SLOT
            IF O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE51_SHARED_HEAD_FAILED=" WS-RUNS
            END-IF
        END-PERFORM
        PERFORM CHECK-SLOT
    END-PERFORM.


RELEASE-RESULT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN(WS-SLOT) NOT = 0
       OR O-CHUNKS(WS-SLOT) NOT = 0
       OR O-HEAD(WS-SLOT) NOT = NULL
       OR O-TAIL(WS-SLOT) NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE51_OUTPUT_FREE_FAILED="
            WS-RUNS ":" WS-SLOT
    END-IF.



*> QA51-B: 8193-digit legal result must reject TO-TEXT.
PROBE-TO-TEXT-OVERFLOW.
    SET OV-C-HEAD OV-C-TAIL OV-T-HEAD OV-T-TAIL
        OV-R-HEAD OV-R-TAIL TO NULL
    MOVE 0 TO OV-C-SIGN OV-C-CHUNKS
        OV-T-SIGN OV-T-CHUNKS OV-R-SIGN OV-R-CHUNKS
        WS-OV-C-OWNED WS-OV-T-OWNED WS-OV-R-OWNED
        WS-OV-SNAPPED WS-OVERFLOW-FAIL
    PERFORM OVERFLOW-MEASURE-HEAP
    IF WS-HEAP NOT = 0
        MOVE 1 TO WS-OVERFLOW-FAIL
        DISPLAY "STAGE51_OVERFLOW_DIRTY_BASELINE"
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        MOVE ALL "9" TO WS-TEXT
        MOVE 8192 TO WS-LEN
        MOVE "INIT-TEXT" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
            WS-OV-C WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS = 0 AND OV-C-SIGN = 1
           AND OV-C-CHUNKS > 0 AND OV-C-HEAD NOT = NULL
            MOVE 1 TO WS-OV-C-OWNED
        ELSE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_INIT_C_FAILED="
                WS-STATUS
        END-IF
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        MOVE ALL "9" TO WS-TEXT
        MOVE 8192 TO WS-LEN
        MOVE "INIT-TEXT" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
            WS-OV-T WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS = 0 AND OV-T-SIGN = 1
           AND OV-T-CHUNKS > 0 AND OV-T-HEAD NOT = NULL
           AND OV-C-HEAD NOT = OV-T-HEAD
            MOVE 1 TO WS-OV-T-OWNED
            MOVE -1 TO OV-T-SIGN
        ELSE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_INIT_T_FAILED="
                WS-STATUS
        END-IF
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        MOVE SPACES TO WS-MESSAGE
        MOVE 0 TO WS-STATUS
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-OV-C WS-OV-T WS-OV-R
            WS-STATUS WS-MESSAGE
        IF WS-STATUS = 0
           AND WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
           AND OV-R-SIGN = 1 AND OV-R-CHUNKS > 0
           AND OV-R-HEAD NOT = NULL
           AND OV-R-HEAD NOT = OV-C-HEAD
           AND OV-R-HEAD NOT = OV-T-HEAD
            MOVE 1 TO WS-OV-R-OWNED
        ELSE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_PATCH_FAILED="
                WS-STATUS
        END-IF
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        MOVE WS-OV-C TO WS-OV-C-SAVE
        MOVE WS-OV-T TO WS-OV-T-SAVE
        MOVE WS-OV-R TO WS-OV-R-SAVE
        MOVE 1 TO WS-OV-SNAPPED
        PERFORM OVERFLOW-MEASURE-HEAP
        MOVE WS-HEAP TO WS-OV-HEAP-BASE
        IF WS-HEAP = 0
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_EMPTY_LIVE_HEAP"
        END-IF
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-OV-R WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 45 OR WS-LEN NOT = 0
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_STATUS_FAILED="
                WS-STATUS ":" WS-LEN
        END-IF
        IF WS-OV-C NOT = WS-OV-C-SAVE
           OR WS-OV-T NOT = WS-OV-T-SAVE
           OR WS-OV-R NOT = WS-OV-R-SAVE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_OWNER_MUTATED"
        END-IF
        PERFORM OVERFLOW-MEASURE-HEAP
        IF WS-HEAP NOT = WS-OV-HEAP-BASE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_HEAP_CHANGED"
        END-IF
    END-IF
    PERFORM OVERFLOW-CLEANUP
    PERFORM OVERFLOW-MEASURE-HEAP
    IF WS-HEAP NOT = 0
        MOVE 1 TO WS-OVERFLOW-FAIL
        DISPLAY "STAGE51_OVERFLOW_FINAL_HEAP_NOT_ZERO"
    END-IF
    IF WS-OVERFLOW-FAIL = 0
        ADD 1 TO WS-OVERFLOW-REJECTS
    ELSE
        ADD 1 TO WS-FAIL
    END-IF.

OVERFLOW-MEASURE-HEAP.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
    ELSE
        MOVE 1 TO WS-OVERFLOW-FAIL
        DISPLAY "STAGE51_OVERFLOW_HEAP_SERVICE_FAILED="
            WS-STATUS
    END-IF.

OVERFLOW-CLEANUP.
    *> Free only verified independent owners; never an unknown head.
    IF WS-OV-R-OWNED = 1
        IF WS-OV-SNAPPED = 1
           AND WS-OV-R NOT = WS-OV-R-SAVE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_UNSAFE_R_OWNER"
        ELSE
            MOVE "FREE-A" TO WS-OP
            MOVE 0 TO WS-STATUS
            CALL "BIG-INTEGER-SERVICE" USING
                WS-OP WS-TEXT WS-LEN WS-OV-R WS-EMPTY-B
                WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
            IF WS-STATUS NOT = 0 OR OV-R-HEAD NOT = NULL
               OR OV-R-TAIL NOT = NULL OR OV-R-SIGN NOT = 0
               OR OV-R-CHUNKS NOT = 0
                MOVE 1 TO WS-OVERFLOW-FAIL
                DISPLAY "STAGE51_OVERFLOW_FREE_R_FAILED"
            END-IF
        END-IF
    END-IF
    IF WS-OV-C-OWNED = 1
        IF WS-OV-SNAPPED = 1
           AND WS-OV-C NOT = WS-OV-C-SAVE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_UNSAFE_C_OWNER"
        ELSE
            MOVE "FREE-A" TO WS-OP
            MOVE 0 TO WS-STATUS
            CALL "BIG-INTEGER-SERVICE" USING
                WS-OP WS-TEXT WS-LEN WS-OV-C WS-EMPTY-B
                WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
            IF WS-STATUS NOT = 0 OR OV-C-HEAD NOT = NULL
               OR OV-C-TAIL NOT = NULL OR OV-C-SIGN NOT = 0
               OR OV-C-CHUNKS NOT = 0
                MOVE 1 TO WS-OVERFLOW-FAIL
                DISPLAY "STAGE51_OVERFLOW_FREE_C_FAILED"
            END-IF
        END-IF
    END-IF
    IF WS-OV-T-OWNED = 1
        IF WS-OV-SNAPPED = 1
           AND WS-OV-T NOT = WS-OV-T-SAVE
            MOVE 1 TO WS-OVERFLOW-FAIL
            DISPLAY "STAGE51_OVERFLOW_UNSAFE_T_OWNER"
        ELSE
            MOVE "FREE-A" TO WS-OP
            MOVE 0 TO WS-STATUS
            CALL "BIG-INTEGER-SERVICE" USING
                WS-OP WS-TEXT WS-LEN WS-OV-T WS-EMPTY-B
                WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
            IF WS-STATUS NOT = 0 OR OV-T-HEAD NOT = NULL
               OR OV-T-TAIL NOT = NULL OR OV-T-SIGN NOT = 0
               OR OV-T-CHUNKS NOT = 0
                MOVE 1 TO WS-OVERFLOW-FAIL
                DISPLAY "STAGE51_OVERFLOW_FREE_T_FAILED"
            END-IF
        END-IF
    END-IF.

END PROGRAM STAGE51-DISCOVERY-TESTS.
