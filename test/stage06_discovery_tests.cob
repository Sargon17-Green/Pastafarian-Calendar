>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE06-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE SPACES.
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-C-OFF PIC S9(4) COMP-5 VALUE 0.
01 WS-T-OFF PIC S9(4) COMP-5 VALUE 0.
01 WS-EXPECTED-LEGACY PIC 9(9) COMP-5 VALUE 0.
01 WS-NORM PIC 9(9) COMP-5 VALUE 0.
01 WS-LEGACY-EDIT PIC Z(10)9.
01 WS-C-DAY PIC S9(12) COMP-5 VALUE 0.
01 WS-T-DAY PIC S9(12) COMP-5 VALUE 0.
01 WS-DAY-EDIT PIC -(12)9.
01 WS-RED PIC 9(4) COMP-5 VALUE 0.
01 WS-CONTROL PIC 9(4) COMP-5 VALUE 0.
01 WS-UNEXPECTED PIC 9(4) COMP-5 VALUE 0.
01 WS-REJECT PIC 9(4) COMP-5 VALUE 0.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
        PERFORM WITNESS
    END-PERFORM
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-TEXT-LEN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN NOT = 0
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE6_HEAP_LEAK_OR_STATUS"
    END-IF
    DISPLAY "STAGE6_EXPECTED_RED=" WS-RED
    DISPLAY "STAGE6_CONTROL_PASS=" WS-CONTROL
    DISPLAY "STAGE6_OUTPUT_GUARD=" WS-REJECT
    DISPLAY "STAGE6_UNEXPECTED_FAILURES=" WS-UNEXPECTED
    IF WS-RED = 5 AND WS-CONTROL = 3
       AND WS-REJECT = 8 AND WS-UNEXPECTED = 0
        DISPLAY "RESULT=PASS_STAGE6_EXPECTED_RED_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE6_EXPECTED_RED_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

WITNESS.
    EVALUATE WS-I
        WHEN 1 MOVE 0 TO WS-C-OFF WS-T-OFF
               MOVE 0 TO WS-EXPECTED-LEGACY
        WHEN 2 MOVE 1 TO WS-C-OFF
               MOVE 3 TO WS-T-OFF
               MOVE 4 TO WS-EXPECTED-LEGACY
        WHEN 3 MOVE -3 TO WS-C-OFF
               MOVE -1 TO WS-T-OFF
               MOVE 4 TO WS-EXPECTED-LEGACY
        WHEN 4 MOVE -1 TO WS-C-OFF
               MOVE 1 TO WS-T-OFF
               MOVE 1 TO WS-EXPECTED-LEGACY
        WHEN 5 MOVE -2 TO WS-C-OFF
               MOVE 2 TO WS-T-OFF
               MOVE 1 TO WS-EXPECTED-LEGACY
        WHEN 6 MOVE 0 TO WS-C-OFF
               MOVE 1 TO WS-T-OFF
               MOVE 2 TO WS-EXPECTED-LEGACY
        WHEN 7 MOVE -2 TO WS-C-OFF
               MOVE -1 TO WS-T-OFF
               MOVE 2 TO WS-EXPECTED-LEGACY
        WHEN 8 MOVE 1 TO WS-C-OFF
               MOVE 2 TO WS-T-OFF
               MOVE 2 TO WS-EXPECTED-LEGACY
    END-EVALUATE
    *> 测试独立规范：包含两个端点的日数，不调用生产标签算法。
    COMPUTE WS-NORM = FUNCTION ABS(WS-T-OFF - WS-C-OFF) + 1
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
              O-SIGN O-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL
        O-HEAD O-TAIL TO NULL
    COMPUTE WS-C-DAY = -15055671 + WS-C-OFF
    COMPUTE WS-T-DAY = -15055671 + WS-T-OFF

    MOVE WS-C-DAY TO WS-DAY-EDIT
    PERFORM INIT-C
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-UNEXPECTED
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF
    MOVE WS-T-DAY TO WS-DAY-EDIT
    PERFORM INIT-T
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-UNEXPECTED
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    MOVE "DISTANCE-LEGACY" TO WS-ACTION
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "DISCOVERY03:DISTANCE-LEGACY"
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE6_DISPATCH_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    MOVE "TO-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE WS-EXPECTED-LEGACY TO WS-LEGACY-EDIT
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN = 0
       OR WS-TEXT-LEN > 11
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE6_SERIAL_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF
    IF WS-TEXT(1:WS-TEXT-LEN) NOT =
       FUNCTION TRIM(WS-LEGACY-EDIT)
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE6_WRONG_LEGACY=" WS-I
    ELSE
        IF WS-EXPECTED-LEGACY = WS-NORM
            ADD 1 TO WS-CONTROL
        ELSE
            ADD 1 TO WS-RED
        END-IF
    END-IF

    *> Non-overwrite is a separate error-path guard.
    MOVE 0 TO WS-STATUS
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    IF WS-STATUS = 175
        ADD 1 TO WS-REJECT
    ELSE
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE6_OUTPUT_GUARD_FAILED=" WS-I
    END-IF
    PERFORM RELEASE-CASE.

INIT-C.
    MOVE FUNCTION TRIM(WS-DAY-EDIT) TO WS-TEXT
    COMPUTE WS-TEXT-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-DAY-EDIT))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.
INIT-T.
    MOVE FUNCTION TRIM(WS-DAY-EDIT) TO WS-TEXT
    COMPUTE WS-TEXT-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-DAY-EDIT))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.
RELEASE-CASE.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-T-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF.
END PROGRAM STAGE06-DISCOVERY-TESTS.
