>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE05-PATCH-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE SPACES.
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-DELTA PIC S9(4) COMP-5 VALUE 0.
01 WS-DAY PIC S9(12) COMP-5 VALUE 0.
01 WS-DAY-EDIT PIC -(12)9.
01 WS-LEGACY PIC 9(4) COMP-5 VALUE 0.
01 WS-NORM PIC 9(4) COMP-5 VALUE 0.
01 WS-LEGACY-EDIT PIC Z(10)9.
01 WS-PATCH PIC 9(4) COMP-5 VALUE 0.
01 WS-CONTROL PIC 9(4) COMP-5 VALUE 0.
01 WS-WITNESS-RED PIC 9(4) COMP-5 VALUE 0.
01 WS-WITNESS-CONTROL PIC 9(4) COMP-5 VALUE 0.
01 WS-UNEXPECTED PIC 9(4) COMP-5 VALUE 0.

01 WS-INPUT.
   05 IN-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 IN-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 IN-HEAD USAGE POINTER.
   05 IN-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 OUT-HEAD USAGE POINTER.
   05 OUT-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET IN-HEAD IN-TAIL OUT-HEAD OUT-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    PERFORM VARYING WS-DELTA FROM -64 BY 1
        UNTIL WS-DELTA > 64
        PERFORM CHECK-ONE-DAY
    END-PERFORM

    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN NOT = 0
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_HEAP_LEAK_OR_STATUS"
    END-IF
    DISPLAY "STAGE5_PATCH_PASS=" WS-PATCH
    DISPLAY "STAGE5_CONTROL_PASS=" WS-CONTROL
    DISPLAY "STAGE5_WITNESS_PATCH=" WS-WITNESS-RED
    DISPLAY "STAGE5_WITNESS_CONTROL=" WS-WITNESS-CONTROL
    DISPLAY "STAGE5_UNEXPECTED_FAILURES=" WS-UNEXPECTED
    IF WS-PATCH = 65 AND WS-CONTROL = 64
       AND WS-WITNESS-RED = 3
       AND WS-WITNESS-CONTROL = 2
       AND WS-UNEXPECTED = 0
        DISPLAY "RESULT=PASS_STAGE5_PATCH02_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE5_PATCH02_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

CHECK-ONE-DAY.
    MOVE 0 TO IN-SIGN IN-CHUNKS OUT-SIGN OUT-CHUNKS
    SET IN-HEAD IN-TAIL OUT-HEAD OUT-TAIL TO NULL
    COMPUTE WS-DAY = -15055671 + WS-DELTA
    MOVE WS-DAY TO WS-DAY-EDIT
    MOVE FUNCTION TRIM(WS-DAY-EDIT) TO WS-TEXT
    COMPUTE WS-TEXT-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-DAY-EDIT))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_INPUT_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    MOVE "DAY-TAG-PATCH" TO WS-ACTION
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-BOOTSTRAP" USING
        WS-ACTION WS-INPUT WS-OUTPUT WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "PATCH02:DAY-TAG-PATCH"
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_DISPATCH_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    MOVE "TO-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN = 0
       OR WS-TEXT-LEN > 12
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_SERIAL_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    COMPUTE WS-LEGACY = 2 * FUNCTION ABS(WS-DELTA)
    IF WS-DELTA < 0
        COMPUTE WS-NORM = 2 * FUNCTION ABS(WS-DELTA)
    ELSE
        COMPUTE WS-NORM = 2 * WS-DELTA + 1
    END-IF
    MOVE WS-NORM TO WS-LEGACY-EDIT
    IF WS-TEXT(1:WS-TEXT-LEN) NOT =
       FUNCTION TRIM(WS-LEGACY-EDIT)
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_LEGACY_FORMULA_WRONG_DELTA=" WS-DELTA
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    IF WS-LEGACY = WS-NORM
        IF WS-DELTA < 0
            ADD 1 TO WS-CONTROL
            IF WS-DELTA >= -2
                ADD 1 TO WS-WITNESS-CONTROL
            END-IF
        ELSE
            ADD 1 TO WS-UNEXPECTED
            DISPLAY "STAGE5_MISSING_RED_DELTA=" WS-DELTA
        END-IF
    ELSE
        IF WS-DELTA >= 0
            ADD 1 TO WS-PATCH
            IF WS-DELTA <= 2
                ADD 1 TO WS-WITNESS-RED
            END-IF
        ELSE
            ADD 1 TO WS-UNEXPECTED
            DISPLAY "STAGE5_FALSE_RED_DELTA=" WS-DELTA
        END-IF
    END-IF
    *> PATCH02 must not mutate caller-owned input.
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    MOVE "TO-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR
       WS-TEXT-LEN NOT =
         FUNCTION LENGTH(FUNCTION TRIM(WS-DAY-EDIT))
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "STAGE5_INPUT_MUTATED_DELTA=" WS-DELTA
    ELSE
        IF WS-TEXT(1:WS-TEXT-LEN) NOT =
           FUNCTION TRIM(WS-DAY-EDIT)
            ADD 1 TO WS-UNEXPECTED
            DISPLAY "STAGE5_INPUT_MUTATED_DELTA=" WS-DELTA
        END-IF
    END-IF
    PERFORM RELEASE-CASE.

RELEASE-CASE.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF.
END PROGRAM STAGE05-PATCH-TESTS.
