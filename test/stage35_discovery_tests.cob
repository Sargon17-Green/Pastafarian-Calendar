>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE35-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-RUNS PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-C-LITERAL PIC X(8192) VALUE SPACES.
01 WS-T-LITERAL PIC X(8192) VALUE SPACES.
01 WS-TEMP PIC X(8192) VALUE SPACES.
01 WS-EXPECTED PIC X(8192) VALUE SPACES.
01 WS-SAVED-C-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-C-HEAD USAGE POINTER.
01 WS-SAVED-C-TAIL USAGE POINTER.
01 WS-SAVED-T-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-T-HEAD USAGE POINTER.
01 WS-SAVED-T-TAIL USAGE POINTER.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

01 WS-BOUNDARY-INDEX PIC 9(4) COMP-5 VALUE 0.
01 WS-DIGIT-CASE PIC 9(4) COMP-5 VALUE 0.
01 WS-N PIC 9(4) COMP-5 VALUE 0.
PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    *> Stage35: opposite-sign full-width result and signed input at 8192 text bytes.
    PERFORM VARYING WS-BOUNDARY-INDEX FROM 1 BY 1
        UNTIL WS-BOUNDARY-INDEX > 4
        EVALUATE WS-BOUNDARY-INDEX
            WHEN 1 MOVE 3 TO WS-N
            WHEN 2 MOVE 9 TO WS-N
            WHEN 3 MOVE 320 TO WS-N
            WHEN 4 MOVE 8192 TO WS-N
        END-EVALUATE
        PERFORM VARYING WS-DIGIT-CASE FROM 1 BY 1
            UNTIL WS-DIGIT-CASE > 6
            PERFORM PREPARE-VALID
            PERFORM RUN-PAIR
        END-PERFORM
    END-PERFORM

    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
        DISPLAY "STAGE35_HEAP_MEASURED=YES"
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE35_HEAP_PROBE_FAILED=" WS-STATUS
    END-IF
    DISPLAY "STAGE35_RUNS=" WS-RUNS
    DISPLAY "STAGE35_PASS=" WS-PASS
    DISPLAY "STAGE35_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE35_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 24 AND WS-PASS = 24
       AND WS-FAIL = 0 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE35_SIGNED_OUTPUT_BOUNDARY_DISCOVERY_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE35_SIGNED_OUTPUT_BOUNDARY_DISCOVERY_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

PREPARE-VALID.
    MOVE SPACES TO WS-C-LITERAL WS-T-LITERAL WS-EXPECTED WS-TEMP
    MOVE ALL "0" TO WS-C-LITERAL(1:WS-N)
    MOVE ALL "0" TO WS-T-LITERAL(1:WS-N)
    MOVE ALL "0" TO WS-EXPECTED(1:WS-N)
    *> A=10**(n-1)+j; B=10**(n-2)+1, with signed B length n.
    MOVE "1" TO WS-C-LITERAL(1:1)
    MOVE "-" TO WS-T-LITERAL(1:1)
    MOVE "1" TO WS-T-LITERAL(2:1)
    MOVE "1" TO WS-T-LITERAL(WS-N:1)
    MOVE "11" TO WS-EXPECTED(1:2)
    EVALUATE WS-DIGIT-CASE
        WHEN 1
            MOVE "1" TO WS-C-LITERAL(WS-N:1)
            MOVE "3" TO WS-EXPECTED(WS-N:1)
        WHEN 2
            MOVE "2" TO WS-C-LITERAL(WS-N:1)
            MOVE "4" TO WS-EXPECTED(WS-N:1)
        WHEN 3
            MOVE "3" TO WS-C-LITERAL(WS-N:1)
            MOVE "5" TO WS-EXPECTED(WS-N:1)
        WHEN 4
            MOVE "4" TO WS-C-LITERAL(WS-N:1)
            MOVE "6" TO WS-EXPECTED(WS-N:1)
        WHEN 5
            MOVE "5" TO WS-C-LITERAL(WS-N:1)
            MOVE "7" TO WS-EXPECTED(WS-N:1)
        WHEN 6
            MOVE "6" TO WS-C-LITERAL(WS-N:1)
            MOVE "8" TO WS-EXPECTED(WS-N:1)
    END-EVALUATE
    *> Alternate operand order while preserving the independent numeric oracle.
    IF WS-DIGIT-CASE = 2 OR 4 OR 6
        MOVE WS-C-LITERAL TO WS-TEMP
        MOVE WS-T-LITERAL TO WS-C-LITERAL
        MOVE WS-TEMP TO WS-T-LITERAL
    END-IF.

RUN-PAIR.
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
              O-SIGN O-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL TO NULL
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS = 0
        PERFORM SNAPSHOT-INPUTS
        PERFORM RUN-ONE
    ELSE
        ADD 1 TO WS-RUNS
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE35_INPUT_INIT_FAILED=" WS-STATUS
    END-IF
    PERFORM RELEASE-PAIR.

INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

SNAPSHOT-INPUTS.
    MOVE C-SIGN TO WS-SAVED-C-SIGN
    MOVE C-CHUNKS TO WS-SAVED-C-CHUNKS
    SET WS-SAVED-C-HEAD TO C-HEAD
    SET WS-SAVED-C-TAIL TO C-TAIL
    MOVE T-SIGN TO WS-SAVED-T-SIGN
    MOVE T-CHUNKS TO WS-SAVED-T-CHUNKS
    SET WS-SAVED-T-HEAD TO T-HEAD
    SET WS-SAVED-T-TAIL TO T-TAIL.

RUN-ONE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-STATUS WS-CASE-FAIL
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "PATCH03:DISTANCE-PATCH"
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE35_DISTANCE_STATUS_FAILED=" WS-RUNS
    ELSE
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
           FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED))
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE35_TEXT_LENGTH_FAILED=" WS-RUNS
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
               FUNCTION TRIM(WS-EXPECTED)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE35_ORACLE_FAILED=" WS-RUNS
            END-IF
        END-IF
    END-IF
    PERFORM CHECK-INPUTS
    PERFORM FREE-OUTPUT
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
    END-IF.

CHECK-INPUTS.
    IF C-SIGN NOT = WS-SAVED-C-SIGN
       OR C-CHUNKS NOT = WS-SAVED-C-CHUNKS
       OR C-HEAD NOT = WS-SAVED-C-HEAD
       OR C-TAIL NOT = WS-SAVED-C-TAIL
       OR T-SIGN NOT = WS-SAVED-T-SIGN
       OR T-CHUNKS NOT = WS-SAVED-T-CHUNKS
       OR T-HEAD NOT = WS-SAVED-T-HEAD
       OR T-TAIL NOT = WS-SAVED-T-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE35_INPUT_MUTATED=" WS-RUNS
    END-IF.

FREE-OUTPUT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN NOT = 0
       OR O-CHUNKS NOT = 0 OR O-HEAD NOT = NULL
       OR O-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE35_OUTPUT_FREE_FAILED=" WS-RUNS
    END-IF.

RELEASE-PAIR.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE35_C_FREE_FAILED=" WS-STATUS
    END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE35_T_FREE_FAILED=" WS-STATUS
    END-IF.
END PROGRAM STAGE35-DISCOVERY-TESTS.
