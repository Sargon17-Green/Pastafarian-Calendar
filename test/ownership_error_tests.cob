>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. OWNERSHIP-ERROR-TESTS.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 WS-A.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-B.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-RANK.
   05 R-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 R-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 R-HEAD USAGE POINTER.
   05 R-TAIL USAGE POINTER.
01 WS-COUNT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-YEAR.
   05 Y-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Y-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Y-HEAD USAGE POINTER.
   05 Y-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-LENGTHS.
   05 WS-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-WEAVE.
   05 WS-WEAVE-ID OCCURS 5778 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-DUMMY-REMAINING.
   05 WS-REM OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-OP PIC X(16).
01 WS-CACHE-ACTION PIC X(12).
01 WS-CUTLET-NAME PIC X(96).
01 WS-MONTH-NAME PIC X(96).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CLEANUP-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-BASE-LIVE PIC S9(18) COMP-5 VALUE 0.
01 WS-AFTER-LIVE PIC S9(18) COMP-5 VALUE 0.
01 WS-M PIC 9(4) COMP-5 VALUE 0.
01 WS-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-WEAVE-LEN PIC 9(9) COMP-5 VALUE 0.
01 WS-DAY-IN-CUTLET PIC 9(4) COMP-5 VALUE 0.
01 WS-DAY-IN-MONTH PIC 9(4) COMP-5 VALUE 0.
01 WS-RUN PIC 9(4) COMP-5 VALUE 0.
01 WS-FAILED PIC 9(4) COMP-5 VALUE 0.
01 WS-ARENA-OPEN PIC 9 VALUE 0.
01 WS-ITERATION PIC 9(4) COMP-5 VALUE 0.
01 WS-LOCAL-ERROR PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        A-HEAD A-TAIL B-HEAD B-TAIL R-HEAD R-TAIL C-HEAD C-TAIL Y-HEAD Y-TAIL O-HEAD O-TAIL TO NULL
    PERFORM TEST-WEAVING-ERROR-CLEANUP
    PERFORM TEST-ORACLE-OUTPUT-OWNERSHIP-GUARD
    PERFORM TEST-RAW-BIGINT-TEMP-LIFETIME
    ADD WS-RUN TO LK-RUN
    ADD WS-FAILED TO LK-FAILED
    GOBACK.

TEST-WEAVING-ERROR-CLEANUP.
    PERFORM BEGIN-ARENA
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法启动错误路径所有权测试的 arena。"
        EXIT PARAGRAPH
    END-IF

    MOVE 2 TO WS-M
    MOVE 2 TO WS-LENGTH(1) WS-LENGTH(2)
    MOVE 999 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-RANK WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法构造非法编织 rank。"
        PERFORM END-ARENA
        EXIT PARAGRAPH
    END-IF

    MOVE WS-ZERO TO WS-COUNT
    MOVE 0 TO WS-WEAVE-LEN WS-STATUS
    CALL "NORMATIVE-WEAVING" USING WS-M WS-LENGTHS WS-RANK WS-COUNT WS-WEAVE WS-WEAVE-LEN WS-STATUS
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 141
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 非法编织 rank 未返回预期错误状态 141。实际=" WS-STATUS
    END-IF
    ADD 1 TO WS-RUN
    IF C-HEAD NOT = NULL OR C-SIGN NOT = 0 OR C-CHUNKS NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 编织错误路径留下了部分 count 堆结果。"
    END-IF

    MOVE "ASSERT-EMPTY" TO WS-CACHE-ACTION
    MOVE 0 TO WS-STATUS WS-OPENED WS-CLOSED
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-CACHE-ACTION WS-M WS-LENGTHS WS-DUMMY-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 编织错误路径返回后 有界缓存未清空。"
    END-IF

    PERFORM END-ARENA
    PERFORM READ-LIVE
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 编织错误路径结束后仍有活动 BigInt/arena 分配。数量=" WS-SMALL
    END-IF.

TEST-ORACLE-OUTPUT-OWNERSHIP-GUARD.
    MOVE 123 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-YEAR WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法构造 caller-owned 年份输出。"
        EXIT PARAGRAPH
    END-IF

    PERFORM READ-LIVE
    MOVE WS-SMALL TO WS-BASE-LIVE
    MOVE SPACES TO WS-CUTLET-NAME WS-MONTH-NAME
    MOVE 0 TO WS-DAY-IN-CUTLET WS-DAY-IN-MONTH WS-STATUS
    CALL "NORMATIVE-ORACLE" USING WS-ZERO WS-DUMMY-ZERO WS-YEAR WS-CUTLET-NAME WS-DAY-IN-CUTLET WS-MONTH-NAME WS-DAY-IN-MONTH WS-STATUS
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 175
        ADD 1 TO WS-FAILED
        DISPLAY "失败: oracle 未拒绝已有 caller-owned 年份输出。实际=" WS-STATUS
    END-IF

    PERFORM READ-LIVE
    MOVE WS-SMALL TO WS-AFTER-LIVE
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0 OR WS-AFTER-LIVE NOT = WS-BASE-LIVE
        ADD 1 TO WS-FAILED
        DISPLAY "失败: oracle 输出所有权 guard 改变了活动堆分配数。"
    END-IF

    MOVE WS-YEAR TO WS-OUT
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-CLEANUP-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
    IF WS-CLEANUP-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: caller-owned 年份输出无法释放。"
    END-IF
    MOVE WS-ZERO TO WS-YEAR WS-OUT
    PERFORM READ-LIVE
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: caller-owned 输出释放后仍有活动堆分配。数量=" WS-SMALL
    END-IF.

TEST-RAW-BIGINT-TEMP-LIFETIME.
    MOVE WS-ZERO TO WS-A WS-B WS-OUT
    MOVE 0 TO WS-LOCAL-ERROR

    MOVE 1000000000 TO WS-SCALAR
    MOVE "FROM-SMALL" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-A WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法构造直接 BigInt 所有权压力测试输入 A。"
        MOVE 1 TO WS-LOCAL-ERROR
    END-IF

    IF WS-LOCAL-ERROR = 0
        MOVE 37 TO WS-SCALAR
        MOVE "FROM-SMALL" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-B WS-SCALAR WS-CMP WS-SMALL WS-STATUS
        IF WS-STATUS NOT = 0
            ADD 1 TO WS-RUN WS-FAILED
            DISPLAY "失败: 无法构造直接 BigInt 所有权压力测试输入 B。"
            MOVE 1 TO WS-LOCAL-ERROR
        END-IF
    END-IF

    IF WS-LOCAL-ERROR = 0
        PERFORM READ-LIVE
        MOVE WS-SMALL TO WS-BASE-LIVE
        PERFORM VARYING WS-ITERATION FROM 1 BY 1 UNTIL WS-ITERATION > 50 OR WS-LOCAL-ERROR = 1
            PERFORM RUN-RAW-BIGINT-ROUND
            IF WS-LOCAL-ERROR = 0
                PERFORM READ-LIVE
                IF WS-STATUS NOT = 0 OR WS-SMALL NOT = WS-BASE-LIVE
                    ADD 1 TO WS-RUN WS-FAILED
                    DISPLAY "失败: 直接 BigInt helper 重复调用后活动堆分配未回到基线。迭代=" WS-ITERATION
                    MOVE 1 TO WS-LOCAL-ERROR
                END-IF
            END-IF
        END-PERFORM
    END-IF

    PERFORM FREE-OUT-IF-NEEDED
    PERFORM FREE-A-IF-NEEDED
    PERFORM FREE-B-IF-NEEDED
    PERFORM READ-LIVE
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 直接 BigInt helper 所有权测试结束后仍有活动堆分配。数量=" WS-SMALL
    END-IF.

RUN-RAW-BIGINT-ROUND.
    MOVE 7 TO WS-SCALAR
    MOVE "ADD-SMALL" TO WS-OP
    PERFORM CALL-RAW-OUT-AND-FREE
    IF WS-LOCAL-ERROR = 1 EXIT PARAGRAPH END-IF

    MOVE 3 TO WS-SCALAR
    MOVE "MUL-SMALL" TO WS-OP
    PERFORM CALL-RAW-OUT-AND-FREE
    IF WS-LOCAL-ERROR = 1 EXIT PARAGRAPH END-IF

    MOVE 999999999 TO WS-SCALAR
    MOVE "CMP-SMALL" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: CMP-SMALL 所有权压力调用失败。"
        MOVE 1 TO WS-LOCAL-ERROR
        EXIT PARAGRAPH
    END-IF

    MOVE "MOD-M" TO WS-OP
    PERFORM CALL-RAW-OUT-AND-FREE
    IF WS-LOCAL-ERROR = 1 EXIT PARAGRAPH END-IF

    MOVE 37 TO WS-SCALAR
    MOVE "MOD-SMALL" TO WS-OP
    PERFORM CALL-RAW-OUT-AND-FREE
    IF WS-LOCAL-ERROR = 1 EXIT PARAGRAPH END-IF

    MOVE "DIV" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-B WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: DIV 所有权压力调用失败。"
        MOVE 1 TO WS-LOCAL-ERROR
        EXIT PARAGRAPH
    END-IF
    PERFORM FREE-OUT-IF-NEEDED

    MOVE "SAVE" TO WS-OP
    PERFORM CALL-RAW-OUT-AND-FREE.

CALL-RAW-OUT-AND-FREE.
    MOVE WS-ZERO TO WS-OUT
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 直接 BigInt helper 所有权压力调用失败。操作=" WS-OP
        MOVE 1 TO WS-LOCAL-ERROR
        EXIT PARAGRAPH
    END-IF
    PERFORM FREE-OUT-IF-NEEDED.

FREE-OUT-IF-NEEDED.
    IF O-HEAD = NULL
        MOVE WS-ZERO TO WS-OUT
        EXIT PARAGRAPH
    END-IF
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-CLEANUP-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
    IF WS-CLEANUP-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法释放直接 helper 输出。"
        MOVE 1 TO WS-LOCAL-ERROR
    END-IF
    MOVE WS-ZERO TO WS-OUT.

FREE-A-IF-NEEDED.
    IF A-HEAD = NULL EXIT PARAGRAPH END-IF
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-CLEANUP-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-A WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
    IF WS-CLEANUP-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法释放直接 helper 输入 A。"
    END-IF
    MOVE WS-ZERO TO WS-A.

FREE-B-IF-NEEDED.
    IF B-HEAD = NULL EXIT PARAGRAPH END-IF
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-CLEANUP-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-B WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
    IF WS-CLEANUP-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法释放直接 helper 输入 B。"
    END-IF
    MOVE WS-ZERO TO WS-B.

BEGIN-ARENA.
    MOVE "ARENA-BEGIN" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS = 0 MOVE 1 TO WS-ARENA-OPEN END-IF.

END-ARENA.
    IF WS-ARENA-OPEN = 0 EXIT PARAGRAPH END-IF
    MOVE "ARENA-END" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 错误路径测试 arena 未能干净关闭。"
    END-IF
    MOVE 0 TO WS-ARENA-OPEN.

READ-LIVE.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS.
END PROGRAM OWNERSHIP-ERROR-TESTS.
