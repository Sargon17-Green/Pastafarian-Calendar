>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. FAMILY-BRUTEFORCE-TESTS.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 WS-RANK.
   05 R-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 R-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 R-HEAD USAGE POINTER.
   05 R-TAIL USAGE POINTER.
01 WS-COUNT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-OP PIC X(16).
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-VALUES.
   05 WS-VALUE OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTS.
   05 WS-PART OCCURS 17 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-LENGTHS.
   05 WS-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-WEAVE.
   05 WS-WEAVE-ID OCCURS 5778 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-REMAINING.
   05 WS-REM OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-WEAVE-ACTION PIC X(12).
01 WS-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-WEAVE-LEN PIC 9(9) COMP-5 VALUE 0.
01 WS-TOTAL PIC 9(9) COMP-5 VALUE 0.
01 WS-SLOTS PIC 9(4) COMP-5 VALUE 0.
01 WS-LO PIC 9(4) COMP-5 VALUE 0.
01 WS-HI PIC 9(4) COMP-5 VALUE 0.
01 WS-G PIC 9(4) COMP-5 VALUE 0.
01 WS-K PIC 9(4) COMP-5 VALUE 0.
01 WS-REQUIRED PIC S9(4) COMP-5 VALUE 0.
01 WS-M PIC 9(4) COMP-5 VALUE 0.
01 WS-BRUTE-COUNT PIC 9(9) COMP-5 VALUE 0.
01 WS-BRUTE-RANK PIC 9(9) COMP-5 VALUE 0.
01 WS-RANK-I PIC 9(9) COMP-5 VALUE 0.
01 WS-X1 PIC 9(4) COMP-5 VALUE 0.
01 WS-X2 PIC 9(4) COMP-5 VALUE 0.
01 WS-X3 PIC S9(4) COMP-5 VALUE 0.
01 WS-J1 PIC 9(4) COMP-5 VALUE 0.
01 WS-J2 PIC 9(4) COMP-5 VALUE 0.
01 WS-J3 PIC 9(4) COMP-5 VALUE 0.
01 WS-J4 PIC 9(4) COMP-5 VALUE 0.
01 WS-N1 PIC 9(4) COMP-5 VALUE 0.
01 WS-N2 PIC 9(4) COMP-5 VALUE 0.
01 WS-FIRST1 PIC 9(4) COMP-5 VALUE 0.
01 WS-FIRST2 PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST1 PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST2 PIC 9(4) COMP-5 VALUE 0.
01 WS-LEGAL PIC 9 VALUE 0.
01 WS-RUN PIC 9(4) COMP-5 VALUE 0.
01 WS-FAILED PIC 9(4) COMP-5 VALUE 0.
01 WS-ARENA-OPEN PIC 9 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL
        R-HEAD R-TAIL C-HEAD C-TAIL O-HEAD O-TAIL TO NULL
    PERFORM BEGIN-ARENA
    IF WS-STATUS = 0
        PERFORM TEST-BOUNDED-COMPOSITION
        PERFORM TEST-BOUNDED-COMPOSITION-UPPER
        PERFORM TEST-CUTLET-PARTITION
        PERFORM TEST-WEAVING-TWO-BY-TWO
        PERFORM TEST-WEAVING-BOUNDED-DP-STATES
    ELSE
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 无法启动组合测试的任意精度作用域。"
    END-IF
    PERFORM END-ARENA
    ADD WS-RUN TO LK-RUN
    ADD WS-FAILED TO LK-FAILED
    GOBACK.

BEGIN-ARENA.
    MOVE "ARENA-BEGIN" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS = 0 MOVE 1 TO WS-ARENA-OPEN END-IF.

END-ARENA.
    IF WS-ARENA-OPEN = 0 EXIT PARAGRAPH END-IF
    IF WS-STATUS NOT = 0 MOVE 0 TO WS-STATUS END-IF
    MOVE "ARENA-END" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-RUN WS-FAILED
        DISPLAY "失败: 组合测试的任意精度作用域未能干净关闭。"
        MOVE 0 TO WS-STATUS
    END-IF
    MOVE 0 TO WS-ARENA-OPEN.

TEST-BOUNDED-COMPOSITION.
    MOVE 5 TO WS-TOTAL
    MOVE 2 TO WS-SLOTS
    MOVE 1 TO WS-LO
    MOVE 4 TO WS-HI
    MOVE 0 TO WS-BRUTE-COUNT
    PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 4
        PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 4
            IF WS-X1 + WS-X2 = 5
                ADD 1 TO WS-BRUTE-COUNT
            END-IF
        END-PERFORM
    END-PERFORM

    MOVE WS-ZERO TO WS-RANK
    CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-TOTAL WS-SLOTS WS-LO WS-HI WS-RANK WS-COUNT WS-VALUES WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = WS-BRUTE-COUNT
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 有界组合的精确计数与穷举计数不同。"
    END-IF

    PERFORM VARYING WS-RANK-I FROM 1 BY 1 UNTIL WS-RANK-I > WS-BRUTE-COUNT
        MOVE WS-RANK-I TO WS-SCALAR
        PERFORM MAKE-RANK
        MOVE 0 TO WS-BRUTE-RANK
        PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 4
            PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 4
                IF WS-X1 + WS-X2 = 5
                    ADD 1 TO WS-BRUTE-RANK
                    IF WS-BRUTE-RANK = WS-RANK-I
                        CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-TOTAL WS-SLOTS WS-LO WS-HI WS-RANK WS-COUNT WS-VALUES WS-STATUS
                        PERFORM ASSERT-STATUS-ZERO
                        ADD 1 TO WS-RUN
                        IF WS-VALUE(1) NOT = WS-X1 OR WS-VALUE(2) NOT = WS-X2
                            ADD 1 TO WS-FAILED
                            DISPLAY "失败: 有界组合的词典序反排名与穷举不同。"
                        END-IF
                    END-IF
                END-IF
            END-PERFORM
        END-PERFORM
    END-PERFORM.

TEST-BOUNDED-COMPOSITION-UPPER.
    *> 此例必须触发 inclusion-exclusion 的上界扣除项：总和 8，3 槽，每槽 1..3。
    MOVE 8 TO WS-TOTAL
    MOVE 3 TO WS-SLOTS
    MOVE 1 TO WS-LO
    MOVE 3 TO WS-HI
    MOVE 0 TO WS-BRUTE-COUNT
    PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 3
        PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 3
            PERFORM VARYING WS-X3 FROM 1 BY 1 UNTIL WS-X3 > 3
                IF WS-X1 + WS-X2 + WS-X3 = 8
                    ADD 1 TO WS-BRUTE-COUNT
                END-IF
            END-PERFORM
        END-PERFORM
    END-PERFORM

    MOVE WS-ZERO TO WS-RANK
    MOVE 0 TO WS-STATUS
    CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-TOTAL WS-SLOTS WS-LO WS-HI WS-RANK WS-COUNT WS-VALUES WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = WS-BRUTE-COUNT OR WS-SMALL NOT = 3
        ADD 1 TO WS-FAILED
        DISPLAY "失败: inclusion-exclusion 有界组合计数与穷举不同。"
    END-IF

    PERFORM VARYING WS-RANK-I FROM 1 BY 1 UNTIL WS-RANK-I > WS-BRUTE-COUNT
        MOVE WS-RANK-I TO WS-SCALAR
        PERFORM MAKE-RANK
        MOVE 0 TO WS-BRUTE-RANK
        PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 3
            PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 3
                PERFORM VARYING WS-X3 FROM 1 BY 1 UNTIL WS-X3 > 3
                    IF WS-X1 + WS-X2 + WS-X3 = 8
                        ADD 1 TO WS-BRUTE-RANK
                        IF WS-BRUTE-RANK = WS-RANK-I
                            MOVE 0 TO WS-STATUS
                            CALL "NORMATIVE-BOUNDED-COMPOSITION" USING WS-TOTAL WS-SLOTS WS-LO WS-HI WS-RANK WS-COUNT WS-VALUES WS-STATUS
                            PERFORM ASSERT-STATUS-ZERO
                            ADD 1 TO WS-RUN
                            IF WS-VALUE(1) NOT = WS-X1 OR WS-VALUE(2) NOT = WS-X2 OR WS-VALUE(3) NOT = WS-X3
                                ADD 1 TO WS-FAILED
                                DISPLAY "失败: inclusion-exclusion 有界组合反排名与穷举不同。"
                            END-IF
                        END-IF
                    END-IF
                END-PERFORM
            END-PERFORM
        END-PERFORM
    END-PERFORM.

TEST-CUTLET-PARTITION.
    MOVE 5 TO WS-G
    MOVE 3 TO WS-K
    MOVE 2 TO WS-REQUIRED
    MOVE 0 TO WS-BRUTE-COUNT
    PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 3
        PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 4
            COMPUTE WS-X3 = 5 - WS-X1 - WS-X2
            IF WS-X3 >= 1
                IF WS-X1 = 2 OR WS-X1 + WS-X2 = 2
                    ADD 1 TO WS-BRUTE-COUNT
                END-IF
            END-IF
        END-PERFORM
    END-PERFORM

    MOVE WS-ZERO TO WS-RANK
    CALL "NORMATIVE-CUTLET-PARTITION" USING WS-G WS-K WS-REQUIRED WS-RANK WS-COUNT WS-PARTS WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = WS-BRUTE-COUNT
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 肉饼分割的过滤 DP 计数与穷举计数不同。"
    END-IF

    PERFORM VARYING WS-RANK-I FROM 1 BY 1 UNTIL WS-RANK-I > WS-BRUTE-COUNT
        MOVE WS-RANK-I TO WS-SCALAR
        PERFORM MAKE-RANK
        MOVE 0 TO WS-BRUTE-RANK
        PERFORM VARYING WS-X1 FROM 1 BY 1 UNTIL WS-X1 > 3
            PERFORM VARYING WS-X2 FROM 1 BY 1 UNTIL WS-X2 > 4
                COMPUTE WS-X3 = 5 - WS-X1 - WS-X2
                IF WS-X3 >= 1
                    IF WS-X1 = 2 OR WS-X1 + WS-X2 = 2
                        ADD 1 TO WS-BRUTE-RANK
                        IF WS-BRUTE-RANK = WS-RANK-I
                            CALL "NORMATIVE-CUTLET-PARTITION" USING WS-G WS-K WS-REQUIRED WS-RANK WS-COUNT WS-PARTS WS-STATUS
                            PERFORM ASSERT-STATUS-ZERO
                            ADD 1 TO WS-RUN
                            IF WS-PART(1) NOT = WS-X1 OR WS-PART(2) NOT = WS-X2 OR WS-PART(3) NOT = WS-X3
                                ADD 1 TO WS-FAILED
                                DISPLAY "失败: 肉饼分割的词典序反排名与穷举不同。"
                            END-IF
                        END-IF
                    END-IF
                END-IF
            END-PERFORM
        END-PERFORM
    END-PERFORM.

TEST-WEAVING-TWO-BY-TWO.
    MOVE 2 TO WS-M
    MOVE 0 TO WS-BRUTE-COUNT
    MOVE 2 TO WS-LENGTH(1) WS-LENGTH(2)
    PERFORM VARYING WS-J1 FROM 1 BY 1 UNTIL WS-J1 > 2
        PERFORM VARYING WS-J2 FROM 1 BY 1 UNTIL WS-J2 > 2
            PERFORM VARYING WS-J3 FROM 1 BY 1 UNTIL WS-J3 > 2
                PERFORM VARYING WS-J4 FROM 1 BY 1 UNTIL WS-J4 > 2
                    PERFORM CLASSIFY-FOUR-WEAVE
                    IF WS-LEGAL = 1 ADD 1 TO WS-BRUTE-COUNT END-IF
                END-PERFORM
            END-PERFORM
        END-PERFORM
    END-PERFORM

    MOVE WS-ZERO TO WS-RANK
    CALL "NORMATIVE-WEAVING" USING WS-M WS-LENGTHS WS-RANK WS-COUNT WS-WEAVE WS-WEAVE-LEN WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = WS-BRUTE-COUNT
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 月份编织的有界精确计数与完整穷举不同。"
    END-IF

    PERFORM VARYING WS-RANK-I FROM 1 BY 1 UNTIL WS-RANK-I > WS-BRUTE-COUNT
        MOVE WS-RANK-I TO WS-SCALAR
        PERFORM MAKE-RANK
        MOVE 0 TO WS-BRUTE-RANK
        PERFORM VARYING WS-J1 FROM 1 BY 1 UNTIL WS-J1 > 2
            PERFORM VARYING WS-J2 FROM 1 BY 1 UNTIL WS-J2 > 2
                PERFORM VARYING WS-J3 FROM 1 BY 1 UNTIL WS-J3 > 2
                    PERFORM VARYING WS-J4 FROM 1 BY 1 UNTIL WS-J4 > 2
                        PERFORM CLASSIFY-FOUR-WEAVE
                        IF WS-LEGAL = 1
                            ADD 1 TO WS-BRUTE-RANK
                            IF WS-BRUTE-RANK = WS-RANK-I
                                CALL "NORMATIVE-WEAVING" USING WS-M WS-LENGTHS WS-RANK WS-COUNT WS-WEAVE WS-WEAVE-LEN WS-STATUS
                                PERFORM ASSERT-STATUS-ZERO
                                ADD 1 TO WS-RUN
                                IF WS-WEAVE-LEN NOT = 4 OR WS-WEAVE-ID(1) NOT = WS-J1 OR WS-WEAVE-ID(2) NOT = WS-J2 OR WS-WEAVE-ID(3) NOT = WS-J3 OR WS-WEAVE-ID(4) NOT = WS-J4
                                    ADD 1 TO WS-FAILED
                                    DISPLAY "失败: 月份编织的词典序反排名与穷举不同。"
                                END-IF
                            END-IF
                        END-IF
                    END-PERFORM
                END-PERFORM
            END-PERFORM
        END-PERFORM
    END-PERFORM.

TEST-WEAVING-BOUNDED-DP-STATES.
    MOVE 3 TO WS-M
    MOVE 2 TO WS-LENGTH(1) WS-LENGTH(2) WS-LENGTH(3)
    MOVE 0 TO WS-OPENED WS-CLOSED WS-STATUS
    MOVE 2 TO WS-REM(1) WS-REM(2) WS-REM(3)
    MOVE "RESET" TO WS-WEAVE-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-WEAVE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    PERFORM ASSERT-STATUS-ZERO

    MOVE "COUNT" TO WS-WEAVE-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-WEAVE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = 5
        ADD 1 TO WS-FAILED
        DISPLAY "失败: [2,2,2] 完整编织计数应为 5。"
    END-IF

    MOVE 1 TO WS-REM(1) WS-REM(2)
    MOVE 2 TO WS-REM(3) WS-OPENED
    MOVE 0 TO WS-CLOSED WS-STATUS
    MOVE "COUNT" TO WS-WEAVE-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-WEAVE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = 3
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 前缀 [1,2] 后的编织补全数应为 3。"
    END-IF

    MOVE 0 TO WS-REM(1)
    MOVE 1 TO WS-REM(2)
    MOVE 2 TO WS-REM(3) WS-OPENED
    MOVE 1 TO WS-CLOSED
    MOVE 0 TO WS-STATUS
    MOVE "COUNT" TO WS-WEAVE-ACTION
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-WEAVE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    PERFORM ASSERT-STATUS-ZERO
    PERFORM COUNT-TO-SMALL
    ADD 1 TO WS-RUN
    IF WS-SMALL NOT = 2
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 前缀 [1,2,1] 后的编织补全数应为 2。"
    END-IF

    MOVE "RESET" TO WS-WEAVE-ACTION
    MOVE 0 TO WS-STATUS
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-WEAVE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-COUNT WS-STATUS
    PERFORM ASSERT-STATUS-ZERO.

CLASSIFY-FOUR-WEAVE.
    MOVE 0 TO WS-LEGAL WS-N1 WS-N2 WS-FIRST1 WS-FIRST2 WS-LAST1 WS-LAST2
    IF WS-J1 = 1 ADD 1 TO WS-N1 MOVE 1 TO WS-FIRST1 WS-LAST1 ELSE ADD 1 TO WS-N2 MOVE 1 TO WS-FIRST2 WS-LAST2 END-IF
    IF WS-J2 = 1
        ADD 1 TO WS-N1
        IF WS-FIRST1 = 0 MOVE 2 TO WS-FIRST1 END-IF
        MOVE 2 TO WS-LAST1
    ELSE
        ADD 1 TO WS-N2
        IF WS-FIRST2 = 0 MOVE 2 TO WS-FIRST2 END-IF
        MOVE 2 TO WS-LAST2
    END-IF
    IF WS-J3 = 1
        ADD 1 TO WS-N1
        IF WS-FIRST1 = 0 MOVE 3 TO WS-FIRST1 END-IF
        MOVE 3 TO WS-LAST1
    ELSE
        ADD 1 TO WS-N2
        IF WS-FIRST2 = 0 MOVE 3 TO WS-FIRST2 END-IF
        MOVE 3 TO WS-LAST2
    END-IF
    IF WS-J4 = 1
        ADD 1 TO WS-N1
        IF WS-FIRST1 = 0 MOVE 4 TO WS-FIRST1 END-IF
        MOVE 4 TO WS-LAST1
    ELSE
        ADD 1 TO WS-N2
        IF WS-FIRST2 = 0 MOVE 4 TO WS-FIRST2 END-IF
        MOVE 4 TO WS-LAST2
    END-IF
    IF WS-N1 = 2 AND WS-N2 = 2 AND WS-FIRST1 < WS-FIRST2 AND WS-LAST1 < WS-LAST2
        MOVE 1 TO WS-LEGAL
    END-IF.

MAKE-RANK.
    MOVE "FROM-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS = 0 MOVE WS-OUT TO WS-RANK END-IF
    PERFORM ASSERT-STATUS-ZERO.

COUNT-TO-SMALL.
    MOVE WS-COUNT TO WS-OUT
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    PERFORM ASSERT-STATUS-ZERO.

ASSERT-STATUS-ZERO.
    ADD 1 TO WS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILED
        DISPLAY "失败: 穷举等价性测试收到非零状态 " WS-STATUS
        MOVE 0 TO WS-STATUS
    END-IF.
END PROGRAM FAMILY-BRUTEFORCE-TESTS.
