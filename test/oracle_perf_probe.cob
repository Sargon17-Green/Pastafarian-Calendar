>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. ORACLE-PERF-PROBE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ZERO.
   05 Z-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Z-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Z-HEAD USAGE POINTER.
   05 Z-TAIL USAGE POINTER.
01 WS-DUMMY-ZERO.
   05 DZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DZ-HEAD USAGE POINTER.
   05 DZ-TAIL USAGE POINTER.
01 WS-DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 WS-CDAY.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-TDAY.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-YEAR.
   05 Y-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 Y-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 Y-HEAD USAGE POINTER.
   05 Y-TAIL USAGE POINTER.
01 WS-OUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-GATE-INDEX.
   05 GI-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 GI-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 GI-HEAD USAGE POINTER.
   05 GI-TAIL USAGE POINTER.
01 WS-GATE-DAY.
   05 GD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 GD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 GD-HEAD USAGE POINTER.
   05 GD-TAIL USAGE POINTER.
01 WS-CACHE-COUNT.
   05 MC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 MC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 MC-HEAD USAGE POINTER.
   05 MC-TAIL USAGE POINTER.
01 WS-LENGTHS.
   05 WS-LENGTH OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-REMAINING.
   05 WS-REM OCCURS 47 TIMES PIC 9(4) COMP-5 VALUE 0.
01 WS-OP PIC X(16).
01 WS-NAME PIC X(16).
01 WS-GATE-ACTION PIC X(16).
01 WS-CACHE-ACTION PIC X(12).
01 WS-CUTLET-NAME PIC X(96).
01 WS-MONTH-NAME PIC X(96).
01 WS-DAY-IN-CUTLET PIC 9(4) COMP-5 VALUE 0.
01 WS-DAY-IN-MONTH PIC 9(4) COMP-5 VALUE 0.
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CLEANUP-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-BASE-LIVE PIC S9(18) COMP-5 VALUE 0.
01 WS-AFTER-LIVE PIC S9(18) COMP-5 VALUE 0.
01 WS-PEAK-LIVE PIC S9(18) COMP-5 VALUE 0.
01 WS-REPEAT-PEAK PIC S9(18) COMP-5 VALUE 0.
01 WS-SAFE-PEAK-LIMIT PIC S9(18) COMP-5 VALUE 2000000.
01 WS-ITERATION PIC 9(4) COMP-5 VALUE 0.
01 WS-ITERATIONS PIC 9(4) COMP-5 VALUE 1.
01 WS-FOUND PIC 9 COMP-5 VALUE 0.
01 WS-M PIC 9(4) COMP-5 VALUE 0.
01 WS-OPENED PIC 9(4) COMP-5 VALUE 0.
01 WS-CLOSED PIC 9(4) COMP-5 VALUE 0.
01 WS-FAILURES PIC 9(4) COMP-5 VALUE 0.

PROCEDURE DIVISION.
MAIN.
    SET Z-HEAD Z-TAIL DZ-HEAD DZ-TAIL DO-HEAD DO-TAIL C-HEAD C-TAIL T-HEAD T-TAIL Y-HEAD Y-TAIL
        O-HEAD O-TAIL GI-HEAD GI-TAIL GD-HEAD GD-TAIL MC-HEAD MC-TAIL TO NULL

    PERFORM BUILD-OWNED-INPUTS
    IF WS-FAILURES = 0 PERFORM READ-LIVE-COUNT END-IF
    IF WS-FAILURES = 0 MOVE WS-SMALL TO WS-BASE-LIVE END-IF

    *> 先执行一次完整 warm-up，并读取真实高水位；高水位异常时不进入重复循环。
    IF WS-FAILURES = 0 PERFORM RESET-PEAK-COUNT END-IF
    IF WS-FAILURES = 0
        MOVE 1 TO WS-ITERATION
        PERFORM RUN-ONE-HEAVY-ORACLE
    END-IF
    IF WS-FAILURES = 0 PERFORM ASSERT-SCOPED-CACHES-EMPTY END-IF
    IF WS-FAILURES = 0 PERFORM ASSERT-LIVE-BASELINE END-IF
    IF WS-FAILURES = 0 PERFORM READ-PEAK-COUNT END-IF
    IF WS-FAILURES = 0
        MOVE WS-SMALL TO WS-PEAK-LIVE
        DISPLAY "单次完整 oracle 动态分配高水位: " WS-PEAK-LIVE
        DISPLAY "MEMORY_PEAK_BLOCKS=" WS-PEAK-LIVE
        IF WS-PEAK-LIVE > WS-SAFE-PEAK-LIMIT
            ADD 1 TO WS-FAILURES
            DISPLAY "失败: 单次完整 oracle 的动态分配高水位超过压力测试安全门。"
            DISPLAY "高水位=" WS-PEAK-LIVE " 安全门=" WS-SAFE-PEAK-LIMIT
            DISPLAY "MEMORY_GATE=FAIL"
        ELSE
            DISPLAY "MEMORY_GATE=PASS"
        END-IF
    END-IF

    IF WS-FAILURES = 0 PERFORM RESET-PEAK-COUNT END-IF
    PERFORM VARYING WS-ITERATION FROM 2 BY 1
        UNTIL WS-ITERATION > WS-ITERATIONS OR WS-FAILURES > 0
        PERFORM RUN-ONE-HEAVY-ORACLE
        IF WS-FAILURES = 0 PERFORM ASSERT-SCOPED-CACHES-EMPTY END-IF
        IF WS-FAILURES = 0 PERFORM ASSERT-LIVE-BASELINE END-IF
    END-PERFORM
    IF WS-FAILURES = 0 PERFORM READ-PEAK-COUNT END-IF
    IF WS-FAILURES = 0 MOVE WS-SMALL TO WS-REPEAT-PEAK END-IF

    PERFORM RELEASE-OWNED-INPUTS
    PERFORM READ-LIVE-COUNT
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 压力测试结束后仍存在活动的任意精度堆分配。数量=" WS-SMALL
    END-IF

    IF WS-FAILURES = 0
        DISPLAY "所有权压力测试通过。完整 oracle 重复次数: " WS-ITERATIONS
        DISPLAY "每次调用后活动堆分配均精确回到基线: " WS-BASE-LIVE
        DISPLAY "单次高水位: " WS-PEAK-LIVE " 重复阶段高水位: " WS-REPEAT-PEAK
        DISPLAY "STRESS_RESULT=PASS"
        DISPLAY "PERF_RESULT=PASS"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "所有权压力测试失败。失败数: " WS-FAILURES
        DISPLAY "STRESS_RESULT=FAIL"
        DISPLAY "PERF_RESULT=FAIL"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

BUILD-OWNED-INPUTS.
    MOVE "FOUNDATION" TO WS-NAME
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-CDAY WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 无法为压力测试创建基础日输入。"
        EXIT PARAGRAPH
    END-IF
    MOVE "COPY" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-CDAY WS-ZERO WS-TDAY WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 无法创建独立所有权的目标日副本。"
    END-IF.

RUN-ONE-HEAVY-ORACLE.
    DISPLAY "STRESS_PHASE=ORACLE_BEGIN ITERATION=" WS-ITERATION
    MOVE WS-ZERO TO WS-YEAR
    MOVE SPACES TO WS-CUTLET-NAME WS-MONTH-NAME
    MOVE 0 TO WS-DAY-IN-CUTLET WS-DAY-IN-MONTH WS-STATUS
    CALL "NORMATIVE-ORACLE" USING WS-CDAY WS-TDAY WS-YEAR WS-CUTLET-NAME WS-DAY-IN-CUTLET WS-MONTH-NAME WS-DAY-IN-MONTH WS-STATUS
    DISPLAY "STRESS_PHASE=ORACLE_END ITERATION=" WS-ITERATION " STATUS=" WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 重复完整 oracle 调用返回非零状态。迭代=" WS-ITERATION " 状态=" WS-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE WS-YEAR TO WS-OUT
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 5000
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 基础日完整 oracle 未返回第 5000 年。迭代=" WS-ITERATION
    END-IF
    IF FUNCTION LENGTH(FUNCTION TRIM(WS-CUTLET-NAME)) = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 压力测试未得到肉饼名称。"
    END-IF
    IF FUNCTION LENGTH(FUNCTION TRIM(WS-MONTH-NAME)) = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 压力测试未得到月份名称。"
    END-IF
    IF WS-DAY-IN-CUTLET < 1 OR WS-DAY-IN-MONTH < 1
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 压力测试得到无效的日序号。"
    END-IF
    PERFORM RELEASE-YEAR-RESULT.

RELEASE-YEAR-RESULT.
    IF Y-HEAD = NULL EXIT PARAGRAPH END-IF
    MOVE WS-YEAR TO WS-OUT
    MOVE "FREE" TO WS-OP
    MOVE 0 TO WS-CLEANUP-STATUS
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
    IF WS-CLEANUP-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 压力测试无法释放年份结果。"
    END-IF
    MOVE WS-ZERO TO WS-YEAR.

ASSERT-SCOPED-CACHES-EMPTY.
    MOVE "ASSERT-EMPTY" TO WS-GATE-ACTION
    MOVE 0 TO WS-STATUS WS-FOUND
    CALL "NORMATIVE-GATES" USING WS-GATE-ACTION WS-ZERO WS-GATE-INDEX WS-GATE-DAY WS-FOUND WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 完整 oracle 返回后，门缓存仍持有动态节点。"
        EXIT PARAGRAPH
    END-IF

    MOVE "ASSERT-EMPTY" TO WS-CACHE-ACTION
    MOVE 0 TO WS-STATUS WS-M WS-OPENED WS-CLOSED
    CALL "NORMATIVE-WEAVING-COUNT" USING WS-CACHE-ACTION WS-M WS-LENGTHS WS-REMAINING WS-OPENED WS-CLOSED WS-CACHE-COUNT WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 完整 oracle 返回后，编织有界缓存仍持有动态值。"
    END-IF.

ASSERT-LIVE-BASELINE.
    PERFORM READ-LIVE-COUNT
    IF WS-FAILURES = 0
        MOVE WS-SMALL TO WS-AFTER-LIVE
        IF WS-AFTER-LIVE NOT = WS-BASE-LIVE
            ADD 1 TO WS-FAILURES
            DISPLAY "失败: 重复完整 oracle 调用后，活动堆分配数未回到基线。迭代=" WS-ITERATION
            DISPLAY "基线=" WS-BASE-LIVE " 当前=" WS-AFTER-LIVE
        END-IF
    END-IF.

RESET-PEAK-COUNT.
    MOVE "HEAP-PEAK-RESET" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 无法重置动态分配高水位。"
    END-IF.

READ-PEAK-COUNT.
    MOVE "HEAP-PEAK" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 无法读取动态分配高水位。"
    END-IF.

READ-LIVE-COUNT.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-SMALL
    CALL "ORACLE-BIGINT" USING WS-OP WS-ZERO WS-DUMMY-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAILURES
        DISPLAY "失败: 无法读取活动堆分配计数。"
    END-IF.

RELEASE-OWNED-INPUTS.
    IF C-HEAD NOT = NULL
        MOVE WS-CDAY TO WS-OUT
        MOVE "FREE" TO WS-OP
        MOVE 0 TO WS-CLEANUP-STATUS
        CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
        IF WS-CLEANUP-STATUS NOT = 0
            ADD 1 TO WS-FAILURES
            DISPLAY "失败: 无法释放计算日输入。"
        END-IF
        MOVE WS-ZERO TO WS-CDAY
    END-IF
    IF T-HEAD NOT = NULL
        MOVE WS-TDAY TO WS-OUT
        MOVE "FREE" TO WS-OP
        MOVE 0 TO WS-CLEANUP-STATUS
        CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-DUMMY-OUT WS-SCALAR WS-CMP WS-SMALL WS-CLEANUP-STATUS
        IF WS-CLEANUP-STATUS NOT = 0
            ADD 1 TO WS-FAILURES
            DISPLAY "失败: 无法释放目标日输入。"
        END-IF
        MOVE WS-ZERO TO WS-TDAY
    END-IF.
END PROGRAM ORACLE-PERF-PROBE.
