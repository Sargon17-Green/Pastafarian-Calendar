>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. BIG-INTEGER-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 BI-OP PIC X(16).
01 BI-TEXT PIC X(8192).
01 BI-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 BI-A.
   05 BI-A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-A-HEAD USAGE POINTER.
   05 BI-A-TAIL USAGE POINTER.
01 BI-B.
   05 BI-B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-B-HEAD USAGE POINTER.
   05 BI-B-TAIL USAGE POINTER.
01 BI-OUT.
   05 BI-OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-OUT-HEAD USAGE POINTER.
   05 BI-OUT-TAIL USAGE POINTER.
01 BI-REM.
   05 BI-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-REM-HEAD USAGE POINTER.
   05 BI-REM-TAIL USAGE POINTER.
01 BI-CMP PIC S9(4) COMP-5 VALUE 0.
01 BI-STATUS PIC 9(4) COMP-5 VALUE 0.
01 LOCAL-RUN PIC 9(4) COMP-5 VALUE 0.
01 LOCAL-FAILED PIC 9(4) COMP-5 VALUE 0.
01 EXPECTED PIC X(8192) VALUE SPACES.
01 EXPECTED-LEN PIC 9(18) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    SET BI-A-HEAD TO NULL
    SET BI-A-TAIL TO NULL
    SET BI-B-HEAD TO NULL
    SET BI-B-TAIL TO NULL
    SET BI-OUT-HEAD TO NULL
    SET BI-OUT-TAIL TO NULL
    SET BI-REM-HEAD TO NULL
    SET BI-REM-TAIL TO NULL

    PERFORM TEST-PARSE-M
    PERFORM TEST-PARSE-LEADING-ZEROS
    PERFORM TEST-PARSE-BASE-BOUNDARY
    PERFORM TEST-ADD-M
    PERFORM TEST-MULTIPLY-BASE
    PERFORM TEST-MULTIPLY-NEGATIVE
    PERFORM TEST-DIVIDE-BASE
    PERFORM TEST-DIVIDE-INTERNAL-ZERO
    PERFORM TEST-EUCLIDEAN-NEGATIVE

    ADD LOCAL-RUN TO LK-RUN
    ADD LOCAL-FAILED TO LK-FAILED
    GOBACK.

TEST-PARSE-M.
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "170141183460469231731687303715884105727" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-PARSE-LEADING-ZEROS.
    MOVE "000000000123" TO BI-TEXT
    MOVE 12 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "123" TO EXPECTED
    MOVE 3 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-PARSE-BASE-BOUNDARY.
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO EXPECTED
    MOVE 10 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-ADD-M.
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "ADD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "340282366920938463463374607431768211454" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-MULTIPLY-BASE.
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MUL" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000000000000" TO EXPECTED
    MOVE 19 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-MULTIPLY-NEGATIVE.
    MOVE "-12345678901234567890" TO BI-TEXT
    MOVE 21 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "3" TO BI-TEXT
    MOVE 1 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MUL" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "-37037036703703703670" TO EXPECTED
    MOVE 21 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-DIVIDE-BASE.
    MOVE "1000000000000000000" TO BI-TEXT
    MOVE 19 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "DIVMOD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000" TO EXPECTED
    MOVE 10 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    PERFORM REM-TO-A
    MOVE "0" TO EXPECTED
    MOVE 1 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-DIVIDE-INTERNAL-ZERO.
    MOVE "1000000000000000001000000000" TO BI-TEXT
    MOVE 28 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "DIVMOD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000000000001" TO EXPECTED
    MOVE 19 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    PERFORM REM-TO-A
    MOVE "0" TO EXPECTED
    MOVE 1 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-EUCLIDEAN-NEGATIVE.
    MOVE "-1" TO BI-TEXT
    MOVE 2 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MOD-EUCLID" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "170141183460469231731687303715884105726" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

INIT-A.
    MOVE "INIT-TEXT" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A.

INIT-B.
    MOVE "INIT-TEXT" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-B.

CALL-SERVICE.
    MOVE 0 TO BI-STATUS BI-CMP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 任意精度整数服务返回错误状态 " BI-STATUS
    END-IF.

OUT-TO-A.
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL.

OUT-TO-B.
    MOVE BI-OUT-SIGN TO BI-B-SIGN
    MOVE BI-OUT-CHUNKS TO BI-B-CHUNKS
    SET BI-B-HEAD TO BI-OUT-HEAD
    SET BI-B-TAIL TO BI-OUT-TAIL.

REM-TO-A.
    MOVE BI-REM-SIGN TO BI-A-SIGN
    MOVE BI-REM-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-REM-HEAD
    SET BI-A-TAIL TO BI-REM-TAIL.

ASSERT-A-TEXT.
    MOVE "TO-TEXT" TO BI-OP
    MOVE SPACES TO BI-TEXT
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    ADD 1 TO LOCAL-RUN
    IF BI-STATUS NOT = 0 OR BI-TEXT-LEN NOT = EXPECTED-LEN OR BI-TEXT(1:EXPECTED-LEN) NOT = EXPECTED(1:EXPECTED-LEN)
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 任意精度整数结果不符合预期。"
    END-IF.
END PROGRAM BIG-INTEGER-TESTS.
