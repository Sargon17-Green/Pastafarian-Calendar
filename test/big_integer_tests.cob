>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. BIG-INTEGER-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 BI-OP PIC X(16).
01 BI-TEXT PIC X(8192).
01 BI-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 BI-A.
   05 BI-A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-A-HEAD USAGE POINTER.
   05 BI-A-TAIL USAGE POINTER.
01 BI-B.
   05 BI-B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-B-HEAD USAGE POINTER.
   05 BI-B-TAIL USAGE POINTER.
01 BI-OUT.
   05 BI-OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-OUT-HEAD USAGE POINTER.
   05 BI-OUT-TAIL USAGE POINTER.
01 BI-REM.
   05 BI-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 BI-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 BI-REM-HEAD USAGE POINTER.
   05 BI-REM-TAIL USAGE POINTER.
01 BI-CMP PIC S9(4) COMP-5 VALUE 0.
01 BI-STATUS PIC 9(4) COMP-5 VALUE 0.
01 LOCAL-RUN PIC 9(4) COMP-5 VALUE 0.
01 LOCAL-FAILED PIC 9(4) COMP-5 VALUE 0.
01 EXPECTED PIC X(8192) VALUE SPACES.
01 EXPECTED-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-ARENA-O1-HITS PIC 9(18) COMP-5 VALUE 0.
01 WS-ARENA-SCAN-STEPS PIC 9(18) COMP-5 VALUE 0.
01 WS-MUL-SMALL-HITS PIC 9(18) COMP-5 VALUE 0.
01 WS-DIV-SMALL-HITS PIC 9(18) COMP-5 VALUE 0.
01 WS-MUL-FWD-HITS PIC 9(18) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    SET BI-A-HEAD TO NULL
    SET BI-A-TAIL TO NULL
    SET BI-B-HEAD TO NULL
    SET BI-B-TAIL TO NULL
    SET BI-OUT-HEAD TO NULL
    SET BI-OUT-TAIL TO NULL
    SET BI-REM-HEAD TO NULL
    SET BI-REM-TAIL TO NULL

    DISPLAY "PHASE=BIGINT_ARENA_BEGIN"
    MOVE "ARENA-BEGIN" TO BI-OP
    PERFORM CALL-SERVICE
    IF BI-STATUS = 0
        DISPLAY "PHASE=BIGINT_ARENA_READY"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_PARSE_M_BEGIN"
        PERFORM TEST-PARSE-M
        DISPLAY "PHASE=BIGINT_PARSE_M_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_PARSE_SINGLE_DIGIT_BEGIN"
        PERFORM TEST-PARSE-SINGLE-DIGIT
        DISPLAY "PHASE=BIGINT_PARSE_SINGLE_DIGIT_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_PARSE_EIGHT_DIGITS_BEGIN"
        PERFORM TEST-PARSE-EIGHT-DIGITS
        DISPLAY "PHASE=BIGINT_PARSE_EIGHT_DIGITS_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_PARSE_LEADING_ZEROS_BEGIN"
        PERFORM TEST-PARSE-LEADING-ZEROS
        DISPLAY "PHASE=BIGINT_PARSE_LEADING_ZEROS_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_PARSE_BASE_BOUNDARY_BEGIN"
        PERFORM TEST-PARSE-BASE-BOUNDARY
        DISPLAY "PHASE=BIGINT_PARSE_BASE_BOUNDARY_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_ADD_M_BEGIN"
        PERFORM TEST-ADD-M
        DISPLAY "PHASE=BIGINT_ADD_M_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_MULTIPLY_BASE_BEGIN"
        PERFORM TEST-MULTIPLY-BASE
        DISPLAY "PHASE=BIGINT_MULTIPLY_BASE_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_MULTIPLY_NEGATIVE_BEGIN"
        PERFORM TEST-MULTIPLY-NEGATIVE
        DISPLAY "PHASE=BIGINT_MULTIPLY_NEGATIVE_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_MULTIPLY_MULTI_CHUNK_BEGIN"
        PERFORM TEST-MULTIPLY-MULTI-CHUNK
        DISPLAY "PHASE=BIGINT_MULTIPLY_MULTI_CHUNK_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_MULTIPLY_FWD_ARRAY_BEGIN"
        PERFORM TEST-MULTIPLY-FWD-ARRAY
        DISPLAY "PHASE=BIGINT_MULTIPLY_FWD_ARRAY_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_MULTIPLY_SMALL_DIRECT_BEGIN"
        PERFORM TEST-MULTIPLY-SMALL-DIRECT
        DISPLAY "PHASE=BIGINT_MULTIPLY_SMALL_DIRECT_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_DIVIDE_BASE_BEGIN"
        PERFORM TEST-DIVIDE-BASE
        DISPLAY "PHASE=BIGINT_DIVIDE_BASE_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_DIVIDE_SMALL_BEGIN"
        PERFORM TEST-DIVIDE-SMALL-DIRECT
        DISPLAY "PHASE=BIGINT_DIVIDE_SMALL_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_DIVIDE_INTERNAL_ZERO_BEGIN"
        PERFORM TEST-DIVIDE-INTERNAL-ZERO
        DISPLAY "PHASE=BIGINT_DIVIDE_INTERNAL_ZERO_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_EUCLIDEAN_NEGATIVE_BEGIN"
        PERFORM TEST-EUCLIDEAN-NEGATIVE
        DISPLAY "PHASE=BIGINT_EUCLIDEAN_NEGATIVE_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_ARENA_O1_UNREGISTER_BEGIN"
        PERFORM TEST-ARENA-O1-UNREGISTER
        DISPLAY "PHASE=BIGINT_ARENA_O1_UNREGISTER_DONE"
        PERFORM PROBE-HEAP

        DISPLAY "PHASE=BIGINT_ARENA_END_BEGIN"
        MOVE "ARENA-END" TO BI-OP
        PERFORM CALL-SERVICE
        DISPLAY "PHASE=BIGINT_ARENA_END_DONE"
        MOVE "HEAP-LIVE" TO BI-OP
        MOVE 0 TO BI-TEXT-LEN
        PERFORM CALL-SERVICE
        ADD 1 TO LOCAL-RUN
        IF BI-STATUS NOT = 0 OR BI-TEXT-LEN NOT = 0
            ADD 1 TO LOCAL-FAILED
            DISPLAY "失败: 任意精度整数测试结束后仍有动态分配存活。"
        END-IF
    END-IF
    ADD LOCAL-RUN TO LK-RUN
    ADD LOCAL-FAILED TO LK-FAILED
    GOBACK.

TEST-PARSE-M.
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    DISPLAY "PHASE=BIGINT_PARSE_M_INIT_BEGIN"
    PERFORM INIT-A
    DISPLAY "PHASE=BIGINT_PARSE_M_INIT_DONE"
    MOVE "170141183460469231731687303715884105727" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    DISPLAY "PHASE=BIGINT_PARSE_M_ASSERT_BEGIN"
    PERFORM ASSERT-A-TEXT
    DISPLAY "PHASE=BIGINT_PARSE_M_ASSERT_DONE".

TEST-PARSE-SINGLE-DIGIT.
    MOVE "7" TO BI-TEXT
    MOVE 1 TO BI-TEXT-LEN
    DISPLAY "PHASE=BIGINT_PARSE_SINGLE_INIT_BEGIN"
    PERFORM INIT-A
    DISPLAY "PHASE=BIGINT_PARSE_SINGLE_INIT_DONE"
    DISPLAY "BIGINT_PARSE_SINGLE_CHUNKS=" BI-A-CHUNKS
    MOVE "7" TO EXPECTED
    MOVE 1 TO EXPECTED-LEN
    DISPLAY "PHASE=BIGINT_PARSE_SINGLE_ASSERT_BEGIN"
    PERFORM ASSERT-A-TEXT
    DISPLAY "PHASE=BIGINT_PARSE_SINGLE_ASSERT_DONE".

TEST-PARSE-EIGHT-DIGITS.
    MOVE "12345678" TO BI-TEXT
    MOVE 8 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "12345678" TO EXPECTED
    MOVE 8 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-PARSE-LEADING-ZEROS.
    MOVE "000000000123" TO BI-TEXT
    MOVE 12 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "123" TO EXPECTED
    MOVE 3 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-PARSE-BASE-BOUNDARY.
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO EXPECTED
    MOVE 10 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-ADD-M.
    *> 每个算术测试自给自足；前面的 parse 回归测试会覆盖 A。
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "ADD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "340282366920938463463374607431768211454" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-MULTIPLY-BASE.
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MUL" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000000000000" TO EXPECTED
    MOVE 19 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-MULTIPLY-NEGATIVE.
    DISPLAY "PHASE=BIGINT_NEGATIVE_PARSE_A_BEGIN"
    MOVE "-12345678901234567890" TO BI-TEXT
    MOVE 21 TO BI-TEXT-LEN
    PERFORM INIT-A
    DISPLAY "PHASE=BIGINT_NEGATIVE_PARSE_A_DONE"
    DISPLAY "PHASE=BIGINT_NEGATIVE_PARSE_B_BEGIN"
    MOVE "3" TO BI-TEXT
    MOVE 1 TO BI-TEXT-LEN
    PERFORM INIT-B
    DISPLAY "PHASE=BIGINT_NEGATIVE_PARSE_B_DONE"
    DISPLAY "PHASE=BIGINT_NEGATIVE_MUL_CALL_BEGIN"
    MOVE "MUL" TO BI-OP
    PERFORM CALL-SERVICE
    DISPLAY "PHASE=BIGINT_NEGATIVE_MUL_CALL_DONE"
    PERFORM OUT-TO-A
    DISPLAY "PHASE=BIGINT_NEGATIVE_RESULT_ASSERT_BEGIN"
    MOVE "-37037036703703703670" TO EXPECTED
    MOVE 21 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    DISPLAY "PHASE=BIGINT_NEGATIVE_RESULT_ASSERT_DONE".

TEST-MULTIPLY-MULTI-CHUNK.
    *> Fix 21 回归：两个 50 位、各 6 个 base-10^9 chunk 的操作数，覆盖多行多列定位。
    MOVE "12345678901234567890123456789012345678901234567890" TO BI-TEXT
    MOVE 50 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "98765432109876543210987654321098765432109876543210" TO BI-TEXT
    MOVE 50 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MUL" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1219326311370217952261850327338667885945115073915611949397448712086533622923332237463801111263526900" TO EXPECTED
    MOVE 100 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-MULTIPLY-FWD-ARRAY.
    *> Fix 33 回归：同一 50×50 位向量通过 forward-array 内部入口必须与 Fix 21/22 结果一致。
    MOVE "12345678901234567890123456789012345678901234567890" TO BI-TEXT
    MOVE 50 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "98765432109876543210987654321098765432109876543210" TO BI-TEXT
    MOVE 50 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MUL-FWD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1219326311370217952261850327338667885945115073915611949397448712086533622923332237463801111263526900" TO EXPECTED
    MOVE 100 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT

    MOVE "MUL-FWD-HITS" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    PERFORM CALL-SERVICE
    MOVE BI-TEXT-LEN TO WS-MUL-FWD-HITS
    DISPLAY "BIGINT_MUL_FWD_ARRAY_HITS=" WS-MUL-FWD-HITS
    ADD 1 TO LOCAL-RUN
    IF BI-STATUS NOT = 0 OR WS-MUL-FWD-HITS < 1
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: forward-array MUL 快速通道未记录命中。"
    END-IF.

TEST-MULTIPLY-SMALL-DIRECT.
    *> Fix 27 回归：直接单标量通道必须与精确十进制乘积一致。
    MOVE "123456789012345678901234567890" TO BI-TEXT
    MOVE 30 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE 5778 TO BI-TEXT-LEN
    MOVE "MUL-SMALL-N" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "713333326913333332691333333268420" TO EXPECTED
    MOVE 33 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT

    MOVE "MUL-SMALL-HITS" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    PERFORM CALL-SERVICE
    MOVE BI-TEXT-LEN TO WS-MUL-SMALL-HITS
    DISPLAY "BIGINT_MUL_SMALL_FAST_HITS=" WS-MUL-SMALL-HITS
    ADD 1 TO LOCAL-RUN
    IF BI-STATUS NOT = 0 OR WS-MUL-SMALL-HITS < 1
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 直接 MUL-SMALL 快速通道未记录命中。"
    END-IF.

TEST-DIVIDE-BASE.
    MOVE "1000000000000000000" TO BI-TEXT
    MOVE 19 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "DIVMOD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000" TO EXPECTED
    MOVE 10 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    PERFORM REM-TO-A
    MOVE "0" TO EXPECTED
    MOVE 1 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-DIVIDE-SMALL-DIRECT.
    MOVE "1000000000000000000" TO BI-TEXT
    MOVE 19 TO BI-TEXT-LEN
    PERFORM INIT-A
    *> Fix 27 回归：数值除数直接通过 BI-TEXT-LEN 传入，不进行文本格式化/解析。
    MOVE 10 TO BI-TEXT-LEN
    MOVE "DIV-SMALL-N" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "100000000000000000" TO EXPECTED
    MOVE 18 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    MOVE "DIV-SMALL-HITS" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    PERFORM CALL-SERVICE
    MOVE BI-TEXT-LEN TO WS-DIV-SMALL-HITS
    DISPLAY "BIGINT_DIV_SMALL_FAST_HITS=" WS-DIV-SMALL-HITS
    ADD 1 TO LOCAL-RUN
    IF BI-STATUS NOT = 0 OR WS-DIV-SMALL-HITS < 1
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 数值 DIV-SMALL 快速通道未记录命中。"
    END-IF.

TEST-DIVIDE-INTERNAL-ZERO.
    MOVE "1000000000000000001000000000" TO BI-TEXT
    MOVE 28 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "1000000000" TO BI-TEXT
    MOVE 10 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "DIVMOD" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "1000000000000000001" TO EXPECTED
    MOVE 19 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT
    PERFORM REM-TO-A
    MOVE "0" TO EXPECTED
    MOVE 1 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-EUCLIDEAN-NEGATIVE.
    MOVE "-1" TO BI-TEXT
    MOVE 2 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "170141183460469231731687303715884105727" TO BI-TEXT
    MOVE 39 TO BI-TEXT-LEN
    PERFORM INIT-B
    MOVE "MOD-EUCLID" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A
    MOVE "170141183460469231731687303715884105726" TO EXPECTED
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-A-TEXT.

TEST-ARENA-O1-UNREGISTER.
    *> 先创建 A，再创建 B；此时 A 的 arena node 不是表头。Fix 26 应通过
    *> head chunk backlink 直接注销 A，而不是从 arena head 线性扫描到 A。
    MOVE "123456789012345678901234567890" TO BI-TEXT
    MOVE 30 TO BI-TEXT-LEN
    PERFORM INIT-A
    MOVE "987654321098765432109876543210" TO BI-TEXT
    MOVE 30 TO BI-TEXT-LEN
    PERFORM INIT-B

    MOVE "FREE-A" TO BI-OP
    PERFORM CALL-SERVICE
    MOVE 0 TO BI-A-SIGN BI-A-CHUNKS
    SET BI-A-HEAD BI-A-TAIL TO NULL
    MOVE "FREE-A" TO BI-OP
    MOVE BI-B-SIGN TO BI-A-SIGN
    MOVE BI-B-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-B-HEAD
    SET BI-A-TAIL TO BI-B-TAIL
    PERFORM CALL-SERVICE
    MOVE 0 TO BI-A-SIGN BI-A-CHUNKS BI-B-SIGN BI-B-CHUNKS
    SET BI-A-HEAD BI-A-TAIL BI-B-HEAD BI-B-TAIL TO NULL

    MOVE "ARENA-O1-HITS" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    PERFORM CALL-SERVICE
    MOVE BI-TEXT-LEN TO WS-ARENA-O1-HITS
    MOVE "ARENA-SCAN-STEPS" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    PERFORM CALL-SERVICE
    MOVE BI-TEXT-LEN TO WS-ARENA-SCAN-STEPS
    DISPLAY "BIGINT_ARENA_O1_HITS=" WS-ARENA-O1-HITS
    DISPLAY "BIGINT_ARENA_SCAN_STEPS=" WS-ARENA-SCAN-STEPS
    ADD 1 TO LOCAL-RUN
    IF WS-ARENA-O1-HITS < 2 OR WS-ARENA-SCAN-STEPS NOT = 0
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: arena O(1) 注销未命中，或正常路径发生了线性扫描。"
    END-IF.

PROBE-HEAP.
    DISPLAY "PHASE=BIGINT_HEAP_LIVE_CALL_BEGIN"
    MOVE "HEAP-LIVE" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    DISPLAY "PHASE=BIGINT_HEAP_LIVE_CALL_DONE"
    DISPLAY "BIGINT_HEAP_LIVE=" BI-TEXT-LEN
    DISPLAY "PHASE=BIGINT_HEAP_PEAK_CALL_BEGIN"
    MOVE "HEAP-PEAK" TO BI-OP
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    DISPLAY "PHASE=BIGINT_HEAP_PEAK_CALL_DONE"
    DISPLAY "BIGINT_HEAP_PEAK=" BI-TEXT-LEN.

INIT-A.
    MOVE "INIT-TEXT" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-A.

INIT-B.
    MOVE "INIT-TEXT" TO BI-OP
    PERFORM CALL-SERVICE
    PERFORM OUT-TO-B.

CALL-SERVICE.
    MOVE 0 TO BI-STATUS BI-CMP
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    IF BI-STATUS NOT = 0
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 任意精度整数服务返回错误状态 " BI-STATUS
    END-IF.

OUT-TO-A.
    MOVE BI-OUT-SIGN TO BI-A-SIGN
    MOVE BI-OUT-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-OUT-HEAD
    SET BI-A-TAIL TO BI-OUT-TAIL
    MOVE 0 TO BI-OUT-SIGN BI-OUT-CHUNKS
    SET BI-OUT-HEAD BI-OUT-TAIL TO NULL.

OUT-TO-B.
    MOVE BI-OUT-SIGN TO BI-B-SIGN
    MOVE BI-OUT-CHUNKS TO BI-B-CHUNKS
    SET BI-B-HEAD TO BI-OUT-HEAD
    SET BI-B-TAIL TO BI-OUT-TAIL
    MOVE 0 TO BI-OUT-SIGN BI-OUT-CHUNKS
    SET BI-OUT-HEAD BI-OUT-TAIL TO NULL.

REM-TO-A.
    MOVE BI-REM-SIGN TO BI-A-SIGN
    MOVE BI-REM-CHUNKS TO BI-A-CHUNKS
    SET BI-A-HEAD TO BI-REM-HEAD
    SET BI-A-TAIL TO BI-REM-TAIL
    MOVE 0 TO BI-REM-SIGN BI-REM-CHUNKS
    SET BI-REM-HEAD BI-REM-TAIL TO NULL.

ASSERT-A-TEXT.
    DISPLAY "PHASE=BIGINT_TO_TEXT_CALL_BEGIN"
    MOVE "TO-TEXT" TO BI-OP
    MOVE SPACES TO BI-TEXT
    MOVE 0 TO BI-TEXT-LEN BI-STATUS
    CALL "BIG-INTEGER-SERVICE" USING BI-OP BI-TEXT BI-TEXT-LEN BI-A BI-B BI-OUT BI-REM BI-CMP BI-STATUS
    DISPLAY "PHASE=BIGINT_TO_TEXT_CALL_DONE"
    ADD 1 TO LOCAL-RUN
    IF BI-STATUS NOT = 0 OR BI-TEXT-LEN NOT = EXPECTED-LEN OR BI-TEXT(1:EXPECTED-LEN) NOT = EXPECTED(1:EXPECTED-LEN)
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: 任意精度整数结果不符合预期。"
        DISPLAY "BIGINT_ACTUAL_STATUS=" BI-STATUS
        DISPLAY "BIGINT_ACTUAL_LEN=" BI-TEXT-LEN
        IF BI-TEXT-LEN > 0 AND BI-TEXT-LEN <= 8192
            DISPLAY "BIGINT_ACTUAL_TEXT=" BI-TEXT(1:BI-TEXT-LEN)
        END-IF
        DISPLAY "BIGINT_EXPECTED_LEN=" EXPECTED-LEN
        DISPLAY "BIGINT_EXPECTED_TEXT=" EXPECTED(1:EXPECTED-LEN)
    END-IF.
END PROGRAM BIG-INTEGER-TESTS.
