>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE03-PATCH-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE SPACES.
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-I PIC 9(4) COMP-5 VALUE 0.
01 WS-PATCH-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-CONTROL-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-UNEXPECTED PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-TABLE.
   05 WS-CASE OCCURS 8 TIMES.
      10 WS-CASE-NAME PIC X(12).
      10 WS-CASE-X PIC X(48).
      10 WS-CASE-WANT PIC X(48).
01 WS-INPUT.
   05 IN-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 IN-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 IN-HEAD USAGE POINTER.
   05 IN-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 OUT-HEAD USAGE POINTER.
   05 OUT-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET IN-HEAD IN-TAIL OUT-HEAD OUT-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    MOVE "M" TO WS-CASE-NAME(1)
    MOVE "170141183460469231731687303715884105727" TO WS-CASE-X(1) WS-CASE-WANT(1)
    MOVE "2M" TO WS-CASE-NAME(2)
    MOVE "340282366920938463463374607431768211454" TO WS-CASE-X(2)
    MOVE "170141183460469231731687303715884105727" TO WS-CASE-WANT(2)
    MOVE "3M" TO WS-CASE-NAME(3)
    MOVE "510423550381407695195061911147652317181" TO WS-CASE-X(3)
    MOVE "170141183460469231731687303715884105727" TO WS-CASE-WANT(3)
    MOVE "M+1" TO WS-CASE-NAME(4)
    MOVE "170141183460469231731687303715884105728" TO WS-CASE-X(4)
    MOVE "1" TO WS-CASE-WANT(4)
    MOVE "ZERO" TO WS-CASE-NAME(5)
    MOVE "0" TO WS-CASE-X(5)
    MOVE "170141183460469231731687303715884105727" TO WS-CASE-WANT(5)
    MOVE "-M" TO WS-CASE-NAME(6)
    MOVE "-170141183460469231731687303715884105727" TO WS-CASE-X(6)
    MOVE "170141183460469231731687303715884105727" TO WS-CASE-WANT(6)
    MOVE "-1" TO WS-CASE-NAME(7) WS-CASE-X(7)
    MOVE "170141183460469231731687303715884105726" TO WS-CASE-WANT(7)
    MOVE "M-1" TO WS-CASE-NAME(8)
    MOVE "170141183460469231731687303715884105726"
      TO WS-CASE-X(8) WS-CASE-WANT(8)

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
        PERFORM CHECK-CASE
    END-PERFORM
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN NOT = 0
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "PATCH01_HEAP_LEAK_OR_STATUS"
    END-IF

    DISPLAY "STAGE3_PATCH_PASS=" WS-PATCH-PASS
    DISPLAY "STAGE3_CONTROL_PASS=" WS-CONTROL-PASS
    DISPLAY "STAGE3_UNEXPECTED_FAILURES=" WS-UNEXPECTED
    IF WS-PATCH-PASS = 6 AND WS-CONTROL-PASS = 2
       AND WS-UNEXPECTED = 0
        DISPLAY "RESULT=PASS_STAGE3_PATCH_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE3_PATCH_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

CHECK-CASE.
    MOVE 0 TO IN-SIGN IN-CHUNKS OUT-SIGN OUT-CHUNKS
    SET IN-HEAD IN-TAIL OUT-HEAD OUT-TAIL TO NULL
    MOVE WS-CASE-X(WS-I) TO WS-TEXT
    COMPUTE WS-TEXT-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-CASE-X(WS-I)))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-EMPTY-A WS-EMPTY-B
        WS-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "PATCH01_INPUT_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    MOVE "SAVE-PATCH" TO WS-ACTION
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-BOOTSTRAP" USING
        WS-ACTION WS-INPUT WS-OUTPUT WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "PATCH01:SAVE-PATCH"
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "PATCH01_ROUTING_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF

    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-TEXT-LEN WS-STATUS
    MOVE "TO-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-TEXT-LEN = 0 OR WS-TEXT-LEN > 48
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "PATCH01_SERIALIZATION_ERROR=" WS-STATUS
        PERFORM RELEASE-CASE
        EXIT PARAGRAPH
    END-IF
    DISPLAY "CASE=" FUNCTION TRIM(WS-CASE-NAME(WS-I))
    DISPLAY "ROUTE=" FUNCTION TRIM(WS-MESSAGE)
    DISPLAY "PATCH_SAVE=" WS-TEXT(1:WS-TEXT-LEN)
    DISPLAY "NORMATIVE_SAVE=" FUNCTION TRIM(WS-CASE-WANT(WS-I))
    IF WS-TEXT-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-CASE-WANT(WS-I)))
        AND WS-TEXT(1:WS-TEXT-LEN) =
            FUNCTION TRIM(WS-CASE-WANT(WS-I))
        IF WS-I = 4 OR WS-I = 8
            ADD 1 TO WS-CONTROL-PASS
            DISPLAY "VERDICT=CONTROL_PASS"
        ELSE
            ADD 1 TO WS-PATCH-PASS
            DISPLAY "VERDICT=PATCH_PASS"
        END-IF
    ELSE
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "VERDICT=UNEXPECTED_RESULT"
    END-IF
    PERFORM RELEASE-CASE.

RELEASE-CASE.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-UNEXPECTED END-IF.
END PROGRAM STAGE03-PATCH-TESTS.
