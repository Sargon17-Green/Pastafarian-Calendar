>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE50-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-RUNS PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-INITIAL PIC 9(4) COMP-5 VALUE 0.
01 WS-QUAD PIC 9(4) COMP-5 VALUE 0.
01 WS-ORDER-COMPLETE PIC 9(4) COMP-5 VALUE 0.
01 WS-REBUILD-COMPLETE PIC 9(4) COMP-5 VALUE 0.
01 WS-MID-HEAP-ZERO PIC 9(4) COMP-5 VALUE 0.
01 WS-FINAL-CLEANUP PIC 9(4) COMP-5 VALUE 0.
01 WS-REJECTS PIC 9(4) COMP-5 VALUE 0.
01 WS-PRESERVED PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-FREES PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-REUSES PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-CYCLES PIC 9(4) COMP-5 VALUE 0.
01 WS-PAIR-SWITCHES PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-FREES PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-REUSES PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-THREE PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-QUADS PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-PROBES PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-ROUND PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-IDX PIC 9(4) COMP-5 VALUE 0.
01 WS-REVERSE-IDX PIC 9(4) COMP-5 VALUE 0.
01 WS-HOLE PIC 9(4) COMP-5 VALUE 0.
01 WS-PROBE-TARGET PIC 9(4) COMP-5 VALUE 0.
01 WS-ROLL-SELECTED PIC 9(4) COMP-5 VALUE 0.
01 WS-TARGET-GROUP.
   05 WS-TARGET-COUNT PIC 9(4) COMP-5 OCCURS 5 TIMES.
01 WS-LIVE PIC 9(4) COMP-5 VALUE 0.
01 WS-PEER PIC 9(4) COMP-5 VALUE 0.
01 WS-PERM-ID PIC 9(4) COMP-5 VALUE 0.
01 WS-STEP PIC 9(4) COMP-5 VALUE 0.
01 WS-ORDER-GROUP.
   05 WS-ORDER PIC 9(4) COMP-5 OCCURS 5 TIMES.
01 WS-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-WIDTH-ID PIC 9(4) COMP-5 VALUE 0.
01 WS-N PIC 9(4) COMP-5 VALUE 0.
01 WS-J PIC 9(4) COMP-5 VALUE 0.
01 WS-SLOT PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST-Y PIC 9(4) COMP-5 VALUE 0.
01 WS-X-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-Y-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-TAIL-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST-TWO PIC 99 VALUE 0.
01 WS-EXPECTED-N PIC 9(4) COMP-5 VALUE 0.
01 WS-EXPECTED-EDIT PIC ZZZ9 VALUE 0.
01 WS-BASE-X PIC X(8192) VALUE SPACES.
01 WS-BASE-Y PIC X(8192) VALUE SPACES.
01 WS-BASE-C PIC X(8192) VALUE SPACES.
01 WS-BASE-T PIC X(8192) VALUE SPACES.
01 WS-C-LITERAL PIC X(8192) VALUE SPACES.
01 WS-T-LITERAL PIC X(8192) VALUE SPACES.
01 WS-EXPECTED-GROUP.
   05 WS-EXPECTED PIC X(8192) OCCURS 5 TIMES.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-INPUT-BEFORE.
   05 CB-SIGN PIC S9(4) COMP-5.
   05 CB-CHUNKS PIC 9(18) COMP-5.
   05 CB-HEAD USAGE POINTER.
   05 CB-TAIL USAGE POINTER.
   05 TB-SIGN PIC S9(4) COMP-5.
   05 TB-CHUNKS PIC 9(18) COMP-5.
   05 TB-HEAD USAGE POINTER.
   05 TB-TAIL USAGE POINTER.
01 WS-OUTPUT-GROUP.
   05 WS-OUTPUT OCCURS 5 TIMES.
      10 O-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 O-HEAD USAGE POINTER.
      10 O-TAIL USAGE POINTER.
01 WS-OUTPUT-ALIAS BASED.
   05 OA-SIGN PIC S9(4) COMP-5.
   05 OA-CHUNKS PIC 9(18) COMP-5.
   05 OA-HEAD USAGE POINTER.
   05 OA-TAIL USAGE POINTER.
01 WS-SNAP-GROUP.
   05 WS-SNAP OCCURS 5 TIMES.
      10 S-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 S-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 S-HEAD USAGE POINTER.
      10 S-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.


01 WS-MUT-X PIC X(8192) VALUE SPACES.
01 WS-MUT-Y PIC X(8192) VALUE SPACES.
01 WS-MUT-C PIC X(8192) VALUE SPACES.
01 WS-MUT-T PIC X(8192) VALUE SPACES.
01 WS-PROBE-LITERAL PIC X(8192) VALUE SPACES.
01 WS-PROBE-C.
   05 P-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 P-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 P-HEAD USAGE POINTER.
   05 P-TAIL USAGE POINTER.
01 WS-INPUT-REBUILDS PIC 9(4) COMP-5 VALUE 0.
01 WS-PRESERVED-OUTPUTS PIC 9(4) COMP-5 VALUE 0.
01 WS-SURVIVORS-FREE PIC 9(4) COMP-5 VALUE 0.
01 WS-SURVIVORS-REUSE PIC 9(4) COMP-5 VALUE 0.
01 WS-NEW-OUTPUTS PIC 9(4) COMP-5 VALUE 0.
01 WS-RESTORED-OUTPUTS PIC 9(4) COMP-5 VALUE 0.
01 WS-RESTORED-SNAPSHOTS PIC 9(4) COMP-5 VALUE 0.
01 WS-OCCUPIED-REJECTS PIC 9(4) COMP-5 VALUE 0.
01 WS-REJECT-PRESERVED PIC 9(4) COMP-5 VALUE 0.
01 WS-SELECTED PIC 9(4) COMP-5 VALUE 0.
01 WS-MUTATED PIC 9 VALUE 0.
01 WS-REVERSE-PAIR PIC 9 VALUE 0.


PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL P-HEAD P-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        SET O-HEAD(WS-SLOT) O-TAIL(WS-SLOT)
            S-HEAD(WS-SLOT) S-TAIL(WS-SLOT) TO NULL
    END-PERFORM
    PERFORM VARYING WS-WIDTH-ID FROM 1 BY 1
        UNTIL WS-WIDTH-ID > 5
        EVALUATE WS-WIDTH-ID
            WHEN 1 MOVE 3 TO WS-N
            WHEN 2 MOVE 9 TO WS-N
            WHEN 3 MOVE 320 TO WS-N
            WHEN 4 MOVE 320 TO WS-N
            WHEN 5 MOVE 8192 TO WS-N
        END-EVALUATE
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 5
            PERFORM PREPARE-CASE
            PERFORM PREPARE-MUTATED
            PERFORM RUN-CASE
        END-PERFORM
    END-PERFORM
    PERFORM MEASURE-HEAP
    DISPLAY "STAGE50_INITIAL_OWNERS=" WS-INITIAL
    DISPLAY "STAGE50_INPUT_REBUILDS=" WS-INPUT-REBUILDS
    DISPLAY "STAGE50_PRESERVED_AFTER_INPUT_CHANGE="
        WS-PRESERVED-OUTPUTS
    DISPLAY "STAGE50_SURVIVORS_AFTER_FREE=" WS-SURVIVORS-FREE
    DISPLAY "STAGE50_SURVIVORS_AFTER_REUSE=" WS-SURVIVORS-REUSE
    DISPLAY "STAGE50_REPLACEMENT_OWNERS=" WS-NEW-OUTPUTS
    DISPLAY "STAGE50_RESTORED_OWNERS=" WS-RESTORED-OUTPUTS
    DISPLAY "STAGE50_RESTORED_SNAPSHOTS=" WS-RESTORED-SNAPSHOTS
    DISPLAY "STAGE50_OCCUPIED_REJECTS=" WS-OCCUPIED-REJECTS
    DISPLAY "STAGE50_PRESERVED_AFTER_REJECT=" WS-REJECT-PRESERVED
    DISPLAY "STAGE50_TARGET_SLOT_1=" WS-TARGET-COUNT(1)
    DISPLAY "STAGE50_TARGET_SLOT_2=" WS-TARGET-COUNT(2)
    DISPLAY "STAGE50_TARGET_SLOT_3=" WS-TARGET-COUNT(3)
    DISPLAY "STAGE50_TARGET_SLOT_4=" WS-TARGET-COUNT(4)
    DISPLAY "STAGE50_TARGET_SLOT_5=" WS-TARGET-COUNT(5)
    DISPLAY "STAGE50_FINAL_CLEANUP=" WS-FINAL-CLEANUP
    DISPLAY "STAGE50_RUNS=" WS-RUNS
    DISPLAY "STAGE50_PASS=" WS-PASS
    DISPLAY "STAGE50_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE50_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 25 AND WS-PASS = 25 AND WS-FAIL = 0
       AND WS-INITIAL = 125 AND WS-INPUT-REBUILDS = 100
       AND WS-PRESERVED-OUTPUTS = 125
       AND WS-SURVIVORS-FREE = 100
       AND WS-SURVIVORS-REUSE = 100
       AND WS-NEW-OUTPUTS = 25
       AND WS-RESTORED-OUTPUTS = 25
       AND WS-RESTORED-SNAPSHOTS = 125
       AND WS-OCCUPIED-REJECTS = 25
       AND WS-REJECT-PRESERVED = 125
       AND WS-TARGET-COUNT(1) = 5
       AND WS-TARGET-COUNT(2) = 5
       AND WS-TARGET-COUNT(3) = 5
       AND WS-TARGET-COUNT(4) = 5
       AND WS-TARGET-COUNT(5) = 5
       AND WS-FINAL-CLEANUP = 25 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE50_FIVE_SIGNED_OUTPUTS_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE50_FIVE_SIGNED_OUTPUTS_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.
PREPARE-MUTATED.
    *> Negative 8192-digit magnitudes exceed signed INIT-TEXT.
    *> Initialize unsigned magnitude, then set descriptor sign -1.
    MOVE SPACES TO WS-MUT-C WS-MUT-T
    MOVE ALL "0" TO WS-MUT-C(1:WS-N)
    MOVE "1" TO WS-MUT-C(1:1)
    COMPUTE WS-LAST-TWO = 3 * WS-J + 2
    MOVE WS-LAST-TWO TO WS-MUT-C(WS-X-POS:2)
    MOVE ALL "9" TO WS-MUT-T(1:WS-LAST-Y)
    COMPUTE WS-LAST-TWO = 100 - (WS-J + 1)
    MOVE WS-LAST-TWO TO WS-MUT-T(WS-Y-POS:2).


RUN-CASE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-CASE-FAIL WS-MUTATED WS-REVERSE-PAIR
    MOVE WS-BASE-C TO WS-C-LITERAL
    MOVE WS-BASE-T TO WS-T-LITERAL
    PERFORM INITIALIZE-PAIR
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-SLOT FROM 1 BY 1
            UNTIL WS-SLOT > 5
            PERFORM SET-EXPECTED
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL = 0 ADD 5 TO WS-INITIAL END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM RELEASE-PAIR-ORDER
        MOVE 1 TO WS-MUTATED
        MOVE WS-MUT-C TO WS-C-LITERAL
        MOVE WS-MUT-T TO WS-T-LITERAL
        PERFORM INITIALIZE-PAIR
        IF WS-CASE-FAIL = 0
            ADD 2 TO WS-INPUT-REBUILDS
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
            IF WS-CASE-FAIL = 0
                ADD 5 TO WS-PRESERVED-OUTPUTS
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        COMPUTE WS-SELECTED =
            FUNCTION MOD(WS-RUNS - 1, 5) + 1
        ADD 1 TO WS-TARGET-COUNT(WS-SELECTED)
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM PROBE-OCCUPIED
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM RELEASE-RESULT
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-FOUR
            IF WS-CASE-FAIL = 0
                ADD 4 TO WS-SURVIVORS-FREE
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM SET-EXPECTED
        PERFORM PRODUCE-SLOT
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
            IF WS-CASE-FAIL = 0
                ADD 4 TO WS-SURVIVORS-REUSE
                ADD 1 TO WS-NEW-OUTPUTS
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE 1 TO WS-REVERSE-PAIR
        PERFORM RELEASE-PAIR-ORDER
        MOVE 0 TO WS-MUTATED
        MOVE WS-BASE-C TO WS-C-LITERAL
        MOVE WS-BASE-T TO WS-T-LITERAL
        PERFORM INITIALIZE-PAIR
        IF WS-CASE-FAIL = 0
            ADD 2 TO WS-INPUT-REBUILDS
            PERFORM CHECK-DISTINCT
            PERFORM CHECK-INPUT-PRESERVED
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-SELECTED TO WS-SLOT
        PERFORM RELEASE-RESULT
        IF WS-CASE-FAIL = 0
            PERFORM SET-EXPECTED
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-DISTINCT
                PERFORM CHECK-INPUT-PRESERVED
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-RESTORED-OUTPUTS
                    ADD 5 TO WS-RESTORED-SNAPSHOTS
                END-IF
            END-IF
        END-IF
    END-IF
    PERFORM CLEANUP-CASE
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE50_CASE_FAILED=" WS-RUNS
    END-IF.

INITIALIZE-PAIR.
    IF C-HEAD NOT = NULL OR T-HEAD NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_DIRTY_INPUT_PAIR=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-C
    IF WS-STATUS NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_C_INIT_FAILED=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-T
    IF WS-STATUS NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_T_INIT_FAILED=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    PERFORM SNAPSHOT-INPUTS
    PERFORM CHECK-INPUT-PRESERVED.

SNAPSHOT-INPUTS.
    MOVE C-SIGN TO CB-SIGN
    MOVE C-CHUNKS TO CB-CHUNKS
    SET CB-HEAD TO C-HEAD
    SET CB-TAIL TO C-TAIL
    MOVE T-SIGN TO TB-SIGN
    MOVE T-CHUNKS TO TB-CHUNKS
    SET TB-HEAD TO T-HEAD
    SET TB-TAIL TO T-TAIL.

SET-EXPECTED.
    MOVE SPACES TO WS-EXPECTED(WS-SLOT)
    MOVE ALL "0" TO WS-EXPECTED(WS-SLOT)(1:WS-N)
    MOVE "2" TO WS-EXPECTED(WS-SLOT)(1:1)
    IF WS-MUTATED = 0
        COMPUTE WS-LAST-TWO = 2 * WS-J + 3 + WS-SLOT - 1
    ELSE
        COMPUTE WS-LAST-TWO = 2 * WS-J + 2 + WS-SLOT - 1
    END-IF
    MOVE WS-LAST-TWO
        TO WS-EXPECTED(WS-SLOT)(WS-X-POS:2).


PREPARE-PROBE.
    MOVE SPACES TO WS-PROBE-LITERAL
    IF WS-MUTATED = 0
        MOVE WS-BASE-C TO WS-PROBE-LITERAL
        COMPUTE WS-LAST-TWO = 4 * WS-J + 3 + WS-SLOT - 1
    ELSE
        MOVE WS-MUT-C TO WS-PROBE-LITERAL
        COMPUTE WS-LAST-TWO = 3 * WS-J + 2 + WS-SLOT - 1
    END-IF
    MOVE WS-LAST-TWO TO WS-PROBE-LITERAL(WS-X-POS:2).


INIT-PROBE.
    IF P-HEAD NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_PROBE_DIRTY=" WS-RUNS
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(WS-PROBE-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-PROBE-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-PROBE-C WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR P-HEAD = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_PROBE_INIT_FAILED=" WS-RUNS
    ELSE
        IF WS-MUTATED = 1 MOVE -1 TO P-SIGN END-IF
    END-IF.


PRODUCE-SLOT.
    PERFORM PREPARE-PROBE
    PERFORM INIT-PROBE
    IF WS-CASE-FAIL = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-PROBE-C WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 0 AND
            WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
            PERFORM SNAPSHOT-SLOT
            PERFORM CHECK-SLOT
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_PATCH_CALL_FAILED="
                WS-RUNS ":" WS-SLOT ":" WS-STATUS
        END-IF
    END-IF
    PERFORM RELEASE-PROBE
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-INPUT-PRESERVED
    END-IF.

PROBE-OCCUPIED.
    PERFORM PREPARE-PROBE
    PERFORM INIT-PROBE
    IF WS-CASE-FAIL = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-PROBE-C WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 175
            ADD 1 TO WS-OCCUPIED-REJECTS
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_OCCUPIED_STATUS_FAILED="
                WS-RUNS ":" WS-STATUS
        END-IF
    END-IF
    PERFORM RELEASE-PROBE
    IF WS-CASE-FAIL = 0
        PERFORM CHECK-DISTINCT
        PERFORM CHECK-INPUT-PRESERVED
        IF WS-CASE-FAIL = 0
            ADD 5 TO WS-REJECT-PRESERVED
        END-IF
    END-IF.

RELEASE-PROBE.
    IF P-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-PROBE-C WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR P-HEAD NOT = NULL
           OR P-TAIL NOT = NULL OR P-SIGN NOT = 0
           OR P-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_PROBE_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CHECK-FOUR.
    MOVE 0 TO WS-LIVE
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            ADD 1 TO WS-LIVE
            IF WS-SLOT = WS-SELECTED
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-PERFORM
    IF WS-LIVE NOT = 4
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_FOUR_SURVIVORS_FAILED=" WS-RUNS
    END-IF
    PERFORM CHECK-SURVIVORS.

RELEASE-PAIR-ORDER.
    IF WS-REVERSE-PAIR = 0
        IF WS-J = 1 OR 3 OR 5
            PERFORM RELEASE-C
            PERFORM RELEASE-T
        ELSE
            PERFORM RELEASE-T
            PERFORM RELEASE-C
        END-IF
    ELSE
        IF WS-J = 1 OR 3 OR 5
            PERFORM RELEASE-T
            PERFORM RELEASE-C
        ELSE
            PERFORM RELEASE-C
            PERFORM RELEASE-T
        END-IF
    END-IF.

RELEASE-C.
    IF C-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR C-HEAD NOT = NULL
           OR C-TAIL NOT = NULL OR C-SIGN NOT = 0
           OR C-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_C_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

RELEASE-T.
    IF T-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR T-HEAD NOT = NULL
           OR T-TAIL NOT = NULL OR T-SIGN NOT = 0
           OR T-CHUNKS NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_T_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.

CLEANUP-CASE.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM RELEASE-RESULT
        END-IF
    END-PERFORM
    PERFORM RELEASE-PROBE
    PERFORM RELEASE-C
    PERFORM RELEASE-T
    PERFORM MEASURE-HEAP
    IF WS-STATUS NOT = 0 OR WS-HEAP NOT = 0
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_HEAP_FAILED=" WS-RUNS
    END-IF
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-FINAL-CLEANUP
    END-IF.

MEASURE-HEAP.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
        DISPLAY "STAGE50_HEAP_MEASURED=YES"
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_HEAP_PROBE_FAILED=" WS-STATUS
    END-IF.

PREPARE-CASE.
    MOVE SPACES TO WS-BASE-C WS-BASE-T WS-BASE-Y
    MOVE ALL "0" TO WS-BASE-C(1:WS-N)
    MOVE "1" TO WS-BASE-C(1:1)
    COMPUTE WS-LAST-Y = WS-N - 1
    COMPUTE WS-X-POS = WS-N - 1
    COMPUTE WS-Y-POS = WS-N - 2
    COMPUTE WS-LAST-TWO = 4 * WS-J + 3
    MOVE WS-LAST-TWO TO WS-BASE-C(WS-X-POS:2)
    MOVE ALL "9" TO WS-BASE-Y(1:WS-LAST-Y)
    COMPUTE WS-LAST-TWO = 100 - (2 * WS-J + 1)
    MOVE WS-LAST-TWO TO WS-BASE-Y(WS-Y-POS:2)
    MOVE "-" TO WS-BASE-T(1:1)
    MOVE WS-BASE-Y(1:WS-LAST-Y)
        TO WS-BASE-T(2:WS-LAST-Y).


INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-MUTATED = 1
        MOVE -1 TO C-SIGN
    END-IF.


INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.


CHECK-INPUT-PRESERVED.
    IF C-SIGN NOT = CB-SIGN OR C-CHUNKS NOT = CB-CHUNKS
       OR C-HEAD NOT = CB-HEAD OR C-TAIL NOT = CB-TAIL
       OR T-SIGN NOT = TB-SIGN OR T-CHUNKS NOT = TB-CHUNKS
       OR T-HEAD NOT = TB-HEAD OR T-TAIL NOT = TB-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_INPUT_METADATA_FAILED=" WS-RUNS
    END-IF
    IF WS-CASE-FAIL = 0
        *> Serialize magnitude while temporarily positive, then restore.
        IF WS-MUTATED = 1 MOVE 1 TO C-SIGN END-IF
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-MUTATED = 1 MOVE -1 TO C-SIGN END-IF
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
            FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
            MOVE 1 TO WS-CASE-FAIL
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
                FUNCTION TRIM(WS-C-LITERAL)
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
            FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
            MOVE 1 TO WS-CASE-FAIL
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
                FUNCTION TRIM(WS-T-LITERAL)
                MOVE 1 TO WS-CASE-FAIL
            END-IF
        END-IF
    END-IF
    IF C-SIGN NOT = CB-SIGN MOVE 1 TO WS-CASE-FAIL END-IF
    IF WS-CASE-FAIL NOT = 0
        DISPLAY "STAGE50_INPUT_PRESERVATION_FAILED=" WS-RUNS
    END-IF.


SNAPSHOT-SLOT.
    MOVE O-SIGN(WS-SLOT) TO S-SIGN(WS-SLOT)
    MOVE O-CHUNKS(WS-SLOT) TO S-CHUNKS(WS-SLOT)
    SET S-HEAD(WS-SLOT) TO O-HEAD(WS-SLOT)
    SET S-TAIL(WS-SLOT) TO O-TAIL(WS-SLOT).


CHECK-SLOT.
    IF O-HEAD(WS-SLOT) = NULL
       OR O-SIGN(WS-SLOT) NOT = S-SIGN(WS-SLOT)
       OR O-CHUNKS(WS-SLOT) NOT = S-CHUNKS(WS-SLOT)
       OR O-HEAD(WS-SLOT) NOT = S-HEAD(WS-SLOT)
       OR O-TAIL(WS-SLOT) NOT = S-TAIL(WS-SLOT)
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_METADATA_FAILED=" WS-RUNS ":" WS-SLOT
    END-IF
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-LEN NOT =
           FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED(WS-SLOT)))
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_TEXT_LENGTH_FAILED=" WS-RUNS ":" WS-SLOT
    ELSE
        IF WS-TEXT(1:WS-LEN) NOT =
               FUNCTION TRIM(WS-EXPECTED(WS-SLOT))
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_ORACLE_FAILED=" WS-RUNS ":" WS-SLOT
        END-IF
    END-IF.



CHECK-SURVIVORS.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM VARYING WS-PEER FROM 1 BY 1
                UNTIL WS-PEER >= WS-SLOT
                IF O-HEAD(WS-PEER) NOT = NULL AND
                   O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                    MOVE 1 TO WS-CASE-FAIL
                    DISPLAY "STAGE50_SHARED_LIVE_HEAD=" WS-RUNS
                END-IF
            END-PERFORM
            PERFORM CHECK-SLOT
        END-IF
    END-PERFORM.


CHECK-DISTINCT.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 5
        IF O-HEAD(WS-SLOT) = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE50_NULL_HEAD_FAILED=" WS-RUNS
        END-IF
        PERFORM VARYING WS-PEER FROM 1 BY 1
            UNTIL WS-PEER >= WS-SLOT
            IF O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE50_SHARED_HEAD_FAILED=" WS-RUNS
            END-IF
        END-PERFORM
        PERFORM CHECK-SLOT
    END-PERFORM.


RELEASE-RESULT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN(WS-SLOT) NOT = 0
       OR O-CHUNKS(WS-SLOT) NOT = 0
       OR O-HEAD(WS-SLOT) NOT = NULL
       OR O-TAIL(WS-SLOT) NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE50_OUTPUT_FREE_FAILED="
            WS-RUNS ":" WS-SLOT
    END-IF.


END PROGRAM STAGE50-DISCOVERY-TESTS.
