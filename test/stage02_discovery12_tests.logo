; D12 native: 1 valid (5+11+1 checks) + 4 invalid = 21 checks; independent 1..25 oracle.
load "src/exact_integer.logo
load "src/source_language_catalog.logo
load "src/monster_bootstrap.logo
load "src/stage02_boundary.logo
load "src/stage02_context.logo
load "src/stage02_counts.logo
load "src/stage02_stones.logo
load "src/stage02_hidden.logo
load "src/stage02_visible_prefix.logo
load "src/stage02_visible_ten.logo
load "src/stage02_visible_fifteen.logo
load "src/stage02_visible_twenty.logo
load "src/stage02_visible_twentyfive.logo
load "test/normative_reference.logo
make "D12.N 0
make "D12.CASES 0
make "D12.FAIL "false

to d12.require :ok :tag
  make "D12.N (:D12.N + 1)
  if not :ok [
    make "D12.FAIL "true
    print sentence [STAGE_2_DISCOVERY_12_TESTO_FALIIS:] :tag
  ]
end

to d12.same :a :b :keys
  if emptyp :keys [output "true]
  if not (equalp (monster.context.get :a first :keys) (monster.context.get :b first :keys)) [output "false]
  output d12.same :a :b (butfirst :keys)
end

to d12.take :n :values
  if :n = 0 [output []]
  output fput (first :values) (d12.take (:n - 1) (butfirst :values))
end

to d12.oracle.twentyfive :i :counts :stones :hidden :acc
  if :i > 25 [output :acc]
  localmake "v nr.visible.one :i :counts :stones :hidden :acc
  output d12.oracle.twentyfive (:i + 1) :counts :stones :hidden (lput :v :acc)
end

to d12.check.tail :i :actual :expected :tag
  if :i > 25 [stop]
  d12.require (equalp (item :i :actual) (item :i :expected)) (list :tag :i)
  d12.check.tail (:i + 1) :actual :expected :tag
end

to d12.valid :calculation :target :tag
  print sentence [STAGE_2_DISCOVERY_12_CASE_BEGIN] :tag
  localmake "before monster.stage02.visible.twenty (monster.stage02.visible.fifteen (monster.stage02.visible.ten (monster.stage02.visible.prefix (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts :calculation :target))))))
  localmake "after monster.stage02.visible.twentyfive :before
  localmake "actual monster.context.get :after "visibleTwentyFive
  localmake "counts nr.work.counts :calculation :target
  localmake "stones nr.stones
  localmake "hidden nr.hidden.build :counts :stones
  localmake "expected d12.oracle.twentyfive 1 :counts :stones :hidden []
  make "D12.CASES (:D12.CASES + 1)
  if (count :actual) <> 25 [print [STAGE_2_DISCOVERY_12_SHAPE_FALIIS] stop]
  if (count :expected) <> 25 [print [STAGE_2_DISCOVERY_12_ORACLE_SHAPE_FALIIS] stop]
  d12.check.tail 21 :actual :expected :tag
  d12.require (equalp (monster.context.get :after "calculationDay) :calculation) (list :tag [calculation])
  d12.require (equalp (monster.context.get :after "targetDay) :target) (list :tag [target])
  d12.require (d12.same :before :after [normalizedCalculationDay normalizedTargetDay actionCount targetCount distanceCount connectionCount directionCount]) (list :tag [counts])
  d12.require (equalp (monster.context.get :after "stoneSeries) (monster.context.get :before "stoneSeries)) (list :tag [stones])
  d12.require (equalp (monster.context.get :after "hiddenSeeds) (monster.context.get :before "hiddenSeeds)) (list :tag [hidden])
  d12.require (and (d12.same :before :after [visiblePrefix visibleTen visibleFifteen visibleTwenty]) (equalp (d12.take 20 :actual) (monster.context.get :before "visibleTwenty))) (list :tag [prefix])
  d12.require (equalp (monster.context.get :after "phase) "VISIBLE_TWENTYFIVE_READY) (list :tag [phase])
  d12.require (equalp (monster.context.get :after "mode) "STAGE_2_DISCOVERY_12) (list :tag [mode])
  d12.require (equalp (monster.context.get :after "status) "VISIBLE_TWENTYFIVE_ONLY) (list :tag [status])
  d12.require (equalp (monster.context.get :after "metrics) [stage02.dispatch stage02.counts stage02.stones stage02.hidden stage02.visible stage02.visible.ten stage02.visible.fifteen stage02.visible.twenty stage02.visible.twentyfive]) (list :tag [metrics])
  d12.require (equalp (monster.context.get :after "logs) [stage02.enter stage02.normalized stage02.counts.ready stage02.stones.ready stage02.hidden.ready stage02.visible.prefix.ready stage02.visible.ten.ready stage02.visible.fifteen.ready stage02.visible.twenty.ready stage02.visible.twentyfive.ready]) (list :tag [logs])
  d12.require (equalp (monster.stage02.visible.twentyfive :before) :after) (list :tag [determinism])
  print sentence [STAGE_2_DISCOVERY_12_CASE_END] :tag
  output :before
end

to d12.invalid :ctx :tag
  print sentence [STAGE_2_DISCOVERY_12_CASE_BEGIN] :tag
  make "D12.CASES (:D12.CASES + 1)
  d12.require (equalp (monster.stage02.visible.twentyfive :ctx) :ctx) :tag
  print sentence [STAGE_2_DISCOVERY_12_CASE_END] :tag
end

to stage02.discovery12.run
  localmake "prefix d12.valid (nr.foundation) (nr.tablets) [foundation_tablets]
  d12.invalid (monster.stage02.workcounts [0 [1]] [0 [0]]) [failed_validation]
  d12.invalid (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts [0 [0]] [1 [1]]))) [hidden_only]
  d12.invalid (monster.context.put :prefix "visibleTwenty (d12.take 19 (monster.context.get :prefix "visibleTwenty))) [short_nineteen]
  d12.invalid (monster.context.put :prefix "visibleTwenty "bad) [not_a_list]
  if :D12.FAIL [print [STAGE_2_DISCOVERY_12_FALIIS] stop]
  if :D12.CASES <> 5 [print [STAGE_2_DISCOVERY_12_CASE_COUNT_FALIIS] stop]
  if :D12.N <> 21 [print [STAGE_2_DISCOVERY_12_CHECK_COUNT_FALIIS] stop]
  print sentence [STAGE_2_DISCOVERY_12_CASES_PASIS] :D12.CASES
  print sentence [STAGE_2_DISCOVERY_12_CHECKS_PASIS] :D12.N
  print [STAGE_2_DISCOVERY_12_PASIS]
end

stage02.discovery12.run
