    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
