>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. NORMATIVE-PRIMITIVE-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 ACTION-NAME PIC X(16).
01 INPUT-TEXT PIC X(8192).
01 INPUT-LEN PIC 9(18) COMP-5.
01 OUTPUT-TEXT PIC X(8192).
01 OUTPUT-LEN PIC 9(18) COMP-5.
01 STATUS-CODE PIC 9(4) COMP-5.
01 EXPECTED-TEXT PIC X(8192).
01 EXPECTED-LEN PIC 9(18) COMP-5.
01 LOCAL-RUN PIC 9(4) COMP-5 VALUE 0.
01 LOCAL-FAILED PIC 9(4) COMP-5 VALUE 0.

LINKAGE SECTION.
01 LK-RUN PIC 9(4) COMP-5.
01 LK-FAILED PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-RUN LK-FAILED.
MAIN.
    MOVE "SAVE" TO ACTION-NAME

    MOVE "0" TO INPUT-TEXT
    MOVE 1 TO INPUT-LEN
    MOVE "170141183460469231731687303715884105727" TO EXPECTED-TEXT
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-SAVE

    MOVE "170141183460469231731687303715884105727" TO INPUT-TEXT
    MOVE 39 TO INPUT-LEN
    MOVE "170141183460469231731687303715884105727" TO EXPECTED-TEXT
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-SAVE

    MOVE "170141183460469231731687303715884105728" TO INPUT-TEXT
    MOVE 39 TO INPUT-LEN
    MOVE "1" TO EXPECTED-TEXT
    MOVE 1 TO EXPECTED-LEN
    PERFORM ASSERT-SAVE

    MOVE "340282366920938463463374607431768211454" TO INPUT-TEXT
    MOVE 39 TO INPUT-LEN
    MOVE "170141183460469231731687303715884105727" TO EXPECTED-TEXT
    MOVE 39 TO EXPECTED-LEN
    PERFORM ASSERT-SAVE

    ADD LOCAL-RUN TO LK-RUN
    ADD LOCAL-FAILED TO LK-FAILED
    GOBACK.

ASSERT-SAVE.
    MOVE SPACES TO OUTPUT-TEXT
    MOVE 0 TO OUTPUT-LEN STATUS-CODE
    CALL "NORMATIVE-BIGINT-PRIMITIVES" USING ACTION-NAME INPUT-TEXT INPUT-LEN OUTPUT-TEXT OUTPUT-LEN STATUS-CODE
    ADD 1 TO LOCAL-RUN
    IF STATUS-CODE NOT = 0 OR OUTPUT-LEN NOT = EXPECTED-LEN OR OUTPUT-TEXT(1:EXPECTED-LEN) NOT = EXPECTED-TEXT(1:EXPECTED-LEN)
        ADD 1 TO LOCAL-FAILED
        DISPLAY "失败: SAVE 边界结果不符合规范。"
    END-IF.
END PROGRAM NORMATIVE-PRIMITIVE-TESTS.
