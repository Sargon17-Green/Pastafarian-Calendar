; D21 full-N QA audit. TEST-ONLY candidate; not full-N production or Stage2 acceptance.
; Vectors are generated independently with Python arbitrary-precision arithmetic.
load "src/exact_integer.logo
load "src/source_language_catalog.logo
load "src/monster_bootstrap.logo
load "src/stage02_boundary.logo
load "src/stage02_context.logo
load "src/stage02_answer_at.logo

make "D21A.CASES 0
make "D21A.CHECKS 0
make "D21A.FAILED "false

to d21a.require :condition :tag
  make "D21A.CHECKS (:D21A.CHECKS + 1)
  if not :condition [
    make "D21A.FAILED "true
    print sentence [D21_FULLN_AUDIT_FALIIS:] :tag
  ]
end

; Test-only model: uses exact BI quotient, multiple and remainder, plus accepted D20 indexed stream.
; k=0..31 is an explicit audit horizon, not a general bound for CHOOSE.SHORT.
to d21a.select :stream :N
  localmake "q bi.floor.div nr.M :N
  localmake "limit bi.mul :q :N
  output d21a.scan :stream :N :limit 0
end

to d21a.scan :stream :N :limit :k
  if :k > 31 [output []]
  localmake "x monster.stage02.answer.at :stream :k
  if bi.le :x :limit [
    localmake "rank bi.add (bi.small 1) (bi.regmod (bi.sub :x (bi.small 1)) :N)
    output (list :rank :k)
  ]
  output d21a.scan :stream :N :limit (:k + 1)
end

; Python oracle uses independent native integers and an iterative +/-1 walker.
to d21a.case :N :firstv :dir :expectedQ :expectedR :expectedK :expectedRank :tag
  make "D21A.CASES (:D21A.CASES + 1)
  localmake "qr bi.divmod.floor nr.M :N
  localmake "q first :qr
  localmake "r last :qr
  d21a.require (bi.eq :q :expectedQ) (list :tag [quotient])
  d21a.require (bi.eq :r :expectedR) (list :tag [remainder])
  d21a.require (bi.eq (bi.add (bi.mul :q :N) :r) nr.M) (list :tag [reconstruction])
  d21a.require (and (bi.ge :r bi.zero) (bi.lt :r :N)) (list :tag [euclidean_bounds])
  localmake "stream (list :firstv :dir)
  localmake "actual d21a.select :stream :N
  if :expectedK < 0 [
    d21a.require (equalp :actual []) (list :tag [no_hit_within_32])
  ]
  if :expectedK >= 0 [
    d21a.require (not (emptyp :actual)) (list :tag [hit_within_32])
    if (emptyp :actual) [
      d21a.require "false (list :tag [rank_missing])
      d21a.require "false (list :tag [index_missing])
    ]
    if not (emptyp :actual) [
      d21a.require (bi.eq (first :actual) :expectedRank) (list :tag [independent_rank])
      d21a.require ((last :actual) = :expectedK) (list :tag [independent_index])
    ]
  ]
  d21a.require (equalp :actual (d21a.select :stream :N)) (list :tag [determinism])
end

to d21a.run
  print [D21_FULLN_AUDIT_STEP python_verified_vectors]
  d21a.case (bi.make 1 [1]) (bi.make 1 [1]) 1 (bi.make 1 [5727 8410 7158 7303 3168 2317 469 8346 1411 170]) (bi.make 1 [0]) 0 (bi.make 1 [1]) [one_one_p]
  d21a.case (bi.make 1 [1]) (bi.make 1 [1]) -1 (bi.make 1 [5727 8410 7158 7303 3168 2317 469 8346 1411 170]) (bi.make 1 [0]) 0 (bi.make 1 [1]) [one_one_m]
