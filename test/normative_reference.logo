to nr.build.structure :calculationDay :year
  localmake "firstDay bi.add nr.year.open.day :year bi.small 1
  localmake "r nr.sauce :calculationDay :firstDay
  localmake "cutletCount nr.choose.cutlet.count :r :year
  localmake "partition nr.choose.cutlet.partition :calculationDay :r :year :cutletCount
  localmake "cutletNames nr.choose.cutlet.names :r :cutletCount
  localmake "cutlets nr.materialize.cutlets :year :partition :cutletNames
  localmake "monthCount nr.choose.month.count :r :year
  localmake "monthLengths nr.choose.month.lengths :r :year :monthCount
  localmake "weave nr.choose.weaving :r :monthLengths
  localmake "monthNames nr.choose.month.names :r :monthCount
  output nr.structure.make :year :cutletCount :partition :cutletNames :cutlets :monthCount :monthLengths :weave :monthNames
end

to nr.find.cutlet :cutlets :targetDay :index
  if emptyp :cutlets [output 0]
  localmake "c first :cutlets
  if and (bi.le (item 4 :c) :targetDay) (bi.le :targetDay (item 5 :c)) [output :index]
  output nr.find.cutlet butfirst :cutlets :targetDay (:index + 1)
end

to nr.count.month.occurrences :weave :limit :monthId :pos :counted
  if :pos > :limit [output :counted]
  localmake "next :counted
  if (item :pos :weave) = :monthId [make "next (:counted + 1)]
  output nr.count.month.occurrences :weave :limit :monthId (:pos + 1) :next
end

to nr.calendar.date :calculationDay :targetDay
  localmake "year nr.find.year :calculationDay :targetDay
  localmake "structure nr.build.structure :calculationDay :year
  localmake "cutlets nr.structure.cutlets :structure
  localmake "cutletId nr.find.cutlet :cutlets :targetDay 1
  if :cutletId = 0 [print [ERORO: la targeto ne esas en koteleto.] stop]
  localmake "cutlet item :cutletId :cutlets
  localmake "dayInCutlet bi.add bi.sub :targetDay item 4 :cutlet bi.small 1
  localmake "offset bi.to.small bi.sub :targetDay bi.add nr.year.open.day :year bi.small 1
  localmake "weave nr.structure.weave :structure
  localmake "monthId item (:offset + 1) :weave
  localmake "monthNameId item :monthId nr.structure.month.names :structure
  localmake "dayInMonth nr.count.month.occurrences :weave (:offset + 1) :monthId 1 0
  output (list
    nr.year.number :year
    source.catalog.cutlet.name item 1 :cutlet
    :dayInCutlet
    source.catalog.month.name :monthNameId
    bi.small :dayInMonth)
end
