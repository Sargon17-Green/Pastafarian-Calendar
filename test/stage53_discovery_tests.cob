>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE53-DISCOVERY-TESTS.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 OP PIC X(16).
01 ACTION-NAME PIC X(16) VALUE "DISTANCE-PATCH".
01 TXT PIC X(8192).
01 TXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 STATUS-CODE PIC 9(4) COMP-5 VALUE 0.
01 COMPARE-CODE PIC S9(4) COMP-5 VALUE 0.
01 MESSAGE-TEXT PIC X(160).
01 HEAP-LIVE PIC 9(18) COMP-5 VALUE 0.
01 CASE-NUM PIC 9(4) COMP-5 VALUE 0.
01 PASSED PIC 9(4) COMP-5 VALUE 0.
01 FAILED PIC 9(4) COMP-5 VALUE 0.
01 BAD PIC 9 VALUE 0.
01 WIDTH-INDEX PIC 9 VALUE 0.
01 N PIC 9(4) COMP-5 VALUE 0.
01 J PIC 9 VALUE 0.
01 SIGN-OF-M PIC S9(4) COMP-5 VALUE 0.
01 SLOT-NUM PIC 9 VALUE 0.
01 PEER-NUM PIC 9 VALUE 0.
01 SELECTED-SLOT PIC 9 VALUE 0.
01 LIVE-COUNT PIC 9 VALUE 0.
01 EXPECTED-LIVE PIC 9 VALUE 5.
01 SMALL-DIGIT PIC 9 VALUE 0.
01 TAIL-DIGITS PIC 99 VALUE 0.
01 MAG PIC X(8192).
01 ZERO-INDEX PIC 9 VALUE 0.
01 ZERO-TEXT PIC X(8192).
01 ZERO-LENGTH PIC 9(18) COMP-5 VALUE 0.
01 C-LITERAL PIC X(8192).
01 T-LITERAL PIC X(8192).
01 C-LENGTH PIC 9(18) COMP-5 VALUE 0.
01 T-LENGTH PIC 9(18) COMP-5 VALUE 0.
01 C-REQUIRED-SIGN PIC S9(4) COMP-5 VALUE 0.
01 T-REQUIRED-SIGN PIC S9(4) COMP-5 VALUE 0.
01 COUNTERS.
   05 INITIAL-OWNERS PIC 9(4) COMP-5 VALUE 0.
   05 ZERO-CANONICAL PIC 9(4) COMP-5 VALUE 0.
   05 INPUT-PRESERVED PIC 9(4) COMP-5 VALUE 0.
   05 OCCUPIED-REJECTS PIC 9(4) COMP-5 VALUE 0.
   05 FREE-SURVIVORS PIC 9(4) COMP-5 VALUE 0.
   05 REUSE-SURVIVORS PIC 9(4) COMP-5 VALUE 0.
   05 REPLACEMENTS PIC 9(4) COMP-5 VALUE 0.
   05 RESTORATIONS PIC 9(4) COMP-5 VALUE 0.
   05 CLEANUPS PIC 9(4) COMP-5 VALUE 0.
   05 HEAP-SAMPLES PIC 9(4) COMP-5 VALUE 0.
01 TARGETS.
   05 TARGET-COUNT PIC 9(4) COMP-5 OCCURS 5 TIMES.
01 TEXT-EXPECTATIONS.
   05 EXPECTED-TEXT PIC X(8192) OCCURS 5 TIMES.
01 INPUT-C.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 INPUT-T.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 INPUT-SNAPSHOT.
   05 CB-SIGN PIC S9(4) COMP-5.
   05 CB-CHUNKS PIC 9(18) COMP-5.
   05 CB-HEAD USAGE POINTER.
   05 CB-TAIL USAGE POINTER.
   05 TB-SIGN PIC S9(4) COMP-5.
   05 TB-CHUNKS PIC 9(18) COMP-5.
   05 TB-HEAD USAGE POINTER.
   05 TB-TAIL USAGE POINTER.
01 OUTPUTS.
   05 OUTPUT-SLOT OCCURS 5 TIMES.
      10 O-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 O-HEAD USAGE POINTER.
      10 O-TAIL USAGE POINTER.
01 OUTPUT-ALIAS BASED.
   05 OA-SIGN PIC S9(4) COMP-5.
   05 OA-CHUNKS PIC 9(18) COMP-5.
   05 OA-HEAD USAGE POINTER.
   05 OA-TAIL USAGE POINTER.
01 SNAPSHOTS.
   05 SNAP-SLOT OCCURS 5 TIMES.
      10 S-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 S-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 S-HEAD USAGE POINTER.
      10 S-TAIL USAGE POINTER.
01 EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL
        CB-HEAD CB-TAIL TB-HEAD TB-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        SET O-HEAD(SLOT-NUM) O-TAIL(SLOT-NUM)
            S-HEAD(SLOT-NUM) S-TAIL(SLOT-NUM) TO NULL
        MOVE 0 TO TARGET-COUNT(SLOT-NUM)
    END-PERFORM
    PERFORM VARYING WIDTH-INDEX FROM 1 BY 1
        UNTIL WIDTH-INDEX > 5
        EVALUATE WIDTH-INDEX
            WHEN 1 MOVE 3 TO N
            WHEN 2 MOVE 9 TO N
            WHEN 3 MOVE 128 TO N
            WHEN 4 MOVE 320 TO N
            WHEN 5 MOVE 8192 TO N
        END-EVALUATE
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > 5
            PERFORM PREPARE-CASE
            PERFORM RUN-CASE
        END-PERFORM
    END-PERFORM
    DISPLAY "STAGE53_RUNS=" CASE-NUM
    DISPLAY "STAGE53_PASS=" PASSED
    DISPLAY "STAGE53_INITIAL_OWNERS=" INITIAL-OWNERS
    DISPLAY "STAGE53_ZERO_CANONICAL=" ZERO-CANONICAL
    DISPLAY "STAGE53_PRESERVED_AFTER_INPUT_CHANGE=" INPUT-PRESERVED
    DISPLAY "STAGE53_OCCUPIED_REJECTS=" OCCUPIED-REJECTS
    DISPLAY "STAGE53_SURVIVORS_AFTER_FREE=" FREE-SURVIVORS
    DISPLAY "STAGE53_SURVIVORS_AFTER_REUSE=" REUSE-SURVIVORS
    DISPLAY "STAGE53_REPLACEMENT_OWNERS=" REPLACEMENTS
    DISPLAY "STAGE53_RESTORED_OWNERS=" RESTORATIONS
    DISPLAY "STAGE53_FINAL_CLEANUP=" CLEANUPS
    DISPLAY "STAGE53_HEAP_SAMPLES=" HEAP-SAMPLES
    DISPLAY "STAGE53_HEAP_LIVE_POST_RELEASE=" HEAP-LIVE
    DISPLAY "STAGE53_TARGET_SLOT_1=" TARGET-COUNT(1)
    DISPLAY "STAGE53_TARGET_SLOT_2=" TARGET-COUNT(2)
    DISPLAY "STAGE53_TARGET_SLOT_3=" TARGET-COUNT(3)
    DISPLAY "STAGE53_TARGET_SLOT_4=" TARGET-COUNT(4)
    DISPLAY "STAGE53_TARGET_SLOT_5=" TARGET-COUNT(5)
    DISPLAY "STAGE53_UNEXPECTED_FAILURES=" FAILED
    IF HEAP-SAMPLES = 25
        DISPLAY "STAGE53_HEAP_MEASURED=YES"
    ELSE
        DISPLAY "STAGE53_HEAP_MEASURED=NO"
    END-IF
    IF CASE-NUM = 25 AND PASSED = 25 AND FAILED = 0
       AND INITIAL-OWNERS = 125 AND ZERO-CANONICAL = 50
       AND INPUT-PRESERVED = 125 AND OCCUPIED-REJECTS = 25
       AND FREE-SURVIVORS = 100 AND REUSE-SURVIVORS = 100
       AND REPLACEMENTS = 25 AND RESTORATIONS = 25
       AND CLEANUPS = 25 AND HEAP-SAMPLES = 25
       AND HEAP-LIVE = 0
       AND TARGET-COUNT(1) = 5 AND TARGET-COUNT(2) = 5
       AND TARGET-COUNT(3) = 5 AND TARGET-COUNT(4) = 5
       AND TARGET-COUNT(5) = 5
        DISPLAY "RESULT=PASS_STAGE53_CANONICAL_ZERO_FIVE_LIVE_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE53_CANONICAL_ZERO_FIVE_LIVE_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

PREPARE-CASE.
    MOVE ALL "0" TO MAG
    MOVE "1" TO MAG(1:1)
    COMPUTE TAIL-DIGITS = J + 5
    MOVE TAIL-DIGITS TO MAG(N - 1:2)
    IF FUNCTION MOD(J, 2) = 1
        MOVE -1 TO SIGN-OF-M
    ELSE
        MOVE 1 TO SIGN-OF-M
    END-IF.

MAKE-ZERO.
    MOVE SPACES TO ZERO-TEXT
    EVALUATE ZERO-INDEX
        WHEN 1 MOVE "0" TO ZERO-TEXT
               MOVE 1 TO ZERO-LENGTH
        WHEN 2 MOVE "+000" TO ZERO-TEXT
               MOVE 4 TO ZERO-LENGTH
        WHEN 3 MOVE "-000" TO ZERO-TEXT
               MOVE 4 TO ZERO-LENGTH
        WHEN 4 MOVE ALL "0" TO ZERO-TEXT
               MOVE 8192 TO ZERO-LENGTH
        WHEN 5 MOVE ALL "0" TO ZERO-TEXT
               MOVE "-" TO ZERO-TEXT(1:1)
               MOVE 8192 TO ZERO-LENGTH
    END-EVALUATE.

RUN-CASE.
    ADD 1 TO CASE-NUM
    MOVE 0 TO BAD
    MOVE J TO ZERO-INDEX
    PERFORM MAKE-ZERO
    MOVE ZERO-TEXT TO C-LITERAL
    MOVE ZERO-LENGTH TO C-LENGTH
    MOVE 0 TO C-REQUIRED-SIGN
    MOVE MAG TO T-LITERAL
    MOVE N TO T-LENGTH
    MOVE SIGN-OF-M TO T-REQUIRED-SIGN
    PERFORM INIT-PAIR
    IF BAD = 0 PERFORM CHECK-ZERO-C END-IF
    IF BAD = 0
        PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
            IF SLOT-NUM > 1
                PERFORM FREE-C
                IF BAD = 0
                    COMPUTE SMALL-DIGIT = SLOT-NUM - 1
                    MOVE SPACES TO C-LITERAL
                    MOVE SMALL-DIGIT TO C-LITERAL(1:1)
                    MOVE 1 TO C-LENGTH
                    MOVE SIGN-OF-M TO C-REQUIRED-SIGN
                    PERFORM INIT-C
                    PERFORM SNAPSHOT-INPUTS
                END-IF
            END-IF
            IF BAD = 0
                PERFORM EXPECT-ORIGINAL
                PERFORM PRODUCE-SLOT
            END-IF
            IF BAD NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF BAD = 0
        MOVE 5 TO EXPECTED-LIVE
        PERFORM CHECK-OWNERS
        IF BAD = 0 ADD 5 TO INITIAL-OWNERS END-IF
    END-IF
    IF BAD = 0
        COMPUTE SELECTED-SLOT = FUNCTION MOD(CASE-NUM - 1, 5) + 1
        ADD 1 TO TARGET-COUNT(SELECTED-SLOT)
        PERFORM PROBE-OCCUPIED
    END-IF
    IF BAD = 0
        PERFORM FREE-C
        PERFORM FREE-T
        COMPUTE ZERO-INDEX = FUNCTION MOD(J, 5) + 1
        PERFORM MAKE-ZERO
        MOVE MAG TO C-LITERAL
        MOVE N TO C-LENGTH
        COMPUTE C-REQUIRED-SIGN = 0 - SIGN-OF-M
        MOVE ZERO-TEXT TO T-LITERAL
        MOVE ZERO-LENGTH TO T-LENGTH
        MOVE 0 TO T-REQUIRED-SIGN
        PERFORM INIT-PAIR
        IF BAD = 0
            PERFORM CHECK-ZERO-T
            PERFORM CHECK-OWNERS
            IF BAD = 0 ADD 5 TO INPUT-PRESERVED END-IF
        END-IF
    END-IF
    IF BAD = 0
        MOVE SELECTED-SLOT TO SLOT-NUM
        PERFORM FREE-OUTPUT
        IF BAD = 0
            MOVE 4 TO EXPECTED-LIVE
            PERFORM CHECK-OWNERS
            IF BAD = 0 ADD 4 TO FREE-SURVIVORS END-IF
        END-IF
    END-IF
    IF BAD = 0
        PERFORM FREE-C
        IF BAD = 0
            MOVE MAG TO C-LITERAL
            COMPUTE TAIL-DIGITS = J + 4 + SELECTED-SLOT
            MOVE TAIL-DIGITS TO C-LITERAL(N - 1:2)
            MOVE N TO C-LENGTH
            COMPUTE C-REQUIRED-SIGN = 0 - SIGN-OF-M
            PERFORM INIT-C
            PERFORM SNAPSHOT-INPUTS
        END-IF
        IF BAD = 0
            MOVE SELECTED-SLOT TO SLOT-NUM
            PERFORM EXPECT-REPLACEMENT
            PERFORM PRODUCE-SLOT
            IF BAD = 0
                MOVE 5 TO EXPECTED-LIVE
                PERFORM CHECK-OWNERS
                IF BAD = 0
                    ADD 4 TO REUSE-SURVIVORS
                    ADD 1 TO REPLACEMENTS
                END-IF
            END-IF
        END-IF
    END-IF
    IF BAD = 0
        PERFORM FREE-C
        PERFORM FREE-T
        MOVE J TO ZERO-INDEX
        PERFORM MAKE-ZERO
        IF SELECTED-SLOT = 1
            MOVE ZERO-TEXT TO C-LITERAL
            MOVE ZERO-LENGTH TO C-LENGTH
            MOVE 0 TO C-REQUIRED-SIGN
        ELSE
            COMPUTE SMALL-DIGIT = SELECTED-SLOT - 1
            MOVE SPACES TO C-LITERAL
            MOVE SMALL-DIGIT TO C-LITERAL(1:1)
            MOVE 1 TO C-LENGTH
            MOVE SIGN-OF-M TO C-REQUIRED-SIGN
        END-IF
        MOVE MAG TO T-LITERAL
        MOVE N TO T-LENGTH
        MOVE SIGN-OF-M TO T-REQUIRED-SIGN
        PERFORM INIT-PAIR
        IF BAD = 0
            MOVE SELECTED-SLOT TO SLOT-NUM
            PERFORM FREE-OUTPUT
            IF BAD = 0
                PERFORM EXPECT-ORIGINAL
                PERFORM PRODUCE-SLOT
                IF BAD = 0
                    MOVE 5 TO EXPECTED-LIVE
                    PERFORM CHECK-OWNERS
                    IF BAD = 0 ADD 1 TO RESTORATIONS END-IF
                END-IF
            END-IF
        END-IF
    END-IF
    PERFORM CLEANUP-CASE
    IF BAD = 0
        ADD 1 TO PASSED
    ELSE
        ADD 1 TO FAILED
        DISPLAY "STAGE53_CASE_FAILED=" CASE-NUM
    END-IF.

INIT-PAIR.
    IF C-HEAD NOT = NULL OR T-HEAD NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_DIRTY_INPUTS=" CASE-NUM
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-C
    IF BAD NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM INIT-T
    IF BAD NOT = 0 EXIT PARAGRAPH END-IF
    PERFORM SNAPSHOT-INPUTS.

INIT-C.
    MOVE C-LITERAL TO TXT
    MOVE C-LENGTH TO TXT-LEN
    MOVE "INIT-TEXT" TO OP
    MOVE 0 TO STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN EMPTY-A EMPTY-B
        INPUT-C EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0
        MOVE 1 TO BAD
        DISPLAY "STAGE53_INIT_C_FAILED=" CASE-NUM ":" STATUS-CODE
    ELSE
        IF C-REQUIRED-SIGN = -1 AND C-HEAD NOT = NULL
            MOVE -1 TO C-SIGN
        END-IF
        IF C-SIGN NOT = C-REQUIRED-SIGN
            MOVE 1 TO BAD
            DISPLAY "STAGE53_SIGN_C_FAILED=" CASE-NUM
        END-IF
    END-IF.

INIT-T.
    MOVE T-LITERAL TO TXT
    MOVE T-LENGTH TO TXT-LEN
    MOVE "INIT-TEXT" TO OP
    MOVE 0 TO STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN EMPTY-A EMPTY-B
        INPUT-T EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0
        MOVE 1 TO BAD
        DISPLAY "STAGE53_INIT_T_FAILED=" CASE-NUM ":" STATUS-CODE
    ELSE
        IF T-REQUIRED-SIGN = -1 AND T-HEAD NOT = NULL
            MOVE -1 TO T-SIGN
        END-IF
        IF T-SIGN NOT = T-REQUIRED-SIGN
            MOVE 1 TO BAD
            DISPLAY "STAGE53_SIGN_T_FAILED=" CASE-NUM
        END-IF
    END-IF.

CHECK-ZERO-C.
    IF C-SIGN NOT = 0 OR C-CHUNKS NOT = 0
       OR C-HEAD NOT = NULL OR C-TAIL NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_ZERO_C_FAILED=" CASE-NUM
    ELSE
        ADD 1 TO ZERO-CANONICAL
    END-IF.

CHECK-ZERO-T.
    IF T-SIGN NOT = 0 OR T-CHUNKS NOT = 0
       OR T-HEAD NOT = NULL OR T-TAIL NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_ZERO_T_FAILED=" CASE-NUM
    ELSE
        ADD 1 TO ZERO-CANONICAL
    END-IF.

SNAPSHOT-INPUTS.
    MOVE C-SIGN TO CB-SIGN
    MOVE C-CHUNKS TO CB-CHUNKS
    SET CB-HEAD TO C-HEAD
    SET CB-TAIL TO C-TAIL
    MOVE T-SIGN TO TB-SIGN
    MOVE T-CHUNKS TO TB-CHUNKS
    SET TB-HEAD TO T-HEAD
    SET TB-TAIL TO T-TAIL.

CHECK-INPUTS.
    IF C-SIGN NOT = CB-SIGN OR C-CHUNKS NOT = CB-CHUNKS
       OR C-HEAD NOT = CB-HEAD OR C-TAIL NOT = CB-TAIL
       OR T-SIGN NOT = TB-SIGN OR T-CHUNKS NOT = TB-CHUNKS
       OR T-HEAD NOT = TB-HEAD OR T-TAIL NOT = TB-TAIL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_INPUT_MUTATED=" CASE-NUM
    END-IF.

EXPECT-ORIGINAL.
    MOVE MAG TO EXPECTED-TEXT(SLOT-NUM)
    COMPUTE TAIL-DIGITS = J + 7 - SLOT-NUM
    MOVE TAIL-DIGITS TO EXPECTED-TEXT(SLOT-NUM)(N - 1:2).

EXPECT-REPLACEMENT.
    MOVE MAG TO EXPECTED-TEXT(SLOT-NUM)
    COMPUTE TAIL-DIGITS = J + 5 + SLOT-NUM
    MOVE TAIL-DIGITS TO EXPECTED-TEXT(SLOT-NUM)(N - 1:2).

PRODUCE-SLOT.
    MOVE 0 TO STATUS-CODE
    MOVE SPACES TO MESSAGE-TEXT
    SET ADDRESS OF OUTPUT-ALIAS
        TO ADDRESS OF OUTPUT-SLOT(SLOT-NUM)
    CALL "MONSTER-DISTANCE" USING
        ACTION-NAME INPUT-C INPUT-T
        OUTPUT-ALIAS STATUS-CODE MESSAGE-TEXT
    IF STATUS-CODE NOT = 0
       OR MESSAGE-TEXT NOT = "PATCH03:DISTANCE-PATCH"
        MOVE 1 TO BAD
        DISPLAY "STAGE53_DISTANCE_FAILED="
            CASE-NUM ":" SLOT-NUM ":" STATUS-CODE
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-INPUTS
    IF BAD NOT = 0 EXIT PARAGRAPH END-IF
    MOVE O-SIGN(SLOT-NUM) TO S-SIGN(SLOT-NUM)
    MOVE O-CHUNKS(SLOT-NUM) TO S-CHUNKS(SLOT-NUM)
    SET S-HEAD(SLOT-NUM) TO O-HEAD(SLOT-NUM)
    SET S-TAIL(SLOT-NUM) TO O-TAIL(SLOT-NUM)
    PERFORM CHECK-OUTPUT.

CHECK-OUTPUT.
    IF O-SIGN(SLOT-NUM) NOT = 1
       OR O-CHUNKS(SLOT-NUM) = 0
       OR O-HEAD(SLOT-NUM) = NULL
       OR O-TAIL(SLOT-NUM) = NULL
       OR O-SIGN(SLOT-NUM) NOT = S-SIGN(SLOT-NUM)
       OR O-CHUNKS(SLOT-NUM) NOT = S-CHUNKS(SLOT-NUM)
       OR O-HEAD(SLOT-NUM) NOT = S-HEAD(SLOT-NUM)
       OR O-TAIL(SLOT-NUM) NOT = S-TAIL(SLOT-NUM)
        MOVE 1 TO BAD
        DISPLAY "STAGE53_OWNER_FAILED=" CASE-NUM ":" SLOT-NUM
        EXIT PARAGRAPH
    END-IF
    MOVE "TO-TEXT" TO OP
    MOVE SPACES TO TXT
    MOVE 0 TO TXT-LEN STATUS-CODE
    SET ADDRESS OF OUTPUT-ALIAS
        TO ADDRESS OF OUTPUT-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN OUTPUT-ALIAS EMPTY-B
        EMPTY-OUT EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR TXT-LEN NOT = N
        MOVE 1 TO BAD
        DISPLAY "STAGE53_TEXT_LENGTH_FAILED="
            CASE-NUM ":" SLOT-NUM ":" STATUS-CODE
    ELSE
        IF TXT(1:N) NOT = EXPECTED-TEXT(SLOT-NUM)(1:N)
            MOVE 1 TO BAD
            DISPLAY "STAGE53_TEXT_ORACLE_FAILED="
                CASE-NUM ":" SLOT-NUM
        END-IF
    END-IF.

CHECK-OWNERS.
    MOVE 0 TO LIVE-COUNT
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF O-HEAD(SLOT-NUM) = NULL
            IF EXPECTED-LIVE NOT = 4
                OR SLOT-NUM NOT = SELECTED-SLOT
                MOVE 1 TO BAD
                DISPLAY "STAGE53_MISSING_OWNER=" CASE-NUM
            END-IF
        ELSE
            ADD 1 TO LIVE-COUNT
            PERFORM CHECK-OUTPUT
            PERFORM VARYING PEER-NUM FROM 1 BY 1
                UNTIL PEER-NUM >= SLOT-NUM
                IF O-HEAD(PEER-NUM) NOT = NULL
                   AND O-HEAD(PEER-NUM) = O-HEAD(SLOT-NUM)
                    MOVE 1 TO BAD
                    DISPLAY "STAGE53_ALIAS_OWNER=" CASE-NUM
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM
    IF LIVE-COUNT NOT = EXPECTED-LIVE
        MOVE 1 TO BAD
        DISPLAY "STAGE53_LIVE_COUNT_FAILED=" CASE-NUM
    END-IF
    PERFORM CHECK-INPUTS.

PROBE-OCCUPIED.
    MOVE SELECTED-SLOT TO SLOT-NUM
    MOVE 0 TO STATUS-CODE
    MOVE SPACES TO MESSAGE-TEXT
    SET ADDRESS OF OUTPUT-ALIAS
        TO ADDRESS OF OUTPUT-SLOT(SLOT-NUM)
    CALL "MONSTER-DISTANCE" USING
        ACTION-NAME INPUT-C INPUT-T
        OUTPUT-ALIAS STATUS-CODE MESSAGE-TEXT
    IF STATUS-CODE NOT = 175
        MOVE 1 TO BAD
        DISPLAY "STAGE53_OCCUPIED_FAILED="
            CASE-NUM ":" STATUS-CODE
    ELSE
        PERFORM CHECK-OWNERS
        IF BAD = 0 ADD 1 TO OCCUPIED-REJECTS END-IF
    END-IF.

FREE-C.
    IF C-HEAD = NULL AND C-SIGN = 0 AND C-CHUNKS = 0
        EXIT PARAGRAPH
    END-IF
    MOVE "FREE-A" TO OP
    MOVE 0 TO STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN INPUT-C EMPTY-B
        EMPTY-OUT EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR C-SIGN NOT = 0
       OR C-CHUNKS NOT = 0 OR C-HEAD NOT = NULL
       OR C-TAIL NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_FREE_C_FAILED=" CASE-NUM
    END-IF.

FREE-T.
    IF T-HEAD = NULL AND T-SIGN = 0 AND T-CHUNKS = 0
        EXIT PARAGRAPH
    END-IF
    MOVE "FREE-A" TO OP
    MOVE 0 TO STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN INPUT-T EMPTY-B
        EMPTY-OUT EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR T-SIGN NOT = 0
       OR T-CHUNKS NOT = 0 OR T-HEAD NOT = NULL
       OR T-TAIL NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_FREE_T_FAILED=" CASE-NUM
    END-IF.

FREE-OUTPUT.
    IF O-HEAD(SLOT-NUM) = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_MISSING_ON_FREE=" CASE-NUM
        EXIT PARAGRAPH
    END-IF
    MOVE "FREE-A" TO OP
    MOVE 0 TO STATUS-CODE
    SET ADDRESS OF OUTPUT-ALIAS
        TO ADDRESS OF OUTPUT-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN OUTPUT-ALIAS EMPTY-B
        EMPTY-OUT EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR O-SIGN(SLOT-NUM) NOT = 0
       OR O-CHUNKS(SLOT-NUM) NOT = 0
       OR O-HEAD(SLOT-NUM) NOT = NULL
       OR O-TAIL(SLOT-NUM) NOT = NULL
        MOVE 1 TO BAD
        DISPLAY "STAGE53_FREE_OUTPUT_FAILED="
            CASE-NUM ":" SLOT-NUM
    END-IF.

CLEANUP-CASE.
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF O-HEAD(SLOT-NUM) NOT = NULL
            PERFORM FREE-OUTPUT
        END-IF
    END-PERFORM
    PERFORM FREE-C
    PERFORM FREE-T
    MOVE "HEAP-LIVE" TO OP
    MOVE 0 TO TXT-LEN STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING
        OP TXT TXT-LEN EMPTY-A EMPTY-B
        EMPTY-OUT EMPTY-REM COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0
        MOVE 1 TO BAD
        DISPLAY "STAGE53_HEAP_QUERY_FAILED=" CASE-NUM
    ELSE
        MOVE TXT-LEN TO HEAP-LIVE
        ADD 1 TO HEAP-SAMPLES
        IF HEAP-LIVE NOT = 0
            MOVE 1 TO BAD
            DISPLAY "STAGE53_HEAP_LEAK=" CASE-NUM ":" HEAP-LIVE
        END-IF
    END-IF
    IF BAD = 0 ADD 1 TO CLEANUPS END-IF.
