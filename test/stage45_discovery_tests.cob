>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE45-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-RUNS PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-INITIAL PIC 9(4) COMP-5 VALUE 0.
01 WS-QUAD PIC 9(4) COMP-5 VALUE 0.
01 WS-ORDER-COMPLETE PIC 9(4) COMP-5 VALUE 0.
01 WS-REBUILD-COMPLETE PIC 9(4) COMP-5 VALUE 0.
01 WS-MID-HEAP-ZERO PIC 9(4) COMP-5 VALUE 0.
01 WS-FINAL-CLEANUP PIC 9(4) COMP-5 VALUE 0.
01 WS-REJECTS PIC 9(4) COMP-5 VALUE 0.
01 WS-PRESERVED PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-FREES PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-REUSES PIC 9(4) COMP-5 VALUE 0.
01 WS-PARTIAL-CYCLES PIC 9(4) COMP-5 VALUE 0.
01 WS-PAIR-SWITCHES PIC 9(4) COMP-5 VALUE 0.
01 WS-PEER PIC 9(4) COMP-5 VALUE 0.
01 WS-PERM-ID PIC 9(4) COMP-5 VALUE 0.
01 WS-STEP PIC 9(4) COMP-5 VALUE 0.
01 WS-ORDER-GROUP.
   05 WS-ORDER PIC 9(4) COMP-5 OCCURS 4 TIMES.
01 WS-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-WIDTH-ID PIC 9(4) COMP-5 VALUE 0.
01 WS-N PIC 9(4) COMP-5 VALUE 0.
01 WS-J PIC 9(4) COMP-5 VALUE 0.
01 WS-SLOT PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST-Y PIC 9(4) COMP-5 VALUE 0.
01 WS-X-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-Y-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-TAIL-POS PIC 9(4) COMP-5 VALUE 0.
01 WS-LAST-TWO PIC 99 VALUE 0.
01 WS-EXPECTED-N PIC 99 VALUE 0.
01 WS-EXPECTED-EDIT PIC 99 VALUE 0.
01 WS-BASE-X PIC X(8192) VALUE SPACES.
01 WS-BASE-Y PIC X(8192) VALUE SPACES.
01 WS-BASE-C PIC X(8192) VALUE SPACES.
01 WS-BASE-T PIC X(8192) VALUE SPACES.
01 WS-C-LITERAL PIC X(8192) VALUE SPACES.
01 WS-T-LITERAL PIC X(8192) VALUE SPACES.
01 WS-EXPECTED-GROUP.
   05 WS-EXPECTED PIC X(2) OCCURS 4 TIMES.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-OUTPUT-GROUP.
   05 WS-OUTPUT OCCURS 4 TIMES.
      10 O-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 O-HEAD USAGE POINTER.
      10 O-TAIL USAGE POINTER.
01 WS-OUTPUT-ALIAS BASED.
   05 OA-SIGN PIC S9(4) COMP-5.
   05 OA-CHUNKS PIC 9(18) COMP-5.
   05 OA-HEAD USAGE POINTER.
   05 OA-TAIL USAGE POINTER.
01 WS-SNAP-GROUP.
   05 WS-SNAP OCCURS 4 TIMES.
      10 S-SIGN PIC S9(4) COMP-5 VALUE 0.
      10 S-CHUNKS PIC 9(18) COMP-5 VALUE 0.
      10 S-HEAD USAGE POINTER.
      10 S-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 4
        SET O-HEAD(WS-SLOT) O-TAIL(WS-SLOT)
            S-HEAD(WS-SLOT) S-TAIL(WS-SLOT) TO NULL
    END-PERFORM

    PERFORM VARYING WS-WIDTH-ID FROM 1 BY 1
        UNTIL WS-WIDTH-ID > 4
        EVALUATE WS-WIDTH-ID
            WHEN 1 MOVE 3 TO WS-N
            WHEN 2 MOVE 9 TO WS-N
            WHEN 3 MOVE 320 TO WS-N
            WHEN 4 MOVE 8192 TO WS-N
        END-EVALUATE
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 6
            PERFORM PREPARE-CASE
            PERFORM RUN-CASE
        END-PERFORM
    END-PERFORM

    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-STATUS WS-LEN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0
        MOVE WS-LEN TO WS-HEAP
        DISPLAY "STAGE45_HEAP_MEASURED=YES"
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE45_HEAP_PROBE_FAILED=" WS-STATUS
    END-IF

    DISPLAY "STAGE45_INITIAL_OUTPUTS=" WS-INITIAL
    DISPLAY "STAGE45_QUAD_LIVE=" WS-QUAD
    DISPLAY "STAGE45_ORDER_COVERAGE=" WS-ORDER-COMPLETE
    DISPLAY "STAGE45_REVERSE_REBUILT=" WS-REBUILD-COMPLETE
    DISPLAY "STAGE45_MID_HEAP_ZERO=" WS-MID-HEAP-ZERO
    DISPLAY "STAGE45_FINAL_CLEANUP=" WS-FINAL-CLEANUP
    DISPLAY "STAGE45_OCCUPIED_REJECTS=" WS-REJECTS
    DISPLAY "STAGE45_REJECTED_PRESERVED=" WS-PRESERVED
    DISPLAY "STAGE45_PARTIAL_FREES=" WS-PARTIAL-FREES
    DISPLAY "STAGE45_PARTIAL_REUSES=" WS-PARTIAL-REUSES
    DISPLAY "STAGE45_PARTIAL_CYCLES=" WS-PARTIAL-CYCLES
    DISPLAY "STAGE45_PAIR_SWITCHES=" WS-PAIR-SWITCHES
    DISPLAY "STAGE45_RUNS=" WS-RUNS
    DISPLAY "STAGE45_PASS=" WS-PASS
    DISPLAY "STAGE45_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE45_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 24 AND WS-PASS = 24 AND WS-FAIL = 0
       AND WS-INITIAL = 24 AND WS-QUAD = 24
       AND WS-ORDER-COMPLETE = 24
       AND WS-REBUILD-COMPLETE = 24
       AND WS-MID-HEAP-ZERO = 24
       AND WS-FINAL-CLEANUP = 24 AND WS-HEAP = 0
       AND WS-REJECTS = 48 AND WS-PRESERVED = 48
       AND WS-PARTIAL-FREES = 96 AND WS-PARTIAL-REUSES = 96
       AND WS-PARTIAL-CYCLES = 48
       AND WS-PAIR-SWITCHES = 24
        DISPLAY
          "RESULT=PASS_STAGE45_ALTERNATING_PARTIAL_SLOT_REUSE_DISCOVERY_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY
          "RESULT=FAIL_STAGE45_ALTERNATING_PARTIAL_SLOT_REUSE_DISCOVERY_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

PREPARE-CASE.
    MOVE SPACES TO WS-BASE-X WS-BASE-Y
                   WS-BASE-C WS-BASE-T
    MOVE ALL "0" TO WS-BASE-X(1:WS-N)
    MOVE "1" TO WS-BASE-X(1:1)
    COMPUTE WS-LAST-Y = WS-N - 1
    COMPUTE WS-X-POS = WS-N - 1
    COMPUTE WS-Y-POS = WS-N - 2
    MOVE ALL "9" TO WS-BASE-Y(1:WS-LAST-Y)
    EVALUATE WS-J
        WHEN 1
            MOVE "07" TO WS-BASE-X(WS-X-POS:2)
            MOVE "93" TO WS-BASE-Y(WS-Y-POS:2)
        WHEN 2
            MOVE "12" TO WS-BASE-X(WS-X-POS:2)
            MOVE "91" TO WS-BASE-Y(WS-Y-POS:2)
        WHEN 3
            MOVE "17" TO WS-BASE-X(WS-X-POS:2)
            MOVE "89" TO WS-BASE-Y(WS-Y-POS:2)
        WHEN 4
            MOVE "22" TO WS-BASE-X(WS-X-POS:2)
            MOVE "87" TO WS-BASE-Y(WS-Y-POS:2)
        WHEN 5
            MOVE "27" TO WS-BASE-X(WS-X-POS:2)
            MOVE "85" TO WS-BASE-Y(WS-Y-POS:2)
        WHEN 6
            MOVE "32" TO WS-BASE-X(WS-X-POS:2)
            MOVE "83" TO WS-BASE-Y(WS-Y-POS:2)
    END-EVALUATE
    IF WS-J = 1 OR 3 OR 5
        MOVE WS-BASE-X TO WS-BASE-C
        MOVE WS-BASE-Y TO WS-BASE-T
    ELSE
        MOVE WS-BASE-Y TO WS-BASE-C
        MOVE WS-BASE-X TO WS-BASE-T
    END-IF.

PREPARE-SLOT.
    MOVE WS-BASE-C TO WS-C-LITERAL
    MOVE WS-BASE-T TO WS-T-LITERAL
    COMPUTE WS-TAIL-POS =
        FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL)) - 1
    COMPUTE WS-LAST-TWO =
        FUNCTION NUMVAL(WS-C-LITERAL(WS-TAIL-POS:2))
    IF WS-J = 1 OR 3 OR 5
        COMPUTE WS-LAST-TWO = WS-LAST-TWO + WS-SLOT - 1
    ELSE
        COMPUTE WS-LAST-TWO = WS-LAST-TWO - WS-SLOT + 1
    END-IF
    MOVE WS-LAST-TWO TO WS-C-LITERAL(WS-TAIL-POS:2)
    COMPUTE WS-EXPECTED-N = 7 * WS-J + 8 + WS-SLOT - 1
    MOVE WS-EXPECTED-N TO WS-EXPECTED-EDIT
    MOVE WS-EXPECTED-EDIT TO WS-EXPECTED(WS-SLOT).


PREPARE-ORDER.
    COMPUTE WS-PERM-ID = (WS-WIDTH-ID - 1) * 6 + WS-J
    EVALUATE WS-PERM-ID
        WHEN 1
            MOVE 1 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 2
            MOVE 1 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 3
            MOVE 1 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 4
            MOVE 1 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 5
            MOVE 1 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 6
            MOVE 1 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 7
            MOVE 2 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 8
            MOVE 2 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 9
            MOVE 2 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 10
            MOVE 2 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN 11
            MOVE 2 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 12
            MOVE 2 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN 13
            MOVE 3 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 14
            MOVE 3 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 15
            MOVE 3 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 4 TO WS-ORDER(4)
        WHEN 16
            MOVE 3 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 4 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN 17
            MOVE 3 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 18
            MOVE 3 TO WS-ORDER(1)
            MOVE 4 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN 19
            MOVE 4 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 20
            MOVE 4 TO WS-ORDER(1)
            MOVE 1 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 21
            MOVE 4 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 3 TO WS-ORDER(4)
        WHEN 22
            MOVE 4 TO WS-ORDER(1)
            MOVE 2 TO WS-ORDER(2)
            MOVE 3 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN 23
            MOVE 4 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 1 TO WS-ORDER(3)
            MOVE 2 TO WS-ORDER(4)
        WHEN 24
            MOVE 4 TO WS-ORDER(1)
            MOVE 3 TO WS-ORDER(2)
            MOVE 2 TO WS-ORDER(3)
            MOVE 1 TO WS-ORDER(4)
        WHEN OTHER
            MOVE 1 TO WS-CASE-FAIL
    END-EVALUATE.
RUN-CASE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-CASE-FAIL
    PERFORM PREPARE-ORDER
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-SLOT FROM 1 BY 1
            UNTIL WS-SLOT > 4
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-INITIAL
        PERFORM CHECK-DISTINCT
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-QUAD END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-ORDER(1) TO WS-SLOT
        PERFORM PROBE-OCCUPIED
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 1 BY 1
            UNTIL WS-STEP > 2
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM RELEASE-RESULT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-SURVIVORS
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-PARTIAL-FREES
                END-IF
            END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 2 BY -1
            UNTIL WS-STEP < 1
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-SURVIVORS
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-PARTIAL-REUSES
                END-IF
            END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-DISTINCT
            IF WS-CASE-FAIL = 0
                ADD 1 TO WS-PARTIAL-CYCLES
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 3 BY 1
            UNTIL WS-STEP > 4
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM RELEASE-RESULT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-SURVIVORS
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-PARTIAL-FREES
                END-IF
            END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 4 BY -1
            UNTIL WS-STEP < 3
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL = 0
                PERFORM CHECK-SURVIVORS
                IF WS-CASE-FAIL = 0
                    ADD 1 TO WS-PARTIAL-REUSES
                END-IF
            END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
        IF WS-CASE-FAIL = 0
            PERFORM CHECK-DISTINCT
            IF WS-CASE-FAIL = 0
                ADD 1 TO WS-PARTIAL-CYCLES
                ADD 1 TO WS-PAIR-SWITCHES
            END-IF
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 1 BY 1
            UNTIL WS-STEP > 4
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM RELEASE-RESULT
            IF WS-CASE-FAIL = 0 PERFORM CHECK-SURVIVORS END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-ORDER-COMPLETE END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE "HEAP-LIVE" TO WS-OP
        MOVE 0 TO WS-STATUS WS-LEN
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR WS-LEN NOT = 0
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_INTERMEDIATE_HEAP_FAILED=" WS-RUNS
        ELSE
            ADD 1 TO WS-MID-HEAP-ZERO
        END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 4 BY -1
            UNTIL WS-STEP < 1
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM PRODUCE-SLOT
            IF WS-CASE-FAIL = 0 PERFORM CHECK-SURVIVORS END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
        IF WS-CASE-FAIL = 0 PERFORM CHECK-DISTINCT END-IF
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-REBUILD-COMPLETE END-IF
    END-IF
    IF WS-CASE-FAIL = 0
        MOVE WS-ORDER(4) TO WS-SLOT
        PERFORM PROBE-OCCUPIED
    END-IF
    IF WS-CASE-FAIL = 0
        PERFORM VARYING WS-STEP FROM 1 BY 1
            UNTIL WS-STEP > 4
            MOVE WS-ORDER(WS-STEP) TO WS-SLOT
            PERFORM RELEASE-RESULT
            IF WS-CASE-FAIL = 0 PERFORM CHECK-SURVIVORS END-IF
            IF WS-CASE-FAIL NOT = 0 EXIT PERFORM END-IF
        END-PERFORM
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-FINAL-CLEANUP END-IF
    END-IF
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 4
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM RELEASE-RESULT
        END-IF
    END-PERFORM
    PERFORM RELEASE-PAIR
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE45_CASE_FAILED=" WS-RUNS
    END-IF.
PROBE-OCCUPIED.
    PERFORM PREPARE-SLOT
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL TO NULL
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-C-INPUT WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 175
            ADD 1 TO WS-REJECTS
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_OCCUPIED_STATUS_FAILED="
                WS-RUNS ":" WS-SLOT ":" WS-STATUS
        END-IF
        IF C-HEAD = NULL OR T-HEAD = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_REJECTION_DAMAGED_INPUT=" WS-RUNS
        END-IF
        IF WS-CASE-FAIL = 0 PERFORM CHECK-SURVIVORS END-IF
        IF WS-CASE-FAIL = 0 ADD 1 TO WS-PRESERVED END-IF
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE45_REJECTION_INIT_FAILED=" WS-RUNS
    END-IF
    PERFORM RELEASE-PAIR.

PRODUCE-SLOT.
    PERFORM PREPARE-SLOT
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL TO NULL
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS = 0
        MOVE 0 TO WS-STATUS
        MOVE SPACES TO WS-MESSAGE
        SET ADDRESS OF WS-OUTPUT-ALIAS
            TO ADDRESS OF WS-OUTPUT(WS-SLOT)
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-C-INPUT WS-T-INPUT
            WS-OUTPUT-ALIAS WS-STATUS WS-MESSAGE
        IF WS-STATUS = 0
           AND WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
            PERFORM SNAPSHOT-SLOT
            PERFORM CHECK-SLOT
        ELSE
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_PATCH_CALL_FAILED="
                WS-RUNS ":" WS-SLOT ":" WS-STATUS
        END-IF
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE45_INIT_FAILED="
            WS-RUNS ":" WS-SLOT ":" WS-STATUS
    END-IF
    PERFORM RELEASE-PAIR.

INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN =
        FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

SNAPSHOT-SLOT.
    MOVE O-SIGN(WS-SLOT) TO S-SIGN(WS-SLOT)
    MOVE O-CHUNKS(WS-SLOT) TO S-CHUNKS(WS-SLOT)
    SET S-HEAD(WS-SLOT) TO O-HEAD(WS-SLOT)
    SET S-TAIL(WS-SLOT) TO O-TAIL(WS-SLOT).

CHECK-SLOT.
    IF O-HEAD(WS-SLOT) = NULL
       OR O-SIGN(WS-SLOT) NOT = S-SIGN(WS-SLOT)
       OR O-CHUNKS(WS-SLOT) NOT = S-CHUNKS(WS-SLOT)
       OR O-HEAD(WS-SLOT) NOT = S-HEAD(WS-SLOT)
       OR O-TAIL(WS-SLOT) NOT = S-TAIL(WS-SLOT)
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE45_METADATA_FAILED=" WS-RUNS ":" WS-SLOT
    END-IF
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR WS-LEN NOT = 2
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE45_TEXT_LENGTH_FAILED=" WS-RUNS ":" WS-SLOT
    ELSE
        IF WS-TEXT(1:2) NOT = WS-EXPECTED(WS-SLOT)
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_ORACLE_FAILED=" WS-RUNS ":" WS-SLOT
        END-IF
    END-IF.


CHECK-SURVIVORS.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 4
        IF O-HEAD(WS-SLOT) NOT = NULL
            PERFORM VARYING WS-PEER FROM 1 BY 1
                UNTIL WS-PEER >= WS-SLOT
                IF O-HEAD(WS-PEER) NOT = NULL AND
                   O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                    MOVE 1 TO WS-CASE-FAIL
                    DISPLAY "STAGE45_SHARED_LIVE_HEAD=" WS-RUNS
                END-IF
            END-PERFORM
            PERFORM CHECK-SLOT
        END-IF
    END-PERFORM.

CHECK-DISTINCT.
    PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 4
        IF O-HEAD(WS-SLOT) = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_NULL_HEAD_FAILED=" WS-RUNS
        END-IF
        PERFORM VARYING WS-PEER FROM 1 BY 1
            UNTIL WS-PEER >= WS-SLOT
            IF O-HEAD(WS-SLOT) = O-HEAD(WS-PEER)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE45_SHARED_HEAD_FAILED=" WS-RUNS
            END-IF
        END-PERFORM
        PERFORM CHECK-SLOT
    END-PERFORM.

RELEASE-RESULT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    SET ADDRESS OF WS-OUTPUT-ALIAS
        TO ADDRESS OF WS-OUTPUT(WS-SLOT)
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT-ALIAS WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN(WS-SLOT) NOT = 0
       OR O-CHUNKS(WS-SLOT) NOT = 0
       OR O-HEAD(WS-SLOT) NOT = NULL
       OR O-TAIL(WS-SLOT) NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE45_OUTPUT_FREE_FAILED="
            WS-RUNS ":" WS-SLOT
    END-IF.

RELEASE-PAIR.
    IF C-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR C-HEAD NOT = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_C_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF
    IF T-HEAD NOT = NULL
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR T-HEAD NOT = NULL
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE45_T_FREE_FAILED=" WS-RUNS
        END-IF
    END-IF.
END PROGRAM STAGE45-DISCOVERY-TESTS.
