>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE55-DISCOVERY-TESTS.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 OP PIC X(16).
01 ACTION-NAME PIC X(16) VALUE "DISTANCE-PATCH".
01 TXT PIC X(8192).
01 TXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 STATUS-CODE PIC 9(4) COMP-5 VALUE 0.
01 COMPARE-CODE PIC S9(4) COMP-5 VALUE 0.
01 MESSAGE-TEXT PIC X(160).
01 PHASE-NAME PIC X(48).
01 PERM-ID PIC 9(4) COMP-5.
01 PERM-KEY PIC 9(5) COMP-5 VALUE 0.
01 PREVIOUS-KEY PIC 9(5) COMP-5 VALUE 0.
01 FIRST-KEY PIC 9(5) COMP-5 VALUE 0.
01 LAST-KEY PIC 9(5) COMP-5 VALUE 0.
01 PERMUTATION-GROUP.
   05 PERM-SLOT PIC 9(4) COMP-5 OCCURS 5 TIMES.
01 SEEN-GROUP.
   05 SEEN PIC 9(4) COMP-5 OCCURS 5 TIMES.
01 ORIENTATION PIC 9(4) COMP-5.
01 J PIC 9(4) COMP-5.
01 SLOT-NUM PIC 9(4) COMP-5.
01 MAKE-SLOT PIC 9(4) COMP-5.
01 STEP-NUM PIC S9(4) COMP-5.
01 ACTIVE-COUNT PIC 9(4) COMP-5.
01 PEER PIC 9(4) COMP-5.
01 PIVOT PIC S9(4) COMP-5.
01 NEXT-IDX PIC 9(4) COMP-5.
01 SWAP-IDX PIC 9(4) COMP-5.
01 LEFT-IDX PIC 9(4) COMP-5.
01 RIGHT-IDX PIC 9(4) COMP-5.
01 TEMP-SLOT PIC 9(4) COMP-5.
01 EXPECTED-HEAP PIC 9(18) COMP-5.
01 EXPECTED-DIGIT PIC 9(9) COMP-5.
01 CHUNK-COUNT PIC 9(4) COMP-5.
01 NODE-NUM PIC 9(4) COMP-5.
01 POS-NUM PIC 9(4) COMP-5.
01 PIECE-LEN PIC 9(4) COMP-5.
01 SMALL-VALUE PIC S9(4) COMP-5.
01 SMALL-ABS PIC 99.
01 SMALL-DIGITS PIC 99.
01 DIGIT-TEXT PIC X(2).
01 TAIL-VALUE PIC 99.
01 M-SIGN PIC S9(4) COMP-5.
01 T-SIGN PIC S9(4) COMP-5.
01 BIG-SLOT PIC 9(4) COMP-5.
01 SMALL-SLOT PIC 9(4) COMP-5.
01 COUNT-WALK PIC 9.
01 PTR USAGE POINTER.
01 PREVIOUS-PTR USAGE POINTER.
01 CNT-PERMUTATIONS PIC 9(9) COMP-5 VALUE 0.
01 CNT-CASES PIC 9(9) COMP-5 VALUE 0.
01 CNT-PASS PIC 9(9) COMP-5 VALUE 0.
01 CNT-INITIAL-OWNERS PIC 9(9) COMP-5 VALUE 0.
01 CNT-REBUILD-OWNERS PIC 9(9) COMP-5 VALUE 0.
01 CNT-RELEASE-STEPS PIC 9(9) COMP-5 VALUE 0.
01 CNT-OWNER-WALKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-CHUNK-CHECKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-DISTINCT-CHECKS PIC 9(9) COMP-5 VALUE 0.
01 CNT-HEAP-SAMPLES PIC 9(9) COMP-5 VALUE 0.
01 CNT-HEAP-ZERO PIC 9(9) COMP-5 VALUE 0.
01 CNT-ORIENTATION-0 PIC 9(9) COMP-5 VALUE 0.
01 CNT-ORIENTATION-1 PIC 9(9) COMP-5 VALUE 0.
01 CNT-ORIENTATION-2 PIC 9(9) COMP-5 VALUE 0.
01 CNT-ORIENTATION-3 PIC 9(9) COMP-5 VALUE 0.
01 CNT-UNEXPECTED-FAILURES PIC 9(9) COMP-5 VALUE 0.
01 OWNERS.
   05 OWNER-SLOT OCCURS 7 TIMES.
      10 O-SIGN PIC S9(4) COMP-5.
      10 O-CHUNKS PIC 9(18) COMP-5.
      10 O-HEAD USAGE POINTER.
      10 O-TAIL USAGE POINTER.
01 EXPECTATIONS.
   05 EXPECTATION OCCURS 7 TIMES.
      10 E-SIGN PIC S9(4) COMP-5.
      10 E-WIDTH PIC 9(4) COMP-5.
      10 E-TEXT PIC X(8193).
      10 SNAP-VALID PIC 9.
      10 S-HEAD USAGE POINTER.
      10 S-TAIL USAGE POINTER.
      10 S-NODE USAGE POINTER OCCURS 911 TIMES.
01 LIVE-GROUP.
   05 LIVE-SLOT PIC 9 OCCURS 7 TIMES.
01 NODE-VIEW BASED.
   05 N-DIGIT PIC 9(9) COMP-5.
   05 N-PREV USAGE POINTER.
   05 N-NEXT USAGE POINTER.
   05 N-ARENA USAGE POINTER.
01 ARG-A BASED.
   05 ARG-A-SIGN PIC S9(4) COMP-5.
   05 ARG-A-CHUNKS PIC 9(18) COMP-5.
   05 ARG-A-HEAD USAGE POINTER.
   05 ARG-A-TAIL USAGE POINTER.
01 ARG-B BASED.
   05 ARG-B-SIGN PIC S9(4) COMP-5.
   05 ARG-B-CHUNKS PIC 9(18) COMP-5.
   05 ARG-B-HEAD USAGE POINTER.
   05 ARG-B-TAIL USAGE POINTER.
01 ARG-O BASED.
   05 ARG-O-SIGN PIC S9(4) COMP-5.
   05 ARG-O-CHUNKS PIC 9(18) COMP-5.
   05 ARG-O-HEAD USAGE POINTER.
   05 ARG-O-TAIL USAGE POINTER.
01 EMPTY-A.
   05 EMPTY-A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-A-HEAD USAGE POINTER.
   05 EMPTY-A-TAIL USAGE POINTER.
01 EMPTY-B.
   05 EMPTY-B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-B-HEAD USAGE POINTER.
   05 EMPTY-B-TAIL USAGE POINTER.
01 EMPTY-OUT.
   05 EMPTY-OUT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-OUT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-OUT-HEAD USAGE POINTER.
   05 EMPTY-OUT-TAIL USAGE POINTER.
01 EMPTY-REM.
   05 EMPTY-REM-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EMPTY-REM-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EMPTY-REM-HEAD USAGE POINTER.
   05 EMPTY-REM-TAIL USAGE POINTER.
PROCEDURE DIVISION.
MAIN.
    SET EMPTY-A-HEAD EMPTY-A-TAIL EMPTY-B-HEAD EMPTY-B-TAIL
        EMPTY-OUT-HEAD EMPTY-OUT-TAIL EMPTY-REM-HEAD
        EMPTY-REM-TAIL TO NULL
    MOVE 1 TO PERM-SLOT(1)
    MOVE 2 TO PERM-SLOT(2)
    MOVE 3 TO PERM-SLOT(3)
    MOVE 4 TO PERM-SLOT(4)
    MOVE 5 TO PERM-SLOT(5)
    PERFORM VARYING PERM-ID FROM 1 BY 1 UNTIL PERM-ID > 120
        PERFORM VALIDATE-PERMUTATION
        COMPUTE ORIENTATION =
            FUNCTION INTEGER((PERM-ID - 1) / 30)
        COMPUTE J = FUNCTION MOD(PERM-ID - 1, 30) + 1
        PERFORM RUN-CASE
        IF PERM-ID < 120
            PERFORM NEXT-PERMUTATION
        END-IF
    END-PERFORM
    DISPLAY "STAGE55_PERMUTATIONS=" CNT-PERMUTATIONS
    DISPLAY "STAGE55_CASES=" CNT-CASES
    DISPLAY "STAGE55_PASS=" CNT-PASS
    DISPLAY "STAGE55_FIRST_PERMUTATION=" FIRST-KEY
    DISPLAY "STAGE55_LAST_PERMUTATION=" LAST-KEY
    DISPLAY "STAGE55_INITIAL_OWNERS=" CNT-INITIAL-OWNERS
    DISPLAY "STAGE55_REBUILD_OWNERS=" CNT-REBUILD-OWNERS
    DISPLAY "STAGE55_RELEASE_STEPS=" CNT-RELEASE-STEPS
    DISPLAY "STAGE55_OWNER_WALKS=" CNT-OWNER-WALKS
    DISPLAY "STAGE55_CHUNK_CHECKS=" CNT-CHUNK-CHECKS
    DISPLAY "STAGE55_DISTINCT_CHECKS=" CNT-DISTINCT-CHECKS
    DISPLAY "STAGE55_HEAP_SAMPLES=" CNT-HEAP-SAMPLES
    DISPLAY "STAGE55_HEAP_ZERO=" CNT-HEAP-ZERO
    DISPLAY "STAGE55_ORIENTATION_0=" CNT-ORIENTATION-0
    DISPLAY "STAGE55_ORIENTATION_1=" CNT-ORIENTATION-1
    DISPLAY "STAGE55_ORIENTATION_2=" CNT-ORIENTATION-2
    DISPLAY "STAGE55_ORIENTATION_3=" CNT-ORIENTATION-3
    DISPLAY "STAGE55_UNEXPECTED_FAILURES=" CNT-UNEXPECTED-FAILURES
    MOVE "final counters" TO PHASE-NAME
    IF CNT-PERMUTATIONS NOT = 120
       OR CNT-CASES NOT = 120
       OR CNT-PASS NOT = 120
       OR FIRST-KEY NOT = 12345
       OR LAST-KEY NOT = 54321
       OR CNT-INITIAL-OWNERS NOT = 600
       OR CNT-REBUILD-OWNERS NOT = 600
       OR CNT-RELEASE-STEPS NOT = 1200
       OR CNT-OWNER-WALKS NOT = 6000
       OR CNT-CHUNK-CHECKS NOT = 5466000
       OR CNT-DISTINCT-CHECKS NOT = 2400
       OR CNT-HEAP-SAMPLES NOT = 2400
       OR CNT-HEAP-ZERO NOT = 240
       OR CNT-ORIENTATION-0 NOT = 30
       OR CNT-ORIENTATION-1 NOT = 30
       OR CNT-ORIENTATION-2 NOT = 30
       OR CNT-ORIENTATION-3 NOT = 30
       OR CNT-UNEXPECTED-FAILURES NOT = 0
        PERFORM FAIL-NOW
    END-IF
    DISPLAY "STAGE55_HEAP_MEASURED=YES"
    DISPLAY
      "RESULT=PASS_STAGE55_FIVE_LIVE_EXHAUSTIVE_RELEASE_ORDERS_NATIVE"
    MOVE 0 TO RETURN-CODE
    STOP RUN.

VALIDATE-PERMUTATION.
    MOVE 0 TO SEEN(1) SEEN(2) SEEN(3) SEEN(4) SEEN(5)
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF PERM-SLOT(SLOT-NUM) < 1 OR PERM-SLOT(SLOT-NUM) > 5
            PERFORM FAIL-NOW
        END-IF
        ADD 1 TO SEEN(PERM-SLOT(SLOT-NUM))
    END-PERFORM
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF SEEN(SLOT-NUM) NOT = 1
            PERFORM FAIL-NOW
        END-IF
    END-PERFORM
    COMPUTE PERM-KEY =
        PERM-SLOT(1) * 10000 + PERM-SLOT(2) * 1000
        + PERM-SLOT(3) * 100 + PERM-SLOT(4) * 10
        + PERM-SLOT(5)
    IF PERM-ID = 1 AND PERM-KEY NOT = 12345
        PERFORM FAIL-NOW
    END-IF
    IF PERM-ID > 1 AND PERM-KEY <= PREVIOUS-KEY
        PERFORM FAIL-NOW
    END-IF
    IF PERM-ID = 120 AND PERM-KEY NOT = 54321
        PERFORM FAIL-NOW
    END-IF
    IF PERM-ID = 1 MOVE PERM-KEY TO FIRST-KEY END-IF
    MOVE PERM-KEY TO PREVIOUS-KEY LAST-KEY
    ADD 1 TO CNT-PERMUTATIONS.

NEXT-PERMUTATION.
    MOVE 4 TO PIVOT
    PERFORM UNTIL PIVOT < 1
        COMPUTE NEXT-IDX = PIVOT + 1
        IF PERM-SLOT(PIVOT) < PERM-SLOT(NEXT-IDX)
            EXIT PERFORM
        END-IF
        SUBTRACT 1 FROM PIVOT
    END-PERFORM
    IF PIVOT < 1
        PERFORM FAIL-NOW
    END-IF
    MOVE 5 TO SWAP-IDX
    PERFORM UNTIL PERM-SLOT(SWAP-IDX) > PERM-SLOT(PIVOT)
        SUBTRACT 1 FROM SWAP-IDX
    END-PERFORM
    MOVE PERM-SLOT(PIVOT) TO TEMP-SLOT
    MOVE PERM-SLOT(SWAP-IDX) TO PERM-SLOT(PIVOT)
    MOVE TEMP-SLOT TO PERM-SLOT(SWAP-IDX)
    COMPUTE LEFT-IDX = PIVOT + 1
    MOVE 5 TO RIGHT-IDX
    PERFORM UNTIL LEFT-IDX >= RIGHT-IDX
        MOVE PERM-SLOT(LEFT-IDX) TO TEMP-SLOT
        MOVE PERM-SLOT(RIGHT-IDX) TO PERM-SLOT(LEFT-IDX)
        MOVE TEMP-SLOT TO PERM-SLOT(RIGHT-IDX)
        ADD 1 TO LEFT-IDX
        SUBTRACT 1 FROM RIGHT-IDX
    END-PERFORM.

RUN-CASE.
    ADD 1 TO CNT-CASES
    EVALUATE ORIENTATION
        WHEN 0 ADD 1 TO CNT-ORIENTATION-0
        WHEN 1 ADD 1 TO CNT-ORIENTATION-1
        WHEN 2 ADD 1 TO CNT-ORIENTATION-2
        WHEN 3 ADD 1 TO CNT-ORIENTATION-3
        WHEN OTHER PERFORM FAIL-NOW
    END-EVALUATE
    DISPLAY "STAGE55_CASE=" CNT-CASES
    MOVE 1 TO M-SIGN
    IF ORIENTATION >= 2 MOVE -1 TO M-SIGN END-IF
    MOVE 6 TO BIG-SLOT
    MOVE 7 TO SMALL-SLOT
    IF FUNCTION MOD(ORIENTATION, 2) = 1
        MOVE 7 TO BIG-SLOT
        MOVE 6 TO SMALL-SLOT
    END-IF
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        MOVE 0 TO O-SIGN(SLOT-NUM) O-CHUNKS(SLOT-NUM)
            SNAP-VALID(SLOT-NUM) LIVE-SLOT(SLOT-NUM)
        SET O-HEAD(SLOT-NUM) O-TAIL(SLOT-NUM)
            S-HEAD(SLOT-NUM) S-TAIL(SLOT-NUM) TO NULL
    END-PERFORM
    PERFORM PREPARE-EXPECTED

    MOVE "first create cycle" TO PHASE-NAME
    PERFORM VARYING STEP-NUM FROM 1 BY 1 UNTIL STEP-NUM > 5
        MOVE PERM-SLOT(STEP-NUM) TO MAKE-SLOT
        PERFORM SET-SMALL-VALUE
        PERFORM MAKE-OWNER
        PERFORM CHECK-LIVE
        MOVE STEP-NUM TO ACTIVE-COUNT
        COMPUTE EXPECTED-HEAP = ACTIVE-COUNT * 911
        PERFORM CHECK-HEAP
        ADD 1 TO CNT-INITIAL-OWNERS
    END-PERFORM

    MOVE "first release permutation" TO PHASE-NAME
    PERFORM VARYING STEP-NUM FROM 1 BY 1 UNTIL STEP-NUM > 5
        MOVE PERM-SLOT(STEP-NUM) TO SLOT-NUM
        PERFORM FREE-OWNER
        PERFORM CHECK-LIVE
        COMPUTE ACTIVE-COUNT = 5 - STEP-NUM
        COMPUTE EXPECTED-HEAP = ACTIVE-COUNT * 911
        PERFORM CHECK-HEAP
        ADD 1 TO CNT-RELEASE-STEPS
    END-PERFORM

    MOVE "reverse rebuild cycle" TO PHASE-NAME
    MOVE 5 TO STEP-NUM
    PERFORM UNTIL STEP-NUM < 1
        MOVE PERM-SLOT(STEP-NUM) TO MAKE-SLOT
        PERFORM SET-SMALL-VALUE
        PERFORM MAKE-OWNER
        PERFORM CHECK-LIVE
        COMPUTE ACTIVE-COUNT = 6 - STEP-NUM
        COMPUTE EXPECTED-HEAP = ACTIVE-COUNT * 911
        PERFORM CHECK-HEAP
        ADD 1 TO CNT-REBUILD-OWNERS
        SUBTRACT 1 FROM STEP-NUM
    END-PERFORM

    MOVE "second release permutation" TO PHASE-NAME
    PERFORM VARYING STEP-NUM FROM 1 BY 1 UNTIL STEP-NUM > 5
        MOVE PERM-SLOT(STEP-NUM) TO SLOT-NUM
        PERFORM FREE-OWNER
        PERFORM CHECK-LIVE
        COMPUTE ACTIVE-COUNT = 5 - STEP-NUM
        COMPUTE EXPECTED-HEAP = ACTIVE-COUNT * 911
        PERFORM CHECK-HEAP
        ADD 1 TO CNT-RELEASE-STEPS
    END-PERFORM
    ADD 1 TO CNT-PASS.

PREPARE-EXPECTED.
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        MOVE 1 TO E-SIGN(SLOT-NUM)
        MOVE SPACES TO E-TEXT(SLOT-NUM)
        IF SLOT-NUM <= 2
            MOVE 8192 TO E-WIDTH(SLOT-NUM)
            MOVE ALL "9" TO E-TEXT(SLOT-NUM)
            IF SLOT-NUM = 1
                COMPUTE SMALL-DIGITS = 99 - J
                MOVE SMALL-DIGITS TO DIGIT-TEXT
                MOVE DIGIT-TEXT TO E-TEXT(SLOT-NUM)(8191:2)
            END-IF
        ELSE
            MOVE 8193 TO E-WIDTH(SLOT-NUM)
            MOVE ALL "0" TO E-TEXT(SLOT-NUM)
            MOVE "1" TO E-TEXT(SLOT-NUM)(1:1)
            IF SLOT-NUM = 4
                MOVE J TO TAIL-VALUE
                PERFORM SET-EXPECTED-TAIL
            END-IF
            IF SLOT-NUM = 5
                COMPUTE TAIL-VALUE = J + 1
                PERFORM SET-EXPECTED-TAIL
            END-IF
        END-IF
    END-PERFORM.

SET-EXPECTED-TAIL.
    MOVE TAIL-VALUE TO SMALL-DIGITS
    MOVE SMALL-DIGITS TO DIGIT-TEXT
    IF TAIL-VALUE < 10
        MOVE DIGIT-TEXT(2:1) TO E-TEXT(SLOT-NUM)(8193:1)
    ELSE
        MOVE DIGIT-TEXT TO E-TEXT(SLOT-NUM)(8192:2)
    END-IF.

SET-SMALL-VALUE.
    EVALUATE MAKE-SLOT
        WHEN 1 COMPUTE SMALL-VALUE = J + 1
        WHEN 2 MOVE 1 TO SMALL-VALUE
        WHEN 3 MOVE 0 TO SMALL-VALUE
        WHEN 4 COMPUTE SMALL-VALUE = 0 - J
        WHEN 5 COMPUTE SMALL-VALUE = 0 - J - 1
        WHEN OTHER PERFORM FAIL-NOW
    END-EVALUATE.

MAKE-OWNER.
    MOVE 0 TO COUNT-WALK
    MOVE "initialize input owners" TO PHASE-NAME
    MOVE BIG-SLOT TO SLOT-NUM
    MOVE M-SIGN TO E-SIGN(SLOT-NUM)
    MOVE 8192 TO E-WIDTH(SLOT-NUM)
    MOVE ALL "9" TO E-TEXT(SLOT-NUM)
    PERFORM INIT-OWNER

    MOVE SMALL-SLOT TO SLOT-NUM
    MOVE 0 TO T-SIGN
    IF SMALL-VALUE > 0 MOVE M-SIGN TO T-SIGN END-IF
    IF SMALL-VALUE < 0 COMPUTE T-SIGN = 0 - M-SIGN END-IF
    COMPUTE SMALL-ABS = FUNCTION ABS(SMALL-VALUE)
    MOVE SMALL-ABS TO SMALL-DIGITS
    MOVE SMALL-DIGITS TO DIGIT-TEXT
    MOVE T-SIGN TO E-SIGN(SLOT-NUM)
    MOVE SPACES TO E-TEXT(SLOT-NUM)
    IF SMALL-ABS < 10
        MOVE 1 TO E-WIDTH(SLOT-NUM)
        MOVE DIGIT-TEXT(2:1) TO E-TEXT(SLOT-NUM)(1:1)
    ELSE
        MOVE 2 TO E-WIDTH(SLOT-NUM)
        MOVE DIGIT-TEXT TO E-TEXT(SLOT-NUM)(1:2)
    END-IF
    PERFORM INIT-OWNER

    MOVE "distance call" TO PHASE-NAME
    MOVE MAKE-SLOT TO SLOT-NUM
    PERFORM ASSERT-EMPTY
    SET ADDRESS OF ARG-A TO ADDRESS OF OWNER-SLOT(6)
    SET ADDRESS OF ARG-B TO ADDRESS OF OWNER-SLOT(7)
    SET ADDRESS OF ARG-O TO ADDRESS OF OWNER-SLOT(MAKE-SLOT)
    MOVE 0 TO STATUS-CODE
    MOVE SPACES TO MESSAGE-TEXT
    CALL "MONSTER-DISTANCE" USING ACTION-NAME
        ARG-A ARG-B ARG-O STATUS-CODE MESSAGE-TEXT
    IF STATUS-CODE NOT = 0
       OR MESSAGE-TEXT NOT = "PATCH03:DISTANCE-PATCH"
        PERFORM FAIL-NOW
    END-IF
    MOVE 1 TO LIVE-SLOT(MAKE-SLOT)
    MOVE "validate outputs while inputs remain live" TO PHASE-NAME
    PERFORM CHECK-ALL-OWNERS
    MOVE 6 TO SLOT-NUM
    PERFORM FREE-OWNER
    MOVE 7 TO SLOT-NUM
    PERFORM FREE-OWNER.

INIT-OWNER.
    PERFORM ASSERT-EMPTY
    MOVE E-TEXT(SLOT-NUM)(1:8192) TO TXT
    MOVE E-WIDTH(SLOT-NUM) TO TXT-LEN
    MOVE "INIT-TEXT" TO OP
    MOVE 0 TO STATUS-CODE
    SET ADDRESS OF ARG-O TO ADDRESS OF OWNER-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        EMPTY-A EMPTY-B ARG-O EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0
        PERFORM FAIL-NOW
    END-IF
    IF E-SIGN(SLOT-NUM) = -1
        IF O-SIGN(SLOT-NUM) NOT = 1
           OR O-HEAD(SLOT-NUM) = NULL
            PERFORM FAIL-NOW
        END-IF
        MOVE -1 TO O-SIGN(SLOT-NUM)
    END-IF
    MOVE 1 TO LIVE-SLOT(SLOT-NUM)
    PERFORM WALK-OWNER.

ASSERT-EMPTY.
    IF O-SIGN(SLOT-NUM) NOT = 0
       OR O-CHUNKS(SLOT-NUM) NOT = 0
       OR O-HEAD(SLOT-NUM) NOT = NULL
       OR O-TAIL(SLOT-NUM) NOT = NULL
       OR SNAP-VALID(SLOT-NUM) NOT = 0
       OR LIVE-SLOT(SLOT-NUM) NOT = 0
        PERFORM FAIL-NOW
    END-IF.

CHECK-ALL-OWNERS.
    MOVE 0 TO COUNT-WALK
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        IF LIVE-SLOT(SLOT-NUM) = 1
            PERFORM WALK-OWNER
        END-IF
    END-PERFORM
    PERFORM CHECK-DISTINCT-ALL.

CHECK-DISTINCT-ALL.
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 7
        IF LIVE-SLOT(SLOT-NUM) = 1
           AND O-TAIL(SLOT-NUM) NOT = NULL
            PERFORM VARYING PEER FROM 1 BY 1 UNTIL PEER >= SLOT-NUM
                IF LIVE-SLOT(PEER) = 1
                   AND O-TAIL(PEER) = O-TAIL(SLOT-NUM)
                    PERFORM FAIL-NOW
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM.

CHECK-LIVE.
    MOVE 1 TO COUNT-WALK
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF LIVE-SLOT(SLOT-NUM) = 1
            PERFORM WALK-OWNER
        END-IF
    END-PERFORM
    MOVE 0 TO COUNT-WALK
    PERFORM CHECK-DISTINCT-LIVE
    ADD 1 TO CNT-DISTINCT-CHECKS.

CHECK-DISTINCT-LIVE.
    PERFORM VARYING SLOT-NUM FROM 1 BY 1 UNTIL SLOT-NUM > 5
        IF LIVE-SLOT(SLOT-NUM) = 1
           AND O-TAIL(SLOT-NUM) NOT = NULL
            PERFORM VARYING PEER FROM 1 BY 1 UNTIL PEER >= SLOT-NUM
                IF LIVE-SLOT(PEER) = 1
                   AND O-TAIL(PEER) = O-TAIL(SLOT-NUM)
                    PERFORM FAIL-NOW
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM.

WALK-OWNER.
    IF O-SIGN(SLOT-NUM) NOT = E-SIGN(SLOT-NUM)
        PERFORM FAIL-NOW
    END-IF
    IF E-SIGN(SLOT-NUM) = 0
        IF O-CHUNKS(SLOT-NUM) NOT = 0
           OR O-HEAD(SLOT-NUM) NOT = NULL
           OR O-TAIL(SLOT-NUM) NOT = NULL
            PERFORM FAIL-NOW
        END-IF
        MOVE 1 TO SNAP-VALID(SLOT-NUM)
        EXIT PARAGRAPH
    END-IF
    COMPUTE CHUNK-COUNT = FUNCTION INTEGER(
        (E-WIDTH(SLOT-NUM) + 8) / 9)
    IF CHUNK-COUNT < 1 OR CHUNK-COUNT > 911
       OR O-CHUNKS(SLOT-NUM) NOT = CHUNK-COUNT
       OR O-HEAD(SLOT-NUM) = NULL
       OR O-TAIL(SLOT-NUM) = NULL
        PERFORM FAIL-NOW
    END-IF
    IF SNAP-VALID(SLOT-NUM) = 1
        IF O-HEAD(SLOT-NUM) NOT = S-HEAD(SLOT-NUM)
           OR O-TAIL(SLOT-NUM) NOT = S-TAIL(SLOT-NUM)
            PERFORM FAIL-NOW
        END-IF
    ELSE
        SET S-HEAD(SLOT-NUM) TO O-HEAD(SLOT-NUM)
        SET S-TAIL(SLOT-NUM) TO O-TAIL(SLOT-NUM)
    END-IF
    SET PTR TO O-HEAD(SLOT-NUM)
    SET PREVIOUS-PTR TO NULL
    MOVE 1 TO POS-NUM
    COMPUTE PIECE-LEN =
        E-WIDTH(SLOT-NUM) - 9 * (CHUNK-COUNT - 1)
    PERFORM VARYING NODE-NUM FROM 1 BY 1
        UNTIL NODE-NUM > CHUNK-COUNT
        IF PTR = NULL
            PERFORM FAIL-NOW
        END-IF
        IF SNAP-VALID(SLOT-NUM) = 1
            IF PTR NOT = S-NODE(SLOT-NUM, NODE-NUM)
                PERFORM FAIL-NOW
            END-IF
        ELSE
            SET S-NODE(SLOT-NUM, NODE-NUM) TO PTR
        END-IF
        SET ADDRESS OF NODE-VIEW TO PTR
        IF N-PREV NOT = PREVIOUS-PTR OR N-ARENA NOT = NULL
            PERFORM FAIL-NOW
        END-IF
        COMPUTE EXPECTED-DIGIT = FUNCTION NUMVAL(
            E-TEXT(SLOT-NUM)(POS-NUM:PIECE-LEN))
        IF N-DIGIT NOT = EXPECTED-DIGIT
            PERFORM FAIL-NOW
        END-IF
        IF NODE-NUM = CHUNK-COUNT
            IF PTR NOT = O-TAIL(SLOT-NUM)
               OR N-NEXT NOT = NULL
                PERFORM FAIL-NOW
            END-IF
        ELSE
            IF PTR = O-TAIL(SLOT-NUM) OR N-NEXT = NULL
                PERFORM FAIL-NOW
            END-IF
        END-IF
        SET PREVIOUS-PTR TO PTR
        SET PTR TO N-NEXT
        ADD PIECE-LEN TO POS-NUM
        MOVE 9 TO PIECE-LEN
        IF COUNT-WALK = 1 AND SLOT-NUM <= 5
            ADD 1 TO CNT-CHUNK-CHECKS
        END-IF
    END-PERFORM
    MOVE 1 TO SNAP-VALID(SLOT-NUM)
    IF COUNT-WALK = 1 AND SLOT-NUM <= 5
        ADD 1 TO CNT-OWNER-WALKS
    END-IF.

FREE-OWNER.
    MOVE "FREE-A" TO OP
    MOVE 0 TO STATUS-CODE
    SET ADDRESS OF ARG-A TO ADDRESS OF OWNER-SLOT(SLOT-NUM)
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        ARG-A EMPTY-B EMPTY-OUT EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0
        PERFORM FAIL-NOW
    END-IF
    MOVE 0 TO SNAP-VALID(SLOT-NUM) LIVE-SLOT(SLOT-NUM)
    PERFORM ASSERT-EMPTY.

CHECK-HEAP.
    MOVE "HEAP-LIVE" TO OP
    MOVE 0 TO TXT-LEN STATUS-CODE
    CALL "BIG-INTEGER-SERVICE" USING OP TXT TXT-LEN
        EMPTY-A EMPTY-B EMPTY-OUT EMPTY-REM
        COMPARE-CODE STATUS-CODE
    IF STATUS-CODE NOT = 0 OR TXT-LEN NOT = EXPECTED-HEAP
        PERFORM FAIL-NOW
    END-IF
    ADD 1 TO CNT-HEAP-SAMPLES
    IF EXPECTED-HEAP = 0
        ADD 1 TO CNT-HEAP-ZERO
    END-IF.

FAIL-NOW.
    ADD 1 TO CNT-UNEXPECTED-FAILURES
    DISPLAY "STAGE55_FAILURE=" FUNCTION TRIM(PHASE-NAME)
        " case=" CNT-CASES " permutation=" PERM-ID
        " key=" PERM-KEY " step=" STEP-NUM
        " slot=" SLOT-NUM " node=" NODE-NUM
        " status=" STATUS-CODE " text-len=" TXT-LEN
        " expected-heap=" EXPECTED-HEAP
    DISPLAY "STAGE55_UNEXPECTED_FAILURES=" CNT-UNEXPECTED-FAILURES
    MOVE 1 TO RETURN-CODE
    STOP RUN.
