; D8 test: 2 valid contexts (5 oracle + 10 context + 1 repeat each), 2 invalid = 34.
load "src/exact_integer.logo
load "src/source_language_catalog.logo
load "src/monster_bootstrap.logo
load "src/stage02_boundary.logo
load "src/stage02_context.logo
load "src/stage02_counts.logo
load "src/stage02_stones.logo
load "src/stage02_hidden.logo
load "src/stage02_visible_prefix.logo
load "test/normative_reference.logo
make "D8.N 0
make "D8.CASES 0
make "D8.FAIL "false

to d8.require :ok :tag
  make "D8.N (:D8.N + 1)
  if not :ok [
    make "D8.FAIL "true
    print sentence [STAGE_2_DISCOVERY_08_TESTO_FALIIS:] :tag
  ]
end

to d8.same :a :b :keys
  if emptyp :keys [output "true]
  if not (equalp (monster.context.get :a first :keys) (monster.context.get :b first :keys)) [output "false]
  output d8.same :a :b (butfirst :keys)
end

to d8.oracle.prefix :i :counts :stones :hidden :acc
  if :i > 5 [output :acc]
  localmake "v nr.visible.one :i :counts :stones :hidden :acc
  output d8.oracle.prefix (:i + 1) :counts :stones :hidden (lput :v :acc)
end

to d8.check.values :i :actual :expected :tag
  if :i > 5 [stop]
  d8.require (equalp (item :i :actual) (item :i :expected)) (list :tag :i)
  d8.check.values (:i + 1) :actual :expected :tag
end

to d8.valid :calculation :target :tag
  localmake "before monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts :calculation :target))
  localmake "after monster.stage02.visible.prefix :before
  localmake "actual monster.context.get :after "visiblePrefix
  localmake "counts nr.work.counts :calculation :target
  localmake "stones nr.stones
  localmake "hidden nr.hidden.build :counts :stones
  localmake "expected d8.oracle.prefix 1 :counts :stones :hidden []
  make "D8.CASES (:D8.CASES + 1)
  if (count :actual) <> 5 [print [STAGE_2_DISCOVERY_08_SHAPE_FALIIS] stop]
  if (count :expected) <> 5 [print [STAGE_2_DISCOVERY_08_ORACLE_SHAPE_FALIIS] stop]
  d8.check.values 1 :actual :expected :tag
  d8.require (equalp (monster.context.get :after "calculationDay) :calculation) (list :tag [calculation])
  d8.require (equalp (monster.context.get :after "targetDay) :target) (list :tag [target])
  d8.require (d8.same :before :after [normalizedCalculationDay normalizedTargetDay actionCount targetCount distanceCount connectionCount directionCount]) (list :tag [counts])
  d8.require (equalp (monster.context.get :after "stoneSeries) (monster.context.get :before "stoneSeries)) (list :tag [stones])
  d8.require (equalp (monster.context.get :after "hiddenSeeds) (monster.context.get :before "hiddenSeeds)) (list :tag [hidden])
  d8.require (equalp (monster.context.get :after "phase) "VISIBLE_PREFIX_READY) (list :tag [phase])
  d8.require (equalp (monster.context.get :after "mode) "STAGE_2_DISCOVERY_08) (list :tag [mode])
  d8.require (equalp (monster.context.get :after "status) "VISIBLE_PREFIX_ONLY) (list :tag [status])
  d8.require (equalp (monster.context.get :after "metrics) [stage02.dispatch stage02.counts stage02.stones stage02.hidden stage02.visible]) (list :tag [metrics])
  d8.require (equalp (monster.context.get :after "logs) [stage02.enter stage02.normalized stage02.counts.ready stage02.stones.ready stage02.hidden.ready stage02.visible.prefix.ready]) (list :tag [logs])
  d8.require (equalp (monster.stage02.visible.prefix :before) :after) (list :tag [determinism])
end

to d8.invalid :ctx :tag
  make "D8.CASES (:D8.CASES + 1)
  d8.require (equalp (monster.stage02.visible.prefix :ctx) :ctx) :tag
end

to stage02.discovery08.run
  d8.valid [0 [0]] [1 [1]] [zero_one]
  d8.valid (nr.foundation) (nr.tablets) [foundation_tablets]
  d8.invalid (monster.stage02.workcounts [0 [1]] [0 [0]]) [failed]
  d8.invalid (monster.stage02.stones (monster.stage02.workcounts [0 [0]] [1 [1]])) [stones_only]
  if :D8.FAIL [print [STAGE_2_DISCOVERY_08_FALIIS] stop]
  if :D8.CASES <> 4 [print [STAGE_2_DISCOVERY_08_CASE_COUNT_FALIIS] stop]
  if :D8.N <> 34 [print [STAGE_2_DISCOVERY_08_CHECK_COUNT_FALIIS] stop]
  print sentence [STAGE_2_DISCOVERY_08_CASES_PASIS] :D8.CASES
  print sentence [STAGE_2_DISCOVERY_08_CHECKS_PASIS] :D8.N
  print [STAGE_2_DISCOVERY_08_PASIS]
end

stage02.discovery08.run
