>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE08-DISCOVERY-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-CASE PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-HEAP PIC 9(4) COMP-5 VALUE 0.
01 WS-EXPECTED PIC X(32) VALUE SPACES.
01 WS-C-LITERAL PIC X(96) VALUE SPACES.
01 WS-T-LITERAL PIC X(96) VALUE SPACES.
01 WS-SAVED-C-SIGN PIC S9(4) COMP-5 VALUE 0.
01 WS-SAVED-C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
01 WS-SAVED-C-HEAD USAGE POINTER.
01 WS-SAVED-C-TAIL USAGE POINTER.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-T-INPUT.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    MOVE "0" TO WS-C-LITERAL
    PERFORM SAME-INPUT-CASE
    MOVE SPACES TO WS-C-LITERAL
    MOVE "1" TO WS-C-LITERAL(1:1)
    MOVE ALL "0" TO WS-C-LITERAL(2:63)
    PERFORM SAME-INPUT-CASE
    MOVE SPACES TO WS-C-LITERAL
    MOVE "-1" TO WS-C-LITERAL(1:2)
    MOVE ALL "0" TO WS-C-LITERAL(3:63)
    PERFORM SAME-INPUT-CASE
    MOVE "-2" TO WS-C-LITERAL
    MOVE "2" TO WS-T-LITERAL
    PERFORM DISTINCT-CASE
    MOVE "5" TO WS-C-LITERAL
    MOVE "7" TO WS-T-LITERAL
    PERFORM OCCUPIED-RESULT-CASE
    PERFORM RESULT-C-ALIAS-CASE
    PERFORM RESULT-T-ALIAS-CASE
    PERFORM INVALID-SIGN-CASE

    MOVE "HEAP-LIVE" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-LEN = 0
        MOVE 0 TO WS-HEAP
    ELSE
        MOVE 1 TO WS-HEAP
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE8_HEAP_ERROR=" WS-STATUS
    END-IF
    DISPLAY "STAGE8_CASES_RUN=" WS-CASE
    DISPLAY "STAGE8_PASS=" WS-PASS
    DISPLAY "STAGE8_REPRODUCED_FAILURES=0"
    DISPLAY "STAGE8_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE8_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-CASE = 8 AND WS-PASS = 8 AND WS-FAIL = 0
       AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE8_ALIAS_DISCOVERY_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE8_ALIAS_DISCOVERY_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

RESET-CASE.
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
              O-SIGN O-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL
        O-HEAD O-TAIL TO NULL
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE.

INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE8_INIT_C_FAILED=" WS-STATUS
    END-IF.
INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE8_INIT_T_FAILED=" WS-STATUS
    END-IF.

SNAPSHOT-C.
    MOVE C-SIGN TO WS-SAVED-C-SIGN
    MOVE C-CHUNKS TO WS-SAVED-C-CHUNKS
    SET WS-SAVED-C-HEAD TO C-HEAD
    SET WS-SAVED-C-TAIL TO C-TAIL.
CHECK-C-UNCHANGED.
    IF C-SIGN NOT = WS-SAVED-C-SIGN
       OR C-CHUNKS NOT = WS-SAVED-C-CHUNKS
       OR C-HEAD NOT = WS-SAVED-C-HEAD
       OR C-TAIL NOT = WS-SAVED-C-TAIL
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE8_INPUT_MUTATED=" WS-CASE
    END-IF.

CHECK-DISTANCE.
    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-LEN > 0
       AND WS-TEXT(1:WS-LEN) = FUNCTION TRIM(WS-EXPECTED)
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE8_DISTANCE_MISMATCH=" WS-CASE
    END-IF.

SAME-INPUT-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        PERFORM SNAPSHOT-C
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-C-INPUT WS-C-INPUT WS-OUTPUT
            WS-STATUS WS-MESSAGE
        IF WS-STATUS = 0 AND
           WS-MESSAGE = "PATCH03:DISTANCE-PATCH"
            MOVE "1" TO WS-EXPECTED
            PERFORM CHECK-DISTANCE
        ELSE
            ADD 1 TO WS-FAIL
            DISPLAY "STAGE8_SAME_INPUT_FAILED=" WS-STATUS
        END-IF
        PERFORM CHECK-C-UNCHANGED
    END-IF
    PERFORM RELEASE-CASE.

DISTINCT-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        PERFORM INIT-T
        IF WS-STATUS = 0
            PERFORM SNAPSHOT-C
            CALL "MONSTER-DISTANCE" USING
                WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
                WS-STATUS WS-MESSAGE
            IF WS-STATUS = 0
                MOVE "5" TO WS-EXPECTED
                PERFORM CHECK-DISTANCE
            ELSE
                ADD 1 TO WS-FAIL
                DISPLAY "STAGE8_DISTINCT_FAILED=" WS-STATUS
            END-IF
            PERFORM CHECK-C-UNCHANGED
        END-IF
    END-IF
    PERFORM RELEASE-CASE.

OCCUPIED-RESULT-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        PERFORM INIT-T
        IF WS-STATUS = 0
            MOVE "17" TO WS-TEXT
            MOVE 2 TO WS-LEN
            MOVE "INIT-TEXT" TO WS-OP
            MOVE 0 TO WS-STATUS
            CALL "BIG-INTEGER-SERVICE" USING
                WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
                WS-OUTPUT WS-EMPTY-REM WS-CMP WS-STATUS
            IF WS-STATUS = 0
                CALL "MONSTER-DISTANCE" USING
                    WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
                    WS-STATUS WS-MESSAGE
                IF WS-STATUS = 175 AND O-SIGN = 1
                   AND O-HEAD NOT = NULL
                    MOVE "17" TO WS-EXPECTED
                    PERFORM CHECK-DISTANCE
                ELSE
                    ADD 1 TO WS-FAIL
                    DISPLAY "STAGE8_OCCUPIED_FAILED=" WS-STATUS
                END-IF
            END-IF
        END-IF
    END-IF
    PERFORM RELEASE-CASE.

RESULT-C-ALIAS-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        PERFORM INIT-T
        IF WS-STATUS = 0
            PERFORM SNAPSHOT-C
            CALL "MONSTER-DISTANCE" USING
                WS-ACTION WS-C-INPUT WS-T-INPUT WS-C-INPUT
                WS-STATUS WS-MESSAGE
            IF WS-STATUS = 175
                ADD 1 TO WS-PASS
            ELSE
                ADD 1 TO WS-FAIL
                DISPLAY "STAGE8_RESULT_C_ALIAS_FAILED=" WS-STATUS
            END-IF
            PERFORM CHECK-C-UNCHANGED
        END-IF
    END-IF
    PERFORM RELEASE-CASE.

RESULT-T-ALIAS-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        PERFORM INIT-T
        IF WS-STATUS = 0
            PERFORM SNAPSHOT-C
            CALL "MONSTER-DISTANCE" USING
                WS-ACTION WS-C-INPUT WS-T-INPUT WS-T-INPUT
                WS-STATUS WS-MESSAGE
            IF WS-STATUS = 175
                ADD 1 TO WS-PASS
            ELSE
                ADD 1 TO WS-FAIL
                DISPLAY "STAGE8_RESULT_T_ALIAS_FAILED=" WS-STATUS
            END-IF
            PERFORM CHECK-C-UNCHANGED
        END-IF
    END-IF
    PERFORM RELEASE-CASE.

INVALID-SIGN-CASE.
    ADD 1 TO WS-CASE
    PERFORM RESET-CASE
    PERFORM INIT-C
    IF WS-STATUS = 0
        MOVE 2 TO C-SIGN
        CALL "MONSTER-DISTANCE" USING
            WS-ACTION WS-C-INPUT WS-C-INPUT WS-OUTPUT
            WS-STATUS WS-MESSAGE
        IF WS-STATUS = 22 AND O-HEAD = NULL
           AND O-TAIL = NULL AND O-CHUNKS = 0
            ADD 1 TO WS-PASS
        ELSE
            ADD 1 TO WS-FAIL
            DISPLAY "STAGE8_INVALID_SIGN_FAILED=" WS-STATUS
        END-IF
        MOVE 1 TO C-SIGN
    END-IF
    PERFORM RELEASE-CASE.

RELEASE-CASE.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-FAIL END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-FAIL END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 ADD 1 TO WS-FAIL END-IF.
END PROGRAM STAGE08-DISCOVERY-TESTS.
