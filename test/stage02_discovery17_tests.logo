; D17 native: 1 valid (1+11+1 checks) + 4 invalid = 17 checks; independent 1..46 oracle.
load "src/exact_integer.logo
load "src/source_language_catalog.logo
load "src/monster_bootstrap.logo
load "src/stage02_boundary.logo
load "src/stage02_context.logo
load "src/stage02_counts.logo
load "src/stage02_stones.logo
load "src/stage02_hidden.logo
load "src/stage02_visible_prefix.logo
load "src/stage02_visible_ten.logo
load "src/stage02_visible_fifteen.logo
load "src/stage02_visible_twenty.logo
load "src/stage02_visible_twentyfive.logo
load "src/stage02_visible_thirty.logo
load "src/stage02_visible_thirtyfive.logo
load "src/stage02_visible_forty.logo
load "src/stage02_visible_fortyfive.logo
load "src/stage02_visible_fortysix.logo
load "test/normative_reference.logo
make "D17.N 0
make "D17.CASES 0
make "D17.FAIL "false

to d17.require :ok :tag
  make "D17.N (:D17.N + 1)
  if not :ok [
    make "D17.FAIL "true
    print sentence [STAGE_2_DISCOVERY_17_TESTO_FALIIS:] :tag
  ]
end

to d17.same :a :b :keys
  if emptyp :keys [output "true]
  if not (equalp (monster.context.get :a first :keys) (monster.context.get :b first :keys)) [output "false]
  output d17.same :a :b (butfirst :keys)
end

to d17.take :n :values
  if :n = 0 [output []]
  output fput (first :values) (d17.take (:n - 1) (butfirst :values))
end

to d17.oracle.fortysix :i :counts :stones :hidden :acc
  if :i > 46 [output :acc]
  localmake "v nr.visible.one :i :counts :stones :hidden :acc
  output d17.oracle.fortysix (:i + 1) :counts :stones :hidden (lput :v :acc)
end

to d17.check.tail :i :actual :expected :tag
  if :i > 46 [stop]
  d17.require (equalp (item :i :actual) (item :i :expected)) (list :tag :i)
  d17.check.tail (:i + 1) :actual :expected :tag
end

to d17.valid :calculation :target :tag
  print sentence [STAGE_2_DISCOVERY_17_CASE_BEGIN] :tag
  localmake "before monster.stage02.visible.fortyfive (monster.stage02.visible.forty (monster.stage02.visible.thirtyfive (monster.stage02.visible.thirty (monster.stage02.visible.twentyfive (monster.stage02.visible.twenty (monster.stage02.visible.fifteen (monster.stage02.visible.ten (monster.stage02.visible.prefix (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts :calculation :target)))))))))))
  localmake "after monster.stage02.visible.fortysix :before
  localmake "actual monster.context.get :after "visibleFortySix
  localmake "counts nr.work.counts :calculation :target
  localmake "stones nr.stones
  localmake "hidden nr.hidden.build :counts :stones
  localmake "expected d17.oracle.fortysix 1 :counts :stones :hidden []
  make "D17.CASES (:D17.CASES + 1)
  if (count :actual) <> 46 [print [STAGE_2_DISCOVERY_17_SHAPE_FALIIS] stop]
  if (count :expected) <> 46 [print [STAGE_2_DISCOVERY_17_ORACLE_SHAPE_FALIIS] stop]
  d17.check.tail 46 :actual :expected :tag
  d17.require (equalp (monster.context.get :after "calculationDay) :calculation) (list :tag [calculation])
  d17.require (equalp (monster.context.get :after "targetDay) :target) (list :tag [target])
  d17.require (d17.same :before :after [normalizedCalculationDay normalizedTargetDay actionCount targetCount distanceCount connectionCount directionCount]) (list :tag [counts])
  d17.require (equalp (monster.context.get :after "stoneSeries) (monster.context.get :before "stoneSeries)) (list :tag [stones])
  d17.require (equalp (monster.context.get :after "hiddenSeeds) (monster.context.get :before "hiddenSeeds)) (list :tag [hidden])
  d17.require (and (d17.same :before :after [visiblePrefix visibleTen visibleFifteen visibleTwenty visibleTwentyFive visibleThirty visibleThirtyFive visibleForty visibleFortyFive]) (equalp (d17.take 45 :actual) (monster.context.get :before "visibleFortyFive))) (list :tag [prefix])
  d17.require (equalp (monster.context.get :after "phase) "VISIBLE_FORTYSIX_READY) (list :tag [phase])
  d17.require (equalp (monster.context.get :after "mode) "STAGE_2_DISCOVERY_17) (list :tag [mode])
  d17.require (equalp (monster.context.get :after "status) "VISIBLE_FORTYSIX_ONLY) (list :tag [status])
  d17.require (equalp (monster.context.get :after "metrics) [stage02.dispatch stage02.counts stage02.stones stage02.hidden stage02.visible stage02.visible.ten stage02.visible.fifteen stage02.visible.twenty stage02.visible.twentyfive stage02.visible.thirty stage02.visible.thirtyfive stage02.visible.forty stage02.visible.fortyfive stage02.visible.fortysix]) (list :tag [metrics])
  d17.require (equalp (monster.context.get :after "logs) [stage02.enter stage02.normalized stage02.counts.ready stage02.stones.ready stage02.hidden.ready stage02.visible.prefix.ready stage02.visible.ten.ready stage02.visible.fifteen.ready stage02.visible.twenty.ready stage02.visible.twentyfive.ready stage02.visible.thirty.ready stage02.visible.thirtyfive.ready stage02.visible.forty.ready stage02.visible.fortyfive.ready stage02.visible.fortysix.ready]) (list :tag [logs])
  d17.require (equalp (monster.stage02.visible.fortysix :before) :after) (list :tag [determinism])
  print sentence [STAGE_2_DISCOVERY_17_CASE_END] :tag
  output :before
end

to d17.invalid :ctx :tag
  print sentence [STAGE_2_DISCOVERY_17_CASE_BEGIN] :tag
  make "D17.CASES (:D17.CASES + 1)
  d17.require (equalp (monster.stage02.visible.fortysix :ctx) :ctx) :tag
  print sentence [STAGE_2_DISCOVERY_17_CASE_END] :tag
end

to stage02.discovery17.run
  localmake "prefix d17.valid (nr.foundation) (nr.tablets) [foundation_tablets]
  d17.invalid (monster.stage02.workcounts [0 [1]] [0 [0]]) [failed_validation]
  d17.invalid (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts [0 [0]] [1 [1]]))) [hidden_only]
  d17.invalid (monster.context.put :prefix "visibleFortyFive (d17.take 44 (monster.context.get :prefix "visibleFortyFive))) [short_fortyfour]
  d17.invalid (monster.context.put :prefix "visibleFortyFive "bad) [not_a_list]
  if :D17.FAIL [print [STAGE_2_DISCOVERY_17_FALIIS] stop]
  if :D17.CASES <> 5 [print [STAGE_2_DISCOVERY_17_CASE_COUNT_FALIIS] stop]
  if :D17.N <> 17 [print [STAGE_2_DISCOVERY_17_CHECK_COUNT_FALIIS] stop]
  print sentence [STAGE_2_DISCOVERY_17_CASES_PASIS] :D17.CASES
  print sentence [STAGE_2_DISCOVERY_17_CHECKS_PASIS] :D17.N
  print [STAGE_2_DISCOVERY_17_PASIS]
end

stage02.discovery17.run
