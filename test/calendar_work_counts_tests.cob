>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. WORK-COUNTS-INTEGRATION-TEST.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16).
01 WS-TEXT PIC X(8192).
01 WS-LEN PIC 9(18) COMP-5.
01 WS-CMP PIC S9(4) COMP-5.
01 WS-STATUS PIC 9(4) COMP-5.
01 WS-DIRECTION PIC 9 COMP-5.
01 WS-EXPECTED-DIR PIC 9 COMP-5.
01 WS-INPUT-C PIC X(80).
01 WS-INPUT-T PIC X(80).
01 WS-EXPECTED.
   05 WS-EXPECT OCCURS 4 TIMES PIC X(80).
01 WS-CHECKED PIC 9(4) COMP-5 VALUE 0.
01 C-DAY.
   05 CD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 CD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 CD-HEAD USAGE POINTER.
   05 CD-TAIL USAGE POINTER.
01 T-DAY.
   05 TD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 TD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 TD-HEAD USAGE POINTER.
   05 TD-TAIL USAGE POINTER.
01 C-COUNT.
   05 CC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 CC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 CC-HEAD USAGE POINTER.
   05 CC-TAIL USAGE POINTER.
01 T-COUNT.
   05 TC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 TC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 TC-HEAD USAGE POINTER.
   05 TC-TAIL USAGE POINTER.
01 DISTANCE-OUT.
   05 DI-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DI-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DI-HEAD USAGE POINTER.
   05 DI-TAIL USAGE POINTER.
01 CONNECTION-OUT.
   05 CN-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 CN-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 CN-HEAD USAGE POINTER.
   05 CN-TAIL USAGE POINTER.
01 DUMMY-A.
   05 DA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DA-HEAD USAGE POINTER.
   05 DA-TAIL USAGE POINTER.
01 DUMMY-B.
   05 DB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DB-HEAD USAGE POINTER.
   05 DB-TAIL USAGE POINTER.
01 DUMMY-OUT.
   05 DO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DO-HEAD USAGE POINTER.
   05 DO-TAIL USAGE POINTER.
01 DUMMY-REM.
   05 DR-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 DR-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 DR-HEAD USAGE POINTER.
   05 DR-TAIL USAGE POINTER.
PROCEDURE DIVISION.
MAIN.
    SET CD-HEAD CD-TAIL
        TD-HEAD TD-TAIL
        CC-HEAD CC-TAIL
        TC-HEAD TC-TAIL
        DI-HEAD DI-TAIL
        CN-HEAD CN-TAIL
        DA-HEAD DA-TAIL
        DB-HEAD DB-TAIL
        DO-HEAD DO-TAIL
        DR-HEAD DR-TAIL TO NULL
    MOVE "-15055671" TO WS-INPUT-C
    MOVE "-15055671" TO WS-INPUT-T
    MOVE "1" TO WS-EXPECT(1)
    MOVE "1" TO WS-EXPECT(2)
    MOVE "1" TO WS-EXPECT(3)
    MOVE "2" TO WS-EXPECT(4)
    MOVE 2 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-15055672" TO WS-INPUT-C
    MOVE "-15055671" TO WS-INPUT-T
    MOVE "2" TO WS-EXPECT(1)
    MOVE "1" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "3" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-15055671" TO WS-INPUT-C
    MOVE "-15055670" TO WS-INPUT-T
    MOVE "1" TO WS-EXPECT(1)
    MOVE "3" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "4" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-15055670" TO WS-INPUT-C
    MOVE "-15055672" TO WS-INPUT-T
    MOVE "3" TO WS-EXPECT(1)
    MOVE "2" TO WS-EXPECT(2)
    MOVE "3" TO WS-EXPECT(3)
    MOVE "5" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-15055672" TO WS-INPUT-C
    MOVE "-15055673" TO WS-INPUT-T
    MOVE "2" TO WS-EXPECT(1)
    MOVE "4" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "6" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "0" TO WS-INPUT-C
    MOVE "0" TO WS-INPUT-T
    MOVE "30111343" TO WS-EXPECT(1)
    MOVE "30111343" TO WS-EXPECT(2)
    MOVE "1" TO WS-EXPECT(3)
    MOVE "60222686" TO WS-EXPECT(4)
    MOVE 2 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "0" TO WS-INPUT-C
    MOVE "1" TO WS-INPUT-T
    MOVE "30111343" TO WS-EXPECT(1)
    MOVE "30111345" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "60222688" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "1" TO WS-INPUT-C
    MOVE "0" TO WS-INPUT-T
    MOVE "30111345" TO WS-EXPECT(1)
    MOVE "30111343" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "60222688" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-1" TO WS-INPUT-C
    MOVE "0" TO WS-INPUT-T
    MOVE "30111341" TO WS-EXPECT(1)
    MOVE "30111343" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "60222684" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "0" TO WS-INPUT-C
    MOVE "-1" TO WS-INPUT-T
    MOVE "30111343" TO WS-EXPECT(1)
    MOVE "30111341" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "60222684" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-999999999999999999999999999999" TO WS-INPUT-C
    MOVE "999999999999999999999999999999" TO WS-INPUT-T
    MOVE "1999999999999999999999969888656" TO WS-EXPECT(1)
    MOVE "2000000000000000000000030111341" TO WS-EXPECT(2)
    MOVE "1999999999999999999999999999999" TO WS-EXPECT(3)
    MOVE "3999999999999999999999999999997" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "999999999999999999999999999999" TO WS-INPUT-C
    MOVE "-999999999999999999999999999999" TO WS-INPUT-T
    MOVE "2000000000000000000000030111341" TO WS-EXPECT(1)
    MOVE "1999999999999999999999969888656" TO WS-EXPECT(2)
    MOVE "1999999999999999999999999999999" TO WS-EXPECT(3)
    MOVE "3999999999999999999999999999997" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-1000000000" TO WS-INPUT-C
    MOVE "1000000000" TO WS-INPUT-T
    MOVE "1969888658" TO WS-EXPECT(1)
    MOVE "2030111343" TO WS-EXPECT(2)
    MOVE "2000000001" TO WS-EXPECT(3)
    MOVE "4000000001" TO WS-EXPECT(4)
    MOVE 3 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "1000000000" TO WS-INPUT-C
    MOVE "999999999" TO WS-INPUT-T
    MOVE "2030111343" TO WS-EXPECT(1)
    MOVE "2030111341" TO WS-EXPECT(2)
    MOVE "2" TO WS-EXPECT(3)
    MOVE "4060222684" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    MOVE "-15043326" TO WS-INPUT-C
    MOVE "-15109992" TO WS-INPUT-T
    MOVE "24691" TO WS-EXPECT(1)
    MOVE "108642" TO WS-EXPECT(2)
    MOVE "66667" TO WS-EXPECT(3)
    MOVE "133333" TO WS-EXPECT(4)
    MOVE 1 TO WS-EXPECTED-DIR
    PERFORM RUN-CASE
    DISPLAY "WORK_COUNTS_CASES=" WS-CHECKED
    DISPLAY "WORK_COUNTS_GATE=PASS"
    MOVE 0 TO RETURN-CODE
    STOP RUN.
RUN-CASE.
    MOVE "INIT-TEXT" TO WS-OP
    MOVE WS-INPUT-C TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-INPUT-C))
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        DUMMY-A DUMMY-B C-DAY DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    MOVE WS-INPUT-T TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-INPUT-T))
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        DUMMY-A DUMMY-B T-DAY DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "CALENDAR-WORK-COUNTS" USING C-DAY T-DAY
        C-COUNT T-COUNT DISTANCE-OUT CONNECTION-OUT
        WS-DIRECTION WS-STATUS
    PERFORM REQUIRE-OK
    IF WS-DIRECTION NOT = WS-EXPECTED-DIR PERFORM FAIL-CASE END-IF
    MOVE "TO-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        C-COUNT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-EXPECT(1))
        PERFORM FAIL-CASE
    END-IF
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        T-COUNT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-EXPECT(2))
        PERFORM FAIL-CASE
    END-IF
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        DISTANCE-OUT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-EXPECT(3))
        PERFORM FAIL-CASE
    END-IF
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        CONNECTION-OUT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-EXPECT(4))
        PERFORM FAIL-CASE
    END-IF
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        C-DAY DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-INPUT-C)
        PERFORM FAIL-CASE
    END-IF
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        T-DAY DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF FUNCTION TRIM(WS-TEXT) NOT = FUNCTION TRIM(WS-INPUT-T)
        PERFORM FAIL-CASE
    END-IF
    *> 已有输出必须被拒绝，保留原有结果。
    CALL "CALENDAR-WORK-COUNTS" USING C-DAY T-DAY
        C-COUNT T-COUNT DISTANCE-OUT CONNECTION-OUT
        WS-DIRECTION WS-STATUS
    IF WS-STATUS NOT = 175 PERFORM FAIL-CASE END-IF
    MOVE "FREE-A" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        C-COUNT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        T-COUNT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        DISTANCE-OUT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        CONNECTION-OUT DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        C-DAY DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        T-DAY DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    MOVE "HEAP-LIVE" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING WS-OP WS-TEXT WS-LEN
        DUMMY-A DUMMY-B DUMMY-OUT DUMMY-REM WS-CMP WS-STATUS
    PERFORM REQUIRE-OK
    IF WS-LEN NOT = 0 PERFORM FAIL-CASE END-IF
    ADD 1 TO WS-CHECKED.
REQUIRE-OK.
    IF WS-STATUS NOT = 0 PERFORM FAIL-CASE END-IF.
FAIL-CASE.
    DISPLAY "WORK_COUNTS_FAIL case=" WS-CHECKED
        " status=" WS-STATUS " text=" FUNCTION TRIM(WS-TEXT)
    MOVE 1 TO RETURN-CODE
    STOP RUN.
END PROGRAM WORK-COUNTS-INTEGRATION-TEST.
