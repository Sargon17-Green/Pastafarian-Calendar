RUN-PAIR.
    MOVE 0 TO C-SIGN C-CHUNKS T-SIGN T-CHUNKS
              O-SIGN O-CHUNKS
    SET C-HEAD C-TAIL T-HEAD T-TAIL O-HEAD O-TAIL TO NULL
    PERFORM INIT-C
    IF WS-STATUS = 0 PERFORM INIT-T END-IF
    IF WS-STATUS = 0
        PERFORM SNAPSHOT-INPUTS
        PERFORM RUN-ONE
    ELSE
        ADD 1 TO WS-RUNS
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE21_INPUT_INIT_FAILED=" WS-STATUS
    END-IF
    PERFORM RELEASE-PAIR.

INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

INIT-T.
    MOVE FUNCTION TRIM(WS-T-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-T-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.

SNAPSHOT-INPUTS.
    MOVE C-SIGN TO WS-SAVED-C-SIGN
    MOVE C-CHUNKS TO WS-SAVED-C-CHUNKS
    SET WS-SAVED-C-HEAD TO C-HEAD
    SET WS-SAVED-C-TAIL TO C-TAIL
    MOVE T-SIGN TO WS-SAVED-T-SIGN
    MOVE T-CHUNKS TO WS-SAVED-T-CHUNKS
    SET WS-SAVED-T-HEAD TO T-HEAD
    SET WS-SAVED-T-TAIL TO T-TAIL.

RUN-ONE.
    ADD 1 TO WS-RUNS
    MOVE 0 TO WS-STATUS WS-CASE-FAIL
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-T-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "PATCH03:DISTANCE-PATCH"
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE21_DISTANCE_STATUS_FAILED=" WS-RUNS
    ELSE
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
           FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED))
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE21_TEXT_LENGTH_FAILED=" WS-RUNS
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
               FUNCTION TRIM(WS-EXPECTED)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE21_ORACLE_FAILED=" WS-RUNS
            END-IF
        END-IF
    END-IF
    PERFORM CHECK-INPUTS
    PERFORM FREE-OUTPUT
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
    END-IF.

CHECK-INPUTS.
    IF C-SIGN NOT = WS-SAVED-C-SIGN
       OR C-CHUNKS NOT = WS-SAVED-C-CHUNKS
       OR C-HEAD NOT = WS-SAVED-C-HEAD
       OR C-TAIL NOT = WS-SAVED-C-TAIL
       OR T-SIGN NOT = WS-SAVED-T-SIGN
       OR T-CHUNKS NOT = WS-SAVED-T-CHUNKS
       OR T-HEAD NOT = WS-SAVED-T-HEAD
       OR T-TAIL NOT = WS-SAVED-T-TAIL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE21_INPUT_MUTATED=" WS-RUNS
    END-IF.

FREE-OUTPUT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN NOT = 0
       OR O-CHUNKS NOT = 0 OR O-HEAD NOT = NULL
       OR O-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE21_OUTPUT_FREE_FAILED=" WS-RUNS
    END-IF.

RELEASE-PAIR.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE21_C_FREE_FAILED=" WS-STATUS
    END-IF
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-T-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE21_T_FREE_FAILED=" WS-STATUS
    END-IF.
END PROGRAM STAGE21-DISCOVERY-TESTS.
