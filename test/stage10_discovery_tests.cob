>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STAGE10-DISCOVERY-TESTS.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-ACTION PIC X(16) VALUE "DISTANCE-PATCH".
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160) VALUE SPACES.
01 WS-RUNS PIC 9(4) COMP-5 VALUE 0.
01 WS-PASS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9(4) COMP-5 VALUE 0.
01 WS-HEAP PIC 9(4) COMP-5 VALUE 0.
01 WS-A-LITERAL PIC X(96) VALUE SPACES.
01 WS-B-LITERAL PIC X(96) VALUE SPACES.
01 WS-C-LITERAL PIC X(96) VALUE SPACES.
01 WS-EXPECTED PIC X(96) VALUE SPACES.
01 WS-EXPECT-AB PIC X(96) VALUE SPACES.
01 WS-EXPECT-BC PIC X(96) VALUE SPACES.
01 WS-EXPECT-AC PIC X(96) VALUE SPACES.
01 WS-A-INPUT.
   05 A-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 A-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 A-HEAD USAGE POINTER.
   05 A-TAIL USAGE POINTER.
01 WS-A-SAVED.
   05 AS-SIGN PIC S9(4) COMP-5.
   05 AS-CHUNKS PIC 9(18) COMP-5.
   05 AS-HEAD USAGE POINTER.
   05 AS-TAIL USAGE POINTER.
01 WS-B-INPUT.
   05 B-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 B-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 B-HEAD USAGE POINTER.
   05 B-TAIL USAGE POINTER.
01 WS-B-SAVED.
   05 BS-SIGN PIC S9(4) COMP-5.
   05 BS-CHUNKS PIC 9(18) COMP-5.
   05 BS-HEAD USAGE POINTER.
   05 BS-TAIL USAGE POINTER.
01 WS-C-INPUT.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-C-SAVED.
   05 CS-SIGN PIC S9(4) COMP-5.
   05 CS-CHUNKS PIC 9(18) COMP-5.
   05 CS-HEAD USAGE POINTER.
   05 CS-TAIL USAGE POINTER.
01 WS-OUTPUT.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.
PROCEDURE DIVISION.
MAIN.
    SET A-HEAD A-TAIL B-HEAD B-TAIL C-HEAD C-TAIL
        O-HEAD O-TAIL EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL TO NULL
    MOVE "-2" TO WS-A-LITERAL
    MOVE "0" TO WS-B-LITERAL
    MOVE "2" TO WS-C-LITERAL
    MOVE "3" TO WS-EXPECT-AB WS-EXPECT-BC
    MOVE "5" TO WS-EXPECT-AC
    PERFORM RUN-TRIPLE
    MOVE "-10" TO WS-A-LITERAL
    MOVE "0" TO WS-B-LITERAL
    MOVE "5" TO WS-C-LITERAL
    MOVE "11" TO WS-EXPECT-AB
    MOVE "6" TO WS-EXPECT-BC
    MOVE "16" TO WS-EXPECT-AC
    PERFORM RUN-TRIPLE
    MOVE "7" TO WS-A-LITERAL
    MOVE "3" TO WS-B-LITERAL
    MOVE "-1" TO WS-C-LITERAL
    MOVE "5" TO WS-EXPECT-AB WS-EXPECT-BC
    MOVE "9" TO WS-EXPECT-AC
    PERFORM RUN-TRIPLE
    MOVE SPACES TO WS-A-LITERAL WS-B-LITERAL WS-C-LITERAL
        WS-EXPECT-AB WS-EXPECT-BC WS-EXPECT-AC
    MOVE "1" TO WS-A-LITERAL(1:1)
    MOVE ALL "0" TO WS-A-LITERAL(2:63)
    MOVE "0" TO WS-B-LITERAL
    MOVE "-1" TO WS-C-LITERAL(1:2)
    MOVE ALL "0" TO WS-C-LITERAL(3:63)
    MOVE "1" TO WS-EXPECT-AB(1:1)
    MOVE ALL "0" TO WS-EXPECT-AB(2:62)
    MOVE "1" TO WS-EXPECT-AB(64:1)
    MOVE WS-EXPECT-AB TO WS-EXPECT-BC
    MOVE "2" TO WS-EXPECT-AC(1:1)
    MOVE ALL "0" TO WS-EXPECT-AC(2:62)
    MOVE "1" TO WS-EXPECT-AC(64:1)
    PERFORM RUN-TRIPLE
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS = 0 AND WS-LEN = 0
        MOVE 0 TO WS-HEAP
    ELSE
        MOVE 1 TO WS-HEAP
        ADD 1 TO WS-FAIL
    END-IF
    DISPLAY "STAGE10_RUNS=" WS-RUNS
    DISPLAY "STAGE10_PASS=" WS-PASS
    DISPLAY "STAGE10_UNEXPECTED_FAILURES=" WS-FAIL
    DISPLAY "STAGE10_HEAP_LIVE_POST_RELEASE=" WS-HEAP
    IF WS-RUNS = 20 AND WS-PASS = 20
       AND WS-FAIL = 0 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_STAGE10_ALGEBRAIC_DISCOVERY_NATIVE"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_STAGE10_ALGEBRAIC_DISCOVERY_NATIVE"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.
RUN-TRIPLE.
    MOVE 0 TO A-SIGN A-CHUNKS B-SIGN B-CHUNKS
        C-SIGN C-CHUNKS O-SIGN O-CHUNKS
    SET A-HEAD A-TAIL B-HEAD B-TAIL C-HEAD C-TAIL
        O-HEAD O-TAIL TO NULL
    PERFORM INIT-A
    IF WS-STATUS = 0 PERFORM INIT-B END-IF
    IF WS-STATUS = 0 PERFORM INIT-C END-IF
    IF WS-STATUS = 0
        MOVE WS-A-INPUT TO WS-A-SAVED
        MOVE WS-B-INPUT TO WS-B-SAVED
        MOVE WS-C-INPUT TO WS-C-SAVED
        PERFORM CALL-AB
        PERFORM CALL-BA
        PERFORM CALL-BC
        PERFORM CALL-CB
        PERFORM CALL-AC
    ELSE
        ADD 5 TO WS-RUNS
        ADD 5 TO WS-FAIL
        DISPLAY "STAGE10_INIT_FAILED=" WS-STATUS
    END-IF
    PERFORM RELEASE-TRIPLE.
INIT-A.
    MOVE FUNCTION TRIM(WS-A-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-A-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-A-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.
INIT-B.
    MOVE FUNCTION TRIM(WS-B-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-B-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-B-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.
INIT-C.
    MOVE FUNCTION TRIM(WS-C-LITERAL) TO WS-TEXT
    COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-C-LITERAL))
    MOVE "INIT-TEXT" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C-INPUT WS-EMPTY-REM WS-CMP WS-STATUS.
CALL-AB.
    ADD 1 TO WS-RUNS
    MOVE WS-EXPECT-AB TO WS-EXPECTED
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-A-INPUT WS-B-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    PERFORM CHECK-CALL.
CALL-BA.
    ADD 1 TO WS-RUNS
    MOVE WS-EXPECT-AB TO WS-EXPECTED
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-B-INPUT WS-A-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    PERFORM CHECK-CALL.
CALL-BC.
    ADD 1 TO WS-RUNS
    MOVE WS-EXPECT-BC TO WS-EXPECTED
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-B-INPUT WS-C-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    PERFORM CHECK-CALL.
CALL-CB.
    ADD 1 TO WS-RUNS
    MOVE WS-EXPECT-BC TO WS-EXPECTED
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-C-INPUT WS-B-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    PERFORM CHECK-CALL.
CALL-AC.
    ADD 1 TO WS-RUNS
    MOVE WS-EXPECT-AC TO WS-EXPECTED
    MOVE 0 TO WS-STATUS
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-DISTANCE" USING
        WS-ACTION WS-A-INPUT WS-C-INPUT WS-OUTPUT
        WS-STATUS WS-MESSAGE
    PERFORM CHECK-CALL.
CHECK-CALL.
    MOVE 0 TO WS-CASE-FAIL
    IF WS-STATUS NOT = 0 OR
       WS-MESSAGE NOT = "PATCH03:DISTANCE-PATCH"
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE10_STATUS_FAILED=" WS-RUNS
    ELSE
        MOVE "TO-TEXT" TO WS-OP
        MOVE SPACES TO WS-TEXT
        MOVE 0 TO WS-LEN WS-STATUS
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR WS-LEN NOT =
           FUNCTION LENGTH(FUNCTION TRIM(WS-EXPECTED))
            MOVE 1 TO WS-CASE-FAIL
            DISPLAY "STAGE10_LENGTH_FAILED=" WS-RUNS
        ELSE
            IF WS-TEXT(1:WS-LEN) NOT =
               FUNCTION TRIM(WS-EXPECTED)
                MOVE 1 TO WS-CASE-FAIL
                DISPLAY "STAGE10_ORACLE_FAILED=" WS-RUNS
            END-IF
        END-IF
    END-IF
    IF WS-A-INPUT NOT = WS-A-SAVED OR
       WS-B-INPUT NOT = WS-B-SAVED OR
       WS-C-INPUT NOT = WS-C-SAVED
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE10_INPUT_MUTATED=" WS-RUNS
    END-IF
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OUTPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0 OR O-SIGN NOT = 0
       OR O-CHUNKS NOT = 0 OR O-HEAD NOT = NULL
       OR O-TAIL NOT = NULL
        MOVE 1 TO WS-CASE-FAIL
        DISPLAY "STAGE10_OUTPUT_FREE_FAILED=" WS-RUNS
    END-IF
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        ADD 1 TO WS-FAIL
    END-IF.
RELEASE-TRIPLE.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-A-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE10_RELEASE_A_FAILED"
    END-IF
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-B-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE10_RELEASE_B_FAILED"
    END-IF
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-C-INPUT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO WS-FAIL
        DISPLAY "STAGE10_RELEASE_C_FAILED"
    END-IF.
END PROGRAM STAGE10-DISCOVERY-TESTS.
