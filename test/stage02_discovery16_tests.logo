; D16 native: 1 valid (5+11+1 checks) + 4 invalid = 21 checks; independent 1..45 oracle.
load "src/exact_integer.logo
load "src/source_language_catalog.logo
load "src/monster_bootstrap.logo
load "src/stage02_boundary.logo
load "src/stage02_context.logo
load "src/stage02_counts.logo
load "src/stage02_stones.logo
load "src/stage02_hidden.logo
load "src/stage02_visible_prefix.logo
load "src/stage02_visible_ten.logo
load "src/stage02_visible_fifteen.logo
load "src/stage02_visible_twenty.logo
load "src/stage02_visible_twentyfive.logo
load "src/stage02_visible_thirty.logo
load "src/stage02_visible_thirtyfive.logo
load "src/stage02_visible_forty.logo
load "src/stage02_visible_fortyfive.logo
load "test/normative_reference.logo
make "D16.N 0
make "D16.CASES 0
make "D16.FAIL "false

to d16.require :ok :tag
  make "D16.N (:D16.N + 1)
  if not :ok [
    make "D16.FAIL "true
    print sentence [STAGE_2_DISCOVERY_16_TESTO_FALIIS:] :tag
  ]
end

to d16.same :a :b :keys
  if emptyp :keys [output "true]
  if not (equalp (monster.context.get :a first :keys) (monster.context.get :b first :keys)) [output "false]
  output d16.same :a :b (butfirst :keys)
end

to d16.take :n :values
  if :n = 0 [output []]
  output fput (first :values) (d16.take (:n - 1) (butfirst :values))
end

to d16.oracle.fortyfive :i :counts :stones :hidden :acc
  if :i > 45 [output :acc]
  localmake "v nr.visible.one :i :counts :stones :hidden :acc
  output d16.oracle.fortyfive (:i + 1) :counts :stones :hidden (lput :v :acc)
end

to d16.check.tail :i :actual :expected :tag
  if :i > 45 [stop]
  d16.require (equalp (item :i :actual) (item :i :expected)) (list :tag :i)
  d16.check.tail (:i + 1) :actual :expected :tag
end

to d16.valid :calculation :target :tag
  print sentence [STAGE_2_DISCOVERY_16_CASE_BEGIN] :tag
  localmake "before monster.stage02.visible.forty (monster.stage02.visible.thirtyfive (monster.stage02.visible.thirty (monster.stage02.visible.twentyfive (monster.stage02.visible.twenty (monster.stage02.visible.fifteen (monster.stage02.visible.ten (monster.stage02.visible.prefix (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts :calculation :target))))))))))
  localmake "after monster.stage02.visible.fortyfive :before
  localmake "actual monster.context.get :after "visibleFortyFive
  localmake "counts nr.work.counts :calculation :target
  localmake "stones nr.stones
  localmake "hidden nr.hidden.build :counts :stones
  localmake "expected d16.oracle.fortyfive 1 :counts :stones :hidden []
  make "D16.CASES (:D16.CASES + 1)
  if (count :actual) <> 45 [print [STAGE_2_DISCOVERY_16_SHAPE_FALIIS] stop]
  if (count :expected) <> 45 [print [STAGE_2_DISCOVERY_16_ORACLE_SHAPE_FALIIS] stop]
  d16.check.tail 41 :actual :expected :tag
  d16.require (equalp (monster.context.get :after "calculationDay) :calculation) (list :tag [calculation])
  d16.require (equalp (monster.context.get :after "targetDay) :target) (list :tag [target])
  d16.require (d16.same :before :after [normalizedCalculationDay normalizedTargetDay actionCount targetCount distanceCount connectionCount directionCount]) (list :tag [counts])
  d16.require (equalp (monster.context.get :after "stoneSeries) (monster.context.get :before "stoneSeries)) (list :tag [stones])
  d16.require (equalp (monster.context.get :after "hiddenSeeds) (monster.context.get :before "hiddenSeeds)) (list :tag [hidden])
  d16.require (and (d16.same :before :after [visiblePrefix visibleTen visibleFifteen visibleTwenty visibleTwentyFive visibleThirty visibleThirtyFive visibleForty]) (equalp (d16.take 40 :actual) (monster.context.get :before "visibleForty))) (list :tag [prefix])
  d16.require (equalp (monster.context.get :after "phase) "VISIBLE_FORTYFIVE_READY) (list :tag [phase])
  d16.require (equalp (monster.context.get :after "mode) "STAGE_2_DISCOVERY_16) (list :tag [mode])
  d16.require (equalp (monster.context.get :after "status) "VISIBLE_FORTYFIVE_ONLY) (list :tag [status])
  d16.require (equalp (monster.context.get :after "metrics) [stage02.dispatch stage02.counts stage02.stones stage02.hidden stage02.visible stage02.visible.ten stage02.visible.fifteen stage02.visible.twenty stage02.visible.twentyfive stage02.visible.thirty stage02.visible.thirtyfive stage02.visible.forty stage02.visible.fortyfive]) (list :tag [metrics])
  d16.require (equalp (monster.context.get :after "logs) [stage02.enter stage02.normalized stage02.counts.ready stage02.stones.ready stage02.hidden.ready stage02.visible.prefix.ready stage02.visible.ten.ready stage02.visible.fifteen.ready stage02.visible.twenty.ready stage02.visible.twentyfive.ready stage02.visible.thirty.ready stage02.visible.thirtyfive.ready stage02.visible.forty.ready stage02.visible.fortyfive.ready]) (list :tag [logs])
  d16.require (equalp (monster.stage02.visible.fortyfive :before) :after) (list :tag [determinism])
  print sentence [STAGE_2_DISCOVERY_16_CASE_END] :tag
  output :before
end

to d16.invalid :ctx :tag
  print sentence [STAGE_2_DISCOVERY_16_CASE_BEGIN] :tag
  make "D16.CASES (:D16.CASES + 1)
  d16.require (equalp (monster.stage02.visible.forty :ctx) :ctx) :tag
  print sentence [STAGE_2_DISCOVERY_16_CASE_END] :tag
end

to stage02.discovery16.run
  localmake "prefix d16.valid (nr.foundation) (nr.tablets) [foundation_tablets]
  d16.invalid (monster.stage02.workcounts [0 [1]] [0 [0]]) [failed_validation]
  d16.invalid (monster.stage02.hidden (monster.stage02.stones (monster.stage02.workcounts [0 [0]] [1 [1]]))) [hidden_only]
  d16.invalid (monster.context.put :prefix "visibleForty (d16.take 39 (monster.context.get :prefix "visibleForty))) [short_thirtynine]
  d16.invalid (monster.context.put :prefix "visibleForty "bad) [not_a_list]
  if :D16.FAIL [print [STAGE_2_DISCOVERY_16_FALIIS] stop]
  if :D16.CASES <> 5 [print [STAGE_2_DISCOVERY_16_CASE_COUNT_FALIIS] stop]
  if :D16.N <> 21 [print [STAGE_2_DISCOVERY_16_CHECK_COUNT_FALIIS] stop]
  print sentence [STAGE_2_DISCOVERY_16_CASES_PASIS] :D16.CASES
  print sentence [STAGE_2_DISCOVERY_16_CHECKS_PASIS] :D16.N
  print [STAGE_2_DISCOVERY_16_PASIS]
end

stage02.discovery16.run
