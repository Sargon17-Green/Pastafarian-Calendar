>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. BOOTSTRAP-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 TESTS-RUN PIC 9(4) COMP-5 VALUE 0.
01 TESTS-FAILED PIC 9(4) COMP-5 VALUE 0.
01 WS-ACTION PIC X(16).
01 WS-NAME PIC X(16).
01 WS-OP PIC X(16).
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-DIRECTION PIC 9 COMP-5 VALUE 0.
01 WS-SCALAR PIC S9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-SMALL PIC S9(18) COMP-5 VALUE 0.
01 WS-MESSAGE PIC X(160).
01 WS-CUTLET-NAME PIC X(96).
01 WS-MONTH-NAME PIC X(96).
01 WS-DAY-IN-CUTLET PIC 9(4) COMP-5 VALUE 0.
01 WS-DAY-IN-MONTH PIC 9(4) COMP-5 VALUE 0.

01 WS-ZERO.
   05 WZ-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WZ-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WZ-HEAD USAGE POINTER.
   05 WZ-TAIL USAGE POINTER.
01 WS-CDAY.
   05 WC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WC-HEAD USAGE POINTER.
   05 WC-TAIL USAGE POINTER.
01 WS-TDAY.
   05 WT-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WT-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WT-HEAD USAGE POINTER.
   05 WT-TAIL USAGE POINTER.
01 WS-OUT.
   05 WO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WO-HEAD USAGE POINTER.
   05 WO-TAIL USAGE POINTER.
01 WS-C-COUNT.
   05 WCC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WCC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WCC-HEAD USAGE POINTER.
   05 WCC-TAIL USAGE POINTER.
01 WS-T-COUNT.
   05 WTC-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WTC-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WTC-HEAD USAGE POINTER.
   05 WTC-TAIL USAGE POINTER.
01 WS-DISTANCE.
   05 WD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WD-HEAD USAGE POINTER.
   05 WD-TAIL USAGE POINTER.
01 WS-CONNECTION.
   05 WN-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WN-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WN-HEAD USAGE POINTER.
   05 WN-TAIL USAGE POINTER.
01 WS-YEAR-NUMBER.
   05 WY-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WY-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WY-HEAD USAGE POINTER.
   05 WY-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    SET WZ-HEAD WZ-TAIL WC-HEAD WC-TAIL WT-HEAD WT-TAIL WO-HEAD WO-TAIL
        WCC-HEAD WCC-TAIL WTC-HEAD WTC-TAIL WD-HEAD WD-TAIL
        WN-HEAD WN-TAIL WY-HEAD WY-TAIL TO NULL

    CALL "BIG-INTEGER-TESTS" USING TESTS-RUN TESTS-FAILED
    CALL "NORMATIVE-PRIMITIVE-TESTS" USING TESTS-RUN TESTS-FAILED
    CALL "SOURCE-CATALOG-TESTS" USING TESTS-RUN TESTS-FAILED
    CALL "FAMILY-BRUTEFORCE-TESTS" USING TESTS-RUN TESTS-FAILED
    CALL "SELECTION-TESTS" USING TESTS-RUN TESTS-FAILED
    PERFORM TEST-BASE-SHELL
    PERFORM TEST-WORK-COUNTS
    PERFORM TEST-CALENDAR-ORACLE-SMOKE

    DISPLAY "已执行测试: " TESTS-RUN
    DISPLAY "失败测试: " TESTS-FAILED
    IF TESTS-FAILED = 0
        DISPLAY "第 1 阶段引导测试通过。"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "第 1 阶段引导测试失败。"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

LOAD-FOUNDATION.
    MOVE "FOUNDATION" TO WS-NAME
    MOVE 0 TO WS-STATUS
    CALL "ORACLE-CONSTANTS" USING WS-NAME WS-CDAY WS-STATUS
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 无法装入基础日常量。"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-CDAY TO WS-TDAY.

TEST-BASE-SHELL.
    PERFORM LOAD-FOUNDATION
    IF WS-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE "PING" TO WS-ACTION
    MOVE SPACES TO WS-MESSAGE
    CALL "MONSTER-BOOTSTRAP" USING WS-ACTION WS-CDAY WS-TDAY WS-STATUS WS-MESSAGE
    ADD 1 TO TESTS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 基础怪物外壳未通过自身验证。"
    END-IF.

TEST-WORK-COUNTS.
    PERFORM LOAD-FOUNDATION
    IF WS-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE "WORK-COUNTS" TO WS-ACTION
    CALL "NORMATIVE-BASIC" USING WS-ACTION WS-CDAY WS-TDAY WS-C-COUNT WS-T-COUNT WS-DISTANCE WS-CONNECTION WS-DIRECTION WS-STATUS
    ADD 1 TO TESTS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 同日 workCounts 调用失败。"
    ELSE
        MOVE WS-C-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-1
        MOVE WS-T-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-1
        MOVE WS-DISTANCE TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-1
        MOVE WS-CONNECTION TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-2
        IF WS-DIRECTION NOT = 2
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 同日方向应为 2。"
        END-IF
    END-IF

    PERFORM LOAD-FOUNDATION
    IF WS-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-CDAY TO WS-OUT
    MOVE 1 TO WS-SCALAR
    PERFORM ADD-SMALL-OUT
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 无法构造基础日后一天。"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-OUT TO WS-TDAY
    MOVE "WORK-COUNTS" TO WS-ACTION
    CALL "NORMATIVE-BASIC" USING WS-ACTION WS-CDAY WS-TDAY WS-C-COUNT WS-T-COUNT WS-DISTANCE WS-CONNECTION WS-DIRECTION WS-STATUS
    ADD 1 TO TESTS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 基础日后一天 workCounts 调用失败。"
    ELSE
        MOVE WS-C-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-1
        MOVE WS-T-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-3
        MOVE WS-DISTANCE TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-2
        MOVE WS-CONNECTION TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-4
        IF WS-DIRECTION NOT = 3
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 向未来一天的方向应为 3。"
        END-IF
    END-IF

    PERFORM LOAD-FOUNDATION
    IF WS-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-CDAY TO WS-OUT
    MOVE -1 TO WS-SCALAR
    PERFORM ADD-SMALL-OUT
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 无法构造基础日前一天。"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-OUT TO WS-TDAY
    MOVE "WORK-COUNTS" TO WS-ACTION
    CALL "NORMATIVE-BASIC" USING WS-ACTION WS-CDAY WS-TDAY WS-C-COUNT WS-T-COUNT WS-DISTANCE WS-CONNECTION WS-DIRECTION WS-STATUS
    ADD 1 TO TESTS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 基础日前一天 workCounts 调用失败。"
    ELSE
        MOVE WS-C-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-1
        MOVE WS-T-COUNT TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-2
        MOVE WS-DISTANCE TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-2
        MOVE WS-CONNECTION TO WS-OUT PERFORM ASSERT-OUT-SMALL-IS-3
        IF WS-DIRECTION NOT = 1
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 向过去一天的方向应为 1。"
        END-IF
    END-IF.

TEST-CALENDAR-ORACLE-SMOKE.
    PERFORM LOAD-FOUNDATION
    IF WS-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE SPACES TO WS-CUTLET-NAME WS-MONTH-NAME
    MOVE 0 TO WS-DAY-IN-CUTLET WS-DAY-IN-MONTH WS-STATUS
    CALL "NORMATIVE-ORACLE" USING WS-CDAY WS-TDAY WS-YEAR-NUMBER WS-CUTLET-NAME WS-DAY-IN-CUTLET WS-MONTH-NAME WS-DAY-IN-MONTH WS-STATUS
    ADD 1 TO TESTS-RUN
    IF WS-STATUS NOT = 0
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 完整规范 oracle 的基础日烟雾测试失败。"
    ELSE
        IF FUNCTION LENGTH(FUNCTION TRIM(WS-CUTLET-NAME)) = 0
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 完整规范 oracle 未返回肉饼名称。"
        END-IF
        IF FUNCTION LENGTH(FUNCTION TRIM(WS-MONTH-NAME)) = 0
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 完整规范 oracle 未返回月份名称。"
        END-IF
        IF WS-DAY-IN-CUTLET < 1 OR WS-DAY-IN-MONTH < 1
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 完整规范 oracle 返回了非正的日序号。"
        END-IF
        IF WY-SIGN < -1 OR WY-SIGN > 1
            ADD 1 TO TESTS-FAILED
            DISPLAY "失败: 完整规范 oracle 返回了无效的年份符号。"
        END-IF
    END-IF.

ADD-SMALL-OUT.
    MOVE WS-OUT TO WS-CDAY
    MOVE "ADD-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-CDAY WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS.

OUT-TO-SMALL.
    MOVE "TO-SMALL" TO WS-OP
    CALL "ORACLE-BIGINT" USING WS-OP WS-OUT WS-ZERO WS-OUT WS-SCALAR WS-CMP WS-SMALL WS-STATUS.

ASSERT-OUT-SMALL-IS-1.
    PERFORM OUT-TO-SMALL
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 1
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 任意精度结果应为 1。"
    END-IF.
ASSERT-OUT-SMALL-IS-2.
    PERFORM OUT-TO-SMALL
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 2
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 任意精度结果应为 2。"
    END-IF.
ASSERT-OUT-SMALL-IS-3.
    PERFORM OUT-TO-SMALL
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 3
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 任意精度结果应为 3。"
    END-IF.
ASSERT-OUT-SMALL-IS-4.
    PERFORM OUT-TO-SMALL
    IF WS-STATUS NOT = 0 OR WS-SMALL NOT = 4
        ADD 1 TO TESTS-FAILED
        DISPLAY "失败: 任意精度结果应为 4。"
    END-IF.
END PROGRAM BOOTSTRAP-TESTS.
