(define (regular-mod x d)
  (if (< d 1)
      (error "Divisor skal være positiv" d)
      (modulo x d)))

(define (save x)
  (+ 1 (regular-mod (- x 1) M)))

(define (square x) (* x x))

(define (ceil-div a b)
  (if (or (< a 0) (< b 1))
      (error "Ugyldige argumenter til loftsdivision" a b)
      (quotient (+ a b -1) b)))

(define (wrap1 position size)
  (+ 1 (regular-mod (- position 1) size)))

(define (vref1 v i) (vector-ref v (- i 1)))
(define (vset1! v i x) (vector-set! v (- i 1) x))

(define (copy-vector v)
  (let* ((n (vector-length v))
         (out (make-vector n)))
    (let loop ((i 0))
      (if (= i n)
          out
          (begin
            (vector-set! out i (vector-ref v i))
            (loop (+ i 1)))))))

(define (vector->plain-list v)
  (let loop ((i 0) (out '()))
    (if (= i (vector-length v))
        (reverse out)
        (loop (+ i 1) (cons (vector-ref v i) out)))))

(define (list-ref1 xs i)
  (list-ref xs (- i 1)))

(define (range-inclusive first last)
  (let loop ((i first) (out '()))
    (if (> i last)
        (reverse out)
        (loop (+ i 1) (cons i out)))))

(define (take-list xs n)
  (if (= n 0)
      '()
      (cons (car xs) (take-list (cdr xs) (- n 1)))))

(define (assoc-equal key table)
  (cond
   ((null? table) #f)
   ((equal? key (caar table)) (car table))
   (else (assoc-equal key (cdr table)))))

(define (insert-stable item sorted before?)
  (cond
   ((null? sorted) (list item))
   ((before? item (car sorted)) (cons item sorted))
   (else (cons (car sorted)
               (insert-stable item (cdr sorted) before?)))))

(define (stable-sort xs before?)
  (let loop ((rest xs) (out '()))
    (if (null? rest)
        out
        (loop (cdr rest) (insert-stable (car rest) out before?)))))

(define (factorial n)
  (let loop ((i 2) (r 1))
    (if (> i n)
        r
        (loop (+ i 1) (* r i)))))

(define (falling-factorial n k)
  (let loop ((j 0) (r 1))
    (if (= j k)
        r
        (loop (+ j 1) (* r (- n j))))))

(define (remove-at1 xs index1)
  (cond
   ((null? xs) (error "Indeks uden for listen" index1))
   ((= index1 1) (cdr xs))
   (else (cons (car xs) (remove-at1 (cdr xs) (- index1 1))))))

(define (day-count day)
  (cond
   ((= day FOUNDATION-DAY) 1)
   ((> day FOUNDATION-DAY) (+ (* 2 (- day FOUNDATION-DAY)) 1))
   (else (* 2 (- FOUNDATION-DAY day)))))

;; Arbejdsmængder lagres som: handling, mål, afstand, forbindelse, retning.
(define (work-counts calculation-day target-day)
  (let* ((c (day-count calculation-day))
         (t (day-count target-day))
         (distance (+ (abs (- target-day calculation-day)) 1))
         (connection (+ c t))
         (direction (cond ((< target-day calculation-day) 1)
                          ((= target-day calculation-day) 2)
                          (else 3))))
    (vector c t distance connection direction)))

(define (counts-action c) (vref1 c 1))
(define (counts-target c) (vref1 c 2))
(define (counts-distance c) (vref1 c 3))
(define (counts-connection c) (vref1 c 4))
(define (counts-direction c) (vref1 c 5))

(define (build-stones)
  (let ((table (make-vector 46)))
    (vector-set! table 0 (vector 17 29 43 71 101))
    (let loop ((i 2))
      (if (> i 46)
          table
          (let* ((old (vector-ref table (- i 2)))
                 (w (save (+ (square (vref1 old WHEAT))
                             (* 3 (vref1 old BARLEY)) i)))
                 (b (save (+ (square (vref1 old BARLEY))
                             (* 5 (vref1 old SALT))
                             (vref1 old WHEAT))))
                 (s (save (+ (square (vref1 old SALT))
                             (* 7 (vref1 old BITTER))
                             (vref1 old BARLEY))))
                 (m (save (+ (square (vref1 old BITTER))
                             (* 11 (vref1 old RED))
                             (vref1 old SALT))))
                 (r (save (+ (square (vref1 old RED))
                             (* 13 (vref1 old WHEAT))
                             (vref1 old BITTER)))))
            (vector-set! table (- i 1) (vector w b s m r))
            (loop (+ i 1)))))))

(define STONES (build-stones))

