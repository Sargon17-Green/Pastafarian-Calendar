with "gnatcoll_gmp.gpr";
project Issue29_V192_Panel is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj_v192";
   for Exec_Dir use "bin_v192";
   for Main use ("issue29_v192_panel.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Issue29_V192_Panel;
