>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. QA51B-FAULT-INJECTION-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-BASELINE PIC 9(18) COMP-5 VALUE 0.
01 WS-LOCAL-BASE PIC 9(18) COMP-5 VALUE 0.
01 WS-EXPECTED-HEAP PIC 9(18) COMP-5 VALUE 0.
01 WS-ASSERTIONS PIC 9(4) COMP-5 VALUE 0.
01 WS-CASES PIC 9(2) COMP-5 VALUE 0.
01 WS-PASS PIC 9(2) COMP-5 VALUE 0.
01 WS-UNEXPECTED PIC 9(4) COMP-5 VALUE 0.
01 WS-CASE-FAIL PIC 9 VALUE 0.
01 WS-COND PIC 9 VALUE 0.
01 WS-LABEL PIC X(80) VALUE SPACES.
01 WS-FAULT-CMD PIC X(8) VALUE SPACES.
01 WS-FAULT-TARGET PIC X(16) VALUE SPACES.
01 WS-FAULT-COUNT PIC 9(4) COMP-5 VALUE 0.
01 WS-FAULT-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-FAULT-TRIP PIC 9 COMP-5 VALUE 0.
01 WS-EXPECTED-FAULT-COUNT PIC 9(4) COMP-5 VALUE 0.
01 WS-EXPECTED-FAULT-STATUS PIC 9(4) COMP-5 VALUE 0.

01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-OUT.
   05 EO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EO-HEAD USAGE POINTER.
   05 EO-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

01 WS-C.
   05 C-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 C-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 C-HEAD USAGE POINTER.
   05 C-TAIL USAGE POINTER.
01 WS-C-SAVE.
   05 CS-SIGN PIC S9(4) COMP-5.
   05 CS-CHUNKS PIC 9(18) COMP-5.
   05 CS-HEAD USAGE POINTER.
   05 CS-TAIL USAGE POINTER.
01 WS-T.
   05 T-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 T-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 T-HEAD USAGE POINTER.
   05 T-TAIL USAGE POINTER.
01 WS-T-SAVE.
   05 TS-SIGN PIC S9(4) COMP-5.
   05 TS-CHUNKS PIC 9(18) COMP-5.
   05 TS-HEAD USAGE POINTER.
   05 TS-TAIL USAGE POINTER.
01 WS-RESULT.
   05 R-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 R-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 R-HEAD USAGE POINTER.
   05 R-TAIL USAGE POINTER.
01 WS-OWNER.
   05 O-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 O-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 O-HEAD USAGE POINTER.
   05 O-TAIL USAGE POINTER.
01 WS-OWNER-SAVE.
   05 OS-SIGN PIC S9(4) COMP-5.
   05 OS-CHUNKS PIC 9(18) COMP-5.
   05 OS-HEAD USAGE POINTER.
   05 OS-TAIL USAGE POINTER.
01 WS-PARTIAL.
   05 P-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 P-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 P-HEAD USAGE POINTER.
   05 P-TAIL USAGE POINTER.

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-DESCRIPTORS
    PERFORM INITIALIZE-INPUTS
    IF WS-UNEXPECTED = 0
        PERFORM CONTROL-SUCCESS
        PERFORM PARTIAL-CHAIN-ABORT
        PERFORM VALID-OWNER-FREE-FAILURE
        PERFORM HEAP-LIVE-FAILURE
        PERFORM PATCH-SUB-FAILURE
        PERFORM PATCH-INIT-FAILURE
        PERFORM PATCH-ADD-FAILURE
    END-IF
    PERFORM FINAL-CLEANUP
    DISPLAY "QA51B_CASES=" WS-CASES
    DISPLAY "QA51B_PASS=" WS-PASS
    DISPLAY "QA51B_ASSERTIONS=" WS-ASSERTIONS
    DISPLAY "QA51B_UNEXPECTED_FAILURES=" WS-UNEXPECTED
    DISPLAY "QA51B_HEAP_LIVE_FINAL=" WS-HEAP
    IF WS-CASES = 7 AND WS-PASS = 7
       AND WS-UNEXPECTED = 0 AND WS-HEAP = 0
        DISPLAY "RESULT=PASS_QA51B_TEST_BUILD_ONLY_FAULT_INJECTION"
        DISPLAY "QA51B_GATE=PASS_TEST_BUILD_ONLY"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "RESULT=FAIL_QA51B_TEST_BUILD_ONLY_FAULT_INJECTION"
        DISPLAY "QA51B_GATE=FAIL"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

INITIALIZE-DESCRIPTORS.
    MOVE 0 TO EA-SIGN EA-CHUNKS EB-SIGN EB-CHUNKS
        EO-SIGN EO-CHUNKS ER-SIGN ER-CHUNKS
        C-SIGN C-CHUNKS T-SIGN T-CHUNKS
        R-SIGN R-CHUNKS O-SIGN O-CHUNKS
        P-SIGN P-CHUNKS
    SET EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        EO-HEAD EO-TAIL ER-HEAD ER-TAIL
        C-HEAD C-TAIL T-HEAD T-TAIL
        R-HEAD R-TAIL O-HEAD O-TAIL
        P-HEAD P-TAIL TO NULL
    MOVE "RESET" TO WS-FAULT-CMD
    MOVE SPACES TO WS-FAULT-TARGET
    MOVE 0 TO WS-FAULT-COUNT WS-FAULT-STATUS
        WS-FAULT-TRIP
    CALL "QA51B-FAULT-CONTROL" USING
        WS-FAULT-CMD WS-FAULT-TARGET WS-FAULT-COUNT
        WS-FAULT-STATUS WS-FAULT-TRIP.

INITIALIZE-INPUTS.
    MOVE "INIT-TEXT" TO WS-OP
    MOVE "1000" TO WS-TEXT
    MOVE 4 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-C WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR C-HEAD = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "INIT_C_OWNER" TO WS-LABEL
    PERFORM ASSERT-CHECK

    MOVE "INIT-TEXT" TO WS-OP
    MOVE "990" TO WS-TEXT
    MOVE 3 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-T WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR T-HEAD = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "INIT_T_OWNER" TO WS-LABEL
    PERFORM ASSERT-CHECK

    MOVE WS-C TO WS-C-SAVE
    MOVE WS-T TO WS-T-SAVE
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP < 2
        MOVE 0 TO WS-COND
    END-IF
    MOVE "INPUT_HEAP_BASELINE_POSITIVE" TO WS-LABEL
    PERFORM ASSERT-CHECK
    MOVE WS-HEAP TO WS-BASELINE.

CONTROL-SUCCESS.
    MOVE 0 TO WS-CASE-FAIL
    PERFORM RESET-RESULT
    MOVE "PATCHED-DISTANCE" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "PATCHED-DISTANCE" USING
        WS-C WS-T WS-RESULT WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR R-HEAD = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PATCH_SUCCESS_STATUS_AND_OWNER" TO WS-LABEL
    PERFORM ASSERT-CHECK

    MOVE "TO-TEXT" TO WS-OP
    MOVE SPACES TO WS-TEXT
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-RESULT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR WS-LEN NOT = 2
       OR WS-TEXT(1:2) NOT = "11"
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PATCH_INDEPENDENT_RESULT_11" TO WS-LABEL
    PERFORM ASSERT-CHECK

    PERFORM FREE-RESULT
    PERFORM ASSERT-RESULT-EMPTY
    PERFORM ASSERT-INPUTS-PRESERVED
    PERFORM ASSERT-HEAP-BASELINE
    PERFORM END-CASE.

PARTIAL-CHAIN-ABORT.
    MOVE 0 TO WS-CASE-FAIL
    PERFORM RESET-PARTIAL
    PERFORM MEASURE-HEAP
    MOVE "ALLOC-R" TO WS-FAULT-TARGET
    MOVE 2 TO WS-FAULT-COUNT
    MOVE 96 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE "INIT-TEXT" TO WS-OP
    MOVE "123456789012345678" TO WS-TEXT
    MOVE 18 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-PARTIAL WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 96
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PARTIAL_CHAIN_INJECTED_STATUS_96" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM ASSERT-PARTIAL-EMPTY
    MOVE 2 TO WS-EXPECTED-FAULT-COUNT
    MOVE 96 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM ASSERT-INPUTS-PRESERVED
    PERFORM ASSERT-HEAP-BASELINE
    PERFORM END-CASE.

VALID-OWNER-FREE-FAILURE.
    MOVE 0 TO WS-CASE-FAIL
    MOVE "INIT-TEXT" TO WS-OP
    MOVE "123456789012345678" TO WS-TEXT
    MOVE 18 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-OWNER WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR O-HEAD = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FREE_OWNER_SETUP" TO WS-LABEL
    PERFORM ASSERT-CHECK
    MOVE WS-OWNER TO WS-OWNER-SAVE
    PERFORM MEASURE-HEAP
    MOVE WS-HEAP TO WS-LOCAL-BASE
    MOVE "FREE-A" TO WS-FAULT-TARGET
    MOVE 1 TO WS-FAULT-COUNT
    MOVE 94 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OWNER WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 94 OR WS-OWNER NOT = WS-OWNER-SAVE
        MOVE 0 TO WS-COND
    END-IF
    MOVE "VALID_OWNER_FREE_BOUNDARY_FAILURE_PRESERVES_DESCRIPTOR"
        TO WS-LABEL
    PERFORM ASSERT-CHECK
    MOVE 1 TO WS-EXPECTED-FAULT-COUNT
    MOVE 94 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = WS-LOCAL-BASE
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FREE_FAILURE_RETAINS_HEAP_BASELINE" TO WS-LABEL
    PERFORM ASSERT-CHECK

    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OWNER WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR O-HEAD NOT = NULL
       OR O-TAIL NOT = NULL OR O-SIGN NOT = 0
       OR O-CHUNKS NOT = 0
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FREE_RETRY_SUCCEEDS_AND_CLEARS_OWNER" TO WS-LABEL
    PERFORM ASSERT-CHECK
    COMPUTE WS-EXPECTED-HEAP =
        WS-LOCAL-BASE - OS-CHUNKS
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = WS-EXPECTED-HEAP
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FREE_RETRY_RESTORES_PRIOR_HEAP" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM END-CASE.

HEAP-LIVE-FAILURE.
    MOVE 0 TO WS-CASE-FAIL
    MOVE "INIT-TEXT" TO WS-OP
    MOVE "123456789" TO WS-TEXT
    MOVE 9 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-OWNER WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR O-HEAD = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_OWNER_SETUP" TO WS-LABEL
    PERFORM ASSERT-CHECK
    MOVE WS-OWNER TO WS-OWNER-SAVE
    PERFORM MEASURE-HEAP
    MOVE WS-HEAP TO WS-LOCAL-BASE
    MOVE "HEAP-LIVE" TO WS-FAULT-TARGET
    MOVE 1 TO WS-FAULT-COUNT
    MOVE 95 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 777 TO WS-LEN
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 95 OR WS-LEN NOT = 777
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_LIVE_FAILURE_PRESERVES_SENTINEL" TO WS-LABEL
    PERFORM ASSERT-CHECK
    MOVE 1 TO WS-EXPECTED-FAULT-COUNT
    MOVE 95 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = WS-LOCAL-BASE
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_LIVE_RETRY_MEASURES_SAME_VALUE" TO WS-LABEL
    PERFORM ASSERT-CHECK

    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-OWNER WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0 OR O-HEAD NOT = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_OWNER_CLEANUP" TO WS-LABEL
    PERFORM ASSERT-CHECK
    COMPUTE WS-EXPECTED-HEAP =
        WS-LOCAL-BASE - OS-CHUNKS
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = WS-EXPECTED-HEAP
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_OWNER_RELEASE_RESTORES_BASE" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM END-CASE.

PATCH-SUB-FAILURE.
    MOVE 0 TO WS-CASE-FAIL
    PERFORM RESET-RESULT
    MOVE "SUB" TO WS-FAULT-TARGET
    MOVE 1 TO WS-FAULT-COUNT
    MOVE 91 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE 0 TO WS-STATUS
    CALL "PATCHED-DISTANCE" USING
        WS-C WS-T WS-RESULT WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 91
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PATCH_SUB_FAILURE_PROPAGATES_91" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM ASSERT-RESULT-EMPTY
    PERFORM ASSERT-INPUTS-PRESERVED
    MOVE 1 TO WS-EXPECTED-FAULT-COUNT
    MOVE 91 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM ASSERT-HEAP-BASELINE
    PERFORM END-CASE.

PATCH-INIT-FAILURE.
    MOVE 0 TO WS-CASE-FAIL
    PERFORM RESET-RESULT
    MOVE "INIT-TEXT" TO WS-FAULT-TARGET
    MOVE 1 TO WS-FAULT-COUNT
    MOVE 92 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE 0 TO WS-STATUS
    CALL "PATCHED-DISTANCE" USING
        WS-C WS-T WS-RESULT WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 92
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PATCH_INIT_FAILURE_PROPAGATES_92" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM ASSERT-RESULT-EMPTY
    PERFORM ASSERT-INPUTS-PRESERVED
    MOVE 1 TO WS-EXPECTED-FAULT-COUNT
    MOVE 92 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM ASSERT-HEAP-BASELINE
    PERFORM END-CASE.

PATCH-ADD-FAILURE.
    MOVE 0 TO WS-CASE-FAIL
    PERFORM RESET-RESULT
    MOVE "ADD" TO WS-FAULT-TARGET
    MOVE 1 TO WS-FAULT-COUNT
    MOVE 93 TO WS-FAULT-STATUS
    PERFORM ARM-FAULT
    MOVE 0 TO WS-STATUS
    CALL "PATCHED-DISTANCE" USING
        WS-C WS-T WS-RESULT WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 93
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PATCH_ADD_FAILURE_PROPAGATES_93" TO WS-LABEL
    PERFORM ASSERT-CHECK
    PERFORM ASSERT-RESULT-EMPTY
    PERFORM ASSERT-INPUTS-PRESERVED
    MOVE 1 TO WS-EXPECTED-FAULT-COUNT
    MOVE 93 TO WS-EXPECTED-FAULT-STATUS
    PERFORM READ-FAULT
    PERFORM ASSERT-HEAP-BASELINE
    PERFORM END-CASE.

FINAL-CLEANUP.
    PERFORM RESET-FAULT
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    IF C-HEAD NOT = NULL
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-C WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR C-HEAD NOT = NULL
            ADD 1 TO WS-UNEXPECTED
            DISPLAY "QA51B_FINAL_C_FREE_FAILED"
        END-IF
    END-IF
    MOVE 0 TO WS-STATUS
    IF T-HEAD NOT = NULL
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-LEN WS-T WS-EMPTY-B
            WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0 OR T-HEAD NOT = NULL
            ADD 1 TO WS-UNEXPECTED
            DISPLAY "QA51B_FINAL_T_FREE_FAILED"
        END-IF
    END-IF
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = 0
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FINAL_HEAP_ZERO" TO WS-LABEL
    PERFORM ASSERT-CHECK.

RESET-RESULT.
    MOVE 0 TO R-SIGN R-CHUNKS
    SET R-HEAD R-TAIL TO NULL.

RESET-PARTIAL.
    MOVE 0 TO P-SIGN P-CHUNKS
    SET P-HEAD P-TAIL TO NULL.

FREE-RESULT.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-RESULT WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FREE_SUCCESS_RESULT" TO WS-LABEL
    PERFORM ASSERT-CHECK.

ASSERT-RESULT-EMPTY.
    MOVE 1 TO WS-COND
    IF R-SIGN NOT = 0 OR R-CHUNKS NOT = 0
       OR R-HEAD NOT = NULL OR R-TAIL NOT = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "RESULT_DESCRIPTOR_EMPTY" TO WS-LABEL
    PERFORM ASSERT-CHECK.

ASSERT-PARTIAL-EMPTY.
    MOVE 1 TO WS-COND
    IF P-SIGN NOT = 0 OR P-CHUNKS NOT = 0
       OR P-HEAD NOT = NULL OR P-TAIL NOT = NULL
        MOVE 0 TO WS-COND
    END-IF
    MOVE "PARTIAL_OUTPUT_DESCRIPTOR_EMPTY" TO WS-LABEL
    PERFORM ASSERT-CHECK.

ASSERT-INPUTS-PRESERVED.
    MOVE 1 TO WS-COND
    IF WS-C NOT = WS-C-SAVE OR WS-T NOT = WS-T-SAVE
        MOVE 0 TO WS-COND
    END-IF
    MOVE "INPUT_DESCRIPTORS_PRESERVED" TO WS-LABEL
    PERFORM ASSERT-CHECK.

ASSERT-HEAP-BASELINE.
    PERFORM MEASURE-HEAP
    MOVE 1 TO WS-COND
    IF WS-HEAP NOT = WS-BASELINE
        MOVE 0 TO WS-COND
    END-IF
    MOVE "HEAP_RESTORED_TO_INPUT_BASELINE" TO WS-LABEL
    PERFORM ASSERT-CHECK.

MEASURE-HEAP.
    MOVE "HEAP-LIVE" TO WS-OP
    MOVE 0 TO WS-LEN WS-STATUS
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-LEN WS-EMPTY-A WS-EMPTY-B
        WS-EMPTY-OUT WS-EMPTY-REM WS-CMP WS-STATUS
    MOVE 1 TO WS-COND
    IF WS-STATUS NOT = 0
        MOVE 0 TO WS-COND
        MOVE 0 TO WS-HEAP
    ELSE
        MOVE WS-LEN TO WS-HEAP
    END-IF
    MOVE "HEAP_LIVE_SERVICE_SUCCESS" TO WS-LABEL
    PERFORM ASSERT-CHECK.

ARM-FAULT.
    MOVE "ARM" TO WS-FAULT-CMD
    MOVE 0 TO WS-FAULT-TRIP
    CALL "QA51B-FAULT-CONTROL" USING
        WS-FAULT-CMD WS-FAULT-TARGET WS-FAULT-COUNT
        WS-FAULT-STATUS WS-FAULT-TRIP
    MOVE 1 TO WS-COND
    IF WS-FAULT-TRIP NOT = 0
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FAULT_ARMED" TO WS-LABEL
    PERFORM ASSERT-CHECK.

READ-FAULT.
    MOVE "READ" TO WS-FAULT-CMD
    MOVE 0 TO WS-FAULT-TRIP
    CALL "QA51B-FAULT-CONTROL" USING
        WS-FAULT-CMD WS-FAULT-TARGET WS-FAULT-COUNT
        WS-FAULT-STATUS WS-FAULT-TRIP
    MOVE 1 TO WS-COND
    IF WS-FAULT-COUNT NOT = WS-EXPECTED-FAULT-COUNT
       OR WS-FAULT-STATUS NOT = WS-EXPECTED-FAULT-STATUS
       OR WS-FAULT-TRIP NOT = 1
        MOVE 0 TO WS-COND
    END-IF
    MOVE "FAULT_TRIGGERED_ON_EXPECTED_CALL" TO WS-LABEL
    PERFORM ASSERT-CHECK.

RESET-FAULT.
    MOVE "RESET" TO WS-FAULT-CMD
    MOVE SPACES TO WS-FAULT-TARGET
    MOVE 0 TO WS-FAULT-COUNT WS-FAULT-STATUS
        WS-FAULT-TRIP
    CALL "QA51B-FAULT-CONTROL" USING
        WS-FAULT-CMD WS-FAULT-TARGET WS-FAULT-COUNT
        WS-FAULT-STATUS WS-FAULT-TRIP.

END-CASE.
    ADD 1 TO WS-CASES
    IF WS-CASE-FAIL = 0
        ADD 1 TO WS-PASS
    ELSE
        DISPLAY "QA51B_CASE_FAILED=" WS-CASES
    END-IF.

ASSERT-CHECK.
    IF WS-COND = 1
        ADD 1 TO WS-ASSERTIONS
    ELSE
        MOVE 1 TO WS-CASE-FAIL
        ADD 1 TO WS-UNEXPECTED
        DISPLAY "QA51B_ASSERTION_FAILED="
            FUNCTION TRIM(WS-LABEL)
    END-IF.

END PROGRAM QA51B-FAULT-INJECTION-TESTS.
