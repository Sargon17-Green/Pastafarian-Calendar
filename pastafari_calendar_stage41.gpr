with "gnatcoll_gmp.gpr";

project Pastafari_Calendar_Stage41 is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("stage41_remote_seventeen_observer.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Pastafari_Calendar_Stage41;
