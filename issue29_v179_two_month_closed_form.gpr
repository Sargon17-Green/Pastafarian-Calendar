with "gnatcoll_gmp.gpr";
-- Isolated GMP component; never links or calls original calendar F(c,t).
project Issue29_V179_Two_Month_Closed_Form is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj_v179";
   for Exec_Dir use "bin_v179";
   for Main use ("issue29_v179_two_month_closed_form_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Issue29_V179_Two_Month_Closed_Form;
