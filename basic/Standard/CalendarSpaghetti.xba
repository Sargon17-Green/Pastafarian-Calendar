<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="CalendarSpaghetti" script:language="StarBasic"><![CDATA[
Option Explicit

Public Function CalendarSpaghettiStage() As Long
    CalendarSpaghettiStage = 3
End Function

Public Function CalendarSpaghettiSkeletonReady() As Boolean
    Dim ctx As Variant
    ctx = BootstrapNewContext(ORACLE_FOUNDATION_DAY_TEXT, ORACLE_FOUNDATION_DAY_TEXT)
    BootstrapDispatch ctx, "PRODUCTION_SKELETON"
    CalendarSpaghettiSkeletonReady = BootstrapValidateContext(ctx)
End Function

' Stage3: ਪੁਰਾਣਾ API ਨਾਮ ਅਨੁਕੂਲਤਾ ਲਈ ਕਾਇਮ; SAVE ਦਾ 1..M ਨਿਯਮ ਲਾਗੂ।
Public Function oldRemainder(ByVal x As String) As String
    oldRemainder = BI_Save(x)
End Function

' ਇਹ diagnostic production route ਹੈ, ਪੰਜ-date result ਨਹੀਂ; correction only.
Public Function CalendarSpaghettiDiscovery01Remainder(ByVal x As String) As String
    Dim ctx As Variant
    ctx = BootstrapNewContext(x, x)
    BootstrapDispatch ctx, "DISCOVERY_01_SAVE_CORRECTED"
    If Not BootstrapValidateContext(ctx) Then Err.Raise 9301, "CalendarSpaghettiDiscovery01Remainder", "E_DISCOVERY_01_CONTEXT"
    CalendarSpaghettiDiscovery01Remainder = oldRemainder(CStr(ctx(CTX_TARGET_DAY)))
End Function

Public Function calendarDateSpaghetti(ByVal calculationDay As String, ByVal targetDay As String) As Variant
    Dim ctx As Variant
    Dim legacyValue As String
    ctx = BootstrapNewContext(calculationDay, targetDay)
    BootstrapDispatch ctx, "DISCOVERY_01"
    legacyValue = oldRemainder(CStr(ctx(CTX_TARGET_DAY)))
    If Not BootstrapValidateContext(ctx) Then Err.Raise 9301, "calendarDateSpaghetti", "E_BOOTSTRAP_CONTEXT"
    ' ਪੰਜ canonical date components ਅਜੇ ਅਧੂਰੇ ਹਨ; ਇਹ error ਜਾਣ-ਬੁੱਝ ਕੇ ਹੈ।
    Err.Raise 9302, "calendarDateSpaghetti", "E_STAGE_02_DISCOVERY_ONLY"
End Function
]]></script:module>
