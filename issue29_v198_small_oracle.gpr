with "gnatcoll_gmp.gpr";
-- QA component only: production GMP Count/Unrank; no calendar F(c,t).
project Issue29_V198_Small_Oracle is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj_v198";
   for Exec_Dir use "bin_v198";
   for Main use ("issue29_v198_small_oracle.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Issue29_V198_Small_Oracle;
