>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PATCHED-DAY-TAG.

DATA DIVISION.
LOCAL-STORAGE SECTION.
01 WS-OP PIC X(16) VALUE SPACES.
01 WS-TEXT PIC X(8192) VALUE SPACES.
01 WS-TEXT-LEN PIC 9(18) COMP-5 VALUE 0.
01 WS-CMP PIC S9(4) COMP-5 VALUE 0.
01 WS-STATUS PIC 9(4) COMP-5 VALUE 0.
01 WS-CLEAN PIC 9(4) COMP-5 VALUE 0.
01 WS-FAILED PIC 9(4) COMP-5 VALUE 0.
01 WS-PATCH-FLAG PIC 9 VALUE 0.
01 WS-FOUNDATION.
   05 WF-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WF-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WF-HEAD USAGE POINTER.
   05 WF-TAIL USAGE POINTER.
01 WS-DIFF.
   05 WD-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WD-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WD-HEAD USAGE POINTER.
   05 WD-TAIL USAGE POINTER.
01 WS-ONE.
   05 WO-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WO-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WO-HEAD USAGE POINTER.
   05 WO-TAIL USAGE POINTER.
01 WS-PATCHED.
   05 WP-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 WP-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 WP-HEAD USAGE POINTER.
   05 WP-TAIL USAGE POINTER.
01 WS-EMPTY-A.
   05 EA-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EA-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EA-HEAD USAGE POINTER.
   05 EA-TAIL USAGE POINTER.
01 WS-EMPTY-B.
   05 EB-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 EB-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 EB-HEAD USAGE POINTER.
   05 EB-TAIL USAGE POINTER.
01 WS-EMPTY-REM.
   05 ER-SIGN PIC S9(4) COMP-5 VALUE 0.
   05 ER-CHUNKS PIC 9(18) COMP-5 VALUE 0.
   05 ER-HEAD USAGE POINTER.
   05 ER-TAIL USAGE POINTER.

LINKAGE SECTION.
01 LK-DAY.
   05 LD-SIGN PIC S9(4) COMP-5.
   05 LD-CHUNKS PIC 9(18) COMP-5.
   05 LD-HEAD USAGE POINTER.
   05 LD-TAIL USAGE POINTER.
01 LK-RESULT.
   05 LR-SIGN PIC S9(4) COMP-5.
   05 LR-CHUNKS PIC 9(18) COMP-5.
   05 LR-HEAD USAGE POINTER.
   05 LR-TAIL USAGE POINTER.
01 LK-STATUS PIC 9(4) COMP-5.

PROCEDURE DIVISION USING LK-DAY LK-RESULT LK-STATUS.
MAIN.
    SET WF-HEAD WF-TAIL WD-HEAD WD-TAIL
        WO-HEAD WO-TAIL WP-HEAD WP-TAIL
        EA-HEAD EA-TAIL EB-HEAD EB-TAIL
        ER-HEAD ER-TAIL TO NULL
    MOVE 0 TO LK-STATUS WS-STATUS WS-CLEAN WS-FAILED WS-PATCH-FLAG
    *> 调用者持有结果；绝不能覆盖已有 BigInt 链。
    IF LR-SIGN NOT = 0 OR LR-CHUNKS NOT = 0
       OR LR-HEAD NOT = NULL OR LR-TAIL NOT = NULL
        MOVE 175 TO LK-STATUS
        GOBACK
    END-IF
    IF LD-SIGN < -1 OR LD-SIGN > 1
        MOVE 22 TO LK-STATUS
        GOBACK
    END-IF

    MOVE "-15055671" TO WS-TEXT
    MOVE 9 TO WS-TEXT-LEN
    MOVE "INIT-TEXT" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-EMPTY-A WS-EMPTY-B WS-FOUNDATION
        WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO WS-FAILED
        PERFORM CLEANUP
        MOVE WS-FAILED TO LK-STATUS
        GOBACK
    END-IF

    MOVE "SUB" TO WS-OP
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        LK-DAY WS-FOUNDATION WS-DIFF
        WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO WS-FAILED
        PERFORM CLEANUP
        MOVE WS-FAILED TO LK-STATUS
        GOBACK
    END-IF

    *> PATCH02 keeps the original distance formula and fixes only D >= F.
    IF WD-SIGN >= 0 MOVE 1 TO WS-PATCH-FLAG END-IF
    IF WD-SIGN NOT = 0
        MOVE 1 TO WD-SIGN
    END-IF
    MOVE "MUL-SMALL-N" TO WS-OP
    MOVE 2 TO WS-TEXT-LEN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-DIFF WS-EMPTY-B LK-RESULT
        WS-EMPTY-REM WS-CMP WS-STATUS
    IF WS-STATUS NOT = 0
        MOVE WS-STATUS TO WS-FAILED
    END-IF
    IF WS-FAILED = 0 AND WS-PATCH-FLAG = 1
        MOVE "1" TO WS-TEXT
        MOVE 1 TO WS-TEXT-LEN
        MOVE "INIT-TEXT" TO WS-OP
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-TEXT-LEN
            WS-EMPTY-A WS-EMPTY-B WS-ONE
            WS-EMPTY-REM WS-CMP WS-STATUS
        IF WS-STATUS NOT = 0
            MOVE WS-STATUS TO WS-FAILED
        ELSE
            MOVE "ADD" TO WS-OP
            CALL "BIG-INTEGER-SERVICE" USING
                WS-OP WS-TEXT WS-TEXT-LEN
                LK-RESULT WS-ONE WS-PATCHED
                WS-EMPTY-REM WS-CMP WS-STATUS
            IF WS-STATUS NOT = 0
                MOVE WS-STATUS TO WS-FAILED
            ELSE
                MOVE "FREE-A" TO WS-OP
                CALL "BIG-INTEGER-SERVICE" USING
                    WS-OP WS-TEXT WS-TEXT-LEN
                    LK-RESULT WS-EMPTY-B WS-EMPTY-A
                    WS-EMPTY-REM WS-CMP WS-STATUS
                IF WS-STATUS NOT = 0
                    MOVE WS-STATUS TO WS-FAILED
                ELSE
                    MOVE WP-SIGN TO LR-SIGN
                    MOVE WP-CHUNKS TO LR-CHUNKS
                    SET LR-HEAD TO WP-HEAD
                    SET LR-TAIL TO WP-TAIL
                    MOVE 0 TO WP-SIGN WP-CHUNKS
                    SET WP-HEAD WP-TAIL TO NULL
                END-IF
            END-IF
        END-IF
    END-IF
    PERFORM CLEANUP
    IF WS-FAILED NOT = 0
        MOVE "FREE-A" TO WS-OP
        MOVE 0 TO WS-CLEAN
        CALL "BIG-INTEGER-SERVICE" USING
            WS-OP WS-TEXT WS-TEXT-LEN
            LK-RESULT WS-EMPTY-B WS-EMPTY-A
            WS-EMPTY-REM WS-CMP WS-CLEAN
    END-IF
    MOVE WS-FAILED TO LK-STATUS
    GOBACK.

CLEANUP.
    MOVE "FREE-A" TO WS-OP
    MOVE 0 TO WS-CLEAN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-FOUNDATION WS-EMPTY-B WS-EMPTY-A
        WS-EMPTY-REM WS-CMP WS-CLEAN
    IF WS-CLEAN NOT = 0 AND WS-FAILED = 0
        MOVE WS-CLEAN TO WS-FAILED
    END-IF
    MOVE 0 TO WS-CLEAN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-DIFF WS-EMPTY-B WS-EMPTY-A
        WS-EMPTY-REM WS-CMP WS-CLEAN
    IF WS-CLEAN NOT = 0 AND WS-FAILED = 0
        MOVE WS-CLEAN TO WS-FAILED
    END-IF
    MOVE 0 TO WS-CLEAN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-ONE WS-EMPTY-B WS-EMPTY-A
        WS-EMPTY-REM WS-CMP WS-CLEAN
    IF WS-CLEAN NOT = 0 AND WS-FAILED = 0
        MOVE WS-CLEAN TO WS-FAILED
    END-IF
    MOVE 0 TO WS-CLEAN
    CALL "BIG-INTEGER-SERVICE" USING
        WS-OP WS-TEXT WS-TEXT-LEN
        WS-PATCHED WS-EMPTY-B WS-EMPTY-A
        WS-EMPTY-REM WS-CMP WS-CLEAN
    IF WS-CLEAN NOT = 0 AND WS-FAILED = 0
        MOVE WS-CLEAN TO WS-FAILED
    END-IF.
END PROGRAM PATCHED-DAY-TAG.
