   z;b:i;a;!b;0h;!!n:
   z;b:v;a;!n;a;!b;9h;!!v:
   z;b:d;a;!v;a;!b;9h;!!d:
   z;b:d;a;!b;25h;!!d:
   { Reverse linked list; flatten after all six values are complete. }
   z;r:d;a;!q;a;!r;q:
   u;1+u:
  ]#
  z;x:6a;!1u:
  [u;7<][
   q;r:6u;-j:
   [j;0>][r;1+g;!r:j;1-j:]#
