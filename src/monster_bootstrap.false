{ المرحلة 22: العملية 39؛ اثنتا عشرة دفعة متزامنة لتحديث ست كرات. }
{ الإدخال سجل مباشر [1,bowls]، والنتيجة جدول جديد مباشر [6,B1,...,B6]. }
{ كل دفعة تقرأ لقطة قديمة واحدة؛ لا تتغير أي خلية إدخال أو قيمة BigInt. }
z;39=~["E_BOWL_BATCH_LAYOUT"0 0/]?
[
 k;\z;2+z:b;a;!d;a;!e;a;!f;a;!i;a;!j;a;!l;a;!m;a;!n;a;!o;a;!p;a;!q;a;!r;a;!s;a;!t;a;!u;a;!v;a;!w;a;!x;a;!y;a;!z;22-k:
 k;1+g;!x:x;g;!1=~["E_BOWL_BATCH_RECORD_LENGTH"0 0/]?
 x;1+g;!y:
 y;g;!6=~["E_BOWL_BATCH_BOWLS_LENGTH"0 0/]?
 [
  d:
  d;g;!1=~["E_BOWL_BATCH_BIG_SIGN"0 0/]?
  d;1+g;!e:
  e;1<["E_BOWL_BATCH_BIG_LENGTH"0 0/]?
  e;15>["E_BOWL_BATCH_BIG_LENGTH"0 0/]?
  0f:
  [f;e;<][
   d;2+f;+g;!m:
   m;0<["E_BOWL_BATCH_BIG_DIGIT"0 0/]?
   m;511>["E_BOWL_BATCH_BIG_DIGIT"0 0/]?
   f;1+f:
  ]#
  m;0=["E_BOWL_BATCH_BIG_TOP"0 0/]?
  e;15=[m;1>["E_BOWL_BATCH_BIG_RANGE"0 0/]?]?
 ]q:
 1j:[j;7<][y;j;+g;!q;!j;1+j:]#
 1i:
 [i;13<][
  { T = SAVE(sum(old bowls) + 6 + 149*batch). }
  y;1+g;!s:
  y;2+g;!n:
  z;b:s;a;!n;a;!b;9h;!!s:
  y;3+g;!n:
  z;b:s;a;!n;a;!b;9h;!!s:
  y;4+g;!n:
  z;b:s;a;!n;a;!b;9h;!!s:
  y;5+g;!n:
  z;b:s;a;!n;a;!b;9h;!!s:
  y;6+g;!n:
  z;b:s;a;!n;a;!b;9h;!!s:
  z;b:6a;!b;0h;!!v:
  z;b:s;a;!v;a;!b;9h;!!s:
  z;b:i;a;!b;0h;!!v:
  z;b:v;a;!149a;!b;23h;!!v:
  z;b:s;a;!v;a;!b;9h;!!t:
  z;b:t;a;!b;25h;!!t:
  { rank = 4 + EuclideanRemainder(T-4,7); }
  z;b:4a;!b;0h;!!v:
  z;b:t;a;!v;a;!b;10h;!!n:
  z;b:7a;!b;0h;!!v:
  z;b:n;a;!v;a;!b;16h;!!n:
  z;b:n;a;!0a;!b;3h;!!r:
  r;4+r:
  z;b:r;a;!b;34h;!!o:
  { Build six new values from the same old snapshot, in bowl-ID order. }
  0q:1u:
  [u;7<][
   z;b:o;a;!u;a;!b;36h;!!p:
   y;u;+g;!m:
   { Read cyclic predecessor and successor by permutation position. }
   p;1-j:j;0=[6j:]?o;j;+g;!j:y;j;+g;!s:
   p;1+j:j;7=[1j:]?o;j;+g;!j:y;j;+g;!l:
   { SAVE(B_b^2 + 3L + 5R + T + batch + p^2 + 7LR). }
   z;b:m;a;!m;a;!b;14h;!!d:
   z;b:s;a;!3a;!b;23h;!!e:
   z;b:l;a;!5a;!b;23h;!!f:
   z;b:s;a;!l;a;!b;14h;!!n:
