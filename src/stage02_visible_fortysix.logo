; Stage2 Discovery17 — exact BI final visible 46, production-only D8 helpers.
to monster.stage02.visible.fortysix.extend :i :ctx :stones :hidden :acc
  if :i > 46 [output :acc]
  localmake "p1 monster.stage02.visible.prefix.prior :i 1 :acc :hidden
  localmake "p3 monster.stage02.visible.prefix.prior :i 3 :acc :hidden
  localmake "p7 monster.stage02.visible.prefix.prior :i 7 :acc :hidden
  localmake "stone item :i :stones
  localmake "initial monster.stage02.visible.prefix.initial :i :ctx :stone :p1 :p3 :p7
  localmake "value monster.stage02.visible.prefix.grind 1 :initial :stone :p1 :p3 :p7
  output monster.stage02.visible.fortysix.extend (:i + 1) :ctx :stones :hidden (lput :value :acc)
end

to monster.stage02.visible.fortysix :ctx
  if not (equalp (monster.context.get :ctx "status) "VISIBLE_FORTYFIVE_ONLY) [output :ctx]
  localmake "fortyfive monster.context.get :ctx "visibleFortyFive
  if not (listp :fortyfive) [output :ctx]
  if (count :fortyfive) <> 45 [output :ctx]
  localmake "fortysix monster.stage02.visible.fortysix.extend 46 :ctx (monster.context.get :ctx "stoneSeries) (monster.context.get :ctx "hiddenSeeds) :fortyfive
  localmake "work monster.context.put :ctx "visibleFortySix :fortysix
  make "work monster.context.put :work "phase "VISIBLE_FORTYSIX_READY
  make "work monster.context.put :work "mode "STAGE_2_DISCOVERY_17
  make "work monster.context.put :work "status "VISIBLE_FORTYSIX_ONLY
  make "work monster.metrics.bump :work "stage02.visible.fortysix
  make "work monster.logs.append :work "stage02.visible.fortysix.ready
  output :work
end
