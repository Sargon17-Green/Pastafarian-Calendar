MONTH_NAMES_RO=: MONTH_NAMES_RO, <'pară'
MONTH_NAMES_RO=: MONTH_NAMES_RO, <'arc'
MONTH_NAMES_RO=: MONTH_NAMES_RO, <'nisip'

cutletNameFromCanonicalIndex=: 3 : 0
  assert. (y >: 1) *. y <: 17
  > (y - 1) { CUTLET_NAMES_RO
)

monthNameFromCanonicalIndex=: 3 : 0
  assert. (y >: 1) *. y <: 47
  > (y - 1) { MONTH_NAMES_RO
)

validateSourceLanguageCatalog=: 3 : 0
  assert. 17 = # CUTLET_NAMES_RO
  assert. 47 = # MONTH_NAMES_RO
  assert. CUTLET_CANONICAL_INDEX -: 1 + i. 17
  assert. MONTH_CANONICAL_INDEX -: 1 + i. 47
  assert. 17 = # ~. CUTLET_NAMES_RO
  assert. 47 = # ~. MONTH_NAMES_RO
  1
)
