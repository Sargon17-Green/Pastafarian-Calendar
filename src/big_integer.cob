PROCEDURE DIVISION USING LK-OP LK-TEXT LK-TEXT-LEN LK-A LK-B LK-OUT LK-REM LK-CMP LK-STATUS.
MAIN.
    PERFORM RESET-SCRATCH-ENTRY
    MOVE 0 TO LK-STATUS LK-CMP
    EVALUATE FUNCTION TRIM(LK-OP)
        WHEN "ARENA-BEGIN"
            IF BI-ARENA-ACTIVE = 1 OR BI-SCOPE-DEPTH NOT = 0
                MOVE 46 TO LK-STATUS
            ELSE
                MOVE 1 TO BI-ARENA-ACTIVE
                MOVE 0 TO BI-ARENA-COUNT BI-ARENA-O1-HITS BI-ARENA-SCAN-STEPS BI-MUL-SMALL-FAST-HITS BI-DIV-SMALL-FAST-HITS BI-MUL-FWD-ARRAY-HITS
                SET BI-ARENA-HEAD TO NULL
            END-IF
        WHEN "ARENA-END"
            IF BI-ARENA-ACTIVE = 0 OR BI-SCOPE-DEPTH NOT = 0
                MOVE 46 TO LK-STATUS
            ELSE
                PERFORM FREE-ARENA
                MOVE 0 TO BI-ARENA-ACTIVE
            END-IF
        WHEN "SCOPE-BEGIN"
            PERFORM BEGIN-ARENA-SCOPE
        WHEN "SCOPE-END"
            PERFORM END-ARENA-SCOPE
        WHEN "ARENA-DETACH"
            IF BI-ARENA-ACTIVE = 0
                MOVE 46 TO LK-STATUS
            ELSE
                PERFORM LOAD-A-H1
                PERFORM DETACH-H1-FROM-ARENA
            END-IF
        WHEN "ARENA-ATTACH"
            IF BI-ARENA-ACTIVE = 1
                PERFORM LOAD-A-H1
                PERFORM ATTACH-H1-TO-ARENA
            END-IF
        WHEN "HEAP-LIVE"
            MOVE BI-LIVE-ALLOCATIONS TO LK-TEXT-LEN
        WHEN "HEAP-PEAK"
            MOVE BI-PEAK-ALLOCATIONS TO LK-TEXT-LEN
        WHEN "HEAP-PEAK-RESET"
            MOVE BI-LIVE-ALLOCATIONS TO BI-PEAK-ALLOCATIONS
            MOVE BI-PEAK-ALLOCATIONS TO LK-TEXT-LEN
        WHEN "HEAP-ARENA-LIVE"
            MOVE BI-ARENA-COUNT TO LK-TEXT-LEN
        WHEN "HEAP-CHUNK-LIVE"
            COMPUTE LK-TEXT-LEN = BI-LIVE-ALLOCATIONS - BI-ARENA-COUNT
        WHEN "ARENA-O1-HITS"
            MOVE BI-ARENA-O1-HITS TO LK-TEXT-LEN
        WHEN "ARENA-SCAN-STEPS"
            MOVE BI-ARENA-SCAN-STEPS TO LK-TEXT-LEN
        WHEN "MUL-SMALL-HITS"
            MOVE BI-MUL-SMALL-FAST-HITS TO LK-TEXT-LEN
        WHEN "DIV-SMALL-HITS"
            MOVE BI-DIV-SMALL-FAST-HITS TO LK-TEXT-LEN
        WHEN "MUL-FWD-HITS"
            MOVE BI-MUL-FWD-ARRAY-HITS TO LK-TEXT-LEN
        WHEN "INIT-TEXT"
            PERFORM CLEAR-R
            PERFORM PARSE-TEXT-INTO-R
            IF LK-STATUS = 0
                PERFORM EXPORT-R-OUT
            ELSE
                *> 仅本操作创建 R；失败时只释放 R。
                PERFORM FREE-R-LOCAL
            END-IF
        WHEN "COPY"
            PERFORM LOAD-A-H1
            PERFORM CLEAR-R
            PERFORM COPY-H1-TO-R
            PERFORM EXPORT-R-OUT
        WHEN "CMP"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM COMPARE-SIGNED-H1-H2
            MOVE WS-CMP TO LK-CMP
        WHEN "ADD"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM ADD-SIGNED-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "SUB"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM SUB-SIGNED-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "MUL"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM MULTIPLY-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "MUL-FWD"
            *> Fix 33 内部路径：只用 head/next 把两个正向链复制到连续数组，
            *> 避免为 array-fast MUL 先重建 prev/tail 再反向遍历。
            *> 超出 Fix 22 数组边界时恢复历史保守载入和 cursor 路径。
            PERFORM LOAD-A-H1-FORWARD
            IF LK-STATUS = 0 PERFORM LOAD-B-H2-FORWARD END-IF
            IF LK-STATUS = 0
                PERFORM CLEAR-R
                COMPUTE WS-K = WS-H1-CHUNKS + WS-H2-CHUNKS
                IF WS-H1-CHUNKS <= BI-MUL-FAST-OPERAND-LIMIT
                   AND WS-H2-CHUNKS <= BI-MUL-FAST-OPERAND-LIMIT
                   AND WS-K <= BI-MUL-FAST-RESULT-LIMIT
                    PERFORM MULTIPLY-H1-H2-FAST-ARRAY-FORWARD
                    IF LK-STATUS = 0 ADD 1 TO BI-MUL-FWD-ARRAY-HITS END-IF
                ELSE
                    PERFORM REBUILD-H1-BACKLINKS
                    IF LK-STATUS = 0 PERFORM REBUILD-H2-BACKLINKS END-IF
                    IF LK-STATUS = 0 PERFORM MULTIPLY-H1-H2-CURSOR END-IF
                END-IF
                IF LK-STATUS = 0
                    PERFORM EXPORT-R-OUT
                ELSE
                    PERFORM FREE-R-LOCAL
                END-IF
            END-IF
        WHEN "MUL-SMALL-N"
            *> 内部数值通道：LK-TEXT-LEN 直接承载 0..BI-BASE-1 标量，省去十进制格式化/解析。
            IF LK-TEXT-LEN >= BI-BASE
                MOVE 43 TO LK-STATUS
            ELSE
                MOVE LK-TEXT-LEN TO WS-SCALAR
                PERFORM LOAD-A-H1
                PERFORM CLEAR-R
                PERFORM MULTIPLY-H1-BY-SCALAR-INTO-R
                IF LK-STATUS = 0
                    ADD 1 TO BI-MUL-SMALL-FAST-HITS
                    PERFORM EXPORT-R-OUT
                ELSE
                    PERFORM FREE-R-LOCAL
                END-IF
            END-IF
        WHEN "DIV-SMALL-N"
            *> 与 MUL-SMALL-N 相同，数值参数直接走 LK-TEXT-LEN。零除仍返回历史状态 41。
            IF LK-TEXT-LEN = 0
                MOVE 41 TO LK-STATUS
            ELSE
                IF LK-TEXT-LEN >= BI-BASE
                    MOVE 43 TO LK-STATUS
                ELSE
                    MOVE LK-TEXT-LEN TO WS-SCALAR
                    PERFORM LOAD-A-H1
                    PERFORM CLEAR-R
                    PERFORM DIVIDE-H1-BY-SCALAR
                    IF LK-STATUS = 0
                        ADD 1 TO BI-DIV-SMALL-FAST-HITS
                        PERFORM EXPORT-R-OUT
                    ELSE
                        PERFORM FREE-R-LOCAL
                    END-IF
                END-IF
            END-IF
        WHEN "DIV-SMALL"
            IF LK-TEXT-LEN < 1 OR LK-TEXT-LEN > 18
                MOVE 43 TO LK-STATUS
            ELSE
                MOVE FUNCTION NUMVAL(LK-TEXT(1:LK-TEXT-LEN)) TO WS-SCALAR
                IF WS-SCALAR = 0
                    MOVE 41 TO LK-STATUS
                ELSE
                    IF WS-SCALAR >= BI-BASE
                        MOVE 43 TO LK-STATUS
                    ELSE
                    PERFORM LOAD-A-H1
                    PERFORM CLEAR-R
                    PERFORM DIVIDE-H1-BY-SCALAR
                    IF LK-STATUS = 0
                        PERFORM EXPORT-R-OUT
                    ELSE
                        PERFORM FREE-R-LOCAL
                    END-IF
                    END-IF
                END-IF
            END-IF
        WHEN "DIVMOD"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            MOVE WS-H1-SIGN TO WS-ORIGINAL-A-SIGN
            MOVE WS-H2-SIGN TO WS-ORIGINAL-B-SIGN
            IF WS-H2-SIGN = 0
                MOVE 41 TO LK-STATUS
            ELSE
                *> DIVMOD 才拥有 R/R2/T/U，因此在进入该操作时初始化它们。
                PERFORM CLEAR-R
                PERFORM CLEAR-R2
                PERFORM CLEAR-T
                PERFORM CLEAR-U
                PERFORM DIVIDE-ABS-H1-H2
                IF LK-STATUS = 0
                    IF WS-R-CHUNKS > 0
                        COMPUTE WS-R-SIGN = WS-ORIGINAL-A-SIGN * WS-ORIGINAL-B-SIGN
                    END-IF
                    IF WS-R2-CHUNKS > 0
                        MOVE WS-ORIGINAL-A-SIGN TO WS-R2-SIGN
                    END-IF
                    PERFORM EXPORT-R-OUT
                    PERFORM EXPORT-R2-REM
                END-IF
                *> 成功时 R/R2 已转交并清空；失败时这里释放部分结果。
                PERFORM FREE-R-LOCAL
                PERFORM FREE-R2
                PERFORM FREE-T
                PERFORM FREE-U
            END-IF
        WHEN "MOD-EUCLID"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            MOVE WS-H1-SIGN TO WS-ORIGINAL-A-SIGN
            MOVE WS-H2-SIGN TO WS-ORIGINAL-B-SIGN
            IF WS-H2-SIGN <= 0
                MOVE 42 TO LK-STATUS
            ELSE
                *> MOD-EUCLID 与长除法共享四条临时链；只在此操作内初始化/释放。
                PERFORM CLEAR-R
                PERFORM CLEAR-R2
                PERFORM CLEAR-T
                PERFORM CLEAR-U
                PERFORM DIVIDE-ABS-H1-H2
                IF LK-STATUS = 0
                    IF WS-ORIGINAL-A-SIGN < 0 AND WS-R2-CHUNKS > 0
                        PERFORM LOAD-B-H1
                        PERFORM LOAD-R2-H2
                        PERFORM CLEAR-U
                        PERFORM SUB-ABS-H1-H2-INTO-U
                        PERFORM FREE-R2
                        PERFORM MOVE-U-TO-R2
                    END-IF
                    IF WS-R2-CHUNKS > 0
                        MOVE 1 TO WS-R2-SIGN
                    END-IF
                    PERFORM EXPORT-R2-OUT
                END-IF
                *> 商 R 不导出；其余链可能在错误路径上仍有部分内容。
                PERFORM FREE-R-LOCAL
                PERFORM FREE-R2
                PERFORM FREE-T
                PERFORM FREE-U
            END-IF
        WHEN "TO-TEXT"
            PERFORM LOAD-A-H1
            PERFORM HANDLE-H1-TO-TEXT
        WHEN "FREE-A"
            PERFORM LOAD-A-H1
            PERFORM UNREGISTER-H1-FROM-ARENA
            PERFORM FREE-H1
            MOVE 0 TO LK-A-SIGN LK-A-CHUNKS
            SET LK-A-HEAD TO NULL
            SET LK-A-TAIL TO NULL
        WHEN OTHER
            MOVE 40 TO LK-STATUS
    END-EVALUATE
    *> 不再在所有操作的统一退出路径上释放 R/R2/T/U。
    *> WORKING-STORAGE 临时区在每次入口都显式重置；未初始化的临时链不参与统一退出清理；
    *> 统一 FREE 仍可能破坏调用者刚收到的链。每个会创建临时链的操作
    *> 必须在自己的分支内初始化并完成转交或释放。
    GOBACK.

RESET-SCRATCH-ENTRY.
    *> BIG-INTEGER-SERVICE 没有递归调用。Stage 1 在同一模块中串行复用服务。
    *> 因此把临时指针保存在稳定的 WORKING-STORAGE 中，并在每次入口显式清零。
    *> 这避免 Windows GnuCOBOL 3.2 在反复销毁 RECURSIVE/LOCAL-STORAGE 调用帧时
    *> 让 BASED 临时地址与调用帧生命周期交叉。调用者拥有的已导出链和 arena 不在此清理。
    MOVE 0 TO WS-H1-SIGN WS-H1-CHUNKS
              WS-H2-SIGN WS-H2-CHUNKS
              WS-R-SIGN WS-R-CHUNKS
              WS-R2-SIGN WS-R2-CHUNKS
              WS-T-SIGN WS-T-CHUNKS
              WS-U-SIGN WS-U-CHUNKS
              WS-I WS-J WS-K WS-TEXT-POS WS-TEXT-END WS-TEXT-START
              WS-PART-LEN WS-CHUNK WS-SUM WS-PRODUCT WS-CARRY
              WS-REM-CHUNK WS-BORROW WS-AD WS-BD WS-CMP WS-SCALAR
              WS-DIV-QUOT WS-DIV-REM WS-LOW WS-HIGH WS-MID WS-BEST
              WS-NEGATIVE WS-ARENA-FOUND WS-SAVED-SIGN
              WS-SCOPE-ROOT WS-ORIGINAL-A-SIGN WS-ORIGINAL-B-SIGN
              WS-OUT-POS WS-PIECE-LEN WS-DIGIT-NUM WS-DIGIT-EDIT
    MOVE 1 TO WS-FIRST-DIGIT-POS
    MOVE SPACES TO WS-PART WS-PIECE
    MOVE "000000000" TO WS-DIGIT-BUFFER
    SET WS-H1-HEAD WS-H1-TAIL WS-H2-HEAD WS-H2-TAIL TO NULL
    SET WS-R-HEAD WS-R-TAIL WS-R2-HEAD WS-R2-TAIL TO NULL
    SET WS-T-HEAD WS-T-TAIL WS-U-HEAD WS-U-TAIL TO NULL
    SET WS-PTR-A WS-PTR-B WS-PTR-R WS-PTR-T WS-PTR-U TO NULL
    SET WS-PTR-N WS-PTR-ROW WS-PTR-NEXT WS-PTR-PREV TO NULL
    SET WS-ARENA-PTR WS-ARENA-PREV WS-ARENA-NEXT TO NULL
    SET WS-SCOPE-MARKER WS-DIVIDEND-NEXT TO NULL.

CLEAR-R.
    MOVE 0 TO WS-R-SIGN WS-R-CHUNKS
    SET WS-R-HEAD TO NULL
    SET WS-R-TAIL TO NULL.

CLEAR-R2.
    MOVE 0 TO WS-R2-SIGN WS-R2-CHUNKS
    SET WS-R2-HEAD TO NULL
    SET WS-R2-TAIL TO NULL.

CLEAR-T.
    MOVE 0 TO WS-T-SIGN WS-T-CHUNKS
    SET WS-T-HEAD TO NULL
    SET WS-T-TAIL TO NULL.

CLEAR-U.
    MOVE 0 TO WS-U-SIGN WS-U-CHUNKS
    SET WS-U-HEAD TO NULL
    SET WS-U-TAIL TO NULL.

LOAD-A-H1.
    MOVE LK-A-SIGN TO WS-H1-SIGN
    MOVE LK-A-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-A-HEAD
    SET WS-H1-TAIL TO LK-A-TAIL
    PERFORM REBUILD-H1-BACKLINKS.

LOAD-A-H1-FORWARD.
    MOVE LK-A-SIGN TO WS-H1-SIGN
    MOVE LK-A-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-A-HEAD
    SET WS-H1-TAIL TO LK-A-TAIL
    IF WS-H1-SIGN = 0
        MOVE 0 TO WS-H1-CHUNKS
        SET WS-H1-HEAD WS-H1-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-CHUNKS < 1 OR WS-H1-HEAD = NULL
        MOVE 49 TO LK-STATUS
    END-IF.

LOAD-B-H1.
    MOVE LK-B-SIGN TO WS-H1-SIGN
    MOVE LK-B-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-B-HEAD
    SET WS-H1-TAIL TO LK-B-TAIL
    PERFORM REBUILD-H1-BACKLINKS.

LOAD-B-H2.
    MOVE LK-B-SIGN TO WS-H2-SIGN
    MOVE LK-B-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO LK-B-HEAD
    SET WS-H2-TAIL TO LK-B-TAIL
    PERFORM REBUILD-H2-BACKLINKS.

LOAD-B-H2-FORWARD.
    MOVE LK-B-SIGN TO WS-H2-SIGN
    MOVE LK-B-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO LK-B-HEAD
    SET WS-H2-TAIL TO LK-B-TAIL
    IF WS-H2-SIGN = 0
        MOVE 0 TO WS-H2-CHUNKS
        SET WS-H2-HEAD WS-H2-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-H2-CHUNKS < 1 OR WS-H2-HEAD = NULL
        MOVE 49 TO LK-STATUS
    END-IF.

LOAD-R2-H2.
    MOVE WS-R2-SIGN TO WS-H2-SIGN
    MOVE WS-R2-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-R2-HEAD
    SET WS-H2-TAIL TO WS-R2-TAIL
    PERFORM REBUILD-H2-BACKLINKS.

LOAD-R2-H1.
    MOVE WS-R2-SIGN TO WS-H1-SIGN
    MOVE WS-R2-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO WS-R2-HEAD
    SET WS-H1-TAIL TO WS-R2-TAIL
    PERFORM REBUILD-H1-BACKLINKS.

LOAD-T-H2.
    MOVE WS-T-SIGN TO WS-H2-SIGN
    MOVE WS-T-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-T-HEAD
    SET WS-H2-TAIL TO WS-T-TAIL
    PERFORM REBUILD-H2-BACKLINKS.

*> 调用边界只把 head/chunks 视为权威。tail/prev 在每次载入时从正向 next 链重建。
*> 这样旧的 tail/prev 别名不能把反向算术带到无效地址。
REBUILD-H1-BACKLINKS.
    IF WS-H1-SIGN = 0
        MOVE 0 TO WS-H1-CHUNKS
        SET WS-H1-HEAD TO NULL
        SET WS-H1-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-CHUNKS < 1 OR WS-H1-HEAD = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    SET WS-PTR-PREV TO NULL
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-H1-CHUNKS
        IF WS-PTR-A = NULL
            MOVE 49 TO LK-STATUS
            EXIT PERFORM
        END-IF
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET NODE-A-PREV TO WS-PTR-PREV
        IF WS-I = WS-H1-CHUNKS
            SET WS-H1-TAIL TO WS-PTR-A
        ELSE
            SET WS-PTR-NEXT TO NODE-A-NEXT
            SET WS-PTR-PREV TO WS-PTR-A
            SET WS-PTR-A TO WS-PTR-NEXT
        END-IF
        ADD 1 TO WS-I
    END-PERFORM.

REBUILD-H2-BACKLINKS.
    IF WS-H2-SIGN = 0
        MOVE 0 TO WS-H2-CHUNKS
        SET WS-H2-HEAD TO NULL
        SET WS-H2-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-H2-CHUNKS < 1 OR WS-H2-HEAD = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-B TO WS-H2-HEAD
    SET WS-PTR-PREV TO NULL
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-H2-CHUNKS
        IF WS-PTR-B = NULL
            MOVE 49 TO LK-STATUS
            EXIT PERFORM
        END-IF
        SET ADDRESS OF NODE-B TO WS-PTR-B
        SET NODE-B-PREV TO WS-PTR-PREV
        IF WS-I = WS-H2-CHUNKS
            SET WS-H2-TAIL TO WS-PTR-B
        ELSE
            SET WS-PTR-NEXT TO NODE-B-NEXT
            SET WS-PTR-PREV TO WS-PTR-B
            SET WS-PTR-B TO WS-PTR-NEXT
        END-IF
        ADD 1 TO WS-I
    END-PERFORM.

EXPORT-R-OUT.
    *> 导出前重新封住链表两端。结果的 chunk 数是规范结构的一部分，
    *> 不能依赖分配器留下的终端 POINTER 状态。
    PERFORM SEAL-R-BOUNDARIES
    MOVE WS-R-SIGN TO LK-OUT-SIGN
    MOVE WS-R-CHUNKS TO LK-OUT-CHUNKS
    SET LK-OUT-HEAD TO WS-R-HEAD
    SET LK-OUT-TAIL TO WS-R-TAIL
    IF BI-ARENA-ACTIVE = 1 AND LK-OUT-HEAD NOT = NULL
        PERFORM REGISTER-LK-OUT
    END-IF
    PERFORM SEAL-LK-OUT-BOUNDARIES
    PERFORM CLEAR-R.

EXPORT-R2-OUT.
    PERFORM SEAL-R2-BOUNDARIES
    MOVE WS-R2-SIGN TO LK-OUT-SIGN
    MOVE WS-R2-CHUNKS TO LK-OUT-CHUNKS
    SET LK-OUT-HEAD TO WS-R2-HEAD
    SET LK-OUT-TAIL TO WS-R2-TAIL
    IF BI-ARENA-ACTIVE = 1 AND LK-OUT-HEAD NOT = NULL
        PERFORM REGISTER-LK-OUT
    END-IF
    PERFORM SEAL-LK-OUT-BOUNDARIES
    PERFORM CLEAR-R2.

EXPORT-R2-REM.
    PERFORM SEAL-R2-BOUNDARIES
    MOVE WS-R2-SIGN TO LK-REM-SIGN
    MOVE WS-R2-CHUNKS TO LK-REM-CHUNKS
    SET LK-REM-HEAD TO WS-R2-HEAD
    SET LK-REM-TAIL TO WS-R2-TAIL
    IF BI-ARENA-ACTIVE = 1 AND LK-REM-HEAD NOT = NULL
        PERFORM REGISTER-LK-REM
    END-IF
    PERFORM SEAL-LK-REM-BOUNDARIES
    PERFORM CLEAR-R2.

SEAL-LK-OUT-BOUNDARIES.
    IF LK-OUT-CHUNKS = 0
        SET LK-OUT-HEAD TO NULL
        SET LK-OUT-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF LK-OUT-HEAD = NULL OR LK-OUT-TAIL = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET ADDRESS OF NODE-R TO LK-OUT-HEAD
    SET NODE-R-PREV TO NULL
    SET ADDRESS OF NODE-R TO LK-OUT-TAIL
    SET NODE-R-NEXT TO NULL.

SEAL-LK-REM-BOUNDARIES.
    IF LK-REM-CHUNKS = 0
        SET LK-REM-HEAD TO NULL
        SET LK-REM-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF LK-REM-HEAD = NULL OR LK-REM-TAIL = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET ADDRESS OF NODE-R TO LK-REM-HEAD
    SET NODE-R-PREV TO NULL
    SET ADDRESS OF NODE-R TO LK-REM-TAIL
    SET NODE-R-NEXT TO NULL.

SEAL-R-BOUNDARIES.
    IF WS-R-CHUNKS = 0
        SET WS-R-HEAD TO NULL
        SET WS-R-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-R-HEAD = NULL OR WS-R-TAIL = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET ADDRESS OF NODE-R TO WS-R-HEAD
    SET NODE-R-PREV TO NULL
    SET ADDRESS OF NODE-R TO WS-R-TAIL
    SET NODE-R-NEXT TO NULL.

SEAL-R2-BOUNDARIES.
    IF WS-R2-CHUNKS = 0
        SET WS-R2-HEAD TO NULL
        SET WS-R2-TAIL TO NULL
        EXIT PARAGRAPH
    END-IF
    IF WS-R2-HEAD = NULL OR WS-R2-TAIL = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET ADDRESS OF NODE-R TO WS-R2-HEAD
    SET NODE-R-PREV TO NULL
    SET ADDRESS OF NODE-R TO WS-R2-TAIL
    SET NODE-R-NEXT TO NULL.

BEGIN-ARENA-SCOPE.
    IF BI-SCOPE-DEPTH >= 32
        MOVE 50 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO BI-SCOPE-DEPTH
    IF BI-ARENA-ACTIVE = 0
        MOVE 1 TO BI-ARENA-ACTIVE
        MOVE 0 TO BI-ARENA-COUNT BI-ARENA-O1-HITS BI-ARENA-SCAN-STEPS
        SET BI-ARENA-HEAD TO NULL
        MOVE 1 TO BSF-ROOT(BI-SCOPE-DEPTH)
        SET BSF-MARKER(BI-SCOPE-DEPTH) TO NULL
    ELSE
        MOVE 0 TO BSF-ROOT(BI-SCOPE-DEPTH)
        SET BSF-MARKER(BI-SCOPE-DEPTH) TO BI-ARENA-HEAD
    END-IF.

END-ARENA-SCOPE.
    IF BI-SCOPE-DEPTH = 0 OR BI-ARENA-ACTIVE = 0
        MOVE 50 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    SET WS-SCOPE-MARKER TO BSF-MARKER(BI-SCOPE-DEPTH)
    MOVE BSF-ROOT(BI-SCOPE-DEPTH) TO WS-SCOPE-ROOT
    PERFORM FREE-ARENA-TO-SCOPE-MARKER
    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    SET BSF-MARKER(BI-SCOPE-DEPTH) TO NULL
    MOVE 0 TO BSF-ROOT(BI-SCOPE-DEPTH)
    SUBTRACT 1 FROM BI-SCOPE-DEPTH
    IF WS-SCOPE-ROOT = 1
        SET BI-ARENA-HEAD TO NULL
        MOVE 0 TO BI-ARENA-COUNT BI-ARENA-ACTIVE
    END-IF.

FREE-ARENA-TO-SCOPE-MARKER.
    PERFORM UNTIL BI-ARENA-HEAD = WS-SCOPE-MARKER
        IF BI-ARENA-HEAD = NULL
            MOVE 51 TO LK-STATUS
            EXIT PERFORM
        END-IF
        SET WS-ARENA-PTR TO BI-ARENA-HEAD
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        SET WS-ARENA-NEXT TO AN-NEXT
        MOVE AN-SIGN TO WS-H1-SIGN
        MOVE AN-CHUNKS TO WS-H1-CHUNKS
        SET WS-H1-HEAD TO AN-HEAD
        SET WS-H1-TAIL TO AN-TAIL
        IF WS-H1-HEAD NOT = NULL
            SET ADDRESS OF NODE-A TO WS-H1-HEAD
            SET NODE-A-ARENA TO NULL
        END-IF
        PERFORM FREE-H1
        FREE WS-ARENA-PTR
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS BI-ARENA-COUNT
        SET BI-ARENA-HEAD TO WS-ARENA-NEXT
        IF BI-ARENA-HEAD NOT = NULL
            SET ADDRESS OF ARENA-NODE TO BI-ARENA-HEAD
            SET AN-PREV TO NULL
        END-IF
    END-PERFORM.

ATTACH-H1-TO-ARENA.
    IF WS-H1-HEAD = NULL AND WS-H1-SIGN = 0 EXIT PARAGRAPH END-IF
    IF WS-H1-HEAD = NULL OR WS-H1-CHUNKS = 0
        MOVE 48 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-H1-IN-ARENA
    IF WS-ARENA-FOUND = 1 EXIT PARAGRAPH END-IF
    PERFORM REGISTER-H1-DIRECT.

REGISTER-H1-DIRECT.
    ALLOCATE ARENA-NODE INITIALIZED
    ADD 1 TO BI-LIVE-ALLOCATIONS BI-ARENA-COUNT
    PERFORM UPDATE-PEAK
    MOVE WS-H1-SIGN TO AN-SIGN
    MOVE WS-H1-CHUNKS TO AN-CHUNKS
    SET AN-HEAD TO WS-H1-HEAD
    SET AN-TAIL TO WS-H1-TAIL
    SET AN-PREV TO NULL
    SET AN-NEXT TO BI-ARENA-HEAD
    SET WS-ARENA-PTR TO ADDRESS OF ARENA-NODE
    IF BI-ARENA-HEAD NOT = NULL
        SET ADDRESS OF ARENA-NODE TO BI-ARENA-HEAD
        SET AN-PREV TO WS-ARENA-PTR
    END-IF
    SET BI-ARENA-HEAD TO WS-ARENA-PTR
    SET ADDRESS OF NODE-A TO WS-H1-HEAD
    SET NODE-A-ARENA TO WS-ARENA-PTR.

FIND-H1-IN-ARENA.
    MOVE 0 TO WS-ARENA-FOUND
    IF BI-ARENA-ACTIVE = 0 OR WS-H1-HEAD = NULL EXIT PARAGRAPH END-IF
    SET ADDRESS OF NODE-A TO WS-H1-HEAD
    SET WS-ARENA-PTR TO NODE-A-ARENA
    IF WS-ARENA-PTR NOT = NULL
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        IF AN-HEAD = WS-H1-HEAD
            MOVE 1 TO WS-ARENA-FOUND
            ADD 1 TO BI-ARENA-O1-HITS
            EXIT PARAGRAPH
        END-IF
    END-IF
    *> 历史值或损坏 backlink 才走线性 fallback；正常 Fix 26 路径不应依赖它。
    SET WS-ARENA-PTR TO BI-ARENA-HEAD
    PERFORM UNTIL WS-ARENA-PTR = NULL OR WS-ARENA-FOUND = 1
        ADD 1 TO BI-ARENA-SCAN-STEPS
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        IF AN-HEAD = WS-H1-HEAD
            MOVE 1 TO WS-ARENA-FOUND
            SET ADDRESS OF NODE-A TO WS-H1-HEAD
            SET NODE-A-ARENA TO WS-ARENA-PTR
        ELSE
            SET WS-ARENA-PTR TO AN-NEXT
        END-IF
    END-PERFORM.

REGISTER-LK-OUT.
    MOVE LK-OUT-SIGN TO WS-H1-SIGN
    MOVE LK-OUT-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-OUT-HEAD
    SET WS-H1-TAIL TO LK-OUT-TAIL
    PERFORM REGISTER-H1-DIRECT.

REGISTER-LK-REM.
    MOVE LK-REM-SIGN TO WS-H1-SIGN
    MOVE LK-REM-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-REM-HEAD
    SET WS-H1-TAIL TO LK-REM-TAIL
    PERFORM REGISTER-H1-DIRECT.

UPDATE-PEAK.
    IF BI-LIVE-ALLOCATIONS > BI-PEAK-ALLOCATIONS
        MOVE BI-LIVE-ALLOCATIONS TO BI-PEAK-ALLOCATIONS
    END-IF.

PARSE-TEXT-INTO-R.
    IF LK-TEXT-LEN < 1 OR LK-TEXT-LEN > 8192
        MOVE 43 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-NEGATIVE
    MOVE 1 TO WS-TEXT-START
    IF LK-TEXT(1:1) = "-"
        MOVE 1 TO WS-NEGATIVE
        MOVE 2 TO WS-TEXT-START
    ELSE
        IF LK-TEXT(1:1) = "+"
            MOVE 2 TO WS-TEXT-START
        END-IF
    END-IF
    IF WS-TEXT-START > LK-TEXT-LEN
        MOVE 44 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE WS-TEXT-START TO WS-I
    PERFORM UNTIL WS-I > LK-TEXT-LEN
        IF LK-TEXT(WS-I:1) < "0" OR LK-TEXT(WS-I:1) > "9"
            MOVE 44 TO LK-STATUS
            EXIT PERFORM
        END-IF
        ADD 1 TO WS-I
    END-PERFORM
    IF LK-STATUS NOT = 0
        EXIT PARAGRAPH
    END-IF

    MOVE LK-TEXT-LEN TO WS-TEXT-END
    PERFORM UNTIL WS-TEXT-END < WS-TEXT-START
        *> 先计算当前尚未处理的十进制位数，再决定是否需要 end-8。
        *> WS-TEXT-POS 是无符号 COMP-5；旧实现直接计算 end-8，
        *> 当最后一段少于 9 位时会把负数写入无符号字段并发生回绕。
        *> 例如 39 位的 M 最后一轮 end=3，旧式 3-8 会破坏索引并可能
        *> 导致异常子串长度/循环以及失控内存增长。这里永不执行负减法。
        COMPUTE WS-PART-LEN = WS-TEXT-END - WS-TEXT-START + 1
        IF WS-PART-LEN > 9
            COMPUTE WS-TEXT-POS = WS-TEXT-END - 8
            MOVE 9 TO WS-PART-LEN
        ELSE
            MOVE WS-TEXT-START TO WS-TEXT-POS
        END-IF
        IF WS-TEXT-POS < WS-TEXT-START
           OR WS-TEXT-POS > WS-TEXT-END
           OR WS-PART-LEN < 1
           OR WS-PART-LEN > 9
            MOVE 48 TO LK-STATUS
            EXIT PERFORM
        END-IF
        MOVE SPACES TO WS-PART
        MOVE LK-TEXT(WS-TEXT-POS:WS-PART-LEN) TO WS-PART(10 - WS-PART-LEN:WS-PART-LEN)
        MOVE FUNCTION NUMVAL(WS-PART) TO WS-CHUNK
        *> 从低位向高位分块时，低位零块本身有位值，不能提前丢弃。
        *> 例如 1000000000 必须先形成 [1,0]，随后只能删除真正的高位零块。
        PERFORM PREPEND-CHUNK-R
        IF WS-TEXT-POS <= WS-TEXT-START
            MOVE 0 TO WS-TEXT-END
        ELSE
            COMPUTE WS-TEXT-END = WS-TEXT-POS - 1
        END-IF
    END-PERFORM
    IF LK-STATUS NOT = 0
        EXIT PARAGRAPH
    END-IF

    *> 文本可以带任意数量的前导零；内部表示必须在符号判定前正规化。
    PERFORM NORMALIZE-R
    IF WS-R-CHUNKS > 0
        IF WS-NEGATIVE = 1
            MOVE -1 TO WS-R-SIGN
        ELSE
            MOVE 1 TO WS-R-SIGN
        END-IF
    END-IF.

PREPEND-CHUNK-R.
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-R-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R-HEAD = NULL
        SET WS-R-HEAD TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-PREV TO WS-PTR-N
        SET WS-R-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R-CHUNKS.

APPEND-CHUNK-R.
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-R-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R-TAIL = NULL
        SET WS-R-HEAD TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R-TAIL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-NEXT TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R-CHUNKS.

PREPEND-CHUNK-T.
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-T-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-T-HEAD = NULL
        SET WS-T-HEAD TO WS-PTR-N
        SET WS-T-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-T TO WS-T-HEAD
        SET ADDRESS OF NODE-T TO WS-PTR-T
        SET NODE-T-PREV TO WS-PTR-N
        SET WS-T-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-T-CHUNKS.

APPEND-CHUNK-R2.
    IF WS-R2-CHUNKS = 0 AND WS-CHUNK = 0
        EXIT PARAGRAPH
    END-IF
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-R2-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R2-TAIL = NULL
        SET WS-R2-HEAD TO WS-PTR-N
        SET WS-R2-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R2-TAIL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-NEXT TO WS-PTR-N
        SET WS-R2-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R2-CHUNKS
    MOVE 1 TO WS-R2-SIGN.

APPEND-CHUNK-U.
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-U-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-U-TAIL = NULL
        SET WS-U-HEAD TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-U TO WS-U-TAIL
        SET ADDRESS OF NODE-U TO WS-PTR-U
        SET NODE-U-NEXT TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-U-CHUNKS.

COPY-H1-TO-R.
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SET WS-PTR-A TO NODE-A-NEXT
    END-PERFORM
    MOVE WS-H1-SIGN TO WS-R-SIGN.

COPY-H1-TO-R2-ABS.
    PERFORM CLEAR-R2
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R2
        SET WS-PTR-A TO NODE-A-NEXT
    END-PERFORM
    IF WS-R2-CHUNKS > 0
        MOVE 1 TO WS-R2-SIGN
    END-IF.

COMPARE-ABS-H1-H2.
    MOVE 0 TO WS-CMP
    IF WS-H1-CHUNKS < WS-H2-CHUNKS
        MOVE -1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-CHUNKS > WS-H2-CHUNKS
        MOVE 1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    SET WS-PTR-B TO WS-H2-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET ADDRESS OF NODE-B TO WS-PTR-B
        IF NODE-A-DIGIT < NODE-B-DIGIT
            MOVE -1 TO WS-CMP
            EXIT PERFORM
        END-IF
        IF NODE-A-DIGIT > NODE-B-DIGIT
            MOVE 1 TO WS-CMP
            EXIT PERFORM
        END-IF
        SET WS-PTR-A TO NODE-A-NEXT
        SET WS-PTR-B TO NODE-B-NEXT
    END-PERFORM.

COMPARE-SIGNED-H1-H2.
    IF WS-H1-SIGN < WS-H2-SIGN
        MOVE -1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN > WS-H2-SIGN
        MOVE 1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        MOVE 0 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-H1-SIGN < 0
        COMPUTE WS-CMP = 0 - WS-CMP
    END-IF.

ADD-SIGNED-H1-H2.
    IF WS-H1-SIGN = 0
        PERFORM COPY-H2-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H2-SIGN = 0
        PERFORM COPY-H1-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = WS-H2-SIGN
        PERFORM ADD-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP = 0
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP > 0
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    ELSE
        PERFORM SWAP-H1-H2
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    END-IF.

SUB-SIGNED-H1-H2.
    IF WS-H2-SIGN = 0
        PERFORM COPY-H1-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        PERFORM COPY-H2-TO-R
        COMPUTE WS-R-SIGN = 0 - WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN NOT = WS-H2-SIGN
        PERFORM ADD-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP = 0
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP > 0
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    ELSE
        MOVE WS-H1-SIGN TO WS-SAVED-SIGN
        PERFORM SWAP-H1-H2
        PERFORM SUB-ABS-H1-H2-INTO-R
        COMPUTE WS-R-SIGN = 0 - WS-SAVED-SIGN
    END-IF.

COPY-H2-TO-R.
    IF WS-H2-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-B TO WS-H2-HEAD
    PERFORM UNTIL WS-PTR-B = NULL
        SET ADDRESS OF NODE-B TO WS-PTR-B
        MOVE NODE-B-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SET WS-PTR-B TO NODE-B-NEXT
    END-PERFORM
    MOVE WS-H2-SIGN TO WS-R-SIGN.

SWAP-H1-H2.
    MOVE WS-H1-SIGN TO WS-SAVED-SIGN
    MOVE WS-H1-CHUNKS TO WS-J
    SET WS-PTR-A TO WS-H1-HEAD
    SET WS-PTR-B TO WS-H1-TAIL
    MOVE WS-H2-SIGN TO WS-H1-SIGN
    MOVE WS-H2-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO WS-H2-HEAD
    SET WS-H1-TAIL TO WS-H2-TAIL
    MOVE WS-SAVED-SIGN TO WS-H2-SIGN
    MOVE WS-J TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-PTR-A
    SET WS-H2-TAIL TO WS-PTR-B.

ADD-ABS-H1-H2-INTO-R.
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-CARRY
    PERFORM UNTIL WS-PTR-A = NULL AND WS-PTR-B = NULL AND WS-CARRY = 0
        MOVE 0 TO WS-AD WS-BD
        IF WS-PTR-A NOT = NULL
            SET ADDRESS OF NODE-A TO WS-PTR-A
            MOVE NODE-A-DIGIT TO WS-AD
            SET WS-PTR-A TO NODE-A-PREV
        END-IF
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        COMPUTE WS-SUM = WS-AD + WS-BD + WS-CARRY
        DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
        MOVE WS-REM-CHUNK TO WS-CHUNK
        PERFORM PREPEND-CHUNK-R
    END-PERFORM.

SUB-ABS-H1-H2-INTO-R.
    *> 前置条件是绝对值 H1 大于 H2。
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-BORROW
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-AD
        MOVE 0 TO WS-BD
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        IF WS-AD < WS-BD + WS-BORROW
            COMPUTE WS-SUM = WS-AD + BI-BASE - WS-BD - WS-BORROW
            MOVE 1 TO WS-BORROW
        ELSE
            COMPUTE WS-SUM = WS-AD - WS-BD - WS-BORROW
            MOVE 0 TO WS-BORROW
        END-IF
        *> 该差值按构造严格小于 BI-BASE；通过余数槽显式保持块宽度契约。
        DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-CHUNK
        PERFORM PREPEND-CHUNK-R
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    PERFORM NORMALIZE-R.

SUB-ABS-H1-H2-INTO-U.
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-BORROW
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-AD
        MOVE 0 TO WS-BD
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        IF WS-AD < WS-BD + WS-BORROW
            COMPUTE WS-SUM = WS-AD + BI-BASE - WS-BD - WS-BORROW
            MOVE 1 TO WS-BORROW
        ELSE
            COMPUTE WS-SUM = WS-AD - WS-BD - WS-BORROW
            MOVE 0 TO WS-BORROW
        END-IF
        *> 该差值按构造严格小于 BI-BASE；通过余数槽显式保持块宽度契约。
        DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-CHUNK
        PERFORM PREPEND-CHUNK-U
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    MOVE 1 TO WS-U-SIGN
    PERFORM NORMALIZE-U.

PREPEND-CHUNK-U.
    ALLOCATE NODE-N INITIALIZED
    SET NODE-N-ARENA TO NULL
    ADD 1 TO BI-LIVE-ALLOCATIONS
    PERFORM UPDATE-PEAK
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-U-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-U-HEAD = NULL
        SET WS-U-HEAD TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        SET NODE-U-PREV TO WS-PTR-N
        SET WS-U-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-U-CHUNKS.

NORMALIZE-R.
    PERFORM UNTIL WS-R-HEAD = NULL OR WS-R-CHUNKS <= 1
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        IF NODE-R-DIGIT NOT = 0
            EXIT PERFORM
        END-IF
        SET WS-PTR-NEXT TO NODE-R-NEXT
        IF WS-PTR-NEXT NOT = NULL
            SET ADDRESS OF NODE-R TO WS-PTR-NEXT
            SET NODE-R-PREV TO NULL
        END-IF
        SET WS-R-HEAD TO WS-PTR-NEXT
        SUBTRACT 1 FROM WS-R-CHUNKS
        FREE WS-PTR-R
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
    END-PERFORM
    IF WS-R-CHUNKS = 1
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        IF NODE-R-DIGIT = 0
            FREE WS-PTR-R
            SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
            PERFORM CLEAR-R
        END-IF
    END-IF.

NORMALIZE-U.
    PERFORM UNTIL WS-U-HEAD = NULL OR WS-U-CHUNKS <= 1
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        IF NODE-U-DIGIT NOT = 0
            EXIT PERFORM
        END-IF
        SET WS-PTR-NEXT TO NODE-U-NEXT
        IF WS-PTR-NEXT NOT = NULL
            SET ADDRESS OF NODE-R TO WS-PTR-NEXT
            SET NODE-R-PREV TO NULL
        END-IF
        SET WS-U-HEAD TO WS-PTR-NEXT
        SUBTRACT 1 FROM WS-U-CHUNKS
        FREE WS-PTR-U
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
    END-PERFORM
    IF WS-U-CHUNKS = 1
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        IF NODE-U-DIGIT = 0
            FREE WS-PTR-U
            SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
            PERFORM CLEAR-U
        END-IF
    END-IF.

MULTIPLY-H1-H2.
    IF WS-H1-SIGN = 0 OR WS-H2-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-K = WS-H1-CHUNKS + WS-H2-CHUNKS
    IF WS-H1-CHUNKS <= BI-MUL-FAST-OPERAND-LIMIT
       AND WS-H2-CHUNKS <= BI-MUL-FAST-OPERAND-LIMIT
       AND WS-K <= BI-MUL-FAST-RESULT-LIMIT
        PERFORM MULTIPLY-H1-H2-FAST-ARRAY
    ELSE
        PERFORM MULTIPLY-H1-H2-CURSOR
    END-IF.

MULTIPLY-H1-H2-FAST-ARRAY.
    *> 数组索引 1 是最低有效块。每个乘积后立即执行与链表路径相同的
    *> base-10^9 进位，因此不会把多个 10^18 量级乘积累积到一个机器整数中。
    MOVE 1 TO WS-I
    SET WS-PTR-A TO WS-H1-TAIL
    PERFORM UNTIL WS-I > WS-H1-CHUNKS
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-MUL-FAST-A-DIGIT(WS-I)
        SET WS-PTR-A TO NODE-A-PREV
        ADD 1 TO WS-I
    END-PERFORM

    MOVE 1 TO WS-J
    SET WS-PTR-B TO WS-H2-TAIL
    PERFORM UNTIL WS-J > WS-H2-CHUNKS
        SET ADDRESS OF NODE-B TO WS-PTR-B
        MOVE NODE-B-DIGIT TO WS-MUL-FAST-B-DIGIT(WS-J)
        SET WS-PTR-B TO NODE-B-PREV
        ADD 1 TO WS-J
    END-PERFORM

    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-K
        MOVE 0 TO WS-MUL-FAST-R-DIGIT(WS-I)
        ADD 1 TO WS-I
    END-PERFORM

    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-H1-CHUNKS OR LK-STATUS NOT = 0
        MOVE 1 TO WS-J
        PERFORM UNTIL WS-J > WS-H2-CHUNKS OR LK-STATUS NOT = 0
            COMPUTE WS-MUL-FAST-IDX = WS-I + WS-J - 1
            COMPUTE WS-PRODUCT =
                WS-MUL-FAST-A-DIGIT(WS-I) * WS-MUL-FAST-B-DIGIT(WS-J)
                + WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
            DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
            MOVE WS-REM-CHUNK TO WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
            ADD 1 TO WS-MUL-FAST-IDX
            PERFORM UNTIL WS-CARRY = 0 OR LK-STATUS NOT = 0
                IF WS-MUL-FAST-IDX > WS-K
                    MOVE 44 TO LK-STATUS
                    EXIT PERFORM
                END-IF
                COMPUTE WS-SUM = WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX) + WS-CARRY
                DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
                MOVE WS-REM-CHUNK TO WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
                ADD 1 TO WS-MUL-FAST-IDX
            END-PERFORM
            ADD 1 TO WS-J
        END-PERFORM
        ADD 1 TO WS-I
    END-PERFORM

    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-K TO WS-I
    PERFORM UNTIL WS-I = 0
        MOVE WS-MUL-FAST-R-DIGIT(WS-I) TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SUBTRACT 1 FROM WS-I
    END-PERFORM
    COMPUTE WS-R-SIGN = WS-H1-SIGN * WS-H2-SIGN
    PERFORM NORMALIZE-R.

MULTIPLY-H1-H2-FAST-ARRAY-FORWARD.
    *> 与 Fix 22 的数组 schoolbook 完全相同；区别仅在输入复制方向。
    *> 调用边界的 head/chunks 作为权威，从最高有效块向最低有效块走 next，
    *> 再反向放入“索引 1 = 最低有效块”的既有数组。
    MOVE WS-H1-CHUNKS TO WS-I
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-I = 0 OR LK-STATUS NOT = 0
        IF WS-PTR-A = NULL
            MOVE 49 TO LK-STATUS
        ELSE
            SET ADDRESS OF NODE-A TO WS-PTR-A
            MOVE NODE-A-DIGIT TO WS-MUL-FAST-A-DIGIT(WS-I)
            SET WS-PTR-A TO NODE-A-NEXT
            SUBTRACT 1 FROM WS-I
        END-IF
    END-PERFORM

    MOVE WS-H2-CHUNKS TO WS-J
    SET WS-PTR-B TO WS-H2-HEAD
    PERFORM UNTIL WS-J = 0 OR LK-STATUS NOT = 0
        IF WS-PTR-B = NULL
            MOVE 49 TO LK-STATUS
        ELSE
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-MUL-FAST-B-DIGIT(WS-J)
            SET WS-PTR-B TO NODE-B-NEXT
            SUBTRACT 1 FROM WS-J
        END-IF
    END-PERFORM

    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-K
        MOVE 0 TO WS-MUL-FAST-R-DIGIT(WS-I)
        ADD 1 TO WS-I
    END-PERFORM

    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-H1-CHUNKS OR LK-STATUS NOT = 0
        MOVE 1 TO WS-J
        PERFORM UNTIL WS-J > WS-H2-CHUNKS OR LK-STATUS NOT = 0
            COMPUTE WS-MUL-FAST-IDX = WS-I + WS-J - 1
            COMPUTE WS-PRODUCT =
                WS-MUL-FAST-A-DIGIT(WS-I) * WS-MUL-FAST-B-DIGIT(WS-J)
                + WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
            DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
            MOVE WS-REM-CHUNK TO WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
            ADD 1 TO WS-MUL-FAST-IDX
            PERFORM UNTIL WS-CARRY = 0 OR LK-STATUS NOT = 0
                IF WS-MUL-FAST-IDX > WS-K
                    MOVE 44 TO LK-STATUS
                    EXIT PERFORM
                END-IF
                COMPUTE WS-SUM = WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX) + WS-CARRY
                DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
                MOVE WS-REM-CHUNK TO WS-MUL-FAST-R-DIGIT(WS-MUL-FAST-IDX)
                ADD 1 TO WS-MUL-FAST-IDX
            END-PERFORM
            ADD 1 TO WS-J
        END-PERFORM
        ADD 1 TO WS-I
    END-PERFORM

    IF LK-STATUS NOT = 0 EXIT PARAGRAPH END-IF
    MOVE WS-K TO WS-I
    PERFORM UNTIL WS-I = 0
        MOVE WS-MUL-FAST-R-DIGIT(WS-I) TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SUBTRACT 1 FROM WS-I
    END-PERFORM
    COMPUTE WS-R-SIGN = WS-H1-SIGN * WS-H2-SIGN
    PERFORM NORMALIZE-R.

MULTIPLY-H1-H2-CURSOR.
    *> Fix 21：结果链表的目标位置按行单调向高位移动。该路径也是快速数组
    *> 上限之外的无界后备路径。
    COMPUTE WS-K = WS-H1-CHUNKS + WS-H2-CHUNKS
    MOVE 0 TO WS-I
    PERFORM UNTIL WS-I >= WS-K
        MOVE 0 TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        ADD 1 TO WS-I
    END-PERFORM

    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-ROW TO WS-R-TAIL
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-PTR-B TO WS-H2-TAIL
        SET WS-PTR-PREV TO WS-PTR-ROW
        PERFORM UNTIL WS-PTR-B = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            SET WS-PTR-R TO WS-PTR-PREV
            SET ADDRESS OF NODE-R TO WS-PTR-R
            SET WS-PTR-NEXT TO NODE-R-PREV
            COMPUTE WS-PRODUCT = NODE-A-DIGIT * NODE-B-DIGIT + NODE-R-DIGIT
            DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
            MOVE WS-REM-CHUNK TO NODE-R-DIGIT
            SET WS-PTR-R TO NODE-R-PREV
            PERFORM UNTIL WS-CARRY = 0
                SET ADDRESS OF NODE-R TO WS-PTR-R
                COMPUTE WS-SUM = NODE-R-DIGIT + WS-CARRY
                DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
                MOVE WS-REM-CHUNK TO NODE-R-DIGIT
                SET WS-PTR-R TO NODE-R-PREV
            END-PERFORM
            SET WS-PTR-PREV TO WS-PTR-NEXT
            SET WS-PTR-B TO NODE-B-PREV
        END-PERFORM
        SET ADDRESS OF NODE-R TO WS-PTR-ROW
        SET WS-PTR-ROW TO NODE-R-PREV
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    COMPUTE WS-R-SIGN = WS-H1-SIGN * WS-H2-SIGN
    PERFORM NORMALIZE-R.

MULTIPLY-H1-BY-SCALAR-INTO-R.
    *> Fix 27：专供非负、单 base chunk 标量的精确乘法。
    *> 乘法顺序与通用 schoolbook 的一列完全相同：从最低有效块向高位传播 carry。
    *> WS-SCALAR 已由入口保证小于 BI-BASE；因此 digit*scalar+carry 安全落在 64 位十进制范围内。
    IF WS-H1-SIGN = 0 OR WS-SCALAR = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-TAIL
    MOVE 0 TO WS-CARRY
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        COMPUTE WS-PRODUCT = NODE-A-DIGIT * WS-SCALAR + WS-CARRY
        DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
        MOVE WS-REM-CHUNK TO WS-CHUNK
        PERFORM PREPEND-CHUNK-R
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    IF WS-CARRY > 0
        MOVE WS-CARRY TO WS-CHUNK
        PERFORM PREPEND-CHUNK-R
    END-IF
    MOVE WS-H1-SIGN TO WS-R-SIGN.

MULTIPLY-H2-BY-SCALAR-INTO-T.
    PERFORM CLEAR-T
    IF WS-H2-SIGN = 0 OR WS-SCALAR = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-CARRY
    PERFORM UNTIL WS-PTR-B = NULL
        SET ADDRESS OF NODE-B TO WS-PTR-B
        COMPUTE WS-PRODUCT = NODE-B-DIGIT * WS-SCALAR + WS-CARRY
        DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
        MOVE WS-REM-CHUNK TO WS-CHUNK
        PERFORM PREPEND-CHUNK-T
        SET WS-PTR-B TO NODE-B-PREV
    END-PERFORM
    IF WS-CARRY > 0
        MOVE WS-CARRY TO WS-CHUNK
        PERFORM PREPEND-CHUNK-T
    END-IF
    MOVE 1 TO WS-T-SIGN.

DIVIDE-H1-BY-SCALAR.
    MOVE 0 TO WS-CARRY WS-DIV-QUOT WS-DIV-REM
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL OR LK-STATUS NOT = 0
        SET ADDRESS OF NODE-A TO WS-PTR-A
        COMPUTE WS-SUM = WS-CARRY * BI-BASE + NODE-A-DIGIT
        DIVIDE WS-SCALAR INTO WS-SUM GIVING WS-DIV-QUOT REMAINDER WS-DIV-REM
        IF WS-DIV-QUOT >= BI-BASE OR WS-DIV-REM >= BI-BASE
            MOVE 44 TO LK-STATUS
        ELSE
            COMPUTE WS-CHUNK = WS-DIV-QUOT
                ON SIZE ERROR MOVE 44 TO LK-STATUS
            END-COMPUTE
            COMPUTE WS-CARRY = WS-DIV-REM
                ON SIZE ERROR MOVE 44 TO LK-STATUS
            END-COMPUTE
            IF LK-STATUS = 0 PERFORM APPEND-CHUNK-R END-IF
        END-IF
        SET WS-PTR-A TO NODE-A-NEXT
    END-PERFORM
    IF LK-STATUS = 0
        MOVE WS-H1-SIGN TO WS-R-SIGN
        PERFORM NORMALIZE-R
    END-IF.

DIVIDE-ABS-H1-H2.
    *> 这里实现长除法；每个商块用确定性的二分搜索得到。
    IF WS-H2-SIGN = 0
        MOVE 41 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF

    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP < 0
        PERFORM COPY-H1-TO-R2-ABS
        EXIT PARAGRAPH
    END-IF

    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-DIVIDEND-NEXT TO NODE-A-NEXT
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R2

        MOVE 0 TO WS-LOW WS-BEST
        COMPUTE WS-HIGH = BI-BASE - 1
        PERFORM UNTIL WS-LOW > WS-HIGH
            COMPUTE WS-MID = (WS-LOW + WS-HIGH) / 2
            MOVE WS-MID TO WS-SCALAR
            PERFORM MULTIPLY-H2-BY-SCALAR-INTO-T
            PERFORM LOAD-R2-H1
            PERFORM LOAD-T-H2
            PERFORM COMPARE-ABS-H1-H2
            IF WS-CMP >= 0
                MOVE WS-MID TO WS-BEST
                COMPUTE WS-LOW = WS-MID + 1
            ELSE
                IF WS-MID = 0
                    MOVE 1 TO WS-LOW
                    MOVE 0 TO WS-HIGH
                ELSE
                    COMPUTE WS-HIGH = WS-MID - 1
                END-IF
            END-IF
            PERFORM FREE-T
            PERFORM LOAD-B-H2
        END-PERFORM

        IF WS-R-CHUNKS > 0 OR WS-BEST > 0
            MOVE WS-BEST TO WS-CHUNK
            PERFORM APPEND-CHUNK-R
        END-IF

        IF WS-BEST > 0
            MOVE WS-BEST TO WS-SCALAR
            PERFORM LOAD-B-H2
            PERFORM MULTIPLY-H2-BY-SCALAR-INTO-T
            PERFORM LOAD-R2-H1
            PERFORM LOAD-T-H2
            PERFORM CLEAR-U
            PERFORM SUB-ABS-H1-H2-INTO-U
            PERFORM FREE-R2
            PERFORM MOVE-U-TO-R2
            PERFORM FREE-T
        END-IF
        SET WS-PTR-A TO WS-DIVIDEND-NEXT
        PERFORM LOAD-B-H2
    END-PERFORM

    IF WS-R-CHUNKS > 0
        MOVE 1 TO WS-R-SIGN
    END-IF
    IF WS-R2-CHUNKS > 0
        MOVE 1 TO WS-R2-SIGN
    END-IF.

MOVE-U-TO-R2.
    MOVE WS-U-SIGN TO WS-R2-SIGN
    MOVE WS-U-CHUNKS TO WS-R2-CHUNKS
    SET WS-R2-HEAD TO WS-U-HEAD
    SET WS-R2-TAIL TO WS-U-TAIL
    PERFORM CLEAR-U.

HANDLE-H1-TO-TEXT.
    MOVE SPACES TO LK-TEXT
    MOVE 0 TO LK-TEXT-LEN WS-OUT-POS
    IF WS-H1-SIGN = 0
        IF WS-H1-CHUNKS NOT = 0 OR WS-H1-HEAD NOT = NULL
            MOVE 49 TO LK-STATUS
            EXIT PARAGRAPH
        END-IF
        MOVE "0" TO LK-TEXT(1:1)
        MOVE 1 TO LK-TEXT-LEN
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-CHUNKS < 1 OR WS-H1-HEAD = NULL
        MOVE 49 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN < 0
        MOVE "-" TO LK-TEXT(1:1)
        MOVE 1 TO WS-OUT-POS
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-I > WS-H1-CHUNKS
        IF WS-PTR-A = NULL
            MOVE 49 TO LK-STATUS
            EXIT PERFORM
        END-IF
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM FORMAT-CHUNK-NINE-DIGITS
        IF WS-I = 1
            MOVE 1 TO WS-FIRST-DIGIT-POS
            PERFORM UNTIL WS-FIRST-DIGIT-POS >= 9
                       OR WS-DIGIT-BUFFER(WS-FIRST-DIGIT-POS:1) NOT = "0"
                ADD 1 TO WS-FIRST-DIGIT-POS
            END-PERFORM
            COMPUTE WS-PIECE-LEN = 10 - WS-FIRST-DIGIT-POS
            IF WS-OUT-POS + WS-PIECE-LEN > 8192
                MOVE 45 TO LK-STATUS
                EXIT PERFORM
            END-IF
            MOVE WS-DIGIT-BUFFER(WS-FIRST-DIGIT-POS:WS-PIECE-LEN)
              TO LK-TEXT(WS-OUT-POS + 1:WS-PIECE-LEN)
            ADD WS-PIECE-LEN TO WS-OUT-POS
        ELSE
            IF WS-OUT-POS + 9 > 8192
                MOVE 45 TO LK-STATUS
                EXIT PERFORM
            END-IF
            MOVE WS-DIGIT-BUFFER TO LK-TEXT(WS-OUT-POS + 1:9)
            ADD 9 TO WS-OUT-POS
        END-IF
        IF WS-I < WS-H1-CHUNKS
            SET WS-PTR-A TO NODE-A-NEXT
        END-IF
        ADD 1 TO WS-I
    END-PERFORM
    IF LK-STATUS = 0
        MOVE WS-OUT-POS TO LK-TEXT-LEN
    END-IF.

FORMAT-CHUNK-NINE-DIGITS.
    MOVE "000000000" TO WS-DIGIT-BUFFER
    MOVE WS-CHUNK TO WS-SCALAR
    MOVE 9 TO WS-J
    PERFORM UNTIL WS-J = 0
        DIVIDE 10 INTO WS-SCALAR GIVING WS-DIV-QUOT REMAINDER WS-DIV-REM
        COMPUTE WS-DIGIT-NUM = WS-DIV-REM
            ON SIZE ERROR MOVE 44 TO LK-STATUS
        END-COMPUTE
        IF LK-STATUS NOT = 0
            EXIT PERFORM
        END-IF
        MOVE WS-DIGIT-NUM TO WS-DIGIT-EDIT
        MOVE WS-DIGIT-EDIT TO WS-DIGIT-BUFFER(WS-J:1)
        MOVE WS-DIV-QUOT TO WS-SCALAR
        SUBTRACT 1 FROM WS-J
    END-PERFORM.

FREE-H1.
    SET WS-PTR-A TO WS-H1-HEAD
    MOVE 0 TO WS-I
    PERFORM UNTIL WS-PTR-A = NULL OR WS-I >= WS-H1-CHUNKS
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-PTR-NEXT TO NODE-A-NEXT
        FREE WS-PTR-A
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-PTR-A TO WS-PTR-NEXT
        ADD 1 TO WS-I
    END-PERFORM
    MOVE 0 TO WS-H1-SIGN WS-H1-CHUNKS
    SET WS-H1-HEAD TO NULL
    SET WS-H1-TAIL TO NULL.

FREE-R2.
    SET WS-PTR-R TO WS-R2-HEAD
    PERFORM UNTIL WS-PTR-R = NULL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET WS-PTR-NEXT TO NODE-R-NEXT
        FREE WS-PTR-R
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-PTR-R TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-R2.

FREE-T.
    SET WS-PTR-T TO WS-T-HEAD
    PERFORM UNTIL WS-PTR-T = NULL
        SET ADDRESS OF NODE-T TO WS-PTR-T
        SET WS-PTR-NEXT TO NODE-T-NEXT
        FREE WS-PTR-T
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-PTR-T TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-T.

FREE-R-LOCAL.
    SET WS-PTR-R TO WS-R-HEAD
    PERFORM UNTIL WS-PTR-R = NULL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET WS-PTR-NEXT TO NODE-R-NEXT
        FREE WS-PTR-R
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-PTR-R TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-R.

FREE-U.
    SET WS-PTR-U TO WS-U-HEAD
    PERFORM UNTIL WS-PTR-U = NULL
        SET ADDRESS OF NODE-U TO WS-PTR-U
        SET WS-PTR-NEXT TO NODE-U-NEXT
        FREE WS-PTR-U
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-PTR-U TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-U.

UNREGISTER-H1-FROM-ARENA.
    MOVE 0 TO WS-ARENA-FOUND
    IF BI-ARENA-ACTIVE = 0 OR WS-H1-HEAD = NULL EXIT PARAGRAPH END-IF
    PERFORM LOCATE-H1-ARENA-NODE
    IF WS-ARENA-FOUND = 0 EXIT PARAGRAPH END-IF
    PERFORM UNLINK-LOCATED-ARENA-NODE.

DETACH-H1-FROM-ARENA.
    MOVE 0 TO WS-ARENA-FOUND
    IF WS-H1-HEAD = NULL AND WS-H1-SIGN = 0 EXIT PARAGRAPH END-IF
    IF WS-H1-HEAD = NULL MOVE 48 TO LK-STATUS EXIT PARAGRAPH END-IF
    IF BI-ARENA-ACTIVE = 0 MOVE 48 TO LK-STATUS EXIT PARAGRAPH END-IF
    PERFORM LOCATE-H1-ARENA-NODE
    IF WS-ARENA-FOUND = 0
        MOVE 48 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    PERFORM UNLINK-LOCATED-ARENA-NODE.

LOCATE-H1-ARENA-NODE.
    MOVE 0 TO WS-ARENA-FOUND
    SET WS-ARENA-PTR TO NULL
    IF BI-ARENA-ACTIVE = 0 OR WS-H1-HEAD = NULL EXIT PARAGRAPH END-IF
    SET ADDRESS OF NODE-A TO WS-H1-HEAD
    SET WS-ARENA-PTR TO NODE-A-ARENA
    IF WS-ARENA-PTR NOT = NULL
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        IF AN-HEAD = WS-H1-HEAD
            MOVE 1 TO WS-ARENA-FOUND
            ADD 1 TO BI-ARENA-O1-HITS
            EXIT PARAGRAPH
        END-IF
    END-IF
    SET WS-ARENA-PTR TO BI-ARENA-HEAD
    PERFORM UNTIL WS-ARENA-PTR = NULL OR WS-ARENA-FOUND = 1
        ADD 1 TO BI-ARENA-SCAN-STEPS
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        IF AN-HEAD = WS-H1-HEAD
            MOVE 1 TO WS-ARENA-FOUND
            SET ADDRESS OF NODE-A TO WS-H1-HEAD
            SET NODE-A-ARENA TO WS-ARENA-PTR
        ELSE
            SET WS-ARENA-PTR TO AN-NEXT
        END-IF
    END-PERFORM.

UNLINK-LOCATED-ARENA-NODE.
    IF WS-ARENA-PTR = NULL OR WS-ARENA-FOUND = 0 EXIT PARAGRAPH END-IF
    SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
    SET WS-ARENA-PREV TO AN-PREV
    SET WS-ARENA-NEXT TO AN-NEXT
    IF WS-ARENA-PREV = NULL
        SET BI-ARENA-HEAD TO WS-ARENA-NEXT
    ELSE
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PREV
        SET AN-NEXT TO WS-ARENA-NEXT
    END-IF
    IF WS-ARENA-NEXT NOT = NULL
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-NEXT
        SET AN-PREV TO WS-ARENA-PREV
    END-IF
    SET ADDRESS OF NODE-A TO WS-H1-HEAD
    SET NODE-A-ARENA TO NULL
    FREE WS-ARENA-PTR
    SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS BI-ARENA-COUNT
    SET WS-ARENA-PTR WS-ARENA-PREV WS-ARENA-NEXT TO NULL
    MOVE 0 TO WS-ARENA-FOUND.

FREE-ARENA.
    SET WS-ARENA-PTR TO BI-ARENA-HEAD
    PERFORM UNTIL WS-ARENA-PTR = NULL
        SET ADDRESS OF ARENA-NODE TO WS-ARENA-PTR
        SET WS-ARENA-NEXT TO AN-NEXT
        MOVE AN-SIGN TO WS-H1-SIGN
        MOVE AN-CHUNKS TO WS-H1-CHUNKS
        SET WS-H1-HEAD TO AN-HEAD
        SET WS-H1-TAIL TO AN-TAIL
        IF WS-H1-HEAD NOT = NULL
            SET ADDRESS OF NODE-A TO WS-H1-HEAD
            SET NODE-A-ARENA TO NULL
        END-IF
        PERFORM FREE-H1
        FREE WS-ARENA-PTR
        SUBTRACT 1 FROM BI-LIVE-ALLOCATIONS
        SET WS-ARENA-PTR TO WS-ARENA-NEXT
    END-PERFORM
    SET BI-ARENA-HEAD TO NULL
    MOVE 0 TO BI-ARENA-COUNT.
END PROGRAM BIG-INTEGER-SERVICE.
