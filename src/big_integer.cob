PROCEDURE DIVISION USING LK-OP LK-TEXT LK-TEXT-LEN LK-A LK-B LK-OUT LK-REM LK-CMP LK-STATUS.
MAIN.
    MOVE 0 TO LK-STATUS LK-CMP
    EVALUATE FUNCTION TRIM(LK-OP)
        WHEN "INIT-TEXT"
            PERFORM CLEAR-R
            PERFORM PARSE-TEXT-INTO-R
            IF LK-STATUS = 0
                PERFORM EXPORT-R-OUT
            END-IF
        WHEN "COPY"
            PERFORM LOAD-A-H1
            PERFORM CLEAR-R
            PERFORM COPY-H1-TO-R
            PERFORM EXPORT-R-OUT
        WHEN "CMP"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM COMPARE-SIGNED-H1-H2
            MOVE WS-CMP TO LK-CMP
        WHEN "ADD"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM ADD-SIGNED-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "SUB"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM SUB-SIGNED-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "MUL"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            PERFORM CLEAR-R
            PERFORM MULTIPLY-H1-H2
            PERFORM EXPORT-R-OUT
        WHEN "DIVMOD"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            MOVE WS-H1-SIGN TO WS-ORIGINAL-A-SIGN
            MOVE WS-H2-SIGN TO WS-ORIGINAL-B-SIGN
            IF WS-H2-SIGN = 0
                MOVE 41 TO LK-STATUS
            ELSE
                PERFORM CLEAR-R
                PERFORM CLEAR-R2
                PERFORM DIVIDE-ABS-H1-H2
                IF LK-STATUS = 0
                    IF WS-R-CHUNKS > 0
                        COMPUTE WS-R-SIGN = WS-ORIGINAL-A-SIGN * WS-ORIGINAL-B-SIGN
                    END-IF
                    IF WS-R2-CHUNKS > 0
                        MOVE WS-ORIGINAL-A-SIGN TO WS-R2-SIGN
                    END-IF
                    PERFORM EXPORT-R-OUT
                    PERFORM EXPORT-R2-REM
                END-IF
            END-IF
        WHEN "MOD-EUCLID"
            PERFORM LOAD-A-H1
            PERFORM LOAD-B-H2
            MOVE WS-H1-SIGN TO WS-ORIGINAL-A-SIGN
            MOVE WS-H2-SIGN TO WS-ORIGINAL-B-SIGN
            IF WS-H2-SIGN <= 0
                MOVE 42 TO LK-STATUS
            ELSE
                PERFORM CLEAR-R
                PERFORM CLEAR-R2
                PERFORM DIVIDE-ABS-H1-H2
                IF LK-STATUS = 0
                    IF WS-ORIGINAL-A-SIGN < 0 AND WS-R2-CHUNKS > 0
                        PERFORM LOAD-B-H1
                        PERFORM LOAD-R2-H2
                        PERFORM CLEAR-U
                        PERFORM SUB-ABS-H1-H2-INTO-U
                        PERFORM FREE-R2
                        PERFORM MOVE-U-TO-R2
                    END-IF
                    IF WS-R2-CHUNKS > 0
                        MOVE 1 TO WS-R2-SIGN
                    END-IF
                    PERFORM EXPORT-R2-OUT
                END-IF
            END-IF
        WHEN "TO-TEXT"
            PERFORM LOAD-A-H1
            PERFORM HANDLE-H1-TO-TEXT
        WHEN "FREE-A"
            PERFORM LOAD-A-H1
            PERFORM FREE-H1
            MOVE 0 TO LK-A-SIGN LK-A-CHUNKS
            SET LK-A-HEAD TO NULL
            SET LK-A-TAIL TO NULL
        WHEN OTHER
            MOVE 40 TO LK-STATUS
    END-EVALUATE
    GOBACK.

CLEAR-R.
    MOVE 0 TO WS-R-SIGN WS-R-CHUNKS
    SET WS-R-HEAD TO NULL
    SET WS-R-TAIL TO NULL.

CLEAR-R2.
    MOVE 0 TO WS-R2-SIGN WS-R2-CHUNKS
    SET WS-R2-HEAD TO NULL
    SET WS-R2-TAIL TO NULL.

CLEAR-T.
    MOVE 0 TO WS-T-SIGN WS-T-CHUNKS
    SET WS-T-HEAD TO NULL
    SET WS-T-TAIL TO NULL.

CLEAR-U.
    MOVE 0 TO WS-U-SIGN WS-U-CHUNKS
    SET WS-U-HEAD TO NULL
    SET WS-U-TAIL TO NULL.

LOAD-A-H1.
    MOVE LK-A-SIGN TO WS-H1-SIGN
    MOVE LK-A-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-A-HEAD
    SET WS-H1-TAIL TO LK-A-TAIL.

LOAD-B-H1.
    MOVE LK-B-SIGN TO WS-H1-SIGN
    MOVE LK-B-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO LK-B-HEAD
    SET WS-H1-TAIL TO LK-B-TAIL.

LOAD-B-H2.
    MOVE LK-B-SIGN TO WS-H2-SIGN
    MOVE LK-B-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO LK-B-HEAD
    SET WS-H2-TAIL TO LK-B-TAIL.

LOAD-R2-H2.
    MOVE WS-R2-SIGN TO WS-H2-SIGN
    MOVE WS-R2-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-R2-HEAD
    SET WS-H2-TAIL TO WS-R2-TAIL.

LOAD-R2-H1.
    MOVE WS-R2-SIGN TO WS-H1-SIGN
    MOVE WS-R2-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO WS-R2-HEAD
    SET WS-H1-TAIL TO WS-R2-TAIL.

LOAD-T-H2.
    MOVE WS-T-SIGN TO WS-H2-SIGN
    MOVE WS-T-CHUNKS TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-T-HEAD
    SET WS-H2-TAIL TO WS-T-TAIL.

EXPORT-R-OUT.
    MOVE WS-R-SIGN TO LK-OUT-SIGN
    MOVE WS-R-CHUNKS TO LK-OUT-CHUNKS
    SET LK-OUT-HEAD TO WS-R-HEAD
    SET LK-OUT-TAIL TO WS-R-TAIL.

EXPORT-R2-OUT.
    MOVE WS-R2-SIGN TO LK-OUT-SIGN
    MOVE WS-R2-CHUNKS TO LK-OUT-CHUNKS
    SET LK-OUT-HEAD TO WS-R2-HEAD
    SET LK-OUT-TAIL TO WS-R2-TAIL.

EXPORT-R2-REM.
    MOVE WS-R2-SIGN TO LK-REM-SIGN
    MOVE WS-R2-CHUNKS TO LK-REM-CHUNKS
    SET LK-REM-HEAD TO WS-R2-HEAD
    SET LK-REM-TAIL TO WS-R2-TAIL.

PARSE-TEXT-INTO-R.
    IF LK-TEXT-LEN < 1 OR LK-TEXT-LEN > 8192
        MOVE 43 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-NEGATIVE
    MOVE 1 TO WS-TEXT-START
    IF LK-TEXT(1:1) = "-"
        MOVE 1 TO WS-NEGATIVE
        MOVE 2 TO WS-TEXT-START
    ELSE
        IF LK-TEXT(1:1) = "+"
            MOVE 2 TO WS-TEXT-START
        END-IF
    END-IF
    IF WS-TEXT-START > LK-TEXT-LEN
        MOVE 44 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE WS-TEXT-START TO WS-I
    PERFORM UNTIL WS-I > LK-TEXT-LEN
        IF LK-TEXT(WS-I:1) < "0" OR LK-TEXT(WS-I:1) > "9"
            MOVE 44 TO LK-STATUS
            EXIT PERFORM
        END-IF
        ADD 1 TO WS-I
    END-PERFORM
    IF LK-STATUS NOT = 0
        EXIT PARAGRAPH
    END-IF

    MOVE LK-TEXT-LEN TO WS-TEXT-END
    PERFORM UNTIL WS-TEXT-END < WS-TEXT-START
        COMPUTE WS-TEXT-POS = WS-TEXT-END - 8
        IF WS-TEXT-POS < WS-TEXT-START
            MOVE WS-TEXT-START TO WS-TEXT-POS
        END-IF
        COMPUTE WS-PART-LEN = WS-TEXT-END - WS-TEXT-POS + 1
        MOVE SPACES TO WS-PART
        MOVE LK-TEXT(WS-TEXT-POS:WS-PART-LEN) TO WS-PART(10 - WS-PART-LEN:WS-PART-LEN)
        MOVE FUNCTION NUMVAL(WS-PART) TO WS-CHUNK
        *> 从低位向高位分块时，低位零块本身有位值，不能提前丢弃。
        *> 例如 1000000000 必须先形成 [1,0]，随后只能删除真正的高位零块。
        PERFORM PREPEND-CHUNK-R
        COMPUTE WS-TEXT-END = WS-TEXT-POS - 1
    END-PERFORM

    *> 文本可以带任意数量的前导零；内部表示必须在符号判定前正规化。
    PERFORM NORMALIZE-R
    IF WS-R-CHUNKS > 0
        IF WS-NEGATIVE = 1
            MOVE -1 TO WS-R-SIGN
        ELSE
            MOVE 1 TO WS-R-SIGN
        END-IF
    END-IF.

PREPEND-CHUNK-R.
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-R-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R-HEAD = NULL
        SET WS-R-HEAD TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-PREV TO WS-PTR-N
        SET WS-R-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R-CHUNKS.

APPEND-CHUNK-R.
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-R-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R-TAIL = NULL
        SET WS-R-HEAD TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R-TAIL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-NEXT TO WS-PTR-N
        SET WS-R-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R-CHUNKS.

PREPEND-CHUNK-T.
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-T-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-T-HEAD = NULL
        SET WS-T-HEAD TO WS-PTR-N
        SET WS-T-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-T TO WS-T-HEAD
        SET ADDRESS OF NODE-T TO WS-PTR-T
        SET NODE-T-PREV TO WS-PTR-N
        SET WS-T-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-T-CHUNKS.

APPEND-CHUNK-R2.
    IF WS-R2-CHUNKS = 0 AND WS-CHUNK = 0
        EXIT PARAGRAPH
    END-IF
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-R2-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-R2-TAIL = NULL
        SET WS-R2-HEAD TO WS-PTR-N
        SET WS-R2-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-R TO WS-R2-TAIL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET NODE-R-NEXT TO WS-PTR-N
        SET WS-R2-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-R2-CHUNKS
    MOVE 1 TO WS-R2-SIGN.

APPEND-CHUNK-U.
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-NEXT TO NULL
    SET NODE-N-PREV TO WS-U-TAIL
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-U-TAIL = NULL
        SET WS-U-HEAD TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-U TO WS-U-TAIL
        SET ADDRESS OF NODE-U TO WS-PTR-U
        SET NODE-U-NEXT TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    END-IF
    ADD 1 TO WS-U-CHUNKS.

COPY-H1-TO-R.
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SET WS-PTR-A TO NODE-A-NEXT
    END-PERFORM
    MOVE WS-H1-SIGN TO WS-R-SIGN.

COPY-H1-TO-R2-ABS.
    PERFORM CLEAR-R2
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R2
        SET WS-PTR-A TO NODE-A-NEXT
    END-PERFORM
    IF WS-R2-CHUNKS > 0
        MOVE 1 TO WS-R2-SIGN
    END-IF.

COMPARE-ABS-H1-H2.
    MOVE 0 TO WS-CMP
    IF WS-H1-CHUNKS < WS-H2-CHUNKS
        MOVE -1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-CHUNKS > WS-H2-CHUNKS
        MOVE 1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    SET WS-PTR-B TO WS-H2-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET ADDRESS OF NODE-B TO WS-PTR-B
        IF NODE-A-DIGIT < NODE-B-DIGIT
            MOVE -1 TO WS-CMP
            EXIT PERFORM
        END-IF
        IF NODE-A-DIGIT > NODE-B-DIGIT
            MOVE 1 TO WS-CMP
            EXIT PERFORM
        END-IF
        SET WS-PTR-A TO NODE-A-NEXT
        SET WS-PTR-B TO NODE-B-NEXT
    END-PERFORM.

COMPARE-SIGNED-H1-H2.
    IF WS-H1-SIGN < WS-H2-SIGN
        MOVE -1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN > WS-H2-SIGN
        MOVE 1 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        MOVE 0 TO WS-CMP
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-H1-SIGN < 0
        COMPUTE WS-CMP = 0 - WS-CMP
    END-IF.

ADD-SIGNED-H1-H2.
    IF WS-H1-SIGN = 0
        PERFORM COPY-H2-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H2-SIGN = 0
        PERFORM COPY-H1-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = WS-H2-SIGN
        PERFORM ADD-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP = 0
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP > 0
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    ELSE
        PERFORM SWAP-H1-H2
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    END-IF.

SUB-SIGNED-H1-H2.
    IF WS-H2-SIGN = 0
        PERFORM COPY-H1-TO-R
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        PERFORM COPY-H2-TO-R
        COMPUTE WS-R-SIGN = 0 - WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN NOT = WS-H2-SIGN
        PERFORM ADD-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP = 0
        EXIT PARAGRAPH
    END-IF
    IF WS-CMP > 0
        PERFORM SUB-ABS-H1-H2-INTO-R
        MOVE WS-H1-SIGN TO WS-R-SIGN
    ELSE
        MOVE WS-H1-SIGN TO WS-SAVED-SIGN
        PERFORM SWAP-H1-H2
        PERFORM SUB-ABS-H1-H2-INTO-R
        COMPUTE WS-R-SIGN = 0 - WS-SAVED-SIGN
    END-IF.

COPY-H2-TO-R.
    IF WS-H2-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-B TO WS-H2-HEAD
    PERFORM UNTIL WS-PTR-B = NULL
        SET ADDRESS OF NODE-B TO WS-PTR-B
        MOVE NODE-B-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        SET WS-PTR-B TO NODE-B-NEXT
    END-PERFORM
    MOVE WS-H2-SIGN TO WS-R-SIGN.

SWAP-H1-H2.
    MOVE WS-H1-SIGN TO WS-SAVED-SIGN
    MOVE WS-H1-CHUNKS TO WS-J
    SET WS-PTR-A TO WS-H1-HEAD
    SET WS-PTR-B TO WS-H1-TAIL
    MOVE WS-H2-SIGN TO WS-H1-SIGN
    MOVE WS-H2-CHUNKS TO WS-H1-CHUNKS
    SET WS-H1-HEAD TO WS-H2-HEAD
    SET WS-H1-TAIL TO WS-H2-TAIL
    MOVE WS-SAVED-SIGN TO WS-H2-SIGN
    MOVE WS-J TO WS-H2-CHUNKS
    SET WS-H2-HEAD TO WS-PTR-A
    SET WS-H2-TAIL TO WS-PTR-B.

ADD-ABS-H1-H2-INTO-R.
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-CARRY
    PERFORM UNTIL WS-PTR-A = NULL AND WS-PTR-B = NULL AND WS-CARRY = 0
        MOVE 0 TO WS-AD WS-BD
        IF WS-PTR-A NOT = NULL
            SET ADDRESS OF NODE-A TO WS-PTR-A
            MOVE NODE-A-DIGIT TO WS-AD
            SET WS-PTR-A TO NODE-A-PREV
        END-IF
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        COMPUTE WS-SUM = WS-AD + WS-BD + WS-CARRY
        DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
        MOVE WS-REM-CHUNK TO WS-CHUNK
        PERFORM PREPEND-CHUNK-R
    END-PERFORM.

SUB-ABS-H1-H2-INTO-R.
    *> 前置条件是绝对值 H1 大于 H2。
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-BORROW
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-AD
        MOVE 0 TO WS-BD
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        IF WS-AD < WS-BD + WS-BORROW
            COMPUTE WS-SUM = WS-AD + BI-BASE - WS-BD - WS-BORROW
            MOVE 1 TO WS-BORROW
        ELSE
            COMPUTE WS-SUM = WS-AD - WS-BD - WS-BORROW
            MOVE 0 TO WS-BORROW
        END-IF
        MOVE WS-SUM TO WS-CHUNK
        PERFORM PREPEND-CHUNK-R
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    PERFORM NORMALIZE-R.

SUB-ABS-H1-H2-INTO-U.
    SET WS-PTR-A TO WS-H1-TAIL
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-BORROW
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        MOVE NODE-A-DIGIT TO WS-AD
        MOVE 0 TO WS-BD
        IF WS-PTR-B NOT = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            MOVE NODE-B-DIGIT TO WS-BD
            SET WS-PTR-B TO NODE-B-PREV
        END-IF
        IF WS-AD < WS-BD + WS-BORROW
            COMPUTE WS-SUM = WS-AD + BI-BASE - WS-BD - WS-BORROW
            MOVE 1 TO WS-BORROW
        ELSE
            COMPUTE WS-SUM = WS-AD - WS-BD - WS-BORROW
            MOVE 0 TO WS-BORROW
        END-IF
        MOVE WS-SUM TO WS-CHUNK
        PERFORM PREPEND-CHUNK-U
        SET WS-PTR-A TO NODE-A-PREV
    END-PERFORM
    MOVE 1 TO WS-U-SIGN
    PERFORM NORMALIZE-U.

PREPEND-CHUNK-U.
    ALLOCATE NODE-N INITIALIZED
    MOVE WS-CHUNK TO NODE-N-DIGIT
    SET NODE-N-PREV TO NULL
    SET NODE-N-NEXT TO WS-U-HEAD
    SET WS-PTR-N TO ADDRESS OF NODE-N
    IF WS-U-HEAD = NULL
        SET WS-U-HEAD TO WS-PTR-N
        SET WS-U-TAIL TO WS-PTR-N
    ELSE
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        SET NODE-U-PREV TO WS-PTR-N
        SET WS-U-HEAD TO WS-PTR-N
    END-IF
    ADD 1 TO WS-U-CHUNKS.

NORMALIZE-R.
    PERFORM UNTIL WS-R-HEAD = NULL OR WS-R-CHUNKS <= 1
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        IF NODE-R-DIGIT NOT = 0
            EXIT PERFORM
        END-IF
        SET WS-PTR-NEXT TO NODE-R-NEXT
        IF WS-PTR-NEXT NOT = NULL
            SET ADDRESS OF NODE-T TO WS-PTR-NEXT
            SET NODE-T-PREV TO NULL
        END-IF
        SET WS-R-HEAD TO WS-PTR-NEXT
        SUBTRACT 1 FROM WS-R-CHUNKS
        FREE WS-PTR-R
    END-PERFORM
    IF WS-R-CHUNKS = 1
        SET WS-PTR-R TO WS-R-HEAD
        SET ADDRESS OF NODE-R TO WS-PTR-R
        IF NODE-R-DIGIT = 0
            FREE WS-PTR-R
            PERFORM CLEAR-R
        END-IF
    END-IF.

NORMALIZE-U.
    PERFORM UNTIL WS-U-HEAD = NULL OR WS-U-CHUNKS <= 1
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        IF NODE-U-DIGIT NOT = 0
            EXIT PERFORM
        END-IF
        SET WS-PTR-NEXT TO NODE-U-NEXT
        IF WS-PTR-NEXT NOT = NULL
            SET ADDRESS OF NODE-T TO WS-PTR-NEXT
            SET NODE-T-PREV TO NULL
        END-IF
        SET WS-U-HEAD TO WS-PTR-NEXT
        SUBTRACT 1 FROM WS-U-CHUNKS
        FREE WS-PTR-U
    END-PERFORM
    IF WS-U-CHUNKS = 1
        SET WS-PTR-U TO WS-U-HEAD
        SET ADDRESS OF NODE-U TO WS-PTR-U
        IF NODE-U-DIGIT = 0
            FREE WS-PTR-U
            PERFORM CLEAR-U
        END-IF
    END-IF.

MULTIPLY-H1-H2.
    IF WS-H1-SIGN = 0 OR WS-H2-SIGN = 0
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-K = WS-H1-CHUNKS + WS-H2-CHUNKS
    MOVE 0 TO WS-I
    PERFORM UNTIL WS-I >= WS-K
        MOVE 0 TO WS-CHUNK
        PERFORM APPEND-CHUNK-R
        ADD 1 TO WS-I
    END-PERFORM

    SET WS-PTR-A TO WS-H1-TAIL
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-PTR-B TO WS-H2-TAIL
        MOVE 1 TO WS-J
        PERFORM UNTIL WS-PTR-B = NULL
            SET ADDRESS OF NODE-B TO WS-PTR-B
            SET WS-PTR-R TO WS-R-TAIL
            COMPUTE WS-SKIP = WS-I + WS-J - 2
            MOVE 0 TO WS-K
            PERFORM UNTIL WS-K >= WS-SKIP
                SET ADDRESS OF NODE-R TO WS-PTR-R
                SET WS-PTR-R TO NODE-R-PREV
                ADD 1 TO WS-K
            END-PERFORM
            SET ADDRESS OF NODE-R TO WS-PTR-R
            COMPUTE WS-PRODUCT = NODE-A-DIGIT * NODE-B-DIGIT + NODE-R-DIGIT
            DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
            MOVE WS-REM-CHUNK TO NODE-R-DIGIT
            SET WS-PTR-R TO NODE-R-PREV
            PERFORM UNTIL WS-CARRY = 0
                SET ADDRESS OF NODE-R TO WS-PTR-R
                COMPUTE WS-SUM = NODE-R-DIGIT + WS-CARRY
                DIVIDE BI-BASE INTO WS-SUM GIVING WS-CARRY REMAINDER WS-REM-CHUNK
                MOVE WS-REM-CHUNK TO NODE-R-DIGIT
                SET WS-PTR-R TO NODE-R-PREV
            END-PERFORM
            SET WS-PTR-B TO NODE-B-PREV
            ADD 1 TO WS-J
        END-PERFORM
        SET WS-PTR-A TO NODE-A-PREV
        ADD 1 TO WS-I
    END-PERFORM
    *> 普通乘法不经过 DIVMOD；结果符号必须直接来自本次乘法的两个操作数。
    COMPUTE WS-R-SIGN = WS-H1-SIGN * WS-H2-SIGN
    PERFORM NORMALIZE-R.

MULTIPLY-H2-BY-SCALAR-INTO-T.
    PERFORM CLEAR-T
    IF WS-H2-SIGN = 0 OR WS-SCALAR = 0
        EXIT PARAGRAPH
    END-IF
    SET WS-PTR-B TO WS-H2-TAIL
    MOVE 0 TO WS-CARRY
    PERFORM UNTIL WS-PTR-B = NULL
        SET ADDRESS OF NODE-B TO WS-PTR-B
        COMPUTE WS-PRODUCT = NODE-B-DIGIT * WS-SCALAR + WS-CARRY
        DIVIDE BI-BASE INTO WS-PRODUCT GIVING WS-CARRY REMAINDER WS-REM-CHUNK
        MOVE WS-REM-CHUNK TO WS-CHUNK
        PERFORM PREPEND-CHUNK-T
        SET WS-PTR-B TO NODE-B-PREV
    END-PERFORM
    IF WS-CARRY > 0
        MOVE WS-CARRY TO WS-CHUNK
        PERFORM PREPEND-CHUNK-T
    END-IF
    MOVE 1 TO WS-T-SIGN.

DIVIDE-ABS-H1-H2.
    *> 这里实现长除法；每个商块用确定性的二分搜索得到。
    IF WS-H2-SIGN = 0
        MOVE 41 TO LK-STATUS
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN = 0
        EXIT PARAGRAPH
    END-IF

    PERFORM COMPARE-ABS-H1-H2
    IF WS-CMP < 0
        PERFORM COPY-H1-TO-R2-ABS
        EXIT PARAGRAPH
    END-IF

    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-DIVIDEND-NEXT TO NODE-A-NEXT
        MOVE NODE-A-DIGIT TO WS-CHUNK
        PERFORM APPEND-CHUNK-R2

        MOVE 0 TO WS-LOW WS-BEST
        COMPUTE WS-HIGH = BI-BASE - 1
        PERFORM UNTIL WS-LOW > WS-HIGH
            COMPUTE WS-MID = (WS-LOW + WS-HIGH) / 2
            MOVE WS-MID TO WS-SCALAR
            PERFORM MULTIPLY-H2-BY-SCALAR-INTO-T
            PERFORM LOAD-R2-H1
            PERFORM LOAD-T-H2
            PERFORM COMPARE-ABS-H1-H2
            IF WS-CMP >= 0
                MOVE WS-MID TO WS-BEST
                COMPUTE WS-LOW = WS-MID + 1
            ELSE
                IF WS-MID = 0
                    MOVE 1 TO WS-LOW
                    MOVE 0 TO WS-HIGH
                ELSE
                    COMPUTE WS-HIGH = WS-MID - 1
                END-IF
            END-IF
            PERFORM FREE-T
            PERFORM LOAD-B-H2
        END-PERFORM

        IF WS-R-CHUNKS > 0 OR WS-BEST > 0
            MOVE WS-BEST TO WS-CHUNK
            PERFORM APPEND-CHUNK-R
        END-IF

        IF WS-BEST > 0
            MOVE WS-BEST TO WS-SCALAR
            PERFORM LOAD-B-H2
            PERFORM MULTIPLY-H2-BY-SCALAR-INTO-T
            PERFORM LOAD-R2-H1
            PERFORM LOAD-T-H2
            PERFORM CLEAR-U
            PERFORM SUB-ABS-H1-H2-INTO-U
            PERFORM FREE-R2
            PERFORM MOVE-U-TO-R2
            PERFORM FREE-T
        END-IF
        SET WS-PTR-A TO WS-DIVIDEND-NEXT
        PERFORM LOAD-B-H2
    END-PERFORM

    IF WS-R-CHUNKS > 0
        MOVE 1 TO WS-R-SIGN
    END-IF
    IF WS-R2-CHUNKS > 0
        MOVE 1 TO WS-R2-SIGN
    END-IF.

MOVE-U-TO-R2.
    MOVE WS-U-SIGN TO WS-R2-SIGN
    MOVE WS-U-CHUNKS TO WS-R2-CHUNKS
    SET WS-R2-HEAD TO WS-U-HEAD
    SET WS-R2-TAIL TO WS-U-TAIL
    PERFORM CLEAR-U.

HANDLE-H1-TO-TEXT.
    MOVE SPACES TO LK-TEXT
    MOVE 0 TO LK-TEXT-LEN WS-OUT-POS
    IF WS-H1-SIGN = 0
        MOVE "0" TO LK-TEXT(1:1)
        MOVE 1 TO LK-TEXT-LEN
        EXIT PARAGRAPH
    END-IF
    IF WS-H1-SIGN < 0
        MOVE "-" TO LK-TEXT(1:1)
        MOVE 1 TO WS-OUT-POS
    END-IF
    SET WS-PTR-A TO WS-H1-HEAD
    MOVE 1 TO WS-I
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        IF WS-I = 1
            MOVE NODE-A-DIGIT TO WS-FIRST-EDIT
            MOVE FUNCTION TRIM(WS-FIRST-EDIT) TO WS-PIECE
        ELSE
            MOVE NODE-A-DIGIT TO WS-NEXT-EDIT
            MOVE WS-NEXT-EDIT TO WS-PIECE
        END-IF
        MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PIECE)) TO WS-PIECE-LEN
        IF WS-OUT-POS + WS-PIECE-LEN > 8192
            MOVE 45 TO LK-STATUS
            EXIT PERFORM
        END-IF
        MOVE FUNCTION TRIM(WS-PIECE) TO LK-TEXT(WS-OUT-POS + 1:WS-PIECE-LEN)
        ADD WS-PIECE-LEN TO WS-OUT-POS
        SET WS-PTR-A TO NODE-A-NEXT
        ADD 1 TO WS-I
    END-PERFORM
    MOVE WS-OUT-POS TO LK-TEXT-LEN.

FREE-H1.
    SET WS-PTR-A TO WS-H1-HEAD
    PERFORM UNTIL WS-PTR-A = NULL
        SET ADDRESS OF NODE-A TO WS-PTR-A
        SET WS-PTR-NEXT TO NODE-A-NEXT
        FREE WS-PTR-A
        SET WS-PTR-A TO WS-PTR-NEXT
    END-PERFORM
    MOVE 0 TO WS-H1-SIGN WS-H1-CHUNKS
    SET WS-H1-HEAD TO NULL
    SET WS-H1-TAIL TO NULL.

FREE-R2.
    SET WS-PTR-R TO WS-R2-HEAD
    PERFORM UNTIL WS-PTR-R = NULL
        SET ADDRESS OF NODE-R TO WS-PTR-R
        SET WS-PTR-NEXT TO NODE-R-NEXT
        FREE WS-PTR-R
        SET WS-PTR-R TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-R2.

FREE-T.
    SET WS-PTR-T TO WS-T-HEAD
    PERFORM UNTIL WS-PTR-T = NULL
        SET ADDRESS OF NODE-T TO WS-PTR-T
        SET WS-PTR-NEXT TO NODE-T-NEXT
        FREE WS-PTR-T
        SET WS-PTR-T TO WS-PTR-NEXT
    END-PERFORM
    PERFORM CLEAR-T.
END PROGRAM BIG-INTEGER-SERVICE.
