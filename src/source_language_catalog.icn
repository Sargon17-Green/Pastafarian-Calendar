record CatalogEntry(canonicalIndex, text)
record SourceLanguageCatalog(version, frozen, cutlets, months)

procedure canonicalCutletKannada(canonicalIndex)
    case canonicalIndex of {
        1: return "ಕಂಚು"
        2: return "ನರಿ"
        3: return "ಮೂತ್ರಪಿಂಡ"
        4: return "ಲಗಾಶ್"
        5: return "ಚಿಂತನೆ"
        6: return "ಒಂಬತ್ತರಲ್ಲಿ ನಾಲ್ಕು ಭಾಗಗಳು"
        7: return "ಫಲ್ಗುರಶ್"
        8: return "ಜೊಂಡು"
        9: return "ಗೊಂಚಲು"
        10: return "ಚೇಳು"
        11: return "ಬೂದಿ"
        12: return "ಗೋಧಿ"
        13: return "ನದಿ"
        14: return "ನಗು"
        15: return "ಅಕ್ಕಾಡ್"
        16: return "ಕೊಂಬು"
        17: return "ಖಾಲಿ ಮಡಿಕೆ"
        default: fail
    }
end

procedure canonicalMonthKannada(canonicalIndex)
    case canonicalIndex of {
        1: return "ಕೆಸರು"
        2: return "ದಾಳಿಂಬೆ"
        3: return "ಮೊಣಕೈ"
        4: return "ಅಸೂಯೆ"
        5: return "ಎರಿಡು"
        6: return "ದಂತಮಂಜನ"
        7: return "ಐದರಲ್ಲಿ ಮೂರು ಭಾಗಗಳು"
        8: return "ಕರ್ಷುಮಬ್"
        9: return "ಚಿರತೆ"
        10: return "ತವರ"
        11: return "ಮಂಜು"
        12: return "ಧೂಪದ ರಾಳ"
        13: return "ತಕಲಿ"
        14: return "ಪಕ್ಕೆಲುಬು"
        15: return "ಕ್ಯಾರಬ್ ಹಣ್ಣು"
        16: return "ಉರುಕ್"
        17: return "ನಾಚಿಕೆ"
        18: return "ಒಂಟೆ"
        19: return "ತಾಮ್ರ"
        20: return "ಬಾವಿ"
        21: return "ಮೊಟ್ಟೆಯ ಹಳದಿ ಭಾಗ"
        22: return "ನಕ್ಷತ್ರ"
        23: return "ಜೇನು"
        24: return "ಪ್ಲೀಹೆ"
        25: return "ಸುಣ್ಣದ ಕಲ್ಲು"
        26: return "ಸಂತೋಷ"
        27: return "ಅಂಜೂರ"
        28: return "ನಿನವೆ"
        29: return "ಕಪ್ಪೆ"
        30: return "ಡಾಮರು"
        31: return "ಮೇಣದಬತ್ತಿ"
        32: return "ಮುಚ್ಚಿದ ಬಾಗಿಲು"
        33: return "ಎಳ್ಳು"
        34: return "ಕುತ್ತಿಗೆಯ ಹಿಂಭಾಗ"
        35: return "ಬೆಳ್ಳಿ"
        36: return "ಲಿಲಿ ಹೂ"
        37: return "ಬಿರುಗಾಳಿ"
        38: return "ಕತ್ತೆ"
        39: return "ಹಿಟ್ಟು"
        40: return "ಪಶ್ಚಾತ್ತಾಪ"
        41: return "ಬಾಬಿಲೋನ್"
        42: return "ನಾಲಿಗೆ"
        43: return "ಅಗಸೆ"
        44: return "ಉಪ್ಪು"
        45: return "ಪಿಯರ್ ಹಣ್ಣು"
        46: return "ಬಿಲ್ಲು"
        47: return "ಮರಳು"
        default: fail
    }
end

procedure buildSourceLanguageCatalog()
    local cutlets, months, i
    cutlets := []
    i := 1
    while i <= 17 do {
        put(cutlets, CatalogEntry(i, canonicalCutletKannada(i)))
        i := i + 1
    }
    months := []
    i := 1
    while i <= 47 do {
        put(months, CatalogEntry(i, canonicalMonthKannada(i)))
        i := i + 1
    }
    return SourceLanguageCatalog("kn-v1", 1, cutlets, months)
end

procedure validateSourceLanguageCatalog(catalog)
    local i
    if /catalog then fail
    if catalog.version ~== "kn-v1" then fail
    if catalog.frozen ~= 1 then fail
    if *catalog.cutlets ~= 17 then fail
    if *catalog.months ~= 47 then fail
    i := 1
    while i <= 17 do {
        if catalog.cutlets[i].canonicalIndex ~= i then fail
        if catalog.cutlets[i].text ~== canonicalCutletKannada(i) then fail
        i := i + 1
    }
    i := 1
    while i <= 47 do {
        if catalog.months[i].canonicalIndex ~= i then fail
        if catalog.months[i].text ~== canonicalMonthKannada(i) then fail
        i := i + 1
    }
    return 1
end

procedure catalogCutletText(catalog, canonicalIndex)
    validateSourceLanguageCatalog(catalog) | fail
    if 1 <= canonicalIndex & canonicalIndex <= 17 then return canonicalCutletKannada(canonicalIndex)
    fail
end

procedure catalogMonthText(catalog, canonicalIndex)
    validateSourceLanguageCatalog(catalog) | fail
    if 1 <= canonicalIndex & canonicalIndex <= 47 then return canonicalMonthKannada(canonicalIndex)
    fail
end
