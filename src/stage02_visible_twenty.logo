; Stage2 Discovery11: extend fifteen visible drops to twenty; exact BI production only.
to monster.stage02.visible.twenty.extend :i :ctx :stones :hidden :acc
  if :i > 20 [output :acc]
  localmake "p1 monster.stage02.visible.prefix.prior :i 1 :acc :hidden
  localmake "p3 monster.stage02.visible.prefix.prior :i 3 :acc :hidden
  localmake "p7 monster.stage02.visible.prefix.prior :i 7 :acc :hidden
  localmake "stone item :i :stones
  localmake "initial monster.stage02.visible.prefix.initial :i :ctx :stone :p1 :p3 :p7
  localmake "value monster.stage02.visible.prefix.grind 1 :initial :stone :p1 :p3 :p7
  output monster.stage02.visible.twenty.extend (:i + 1) :ctx :stones :hidden (lput :value :acc)
end

to monster.stage02.visible.twenty :ctx
  if not (equalp (monster.context.get :ctx "status) "VISIBLE_FIFTEEN_ONLY) [output :ctx]
  localmake "fifteen monster.context.get :ctx "visibleFifteen
  if not (listp :fifteen) [output :ctx]
  if (count :fifteen) <> 15 [output :ctx]
  localmake "twenty monster.stage02.visible.twenty.extend 16 :ctx (monster.context.get :ctx "stoneSeries) (monster.context.get :ctx "hiddenSeeds) :fifteen
  localmake "work monster.context.put :ctx "visibleTwenty :twenty
  make "work monster.context.put :work "phase "VISIBLE_TWENTY_READY
  make "work monster.context.put :work "mode "STAGE_2_DISCOVERY_11
  make "work monster.context.put :work "status "VISIBLE_TWENTY_ONLY
  make "work monster.metrics.bump :work "stage02.visible.twenty
  make "work monster.logs.append :work "stage02.visible.twenty.ready
  output :work
end
