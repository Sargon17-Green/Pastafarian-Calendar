to source.catalog.lookup :catalog :index
  if emptyp :catalog [output []]
  localmake "entry first :catalog
  if (first :entry) = :index [output last :entry]
  output source.catalog.lookup butfirst :catalog :index
end

to source.catalog.cutlet.name :index
  output source.catalog.lookup source.catalog.cutlets :index
end

to source.catalog.month.name :index
  output source.catalog.lookup source.catalog.months :index
end

to source.catalog.indices.ok :catalog :expected
  if :expected > (count :catalog) [output "true]
  if (first item :expected :catalog) <> :expected [output "false]
  output source.catalog.indices.ok :catalog (:expected + 1)
end

to source.catalog.validp
  if (count source.catalog.cutlets) <> 17 [output "false]
  if (count source.catalog.months) <> 47 [output "false]
  if not source.catalog.indices.ok source.catalog.cutlets 1 [output "false]
  if not source.catalog.indices.ok source.catalog.months 1 [output "false]
  output "true
end
