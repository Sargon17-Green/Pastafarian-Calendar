; Stage2 Discovery15 — exact BI visible 36..40, production-only D8 helpers.
to monster.stage02.visible.forty.extend :i :ctx :stones :hidden :acc
  if :i > 40 [output :acc]
  localmake "p1 monster.stage02.visible.prefix.prior :i 1 :acc :hidden
  localmake "p3 monster.stage02.visible.prefix.prior :i 3 :acc :hidden
  localmake "p7 monster.stage02.visible.prefix.prior :i 7 :acc :hidden
  localmake "stone item :i :stones
  localmake "initial monster.stage02.visible.prefix.initial :i :ctx :stone :p1 :p3 :p7
  localmake "value monster.stage02.visible.prefix.grind 1 :initial :stone :p1 :p3 :p7
  output monster.stage02.visible.forty.extend (:i + 1) :ctx :stones :hidden (lput :value :acc)
end

to monster.stage02.visible.forty :ctx
  if not (equalp (monster.context.get :ctx "status) "VISIBLE_THIRTYFIVE_ONLY) [output :ctx]
  localmake "thirtyfive monster.context.get :ctx "visibleThirtyFive
  if not (listp :thirtyfive) [output :ctx]
  if (count :thirtyfive) <> 35 [output :ctx]
  localmake "forty monster.stage02.visible.forty.extend 36 :ctx (monster.context.get :ctx "stoneSeries) (monster.context.get :ctx "hiddenSeeds) :thirtyfive
  localmake "work monster.context.put :ctx "visibleForty :forty
  make "work monster.context.put :work "phase "VISIBLE_FORTY_READY
  make "work monster.context.put :work "mode "STAGE_2_DISCOVERY_15
  make "work monster.context.put :work "status "VISIBLE_FORTY_ONLY
  make "work monster.metrics.bump :work "stage02.visible.forty
  make "work monster.logs.append :work "stage02.visible.forty.ready
  output :work
end
