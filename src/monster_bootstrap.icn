record BaseMonsterContext(calculationDay, targetDay, phase, subPhase, mode, status, semanticSnapshot, pendingSnapshot, rollbackSnapshot, snapshotActive, metrics, logs, diagnostics, lastError, validationFailures)
record BaseDispatcher(currentPhase, handlersSeen)
record BaseValidationState(checksRun, failures)
record BaseErrorEnvelope(code, phase, detailCode)
record BaseMetrics(counters)

procedure newBaseMonsterContext(calculationDay, targetDay)
    return BaseMonsterContext(
        calculationDay,
        targetDay,
        "BOOTSTRAP",
        0,
        "AUTHORITATIVE_PENDING",
        "NEW",
        &null,
        &null,
        &null,
        0,
        BaseMetrics(table(0)),
        [],
        [],
        &null,
        []
    )
end

procedure baseScalarSemanticType(typeName)
    if typeName == "integer" | typeName == "string" | typeName == "cset" | typeName == "null" then return 1
    fail
end

procedure baseScalarTableKey(value)
    local typeName
    typeName := type(value)
    if typeName == "integer" | typeName == "string" | typeName == "cset" then return 1
    fail
end

procedure baseCloneOwned(value, seen)
    local typeName, out, i, k, element, probe, defaultValue
    typeName := type(value)
    if baseScalarSemanticType(typeName) then return value
    if typeName == "real" then stop("E_SEMANTIC_REAL_FORBIDDEN")
    if typeName == "co-expression" then stop("E_SEMANTIC_COEXPRESSION_FORBIDDEN")
    if /seen then seen := table()
    if \seen[value] then return seen[value]

    if typeName == "list" then {
        out := list(*value)
        seen[value] := out
        i := 1
        while i <= *value do {
            out[i] := baseCloneOwned(value[i], seen)
            i := i + 1
        }
        return out
    }

    if typeName == "table" then {
        probe := "__BASE_SNAPSHOT_DEFAULT_PROBE__"
        while member(value, probe) do probe := probe || "_"
        defaultValue := value[probe]
        if /baseScalarSemanticType(type(defaultValue)) then stop("E_MUTABLE_TABLE_DEFAULT_FORBIDDEN")
        out := copy(value)
        seen[value] := out
        every k := key(value) do {
            if /baseScalarTableKey(k) then stop("E_MUTABLE_TABLE_KEY_FORBIDDEN")
            out[k] := baseCloneOwned(value[k], seen)
        }
        return out
    }

    if typeName == "set" then {
        out := set()
        seen[value] := out
        every element := !value do {
            if /baseScalarTableKey(element) then stop("E_MUTABLE_SET_MEMBER_FORBIDDEN")
            insert(out, element)
        }
        return out
    }

    stop("E_UNSUPPORTED_SEMANTIC_AGGREGATE")
end

procedure baseMetricBump(ctx, code)
    local old
    old := ctx.metrics.counters[code]
    ctx.metrics.counters[code] := old + 1
    return ctx.metrics.counters[code]
end

procedure baseLogEvent(ctx, code)
    put(ctx.logs, code)
    return *ctx.logs
end

procedure baseValidateIntegerDays(ctx)
    if type(ctx.calculationDay) ~== "integer" then {
        put(ctx.validationFailures, "E_CALCULATION_DAY_TYPE")
        fail
    }
    if type(ctx.targetDay) ~== "integer" then {
        put(ctx.validationFailures, "E_TARGET_DAY_TYPE")
        fail
    }
    return 1
end

procedure baseSnapshotBegin(ctx, semanticValue)
    if ctx.snapshotActive ~= 0 then fail
    ctx.rollbackSnapshot := baseCloneOwned(ctx.semanticSnapshot)
    ctx.pendingSnapshot := baseCloneOwned(semanticValue)
    ctx.snapshotActive := 1
    return 1
end

procedure baseSnapshotValidateAndCommit(ctx, validatorCode)
    local committed
    if ctx.snapshotActive ~= 1 then fail
    if validatorCode ~== "BOOTSTRAP_EXACT" then fail
    committed := baseCloneOwned(ctx.pendingSnapshot)
    ctx.semanticSnapshot := committed
    ctx.pendingSnapshot := &null
    ctx.rollbackSnapshot := &null
    ctx.snapshotActive := 0
    return baseCloneOwned(ctx.semanticSnapshot)
end

procedure baseSnapshotRollback(ctx)
    if ctx.snapshotActive ~= 1 then fail
    ctx.semanticSnapshot := baseCloneOwned(ctx.rollbackSnapshot)
    ctx.pendingSnapshot := &null
    ctx.rollbackSnapshot := &null
    ctx.snapshotActive := 0
    return baseCloneOwned(ctx.semanticSnapshot)
end

procedure baseDispatch(ctx, dispatcher, requestedPhase)
    if /baseValidateIntegerDays(ctx) then {
        ctx.status := "FAILED_VALIDATION"
        ctx.lastError := BaseErrorEnvelope("E_VALIDATION", ctx.phase, "E_INTEGER_DAY")
        fail
    }
    dispatcher.currentPhase := requestedPhase
    put(dispatcher.handlersSeen, requestedPhase)
    ctx.phase := requestedPhase
    ctx.subPhase := ctx.subPhase + 1
    baseMetricBump(ctx, "dispatch.count")
    baseLogEvent(ctx, "DISPATCH")
    return requestedPhase
end

procedure newBaseDispatcher()
    return BaseDispatcher("BOOTSTRAP", [])
end
