; Stage2 Appendix-A general wide rank reporter for k >= 3.
; QA-only production candidate; not promoted to canonical Logo+Ido.
; Input [first BI in 1..M, step exactly +1 or -1], N canonical BI > M^2.
; The minimal width k is derived from N; no D20 0..31 answer.at cap is used.
; All large values remain exact BI; no floating-point conversion or global mutation.

to monster.stage02.choose.wide.general :stream :N
  if not listp :stream [output []]
  if (count :stream) <> 2 [output []]
  localmake "firstv first :stream
  localmake "step last :stream
  if not (monster.stage02.bi.canonical :firstv) [output []]
  if not (monster.stage02.bi.canonical :N) [output []]
  if (bi.lt :firstv (bi.small 1)) [output []]
  localmake "m nr.M
  if (bi.gt :firstv :m) [output []]
  if not numberp :step [output []]
  if not (equalp :step (int :step)) [output []]
  if not (or (:step = 1) (:step = -1)) [output []]
  localmake "square bi.square :m
  if (bi.le :N :square) [output []]
  output monster.stage02.choose.wide.general.prepare :firstv :step :N :m :square 2
end

to monster.stage02.choose.wide.general.prepare :firstv :step :N :m :space :width
  if bi.ge :space :N [
    output monster.stage02.choose.wide.general.build :step :N :m :space :width :firstv 0 (bi.small 1) (bi.small 1)
  ]
  output monster.stage02.choose.wide.general.prepare :firstv :step :N :m (bi.mul :space :m) (:width + 1)
end

; QA-only Horner fastpath: same mathematical k-digit value, no wide-weight table.
; For N>space/2, floor(space/N)=1; limit=N and accepted rank=wide.
; Exact BI throughout. Original canonical branch and QA test source stay untouched.
to monster.stage02.choose.wide.general.next :digit :step :m
  if :step = 1 [
    if bi.eq :digit :m [output bi.small 1]
    output bi.add :digit (bi.small 1)
  ]
  if bi.eq :digit (bi.small 1) [output :m]
  output bi.sub :digit (bi.small 1)
end

to monster.stage02.choose.wide.general.seek :digit :step :m :remaining
  if :remaining = 0 [output :digit]
  output monster.stage02.choose.wide.general.seek (monster.stage02.choose.wide.general.next :digit :step :m) :step :m (:remaining - 1)
end

; Positive BI remainder without constructing the quotient.
; Invariant r<den; next digit in [0,9999] implies next r<10000*den.
to monster.stage02.choose.wide.general.fastmod :num :den
  if bi.lt :num :den [output :num]
  output bi.make 1 (monster.stage02.choose.wide.general.fastmod.walk (reverse (bi.digits :num)) (bi.digits :den) (list 0))
end

to monster.stage02.choose.wide.general.fastmod.walk :msd :den :rem
  if emptyp :msd [output bi.strip.high :rem]
  localmake "newrem bi.strip.high fput first :msd :rem
  if (bi.mag.compare :newrem :den) < 0 [
    output monster.stage02.choose.wide.general.fastmod.walk butfirst :msd :den :newrem
  ]
  localmake "qr bi.mag.qdigit :newrem :den
  output monster.stage02.choose.wide.general.fastmod.walk butfirst :msd :den last :qr
end

; Horner over high-to-low stream digits: accumulator <- accumulator*M+(digit-1).
to monster.stage02.choose.wide.general.horner :digit :reverseStep :m :remaining :acc
  if :remaining = 0 [output :acc]
  localmake "nextAcc bi.add (bi.mul :acc :m) (bi.sub :digit (bi.small 1))
  if :remaining = 1 [output :nextAcc]
  localmake "nextDigit monster.stage02.choose.wide.general.next :digit :reverseStep :m
  output monster.stage02.choose.wide.general.horner :nextDigit :reverseStep :m (:remaining - 1) :nextAcc
end

to monster.stage02.choose.wide.general.build :step :N :m :space :width :digit :index :wide :weight
  localmake "highDigit monster.stage02.choose.wide.general.seek :digit :step :m (:width - 1)
  localmake "digitsValue monster.stage02.choose.wide.general.horner :highDigit (0 - :step) :m :width bi.zero
  localmake "rankSample bi.add (bi.small 1) :digitsValue

  ; General quotient-one fastpath, including N=space.
  localmake "gap bi.sub :space :N
  if bi.gt :N :gap [
    if bi.le :rankSample :N [output :rankSample]
    if :step = 1 [output bi.small 1]
    output :N
  ]

  ; Preserve generic exact BI behavior for all other N.
  localmake "remainder monster.stage02.choose.wide.general.fastmod :space :N
  localmake "limit bi.sub :space :remainder
  if bi.le :rankSample :limit [
    output bi.add (bi.small 1) (monster.stage02.choose.wide.general.fastmod (bi.sub :rankSample (bi.small 1)) :N)
  ]
  if :step = 1 [output bi.small 1]
  output :N
end
