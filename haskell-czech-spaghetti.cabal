cabal-version:      3.0
name:               haskell-czech-spaghetti
version:            0.1.0.0
build-type:         Simple
synopsis:           Zaváděcí základ pro normativní kalendářní monstrum v Haskellu
license:            BSD-3-Clause
author:             Projektová větev Haskell + čeština
maintainer:         neuvedeno
category:           Calendar
extra-source-files: README.md
                    DEVELOPMENT_STAGE.md
                    SPAGHETTI_DEVELOPMENT_HISTORY.md
                    docs/ARCHITECTURE_STAGE_01.md
                    docs/SOURCE_LANGUAGE_CATALOG.md

library
  hs-source-dirs:      src
  exposed-modules:     Pastafari.SourceLanguageCatalog
                     , Pastafari.NormativeOracle
                     , Pastafari.MonsterBase
                     , Pastafari.SpaghettiMonster
  build-depends:       base >=4.14 && <5
                     , containers >=0.6 && <0.8
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

executable stage01-tests
  hs-source-dirs:      test
  main-is:             Main.hs
  other-modules:       BootstrapFixtures
  build-depends:       base >=4.14 && <5
                     , containers >=0.6 && <0.8
                     , haskell-czech-spaghetti
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
