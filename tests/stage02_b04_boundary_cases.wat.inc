
  ;; B04: probes adicionales, aisladas en un fragmento QA.
  (func $b04_check_short
    (param $expected_result i32) (param $expected_limit i32) (result i32)
    (i32.and
      (i32.eqz (call $cmp (global.get $RESULT) (local.get $expected_result)))
      (i32.eqz (call $cmp (global.get $LIMIT) (local.get $expected_limit)))))
  (func $b04_check_wide
    (param $expected_result i32) (param $expected_limit i32) (param $expected_space i32)
    (result i32)
    (i32.and
      (i32.eqz (call $cmp (global.get $RESULT) (local.get $expected_result)))
      (i32.and
        (i32.eqz (call $cmp (global.get $LIMIT) (local.get $expected_limit)))
        (i32.eqz (call $cmp (global.get $SPACE) (local.get $expected_space))))))
  (func (export "test_b04_c1_short_backward_m") (result i32)
    (call $init_constants)
    (call $copy (global.get $FIRST) (global.get $M))
    (call $copy (global.get $N) (global.get $M))
    (call $choose (global.get $FIRST) (i32.const -1) (global.get $N) (global.get $RESULT))
    (call $b04_check_short (global.get $M) (global.get $M)))
  (func (export "test_b04_c2_wide_backward_m_plus_one") (result i32)
    (call $init_constants)
    (call $copy (global.get $FIRST) (global.get $M))
    (call $add_small (global.get $N) (global.get $M) (i32.const 1))
    (call $choose (global.get $FIRST) (i32.const -1) (global.get $N) (global.get $RESULT))
    (call $mul (global.get $TMP1) (global.get $M) (global.get $M))
    (call $sub_small (global.get $TMP2) (global.get $TMP1) (i32.const 1))
    (call $from_u64 (global.get $TMP3) (i64.const 2))
    (call $b04_check_wide (global.get $TMP3) (global.get $TMP2) (global.get $TMP1)))
  (func (export "test_b04_c3_wide_backward_reject_2m") (result i32)
    (call $init_constants)
    (call $copy (global.get $FIRST) (global.get $ONE))
    (call $add (global.get $N) (global.get $M) (global.get $M))
    (call $choose (global.get $FIRST) (i32.const -1) (global.get $N) (global.get $RESULT))
    (call $mul (global.get $TMP1) (global.get $M) (global.get $M))
    (call $sub (global.get $TMP2) (global.get $TMP1) (global.get $M))
    (call $b04_check_wide (global.get $N) (global.get $TMP2) (global.get $TMP1)))
  (func (export "test_b04_c4_wide_backward_reject_3m") (result i32)
    (call $init_constants)
    (call $from_u64 (global.get $TMP3) (i64.const 3))
    (call $mul (global.get $N) (global.get $M) (global.get $TMP3))
    (call $copy (global.get $FIRST) (global.get $ONE))
    (call $choose (global.get $FIRST) (i32.const -1) (global.get $N) (global.get $RESULT))
    (call $mul (global.get $TMP1) (global.get $M) (global.get $M))
    (call $sub (global.get $TMP2) (global.get $TMP1) (global.get $M))
    (call $b04_check_wide (global.get $N) (global.get $TMP2) (global.get $TMP1)))
  (func $b04_forward_wrap_case (result i32)
    (call $sub_small (global.get $FIRST) (global.get $M) (i32.const 1))
    (call $choose (global.get $FIRST) (i32.const 1) (global.get $N) (global.get $RESULT))
    (call $mul (global.get $TMP1) (global.get $M) (global.get $M))
    (call $sub (global.get $TMP2) (global.get $TMP1) (global.get $M))
    (call $b04_check_wide (global.get $ONE) (global.get $TMP2) (global.get $TMP1)))
  (func (export "test_b04_c5_c6_parametric") (result i32)
    (call $init_constants)
    (call $add (global.get $N) (global.get $M) (global.get $M))
    (if (i32.eqz (call $b04_forward_wrap_case)) (then (return (i32.const 0))))
    (call $copy (i32.const 149440) (global.get $RESULT))
    (call $copy (i32.const 153856) (global.get $LIMIT))
    (call $copy (i32.const 158272) (global.get $SPACE))
    (call $copy (i32.const 162688) (global.get $N))
    (call $from_u64 (global.get $TMP3) (i64.const 3))
    (call $mul (global.get $N) (global.get $M) (global.get $TMP3))
    (if (i32.eqz (call $b04_forward_wrap_case)) (then (return (i32.const 0))))
    (i32.const 1))
