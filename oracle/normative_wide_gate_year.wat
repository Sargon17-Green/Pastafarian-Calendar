    (block $eq (loop $again
      (br_if $eq (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (local.set $av (call $w_limb (local.get $a) (local.get $i))) (local.set $bv (call $w_limb (local.get $b) (local.get $i)))
      (if (i32.lt_u (local.get $av) (local.get $bv)) (then (return (i32.const -1))))
      (if (i32.gt_u (local.get $av) (local.get $bv)) (then (return (i32.const 1)))) (br $again)))
    (i32.const 0))
  (func $w_cmp (param $a i32) (param $b i32) (result i32)
    (local $sa i32) (local $sb i32) (local $m i32)
    (local.set $sa (call $w_sign (local.get $a))) (local.set $sb (call $w_sign (local.get $b)))
    (if (i32.lt_s (local.get $sa) (local.get $sb)) (then (return (i32.const -1))))
    (if (i32.gt_s (local.get $sa) (local.get $sb)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $sa)) (then (return (i32.const 0))))
    (local.set $m (call $w_cmp_mag (local.get $a) (local.get $b)))
    (if (result i32) (i32.eq (local.get $sa) (i32.const 1)) (then (local.get $m)) (else (i32.sub (i32.const 0) (local.get $m)))))
  (func $w_mag_add (param $a i32) (param $b i32) (result i32)
    (local $dst i32) (local $la i32) (local $lb i32) (local $n i32) (local $i i32)
    (local $carry i64) (local $av i64) (local $bv i64) (local $s i64)
