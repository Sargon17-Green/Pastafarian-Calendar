      (call $copy_r (global.get $TMP4) (global.get $TMP2))
      (local.set $pos (i32.const 1))
      (block $sd (loop $sl
        (br_if $sd (i32.gt_u (local.get $pos) (i32.const 6)))
        (local.set $id (call $order_id (local.get $pos)))
        (local.set $prev (call $order_id (call $wrap6 (i32.sub (local.get $pos) (i32.const 1)))))
        (local.set $next (call $order_id (call $wrap6 (i32.add (local.get $pos) (i32.const 1)))))
        (call $copy_r (global.get $TMP2) (call $old_bowl (local.get $id)))
        (call $muladd_small (global.get $TMP2) (call $old_bowl (local.get $prev)) (i32.const 3))
        (call $muladd_small (global.get $TMP2) (call $old_bowl (local.get $next)) (i32.const 5))
        (call $sum_into (global.get $TMP2) (global.get $TMP4))
        (call $r_add_small (global.get $TMP2) (global.get $TMP2) (i32.add (local.get $stir) (i32.mul (local.get $pos) (local.get $pos))))
        (call $r_square (global.get $TMP1) (global.get $TMP2))
        (call $copy_r (global.get $TMP2) (global.get $TMP1))
        (call $r_mul (global.get $TMP3) (call $old_bowl (local.get $prev)) (call $old_bowl (local.get $next)))
        (call $muladd_small (global.get $TMP2) (global.get $TMP3) (i32.const 7))
        (call $copy_r (call $next_bowl (local.get $id)) (global.get $TMP2))
        (local.set $pos (i32.add (local.get $pos) (i32.const 1))) (br $sl)))
      (call $commit_next_bowls)
      (local.set $stir (i32.add (local.get $stir) (i32.const 1))) (br $again))))

  (func $sauce_fixture (param $c i64) (param $t i64)
    (call $init_m)
    (call $build_stones)
    (call $work_counts_fixture (local.get $c) (local.get $t))
    (call $build_hidden)
    (call $build_visible)
    (call $initial_bowls)
    (call $apply_drops)
    (call $post_stir12))

  ;; Siguiente vasija según el orden de la gota 46, usado por askBowl.
  (func $next46 (param $queried i32) (result i32)
    (local $p i32) (local $id i32)
    (local.set $p (i32.const 0))
    (block $found (loop $again
      (br_if $found (i32.ge_u (local.get $p) (i32.const 6)))
