    (local.set $n (select (local.get $la) (local.get $lb) (i32.gt_u (local.get $la) (local.get $lb))))
    (local.set $dst (call $w_new (i32.add (local.get $n) (i32.const 1))))
    (local.set $i (i32.const 0)) (local.set $carry (i64.const 0))
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $av (if (result i64) (i32.lt_u (local.get $i) (local.get $la)) (then (i64.extend_i32_u (call $w_limb (local.get $a) (local.get $i)))) (else (i64.const 0))))
      (local.set $bv (if (result i64) (i32.lt_u (local.get $i) (local.get $lb)) (then (i64.extend_i32_u (call $w_limb (local.get $b) (local.get $i)))) (else (i64.const 0))))
      (local.set $s (i64.add (i64.add (local.get $av) (local.get $bv)) (local.get $carry)))
      (call $w_set_limb_internal (local.get $dst) (local.get $i) (i32.wrap_i64 (i64.and (local.get $s) (global.get $MASK))))
      (local.set $carry (i64.shr_u (local.get $s) (i64.const 30))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $again)))
    (if (i64.ne (local.get $carry) (i64.const 0))
      (then (call $w_set_limb_internal (local.get $dst) (local.get $n) (i32.wrap_i64 (local.get $carry))) (local.set $n (i32.add (local.get $n) (i32.const 1)))))
    (call $w_set_len (local.get $dst) (local.get $n)) (call $w_set_sign (local.get $dst) (if (result i32) (i32.eqz (local.get $n)) (then (i32.const 0)) (else (i32.const 1))))
    (local.get $dst))
  (func $w_mag_sub (param $a i32) (param $b i32) (result i32)
    (local $dst i32) (local $na i32) (local $nb i32) (local $i i32)
    (local $borrow i64) (local $av i64) (local $bv i64) (local $v i64)
    (if (i32.lt_s (call $w_cmp_mag (local.get $a) (local.get $b)) (i32.const 0)) (then unreachable))
    (local.set $na (call $w_len (local.get $a))) (local.set $nb (call $w_len (local.get $b)))
    (local.set $dst (call $w_new (i32.add (local.get $na) (i32.const 1))))
    (local.set $i (i32.const 0)) (local.set $borrow (i64.const 0))
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $na)))
      (local.set $av (i64.extend_i32_u (call $w_limb (local.get $a) (local.get $i))))
      (local.set $bv (if (result i64) (i32.lt_u (local.get $i) (local.get $nb)) (then (i64.extend_i32_u (call $w_limb (local.get $b) (local.get $i)))) (else (i64.const 0))))
      (local.set $v (i64.sub (i64.sub (local.get $av) (local.get $bv)) (local.get $borrow)))
      (if (i64.lt_s (local.get $v) (i64.const 0)) (then (local.set $v (i64.add (local.get $v) (global.get $BASE))) (local.set $borrow (i64.const 1))) (else (local.set $borrow (i64.const 0))))
      (call $w_set_limb_internal (local.get $dst) (local.get $i) (i32.wrap_i64 (local.get $v)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $again)))
    (call $w_set_len (local.get $dst) (local.get $na)) (call $w_set_sign (local.get $dst) (i32.const 1)) (call $w_normalize (local.get $dst))
    (local.get $dst))
  (func $w_abs_diff (param $a i32) (param $b i32) (result i32)
    (local $sa i32) (local $sb i32) (local $m i32) (local $dst i32)
    (local.set $sa (call $w_sign (local.get $a))) (local.set $sb (call $w_sign (local.get $b)))
    (if (i32.eqz (local.get $sa)) (then (local.set $dst (call $w_mag_add (local.get $a) (local.get $b))) (return (local.get $dst))))
    (if (i32.eqz (local.get $sb)) (then (local.set $dst (call $w_mag_add (local.get $a) (local.get $b))) (return (local.get $dst))))
    (if (i32.ne (local.get $sa) (local.get $sb)) (then (return (call $w_mag_add (local.get $a) (local.get $b)))))
    (local.set $m (call $w_cmp_mag (local.get $a) (local.get $b)))
    (if (result i32) (i32.ge_s (local.get $m) (i32.const 0)) (then (call $w_mag_sub (local.get $a) (local.get $b))) (else (call $w_mag_sub (local.get $b) (local.get $a)))))

  ;; Convierte una magnitud arbitraria a la clase SAVE 1..M sin truncarla antes.
  (func $w_mag_to_saved (param $w i32) (param $dst i32)
    (local $i i32) (local $bit i32) (local $v i32)
    (call $copy_r (local.get $dst) (global.get $M)) ;; M representa cero módulo M.
    (local.set $i (call $w_len (local.get $w)))
    (block $done (loop $limbs
      (br_if $done (i32.eqz (local.get $i)))
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (local.set $v (call $w_limb (local.get $w) (local.get $i)))
      (local.set $bit (i32.const 29))
      (block $bd (loop $bits
        (br_if $bd (i32.lt_s (local.get $bit) (i32.const 0)))
        (call $r_mul_small (local.get $dst) (local.get $dst) (i32.const 2))
        (if (i32.ne (i32.and (i32.shr_u (local.get $v) (local.get $bit)) (i32.const 1)) (i32.const 0))
          (then (call $r_add_small (local.get $dst) (local.get $dst) (i32.const 1))))
        (local.set $bit (i32.sub (local.get $bit) (i32.const 1))) (br $bits)))
      (br $limbs))))

  (func $day_count_wide (param $day i32) (param $foundation i32) (param $dst i32)
    (local $cmpv i32) (local $d i32)
    (local.set $cmpv (call $w_cmp (local.get $day) (local.get $foundation)))
    (if (i32.eqz (local.get $cmpv)) (then (call $r_from_u64 (local.get $dst) (i64.const 1)) (return)))
    (local.set $d (call $w_abs_diff (local.get $day) (local.get $foundation)))
    (call $w_mag_to_saved (local.get $d) (local.get $dst))
    (call $r_mul_small (local.get $dst) (local.get $dst) (i32.const 2))
    (if (i32.gt_s (local.get $cmpv) (i32.const 0)) (then (call $r_add_small (local.get $dst) (local.get $dst) (i32.const 1)))))
  (func $work_counts_wide (param $c i32) (param $t i32)
    (local $f i32) (local $d i32) (local $cmpct i32)
    (local.set $f (call $w_from_i64 (i64.const -15055671)))
    (call $day_count_wide (local.get $c) (local.get $f) (call $count (i32.const 1)))
    (call $day_count_wide (local.get $t) (local.get $f) (call $count (i32.const 2)))
    (local.set $d (call $w_abs_diff (local.get $t) (local.get $c)))
    (call $w_mag_to_saved (local.get $d) (call $count (i32.const 3)))
    (call $r_add_small (call $count (i32.const 3)) (call $count (i32.const 3)) (i32.const 1))
    (call $r_add (call $count (i32.const 4)) (call $count (i32.const 1)) (call $count (i32.const 2)))
    (local.set $cmpct (call $w_cmp (local.get $t) (local.get $c)))
    (call $r_from_u64 (call $count (i32.const 5))
      (if (result i64) (i32.lt_s (local.get $cmpct) (i32.const 0)) (then (i64.const 1)) (else (if (result i64) (i32.eqz (local.get $cmpct)) (then (i64.const 2)) (else (i64.const 3)))))))
  (func $sauce_wide (param $c i32) (param $t i32)
    (local $mark i32)
    (local.set $mark (global.get $W_HEAP))
    (call $init_m) (call $build_stones) (call $work_counts_wide (local.get $c) (local.get $t))
    (call $build_hidden) (call $build_visible) (call $initial_bowls) (call $apply_drops) (call $post_stir12)
    ;; Todos los temporales amplios pertenecen a esta invocación; cuencos y gotas viven en memoria estática del oráculo.
    (global.set $W_HEAP (local.get $mark)))

  (func (export "test_wide_sauce_foundation_matches_fixture") (result i32)
    (local $f i32) (local $a i32) (local $b i32)
    (local.set $f (call $w_from_i64 (i64.const -15055671)))
    (call $sauce_wide (local.get $f) (local.get $f))
    (local.set $a (call $r_mod_small (call $bowl (i32.const 1)) (i32.const 1000003)))
    (local.set $b (i32.load (global.get $ORDER46)))
    (i32.and (i32.eq (local.get $a) (i32.const 235849)) (i32.eq (local.get $b) (i32.const 4))))

  (func (export "fixture_wide_sauce_beyond_i64") (result i32 i32 i32)
    (local $c i32) (local $t i32) (local $dir i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $t (call $w_new (i32.const 4)))
    ;; 2^90+17.
    (call $w_set_limb_internal (local.get $t) (i32.const 0) (i32.const 17))
    (call $w_set_limb_internal (local.get $t) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $t) (i32.const 4)) (call $w_set_sign (local.get $t) (i32.const 1))
    (call $sauce_wide (local.get $c) (local.get $t))
    (local.set $dir (call $ask (i32.const 1) (i32.const 1) (global.get $TMP4)))
    (call $r_mod_small (call $bowl (i32.const 1)) (i32.const 1000003))
    (call $r_mod_small (global.get $TMP4) (i32.const 1000003))
    (local.get $dir))

  (func $w_copy (param $src i32) (result i32)
    (local $dst i32) (local $i i32) (local $n i32)
    (local.set $n (call $w_len (local.get $src)))
    (local.set $dst (call $w_new (i32.add (local.get $n) (i32.const 1))))
    (call $w_set_sign (local.get $dst) (call $w_sign (local.get $src))) (call $w_set_len (local.get $dst) (local.get $n))
    (local.set $i (i32.const 0))
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (call $w_set_limb_internal (local.get $dst) (local.get $i) (call $w_limb (local.get $src) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $again)))
    (local.get $dst))
  (func $w_add_signed (param $a i32) (param $b i32) (result i32)
    (local $sa i32) (local $sb i32) (local $m i32) (local $dst i32)
    (local.set $sa (call $w_sign (local.get $a))) (local.set $sb (call $w_sign (local.get $b)))
    (if (i32.eqz (local.get $sa)) (then (return (call $w_copy (local.get $b)))))
    (if (i32.eqz (local.get $sb)) (then (return (call $w_copy (local.get $a)))))
    (if (i32.eq (local.get $sa) (local.get $sb))
      (then
        (local.set $dst (call $w_mag_add (local.get $a) (local.get $b)))
        (call $w_set_sign (local.get $dst) (local.get $sa)) (return (local.get $dst))))
    (local.set $m (call $w_cmp_mag (local.get $a) (local.get $b)))
    (if (i32.eqz (local.get $m)) (then (return (call $w_new (i32.const 1)))))
    (if (i32.gt_s (local.get $m) (i32.const 0))
      (then (local.set $dst (call $w_mag_sub (local.get $a) (local.get $b))) (call $w_set_sign (local.get $dst) (local.get $sa)))
      (else (local.set $dst (call $w_mag_sub (local.get $b) (local.get $a))) (call $w_set_sign (local.get $dst) (local.get $sb))))
    (local.get $dst))
  (func $w_neg_signed (param $a i32) (result i32)
    (local $dst i32) (local.set $dst (call $w_copy (local.get $a)))
    (call $w_set_sign (local.get $dst) (i32.sub (i32.const 0) (call $w_sign (local.get $dst)))) (local.get $dst))
  (func $w_sub_signed (param $a i32) (param $b i32) (result i32)
    (local $nb i32) (local.set $nb (call $w_neg_signed (local.get $b))) (call $w_add_signed (local.get $a) (local.get $nb)))

  (func $ring_step_residue (param $x i32) (param $step i32)
    (if (i32.eq (local.get $step) (i32.const 1))
      (then
        (if (i32.eqz (call $cmp (local.get $x) (global.get $M)))
          (then (call $r_from_u64 (local.get $x) (i64.const 1)))
          (else (call $r_add_small (local.get $x) (local.get $x) (i32.const 1)))))
      (else
        (call $r_from_u64 (global.get $TMP7) (i64.const 1))
        (if (i32.eqz (call $cmp (local.get $x) (global.get $TMP7)))
          (then (call $copy_r (local.get $x) (global.get $M)))
          (else (call $sub (local.get $x) (local.get $x) (global.get $TMP7)))))))

  (func $choose_922 (param $first i32) (param $step i32) (result i32)
    (local $rem i32) (local $rr i32)
    ;; limit = M - (M mod 922).
    (local.set $rem (call $r_mod_small (global.get $M) (i32.const 922)))
    (call $from_u64 (global.get $TMP7) (i64.extend_i32_u (local.get $rem)))
    (call $sub (global.get $TMP6) (global.get $M) (global.get $TMP7))
    (call $copy_r (global.get $TMP5) (local.get $first))
    (block $accept (loop $again
      (br_if $accept (i32.le_s (call $cmp (global.get $TMP5) (global.get $TMP6)) (i32.const 0)))
      (call $ring_step_residue (global.get $TMP5) (local.get $step))
      (br $again)))
    ;; ((x-1) mod 922)+1 equivale a x mod 922, sustituyendo 0 por 922.
    (local.set $rr (call $r_mod_small (global.get $TMP5) (i32.const 922)))
    (if (result i32) (i32.eqz (local.get $rr)) (then (i32.const 922)) (else (local.get $rr))))

  (func $gate_gap_wide (param $magnitude i32) (param $signStep i32) (result i32)
    (local $f i32) (local $signedMag i32) (local $q i32) (local $dir i32) (local $rank i32)
    (if (i32.le_s (local.get $signStep) (i32.const -2)) (then unreachable))
    (if (i32.ge_s (local.get $signStep) (i32.const 2)) (then unreachable))
    (if (i32.eqz (local.get $signStep)) (then unreachable))
    (local.set $f (call $w_from_i64 (i64.const -15055671)))
    (local.set $signedMag (call $w_copy (local.get $magnitude)))
    (if (i32.lt_s (local.get $signStep) (i32.const 0))
      (then (call $w_set_sign (local.get $signedMag) (i32.const -1)))
      (else (call $w_set_sign (local.get $signedMag) (i32.const 1))))
    (local.set $q (call $w_add_signed (local.get $f) (local.get $signedMag)))
    (call $sauce_wide (local.get $f) (local.get $q))
    (local.set $dir (call $ask (i32.const 1) (i32.const 1) (global.get $TMP4)))
    (local.set $rank (call $choose_922 (global.get $TMP4) (local.get $dir)))
    (i32.add (i32.const 41) (local.get $rank)))

  (func (export "test_wide_gate_unit_steps") (result i32)
    (local $one i32)
    (local.set $one (call $w_from_i64 (i64.const 1)))
    (i32.and
      (i32.eq (call $gate_gap_wide (local.get $one) (i32.const 1)) (i32.const 216))
      (i32.eq (call $gate_gap_wide (local.get $one) (i32.const -1)) (i32.const 949))))

  (func (export "fixture_wide_gate_beyond_i64") (result i32 i32)
    (local $n i32) (local $a i32) (local $b i32)
    (local.set $n (call $w_new (i32.const 4)))
    ;; n = 2^90 + 5.
    (call $w_set_limb_internal (local.get $n) (i32.const 0) (i32.const 5))
    (call $w_set_limb_internal (local.get $n) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $n) (i32.const 4)) (call $w_set_sign (local.get $n) (i32.const 1))
    (local.set $a (call $gate_gap_wide (local.get $n) (i32.const 1)))
    (local.set $b (call $gate_gap_wide (local.get $n) (i32.const -1)))
    (local.get $a) (local.get $b))
  (func (export "test_wide_gate_gap_beyond_i64") (result i32)
    (local $n i32) (local $a i32) (local $b i32)
    ;; Un índice 2^90+5 obliga a recorrer la ruta amplia real de salsa y de separación de puertas.
    (local.set $n (call $w_new (i32.const 4)))
    (call $w_set_limb_internal (local.get $n) (i32.const 0) (i32.const 5))
    (call $w_set_limb_internal (local.get $n) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $n) (i32.const 4))
    (call $w_set_sign (local.get $n) (i32.const 1))
    (local.set $a (call $gate_gap_wide (local.get $n) (i32.const 1)))
    (local.set $b (call $gate_gap_wide (local.get $n) (i32.const -1)))
    (i32.and
      (i32.and (i32.ge_u (local.get $a) (i32.const 42)) (i32.le_u (local.get $a) (i32.const 963)))
      (i32.and (i32.ge_u (local.get $b) (i32.const 42)) (i32.le_u (local.get $b) (i32.const 963)))))
  (func (export "test_wide_sauce_heap_stable") (result i32)
    (local $c i32) (local $t i32) (local $mark i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $t (call $w_new (i32.const 4)))
    (call $w_set_limb_internal (local.get $t) (i32.const 0) (i32.const 17))
    (call $w_set_limb_internal (local.get $t) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $t) (i32.const 4)) (call $w_set_sign (local.get $t) (i32.const 1))
    (local.set $mark (global.get $W_HEAP))
    (call $sauce_wide (local.get $c) (local.get $t))
    (if (i32.ne (global.get $W_HEAP) (local.get $mark)) (then (return (i32.const 0))))
    (call $sauce_wide (local.get $c) (local.get $t))
    (i32.eq (global.get $W_HEAP) (local.get $mark)))

  ;; -------- Puertas y años con enteros de precisión arbitraria --------
  ;; Esta capa usa índices, días y números de año anchos. Los contadores locales de
  ;; candidatos caben en i32 porque una ventana normativa mide como máximo 11.556 días.

  (func $w_assign (param $dst i32) (param $src i32)
    (local $i i32) (local $n i32)
    (local.set $n (call $w_len (local.get $src)))
    (if (i32.gt_u (local.get $n) (call $w_cap (local.get $dst))) (then unreachable))
    (call $w_set_sign (local.get $dst) (call $w_sign (local.get $src)))
    (call $w_set_len (local.get $dst) (local.get $n))
    (local.set $i (i32.const 0))
    (block $done (loop $again
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (call $w_set_limb_internal (local.get $dst) (local.get $i) (call $w_limb (local.get $src) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $again))))

  (func $w_add_small_signed_inplace (param $p i32) (param $delta i32)
    (local $s i32) (local $ds i32) (local $mag i32) (local $n i32)
    (local $i i32) (local $v i64) (local $borrow i32)
    (if (i32.eqz (local.get $delta)) (then (return)))
    (local.set $ds (if (result i32) (i32.gt_s (local.get $delta) (i32.const 0)) (then (i32.const 1)) (else (i32.const -1))))
    (local.set $mag (if (result i32) (i32.gt_s (local.get $delta) (i32.const 0)) (then (local.get $delta)) (else (i32.sub (i32.const 0) (local.get $delta)))))
    (local.set $s (call $w_sign (local.get $p)))
    (local.set $n (call $w_len (local.get $p)))
    (if (i32.eqz (local.get $s))
      (then
        (call $w_set_sign (local.get $p) (local.get $ds))
        (call $w_set_len (local.get $p) (i32.const 1))
        (call $w_set_limb_internal (local.get $p) (i32.const 0) (local.get $mag))
        (return)))
    (if (i32.eq (local.get $s) (local.get $ds))
      (then
        (local.set $i (i32.const 0))
        (local.set $v (i64.extend_i32_u (local.get $mag)))
        (block $addDone (loop $addLoop
          (br_if $addDone (i64.eqz (local.get $v)))
          (if (i32.ge_u (local.get $i) (local.get $n))
            (then
              (if (i32.ge_u (local.get $i) (call $w_cap (local.get $p))) (then unreachable))
              (call $w_set_limb_internal (local.get $p) (local.get $i) (i32.const 0))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))
              (call $w_set_len (local.get $p) (local.get $n))))
          (local.set $v (i64.add (local.get $v) (i64.extend_i32_u (call $w_limb (local.get $p) (local.get $i)))))
          (call $w_set_limb_internal (local.get $p) (local.get $i) (i32.wrap_i64 (i64.and (local.get $v) (i64.const 1073741823))))
          (local.set $v (i64.shr_u (local.get $v) (i64.const 30)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $addLoop)))
        (return)))
    ;; Los signos son opuestos: se resta un entero pequeño a la magnitud.
    (if (i32.gt_u (local.get $n) (i32.const 1))
      (then
        (local.set $v (i64.sub (i64.extend_i32_u (call $w_limb (local.get $p) (i32.const 0))) (i64.extend_i32_u (local.get $mag))))
        (if (i64.lt_s (local.get $v) (i64.const 0))
          (then
            (local.set $v (i64.add (local.get $v) (i64.const 1073741824)))
            (local.set $borrow (i32.const 1)))
          (else (local.set $borrow (i32.const 0))))
        (call $w_set_limb_internal (local.get $p) (i32.const 0) (i32.wrap_i64 (local.get $v)))
        (local.set $i (i32.const 1))
        (block $borrowDone (loop $borrowLoop
          (br_if $borrowDone (i32.eqz (local.get $borrow)))
          (local.set $v (i64.sub (i64.extend_i32_u (call $w_limb (local.get $p) (local.get $i))) (i64.const 1)))
          (if (i64.lt_s (local.get $v) (i64.const 0))
            (then (call $w_set_limb_internal (local.get $p) (local.get $i) (i32.const 1073741823)))
            (else (call $w_set_limb_internal (local.get $p) (local.get $i) (i32.wrap_i64 (local.get $v))) (local.set $borrow (i32.const 0))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $borrowLoop)))
        (call $w_normalize (local.get $p))
        (return)))
    ;; Magnitud de un solo miembro.
    (local.set $i (call $w_limb (local.get $p) (i32.const 0)))
    (if (i32.gt_u (local.get $i) (local.get $mag))
      (then (call $w_set_limb_internal (local.get $p) (i32.const 0) (i32.sub (local.get $i) (local.get $mag))) (return)))
    (if (i32.eq (local.get $i) (local.get $mag))
      (then (call $w_set_len (local.get $p) (i32.const 0)) (call $w_set_sign (local.get $p) (i32.const 0)) (return)))
    (call $w_set_limb_internal (local.get $p) (i32.const 0) (i32.sub (local.get $mag) (local.get $i)))
    (call $w_set_sign (local.get $p) (local.get $ds)))

  (func $gate_gap_owned (param $magnitude i32) (param $signStep i32) (result i32)
    (local $mark i32) (local $gap i32)
    (local.set $mark (global.get $W_HEAP))
    (local.set $gap (call $gate_gap_wide (local.get $magnitude) (local.get $signStep)))
    (global.set $W_HEAP (local.get $mark))
    (local.get $gap))

  (func $forward_gap_for_index (param $idx i32) (result i32)
    (local $mark i32) (local $tmp i32) (local $gap i32)
    (if (i32.lt_s (call $w_sign (local.get $idx)) (i32.const 0))
      (then (return (call $gate_gap_owned (local.get $idx) (i32.const -1)))))
    (local.set $mark (global.get $W_HEAP))
    (local.set $tmp (call $w_copy (local.get $idx)))
    (call $w_add_small_signed_inplace (local.get $tmp) (i32.const 1))
    (local.set $gap (call $gate_gap_wide (local.get $tmp) (i32.const 1)))
    (global.set $W_HEAP (local.get $mark))
    (local.get $gap))

  (func $backward_gap_for_index (param $idx i32) (result i32)
    (local $mark i32) (local $tmp i32) (local $gap i32)
    (if (i32.gt_s (call $w_sign (local.get $idx)) (i32.const 0))
      (then (return (call $gate_gap_owned (local.get $idx) (i32.const 1)))))
    (local.set $mark (global.get $W_HEAP))
    (local.set $tmp (call $w_copy (local.get $idx)))
    (call $w_add_small_signed_inplace (local.get $tmp) (i32.const -1))
    (local.set $gap (call $gate_gap_wide (local.get $tmp) (i32.const -1)))
    (global.set $W_HEAP (local.get $mark))
    (local.get $gap))

  (func $wide_gate_at_index (export "wide_gate_at_index") (param $targetIndex i32) (result i32)
    (local $idx i32) (local $day i32) (local $f i32) (local $gap i32) (local $cap i32)
    (local.set $cap (i32.add (call $w_len (local.get $targetIndex)) (i32.const 6)))
    (local.set $idx (call $w_new (local.get $cap)))
    (local.set $day (call $w_new (local.get $cap)))
    (local.set $f (call $w_from_i64 (i64.const -15055671)))
    (call $w_assign (local.get $day) (local.get $f))
    (block $done (loop $walk
      (br_if $done (i32.eqz (call $w_cmp (local.get $idx) (local.get $targetIndex))))
      (if (i32.lt_s (call $w_cmp (local.get $idx) (local.get $targetIndex)) (i32.const 0))
        (then
          (local.set $gap (call $forward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
          (call $w_add_small_signed_inplace (local.get $day) (local.get $gap)))
        (else
          (local.set $gap (call $backward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const -1))
          (call $w_add_small_signed_inplace (local.get $day) (i32.sub (i32.const 0) (local.get $gap)))))
      (br $walk)))
    (local.get $day))

  (func $choose_small_n (param $first i32) (param $step i32) (param $n i32) (result i32)
    (local $rem i32) (local $rr i32)
    (if (i32.le_u (local.get $n) (i32.const 0)) (then unreachable))
    (local.set $rem (call $r_mod_small (global.get $M) (local.get $n)))
    (call $copy_r (global.get $TMP6) (global.get $M))
    (if (i32.ne (local.get $rem) (i32.const 0))
      (then
        (call $from_u64 (global.get $TMP7) (i64.extend_i32_u (local.get $rem)))
        (call $sub (global.get $TMP6) (global.get $TMP6) (global.get $TMP7))))
    (call $copy_r (global.get $TMP5) (local.get $first))
    (block $accept (loop $again
      (br_if $accept (i32.le_s (call $cmp (global.get $TMP5) (global.get $TMP6)) (i32.const 0)))
      (call $ring_step_residue (global.get $TMP5) (local.get $step))
      (br $again)))
    (local.set $rr (call $r_mod_small (global.get $TMP5) (local.get $n)))
    (if (result i32) (i32.eqz (local.get $rr)) (then (local.get $n)) (else (local.get $rr))))

  ;; Registro de año: cinco punteros a enteros anchos: número, índice de apertura,
  ;; índice de cierre, día de apertura y día de cierre.
  (func $year_new (param $number i32) (param $openIdx i32) (param $closeIdx i32) (param $openDay i32) (param $closeDay i32) (result i32)
    (local $r i32)
    (local.set $r (call $w_alloc (i32.const 20)))
    (i32.store (local.get $r) (local.get $number))
    (i32.store offset=4 (local.get $r) (local.get $openIdx))
    (i32.store offset=8 (local.get $r) (local.get $closeIdx))
    (i32.store offset=12 (local.get $r) (local.get $openDay))
    (i32.store offset=16 (local.get $r) (local.get $closeDay))
    (local.get $r))
  (func $year_number (param $r i32) (result i32) (i32.load (local.get $r)))
  (func $year_open_idx (param $r i32) (result i32) (i32.load offset=4 (local.get $r)))
  (func $year_close_idx (param $r i32) (result i32) (i32.load offset=8 (local.get $r)))
  (func $year_open_day (param $r i32) (result i32) (i32.load offset=12 (local.get $r)))
  (func $year_close_day (param $r i32) (result i32) (i32.load offset=16 (local.get $r)))

  (func $year_interval_contains (param $year i32) (param $target i32) (result i32)
    (i32.and
      (i32.lt_s (call $w_cmp (call $year_open_day (local.get $year)) (local.get $target)) (i32.const 0))
      (i32.ge_s (call $w_cmp (call $year_close_day (local.get $year)) (local.get $target)) (i32.const 0))))

  ;; Los candidatos de nextYear/previousYear se materializan una sola vez.
  ;; El orden almacenado es exactamente el orden de enumeración normativa;
  ;; la selección sigue usando la misma salsa, el mismo sello y chooseSmallN.
  (func $next_year_wide (export "wide_next_year") (param $cDay i32) (param $known i32) (result i32)
    (local $openIdx i32) (local $openDay i32) (local $idx i32) (local $day i32)
    (local $length i32) (local $steps i32) (local $gap i32) (local $countc i32)
    (local $dir i32) (local $rank i32) (local $number i32) (local $candidates i32)
    (local $chosenIdx i32) (local $chosenDay i32)
    (local.set $openIdx (call $w_copy (call $year_close_idx (local.get $known))))
    (local.set $openDay (call $w_copy (call $year_close_day (local.get $known))))
    (local.set $idx (call $w_copy (local.get $openIdx)))
    (local.set $day (call $w_copy (local.get $openDay)))
    (local.set $candidates (call $w_alloc (i32.const 3840)))
    (local.set $length (i32.const 0))
    (local.set $steps (i32.const 0))
    (local.set $countc (i32.const 0))
    (block $countDone (loop $countLoop
      (local.set $gap (call $forward_gap_for_index (local.get $idx)))
      (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
      (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
      (local.set $length (i32.add (local.get $length) (local.get $gap)))
      (local.set $steps (i32.add (local.get $steps) (i32.const 1)))
      (br_if $countDone (i32.gt_u (local.get $length) (i32.const 5778)))
      (if (i32.and (i32.ge_u (local.get $steps) (i32.const 6)) (i32.ge_u (local.get $length) (i32.const 252)))
        (then
          (if (i32.ge_u (local.get $countc) (i32.const 320)) (then unreachable))
          (call $gate_table_store (local.get $candidates) (local.get $countc) (local.get $idx) (local.get $day) (local.get $length))
          (local.set $countc (i32.add (local.get $countc) (i32.const 1)))))
      (br $countLoop)))
    (if (i32.eqz (local.get $countc)) (then unreachable))
    (call $sauce_wide (local.get $cDay) (local.get $openDay))
    (local.set $dir (call $ask (i32.const 1) (i32.const 11) (global.get $TMP4)))
    (local.set $rank (call $choose_small_n (global.get $TMP4) (local.get $dir) (local.get $countc)))
    (local.set $chosenIdx (call $gate_table_idx (local.get $candidates) (i32.sub (local.get $rank) (i32.const 1))))
    (local.set $chosenDay (call $gate_table_day (local.get $candidates) (i32.sub (local.get $rank) (i32.const 1))))
    (local.set $number (call $w_copy (call $year_number (local.get $known))))
    (call $w_add_small_signed_inplace (local.get $number) (i32.const 1))
    (call $year_new
      (local.get $number)
      (local.get $openIdx)
      (call $w_copy (local.get $chosenIdx))
      (local.get $openDay)
      (call $w_copy (local.get $chosenDay))))

  (func $previous_year_wide (export "wide_previous_year") (param $cDay i32) (param $known i32) (result i32)
    (local $closeIdx i32) (local $closeDay i32) (local $idx i32) (local $day i32)
    (local $length i32) (local $steps i32) (local $gap i32) (local $countc i32)
    (local $dir i32) (local $rank i32) (local $number i32) (local $candidates i32)
    (local $chosenIdx i32) (local $chosenDay i32)
    (local.set $closeIdx (call $w_copy (call $year_open_idx (local.get $known))))
    (local.set $closeDay (call $w_copy (call $year_open_day (local.get $known))))
    (local.set $idx (call $w_copy (local.get $closeIdx)))
    (local.set $day (call $w_copy (local.get $closeDay)))
    (local.set $candidates (call $w_alloc (i32.const 3840)))
    (local.set $length (i32.const 0))
    (local.set $steps (i32.const 0))
    (local.set $countc (i32.const 0))
    (block $countDone (loop $countLoop
      (local.set $gap (call $backward_gap_for_index (local.get $idx)))
      (call $w_add_small_signed_inplace (local.get $idx) (i32.const -1))
      (call $w_add_small_signed_inplace (local.get $day) (i32.sub (i32.const 0) (local.get $gap)))
      (local.set $length (i32.add (local.get $length) (local.get $gap)))
      (local.set $steps (i32.add (local.get $steps) (i32.const 1)))
      (br_if $countDone (i32.gt_u (local.get $length) (i32.const 5778)))
      (if (i32.and (i32.ge_u (local.get $steps) (i32.const 6)) (i32.ge_u (local.get $length) (i32.const 252)))
        (then
          (if (i32.ge_u (local.get $countc) (i32.const 320)) (then unreachable))
          (call $gate_table_store (local.get $candidates) (local.get $countc) (local.get $idx) (local.get $day) (local.get $length))
          (local.set $countc (i32.add (local.get $countc) (i32.const 1)))))
      (br $countLoop)))
    (if (i32.eqz (local.get $countc)) (then unreachable))
    (call $sauce_wide (local.get $cDay) (local.get $closeDay))
    (local.set $dir (call $ask (i32.const 1) (i32.const 12) (global.get $TMP4)))
    (local.set $rank (call $choose_small_n (global.get $TMP4) (local.get $dir) (local.get $countc)))
    (local.set $chosenIdx (call $gate_table_idx (local.get $candidates) (i32.sub (local.get $rank) (i32.const 1))))
    (local.set $chosenDay (call $gate_table_day (local.get $candidates) (i32.sub (local.get $rank) (i32.const 1))))
    (local.set $number (call $w_copy (call $year_number (local.get $known))))
    (call $w_add_small_signed_inplace (local.get $number) (i32.const -1))
    (call $year_new
      (local.get $number)
      (call $w_copy (local.get $chosenIdx))
      (local.get $closeIdx)
      (call $w_copy (local.get $chosenDay))
      (local.get $closeDay)))

  (func (export "test_wide_gate_at_unit_indices") (result i32)
    (local $p i32) (local $m i32) (local $pd i32) (local $md i32) (local $ep i32) (local $em i32)
    (local.set $p (call $w_from_i64 (i64.const 1)))
    (local.set $m (call $w_from_i64 (i64.const -1)))
    (local.set $pd (call $wide_gate_at_index (local.get $p)))
    (local.set $md (call $wide_gate_at_index (local.get $m)))
    (local.set $ep (call $w_from_i64 (i64.const -15055455)))
    (local.set $em (call $w_from_i64 (i64.const -15056620)))
    (i32.and (i32.eqz (call $w_cmp (local.get $pd) (local.get $ep))) (i32.eqz (call $w_cmp (local.get $md) (local.get $em)))))

  (func (export "test_wide_year_interval_beyond_i64") (result i32)
    (local $n i32) (local $oi i32) (local $ci i32) (local $od i32) (local $cd i32) (local $tOpen i32) (local $tClose i32) (local $y i32)
    (local.set $n (call $w_new (i32.const 5)))
    (call $w_set_limb_internal (local.get $n) (i32.const 0) (i32.const 5000))
    (call $w_set_limb_internal (local.get $n) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $n) (i32.const 4)) (call $w_set_sign (local.get $n) (i32.const 1))
    (local.set $oi (call $w_from_i64 (i64.const 0))) (local.set $ci (call $w_from_i64 (i64.const 6)))
    (local.set $od (call $w_new (i32.const 5)))
    (call $w_set_limb_internal (local.get $od) (i32.const 0) (i32.const 123))
    (call $w_set_limb_internal (local.get $od) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $od) (i32.const 4)) (call $w_set_sign (local.get $od) (i32.const 1))
    (local.set $cd (call $w_copy (local.get $od))) (call $w_add_small_signed_inplace (local.get $cd) (i32.const 4922))
    (local.set $y (call $year_new (local.get $n) (local.get $oi) (local.get $ci) (local.get $od) (local.get $cd)))
    (local.set $tOpen (call $w_copy (local.get $od))) (local.set $tClose (call $w_copy (local.get $cd)))
    (i32.and (i32.eqz (call $year_interval_contains (local.get $y) (local.get $tOpen))) (call $year_interval_contains (local.get $y) (local.get $tClose))))

  (func (export "test_wide_year_number_step_beyond_i64") (result i32)
    (local $n i32) (local $n2 i32)
    (local.set $n (call $w_new (i32.const 5)))
    (call $w_set_limb_internal (local.get $n) (i32.const 0) (i32.const 5000))
    (call $w_set_limb_internal (local.get $n) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $n) (i32.const 4)) (call $w_set_sign (local.get $n) (i32.const 1))
    (local.set $n2 (call $w_copy (local.get $n)))
    (call $w_add_small_signed_inplace (local.get $n2) (i32.const 1))
    (i32.and
      (i32.eq (call $w_len (local.get $n2)) (i32.const 4))
      (i32.and (i32.eq (call $w_limb (local.get $n2) (i32.const 0)) (i32.const 5001)) (i32.eq (call $w_limb (local.get $n2) (i32.const 3)) (i32.const 1)))))

  (func $make_foundation_year_with_wide_number (result i32)
    (local $n i32) (local $oi i32) (local $ci i32) (local $od i32) (local $cd i32)
    ;; Número de año = 2^90 + 5000; las fronteras son las del año ancla real.
    (local.set $n (call $w_new (i32.const 5)))
    (call $w_set_limb_internal (local.get $n) (i32.const 0) (i32.const 5000))
    (call $w_set_limb_internal (local.get $n) (i32.const 3) (i32.const 1))
    (call $w_set_len (local.get $n) (i32.const 4))
    (call $w_set_sign (local.get $n) (i32.const 1))
    (local.set $oi (call $w_from_i64 (i64.const -5)))
    (local.set $ci (call $w_from_i64 (i64.const 6)))
    (local.set $od (call $wide_gate_at_index (local.get $oi)))
    (local.set $cd (call $wide_gate_at_index (local.get $ci)))
    (call $year_new (local.get $n) (local.get $oi) (local.get $ci) (local.get $od) (local.get $cd)))

  (func (export "test_wide_next_year_with_wide_number") (result i32)
    (local $c i32) (local $known i32) (local $next i32) (local $num i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $known (call $make_foundation_year_with_wide_number))
    (local.set $next (call $next_year_wide (local.get $c) (local.get $known)))
    (local.set $num (call $year_number (local.get $next)))
    (i32.and
      (i32.eq (call $w_len (local.get $num)) (i32.const 4))
      (i32.and
        (i32.eq (call $w_limb (local.get $num) (i32.const 0)) (i32.const 5001))
        (i32.eq (call $w_limb (local.get $num) (i32.const 3)) (i32.const 1)))))

  (func (export "test_wide_previous_year_with_wide_number") (result i32)
    (local $c i32) (local $known i32) (local $prev i32) (local $num i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $known (call $make_foundation_year_with_wide_number))
    (local.set $prev (call $previous_year_wide (local.get $c) (local.get $known)))
    (local.set $num (call $year_number (local.get $prev)))
    (i32.and
      (i32.eq (call $w_len (local.get $num)) (i32.const 4))
      (i32.and
        (i32.eq (call $w_limb (local.get $num) (i32.const 0)) (i32.const 4999))
        (i32.eq (call $w_limb (local.get $num) (i32.const 3)) (i32.const 1)))))

  (func (export "test_wide_next_boundary_continuity") (result i32)
    (local $c i32) (local $known i32) (local $next i32) (local $num i32)
    ;; La continuidad se comprueba sobre el año ancla con un número de año mayor que i64.
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $known (call $make_foundation_year_with_wide_number))
    (local.set $next (call $next_year_wide (local.get $c) (local.get $known)))
    (local.set $num (call $year_number (local.get $next)))
    (i32.and
      (i32.and
        (i32.eqz (call $w_cmp (call $year_open_idx (local.get $next)) (call $year_close_idx (local.get $known))))
        (i32.eqz (call $w_cmp (call $year_open_day (local.get $next)) (call $year_close_day (local.get $known)))))
      (i32.and
        (i32.eq (call $w_limb (local.get $num) (i32.const 0)) (i32.const 5001))
        (i32.eq (call $w_limb (local.get $num) (i32.const 3)) (i32.const 1)))))

  (func (export "test_wide_previous_boundary_continuity") (result i32)
    (local $c i32) (local $known i32) (local $prev i32) (local $num i32)
    ;; previousYear debe cerrar exactamente en la apertura del año conocido.
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $known (call $make_foundation_year_with_wide_number))
    (local.set $prev (call $previous_year_wide (local.get $c) (local.get $known)))
    (local.set $num (call $year_number (local.get $prev)))
    (i32.and
      (i32.and
        (i32.eqz (call $w_cmp (call $year_close_idx (local.get $prev)) (call $year_open_idx (local.get $known))))
        (i32.eqz (call $w_cmp (call $year_close_day (local.get $prev)) (call $year_open_day (local.get $known)))))
      (i32.and
        (i32.eq (call $w_limb (local.get $num) (i32.const 0)) (i32.const 4999))
        (i32.eq (call $w_limb (local.get $num) (i32.const 3)) (i32.const 1)))))

  (func $w_diff_small_owned (param $a i32) (param $b i32) (result i32)
    (local $mark i32) (local $d i32) (local $r i32)
    (local.set $mark (global.get $W_HEAP))
    (local.set $d (call $w_abs_diff (local.get $a) (local.get $b)))
    (if (i32.gt_u (call $w_len (local.get $d)) (i32.const 1)) (then unreachable))
    (local.set $r (if (result i32) (i32.eqz (call $w_len (local.get $d))) (then (i32.const 0)) (else (call $w_limb (local.get $d) (i32.const 0)))))
    (global.set $W_HEAP (local.get $mark))
    (local.get $r))

  ;; Devuelve un par [índice,día] de la puerta situada en o antes del día pedido.
  (func $gate_at_or_before_wide (param $targetDay i32) (result i32)
    (local $pair i32) (local $idx i32) (local $day i32) (local $foundation i32)
    (local $cap i32) (local $gap i32)
    (local.set $cap (i32.add (call $w_len (local.get $targetDay)) (i32.const 8)))
    (local.set $idx (call $w_new (local.get $cap)))
    (local.set $day (call $w_new (local.get $cap)))
    (local.set $foundation (call $w_from_i64 (i64.const -15055671)))
    (call $w_assign (local.get $day) (local.get $foundation))
    (if (i32.ge_s (call $w_cmp (local.get $targetDay) (local.get $foundation)) (i32.const 0))
      (then
        (block $doneForward (loop $forward
          (local.set $gap (call $forward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
          (if (i32.gt_s (call $w_cmp (local.get $day) (local.get $targetDay)) (i32.const 0))
            (then
              (call $w_add_small_signed_inplace (local.get $day) (i32.sub (i32.const 0) (local.get $gap)))
              (br $doneForward)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
          (br $forward))))
      (else
        (block $doneBackward (loop $backward
          (br_if $doneBackward (i32.le_s (call $w_cmp (local.get $day) (local.get $targetDay)) (i32.const 0)))
          (local.set $gap (call $backward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const -1))
          (call $w_add_small_signed_inplace (local.get $day) (i32.sub (i32.const 0) (local.get $gap)))
          (br $backward)))))
    (local.set $pair (call $w_alloc (i32.const 8)))
    (i32.store (local.get $pair) (local.get $idx))
    (i32.store offset=4 (local.get $pair) (local.get $day))
    (local.get $pair))

  ;; Tabla local de puertas: cada entrada guarda índice ancho, día ancho y desplazamiento i32.
  (func $gate_table_store (param $table i32) (param $pos i32) (param $idx i32) (param $day i32) (param $offset i32)
    (local $p i32)
    (local.set $p (i32.add (local.get $table) (i32.mul (local.get $pos) (i32.const 12))))
    (i32.store (local.get $p) (call $w_copy (local.get $idx)))
    (i32.store offset=4 (local.get $p) (call $w_copy (local.get $day)))
    (i32.store offset=8 (local.get $p) (local.get $offset)))
  (func $gate_table_idx (param $table i32) (param $pos i32) (result i32)
    (i32.load (i32.add (local.get $table) (i32.mul (local.get $pos) (i32.const 12)))))
  (func $gate_table_day (param $table i32) (param $pos i32) (result i32)
    (i32.load offset=4 (i32.add (local.get $table) (i32.mul (local.get $pos) (i32.const 12)))))
  (func $gate_table_offset (param $table i32) (param $pos i32) (result i32)
    (i32.load offset=8 (i32.add (local.get $table) (i32.mul (local.get $pos) (i32.const 12)))))


  ;; Construye la tabla de puertas sin recalcular el tramo que cruza Fundación.
  ;; Si Fundación cae dentro de [low,high], cada gap se evalúa una sola vez:
  ;; primero hacia atrás, luego hacia delante. Fuera de ese caso se conserva
  ;; exactamente la ruta general anterior.
  (func $fill_gate_table_window (param $low i32) (param $high i32) (param $table i32) (result i32)
    (local $foundation i32) (local $idx i32) (local $day i32) (local $gap i32)
    (local $pair i32) (local $n i32) (local $offset i32)
    (local $back i32) (local $backN i32) (local $p i32) (local $prevDay i32)
    (local $curIdx i32) (local $curDay i32)
    (local.set $foundation (call $w_from_i64 (i64.const -15055671)))
    (if
      (i32.and
        (i32.le_s (call $w_cmp (local.get $low) (local.get $foundation)) (i32.const 0))
        (i32.ge_s (call $w_cmp (local.get $high) (local.get $foundation)) (i32.const 0)))
      (then
        (local.set $back (call $w_alloc (i32.const 3840)))
        (local.set $idx (call $w_from_i64 (i64.const 0)))
        (local.set $day (call $w_copy (local.get $foundation)))
        (local.set $backN (i32.const 0))
        (call $gate_table_store (local.get $back) (local.get $backN) (local.get $idx) (local.get $day) (i32.const 0))
        (local.set $backN (i32.add (local.get $backN) (i32.const 1)))
        (block $backDone (loop $backLoop
          (br_if $backDone (i32.le_s (call $w_cmp (local.get $day) (local.get $low)) (i32.const 0)))
          (if (i32.ge_u (local.get $backN) (i32.const 320)) (then unreachable))
          (local.set $gap (call $backward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const -1))
          (call $w_add_small_signed_inplace (local.get $day) (i32.sub (i32.const 0) (local.get $gap)))
          (call $gate_table_store (local.get $back) (local.get $backN) (local.get $idx) (local.get $day) (i32.const 0))
          (local.set $backN (i32.add (local.get $backN) (i32.const 1)))
          (br $backLoop)))
        ;; Invertir [Fundación,...,low] para obtener orden ascendente de puertas.
        (local.set $n (i32.const 0))
        (local.set $offset (i32.const 0))
        (local.set $p (local.get $backN))
        (block $reverseDone (loop $reverseLoop
          (br_if $reverseDone (i32.eqz (local.get $p)))
          (local.set $p (i32.sub (local.get $p) (i32.const 1)))
          (local.set $curIdx (call $gate_table_idx (local.get $back) (local.get $p)))
          (local.set $curDay (call $gate_table_day (local.get $back) (local.get $p)))
          (if (i32.ne (local.get $n) (i32.const 0))
            (then (local.set $offset (i32.add (local.get $offset) (call $w_diff_small_owned (local.get $curDay) (local.get $prevDay))))))
          (call $gate_table_store (local.get $table) (local.get $n) (local.get $curIdx) (local.get $curDay) (local.get $offset))
          (local.set $prevDay (local.get $curDay))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))
          (br $reverseLoop)))
        ;; Reanudar desde Fundación sin volver a calcular los gaps negativos.
        (call $w_assign (local.get $idx) (call $gate_table_idx (local.get $back) (i32.const 0)))
        (call $w_assign (local.get $day) (call $gate_table_day (local.get $back) (i32.const 0)))
        (block $forwardDone (loop $forwardLoop
          (br_if $forwardDone (i32.ge_s (call $w_cmp (local.get $day) (local.get $high)) (i32.const 0)))
          (if (i32.ge_u (local.get $n) (i32.const 320)) (then unreachable))
          (local.set $gap (call $forward_gap_for_index (local.get $idx)))
          (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
          (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
          (local.set $offset (i32.add (local.get $offset) (local.get $gap)))
          (call $gate_table_store (local.get $table) (local.get $n) (local.get $idx) (local.get $day) (local.get $offset))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))
          (br $forwardLoop)))
        (return (local.get $n))))
    ;; Ruta general preexistente para ventanas que no cruzan Fundación.
    (local.set $pair (call $gate_at_or_before_wide (local.get $low)))
    (local.set $idx (i32.load (local.get $pair)))
    (local.set $day (i32.load offset=4 (local.get $pair)))
    (local.set $n (i32.const 0))
    (local.set $offset (i32.const 0))
    (call $gate_table_store (local.get $table) (local.get $n) (local.get $idx) (local.get $day) (local.get $offset))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (block $coverDone (loop $coverLoop
      (br_if $coverDone (i32.ge_s (call $w_cmp (local.get $day) (local.get $high)) (i32.const 0)))
      (if (i32.ge_u (local.get $n) (i32.const 320)) (then unreachable))
      (local.set $gap (call $forward_gap_for_index (local.get $idx)))
      (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
      (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
      (local.set $offset (i32.add (local.get $offset) (local.get $gap)))
      (call $gate_table_store (local.get $table) (local.get $n) (local.get $idx) (local.get $day) (local.get $offset))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br $coverLoop)))
    (local.get $n))

  (func $year5000_wide (export "wide_year5000") (param $cDay i32) (result i32)
    (local $low i32) (local $high i32) (local $pair i32) (local $idx i32) (local $day i32)
    (local $table i32) (local $counts i32) (local $nGates i32) (local $offset i32) (local $gap i32)
    (local $i i32) (local $j i32) (local $L i32) (local $total i32)
    (local $dir i32) (local $rank i32) (local $bucket i32) (local $inside i32) (local $countAtLength i32)
    (local $chosenI i32) (local $chosenJ i32) (local $number i32) (local $foundFlag i32)
    (local.set $low (call $w_copy (local.get $cDay)))
    (local.set $high (call $w_copy (local.get $cDay)))
    (call $w_add_small_signed_inplace (local.get $low) (i32.const -5778))
    (call $w_add_small_signed_inplace (local.get $high) (i32.const 5778))
    (local.set $table (call $w_alloc (i32.const 3840)))
    (local.set $counts (call $w_alloc (i32.const 22108)))
    (local.set $i (i32.const 0))
    (block $zeroDone (loop $zeroLoop
      (br_if $zeroDone (i32.ge_u (local.get $i) (i32.const 5527)))
      (i32.store (i32.add (local.get $counts) (i32.mul (local.get $i) (i32.const 4))) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $zeroLoop)))
    (local.set $nGates (call $fill_gate_table_window (local.get $low) (local.get $high) (local.get $table)))
    ;; Se cuenta cada candidato en el grupo de su longitud exacta.
    (local.set $total (i32.const 0))
    (local.set $i (i32.const 0))
    (block $countIDone (loop $countILoop
      (br_if $countIDone (i32.ge_u (i32.add (local.get $i) (i32.const 6)) (local.get $nGates)))
      (local.set $j (i32.add (local.get $i) (i32.const 6)))
      (block $countJDone (loop $countJLoop
        (br_if $countJDone (i32.ge_u (local.get $j) (local.get $nGates)))
        (local.set $L (i32.sub (call $gate_table_offset (local.get $table) (local.get $j)) (call $gate_table_offset (local.get $table) (local.get $i))))
        (br_if $countJDone (i32.gt_u (local.get $L) (i32.const 5778)))
        (if
          (i32.and
            (i32.ge_u (local.get $L) (i32.const 252))
            (i32.and
              (i32.lt_s (call $w_cmp (call $gate_table_day (local.get $table) (local.get $i)) (local.get $cDay)) (i32.const 0))
              (i32.ge_s (call $w_cmp (call $gate_table_day (local.get $table) (local.get $j)) (local.get $cDay)) (i32.const 0))))
          (then
            (local.set $bucket (i32.sub (local.get $L) (i32.const 252)))
            (i32.store
              (i32.add (local.get $counts) (i32.mul (local.get $bucket) (i32.const 4)))
              (i32.add (i32.load (i32.add (local.get $counts) (i32.mul (local.get $bucket) (i32.const 4)))) (i32.const 1)))
            (local.set $total (i32.add (local.get $total) (i32.const 1)))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $countJLoop)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $countILoop)))
    (if (i32.eqz (local.get $total)) (then unreachable))
    (call $sauce_wide (local.get $cDay) (local.get $cDay))
    (local.set $dir (call $ask (i32.const 1) (i32.const 10) (global.get $TMP4)))
    (local.set $rank (call $choose_small_n (global.get $TMP4) (local.get $dir) (local.get $total)))
    ;; Los grupos producen el primer criterio de ordenación: longitud ascendente.
    (local.set $bucket (i32.const 0))
    (block $bucketDone (loop $bucketLoop
      (local.set $countAtLength (i32.load (i32.add (local.get $counts) (i32.mul (local.get $bucket) (i32.const 4)))))
      (br_if $bucketDone (i32.le_u (local.get $rank) (local.get $countAtLength)))
      (local.set $rank (i32.sub (local.get $rank) (local.get $countAtLength)))
      (local.set $bucket (i32.add (local.get $bucket) (i32.const 1)))
      (if (i32.ge_u (local.get $bucket) (i32.const 5527)) (then unreachable))
      (br $bucketLoop)))
    (local.set $L (i32.add (local.get $bucket) (i32.const 252)))
    ;; Dentro de una longitud fija, i ascendente equivale a puerta de apertura ascendente.
    (local.set $inside (i32.const 0))
    (local.set $foundFlag (i32.const 0))
    (local.set $i (i32.const 0))
    (block $findDone (loop $findILoop
      (br_if $findDone (local.get $foundFlag))
      (br_if $findDone (i32.ge_u (i32.add (local.get $i) (i32.const 6)) (local.get $nGates)))
      (local.set $j (i32.add (local.get $i) (i32.const 6)))
      (block $findJDone (loop $findJLoop
        (br_if $findJDone (local.get $foundFlag))
        (br_if $findJDone (i32.ge_u (local.get $j) (local.get $nGates)))
        (local.set $countAtLength (i32.sub (call $gate_table_offset (local.get $table) (local.get $j)) (call $gate_table_offset (local.get $table) (local.get $i))))
        (br_if $findJDone (i32.gt_u (local.get $countAtLength) (local.get $L)))
        (if (i32.eq (local.get $countAtLength) (local.get $L))
          (then
            (if
              (i32.and
                (i32.lt_s (call $w_cmp (call $gate_table_day (local.get $table) (local.get $i)) (local.get $cDay)) (i32.const 0))
                (i32.ge_s (call $w_cmp (call $gate_table_day (local.get $table) (local.get $j)) (local.get $cDay)) (i32.const 0)))
              (then
                (local.set $inside (i32.add (local.get $inside) (i32.const 1)))
                (if (i32.eq (local.get $inside) (local.get $rank))
                  (then
                    (local.set $chosenI (local.get $i))
                    (local.set $chosenJ (local.get $j))
                    (local.set $foundFlag (i32.const 1))))))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $findJLoop)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $findILoop)))
    (if (i32.eqz (local.get $foundFlag)) (then unreachable))
    (local.set $number (call $w_from_i64 (i64.const 5000)))
    (call $year_new
      (local.get $number)
      (call $w_copy (call $gate_table_idx (local.get $table) (local.get $chosenI)))
      (call $w_copy (call $gate_table_idx (local.get $table) (local.get $chosenJ)))
      (call $w_copy (call $gate_table_day (local.get $table) (local.get $chosenI)))
      (call $w_copy (call $gate_table_day (local.get $table) (local.get $chosenJ)))))
  (func $find_target_year_wide (export "wide_find_target_year") (param $cDay i32) (param $tDay i32) (result i32)
    (local $y i32)
    (local.set $y (call $year5000_wide (local.get $cDay)))
    (block $forwardDone (loop $forward
      (br_if $forwardDone (i32.le_s (call $w_cmp (local.get $tDay) (call $year_close_day (local.get $y))) (i32.const 0)))
      (local.set $y (call $next_year_wide (local.get $cDay) (local.get $y)))
      (br $forward)))
    (block $backwardDone (loop $backward
      (br_if $backwardDone (i32.gt_s (call $w_cmp (local.get $tDay) (call $year_open_day (local.get $y))) (i32.const 0)))
      (local.set $y (call $previous_year_wide (local.get $cDay) (local.get $y)))
      (br $backward)))
    (local.get $y))

  (func (export "test_wide_year5000_foundation") (result i32)
    (local $c i32) (local $y i32) (local $minus5 i32) (local $plus6 i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $y (call $year5000_wide (local.get $c)))
    (local.set $minus5 (call $w_from_i64 (i64.const -5)))
    (local.set $plus6 (call $w_from_i64 (i64.const 6)))
    (i32.and
      (i32.eq (call $w_diff_small_owned (call $year_open_day (local.get $y)) (call $year_close_day (local.get $y))) (i32.const 4922))
      (i32.and
        (i32.eqz (call $w_cmp (call $year_open_idx (local.get $y)) (local.get $minus5)))
        (i32.eqz (call $w_cmp (call $year_close_idx (local.get $y)) (local.get $plus6))))))

  (func (export "test_wide_find_target_boundaries") (result i32)
    (local $c i32) (local $anchor i32) (local $open i32) (local $close i32) (local $yo i32) (local $yc i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $anchor (call $year5000_wide (local.get $c)))
    (local.set $open (call $w_copy (call $year_open_day (local.get $anchor))))
    (local.set $close (call $w_copy (call $year_close_day (local.get $anchor))))
    (local.set $yo (call $find_target_year_wide (local.get $c) (local.get $open)))
    (local.set $yc (call $find_target_year_wide (local.get $c) (local.get $close)))
    (i32.and
      (i32.eqz (call $w_cmp (call $year_number (local.get $yo)) (call $w_from_i64 (i64.const 4999))))
      (i32.eqz (call $w_cmp (call $year_number (local.get $yc)) (call $w_from_i64 (i64.const 5000))))))
  (func (export "test_wide_gate_at_or_before_low_foundation") (result i32)
    (local $d i32) (local $p i32) (local $idx i32) (local $day i32)
    (local.set $d (call $w_from_i64 (i64.const -15061449)))
    (local.set $p (call $gate_at_or_before_wide (local.get $d)))
    (local.set $idx (i32.load (local.get $p)))
    (local.set $day (i32.load offset=4 (local.get $p)))
    (i32.and
      (i32.le_s (call $w_cmp (local.get $day) (local.get $d)) (i32.const 0))
      (i32.lt_s (call $w_sign (local.get $idx)) (i32.const 0))))
  (func (export "test_wide_find_opening_boundary") (result i32)
    (local $c i32) (local $anchor i32) (local $open i32) (local $y i32) (local $expected i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $anchor (call $year5000_wide (local.get $c)))
    (local.set $open (call $w_copy (call $year_open_day (local.get $anchor))))
    ;; Se reutiliza el ancla ya calculada: la puerta de apertura obliga a un solo paso atrás.
    (local.set $y (call $previous_year_wide (local.get $c) (local.get $anchor)))
    (local.set $expected (call $w_from_i64 (i64.const 4999)))
    (i32.and
      (i32.eqz (call $w_cmp (local.get $open) (call $year_close_day (local.get $y))))
      (i32.eqz (call $w_cmp (call $year_number (local.get $y)) (local.get $expected)))))
  (func (export "test_wide_find_closing_boundary") (result i32)
    (local $c i32) (local $anchor i32) (local $close i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $anchor (call $year5000_wide (local.get $c)))
    (local.set $close (call $w_copy (call $year_close_day (local.get $anchor))))
    (call $year_interval_contains (local.get $anchor) (local.get $close)))
)
