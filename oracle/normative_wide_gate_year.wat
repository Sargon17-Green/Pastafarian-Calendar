      (local.set $p (i32.add (local.get $p) (i32.const 1))) (br $again)))
    unreachable)

  ;; el primer valor se escribe en dstFirst y el resultado devuelto es directionStep.
  (func $ask (param $bowlId i32) (param $seal i32) (param $dstFirst i32) (result i32)
    (local $next i32) (local $parity i32)
    (local.set $next (call $next46 (local.get $bowlId)))
