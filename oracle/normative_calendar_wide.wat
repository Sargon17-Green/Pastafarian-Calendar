    (call $sauce_fixture (i64.const -15055671) (i64.const -15055671))
    (call $ask (i32.const 1) (i32.const 1) (global.get $TMP4)))

  ;; -------- Días con signo de precisión arbitraria para el oráculo general --------
  ;; Formato: signo, longitud, capacidad, miembros base 2^30.
  (global $W_HEAP (mut i32) (i32.const 48000000))
  (func $w_align8 (param $n i32) (result i32) (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8)))
  (func $w_ensure (param $end i32)
    (local $have i64) (local $need i64) (local $pages i32)
    (local.set $have (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)))
    (local.set $need (i64.extend_i32_u (local.get $end)))
    (if (i64.gt_u (local.get $need) (local.get $have))
      (then
        (local.set $pages (i32.wrap_i64 (i64.shr_u (i64.add (i64.sub (local.get $need) (local.get $have)) (i64.const 65535)) (i64.const 16))))
        (if (i32.eq (memory.grow (local.get $pages)) (i32.const -1)) (then unreachable)))))
  (func $w_alloc (param $bytes i32) (result i32)
    (local $p i32) (local $end i32)
    (local.set $p (global.get $W_HEAP))
    (local.set $end (i32.add (local.get $p) (call $w_align8 (local.get $bytes))))
    (call $w_ensure (local.get $end)) (global.set $W_HEAP (local.get $end)) (local.get $p))
  (func $w_sign (param $p i32) (result i32) (i32.load (local.get $p)))
  (func $w_len (param $p i32) (result i32) (i32.load offset=4 (local.get $p)))
  (func $w_cap (param $p i32) (result i32) (i32.load offset=8 (local.get $p)))
  (func $w_addr (param $p i32) (param $i i32) (result i32) (i32.add (i32.add (local.get $p) (i32.const 12)) (i32.mul (local.get $i) (i32.const 4))))
  (func $w_limb (param $p i32) (param $i i32) (result i32) (i32.load (call $w_addr (local.get $p) (local.get $i))))
  (func $w_set_sign (param $p i32) (param $s i32) (i32.store (local.get $p) (local.get $s)))
  (func $w_set_len (param $p i32) (param $n i32) (i32.store offset=4 (local.get $p) (local.get $n)))
  (func $w_set_limb_internal (param $p i32) (param $i i32) (param $v i32)
    (if (i32.ge_u (local.get $i) (call $w_cap (local.get $p))) (then unreachable))
    (i32.store (call $w_addr (local.get $p) (local.get $i)) (local.get $v)))
  (func $w_normalize (param $p i32)
    (local $n i32) (local.set $n (call $w_len (local.get $p)))
