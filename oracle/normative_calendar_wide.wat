    (local.set $s_a (i32.sub (global.get $s_MONTH_COUNT) (i32.const 1)))
    (block $s_allDone (loop $s_rows
      (br_if $s_allDone (i32.lt_s (local.get $s_a) (i32.const 0)))
      (local.set $s_qv (call $s_ws_len (local.get $s_a)))
      (local.set $s_rm (call $s_ws_rmax (local.get $s_a)))
      (call $s_from_u64 (global.get $s_WS_COEFF) (i64.const 1))
      (call $s_zero (global.get $s_WS_ACC))
