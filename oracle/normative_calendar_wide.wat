          (global.get $s_WS_TERM)
          (call $s_ws_at (local.get $s_childBase) (i32.add (i32.sub (local.get $s_qv) (i32.const 1)) (local.get $s_r)))
          (global.get $s_WS_COEFF))
        (call $s_ws_add_inplace_fast (global.get $s_WS_ACC) (global.get $s_WS_TERM))
        (call $s_ws_copy_fast (call $s_ws_at (local.get $s_parentBase) (local.get $s_r)) (global.get $s_WS_ACC))
        (local.set $s_packed (call $s_wp_pack (call $s_ws_at (local.get $s_parentBase) (local.get $s_r))))
        (i32.store (call $s_wp_slot (local.get $s_a) (local.get $s_r)) (local.get $s_packed))
