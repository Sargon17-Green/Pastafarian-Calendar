  (func $s_wf_mul_small_alias (param $s_dst i32) (param $s_a i32) (param $s_x i32)
    (local $s_n i32) (local $s_i i32) (local $s_carry i64) (local $s_v i64)
    (if (i32.ne (local.get $s_dst) (local.get $s_a)) (then unreachable))
    (if (i32.eqz (local.get $s_x)) (then (i32.store (local.get $s_dst) (i32.const 0)) (return)))
    (local.set $s_n (i32.load (local.get $s_dst)))
    (local.set $s_i (i32.const 0))
    (local.set $s_carry (i64.const 0))
    (block $s_done (loop $s_again
      (br_if $s_done (i32.ge_u (local.get $s_i) (local.get $s_n)))
      (local.set $s_v
        (i64.add
          (i64.mul
            (i64.extend_i32_u (i32.load (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4)))))
            (i64.extend_i32_u (local.get $s_x)))
          (local.get $s_carry)))
      (i32.store
        (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4)))
        (i32.wrap_i64 (i64.and (local.get $s_v) (global.get $s_MASK))))
      (local.set $s_carry (i64.shr_u (local.get $s_v) (i64.const 30)))
      (local.set $s_i (i32.add (local.get $s_i) (i32.const 1)))
      (br $s_again)))
    (if (i64.ne (local.get $s_carry) (i64.const 0))
      (then
        (if (i32.ge_u (local.get $s_n) (global.get $s_MAXL)) (then unreachable))
        (i32.store
          (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_n) (i32.const 4)))
          (i32.wrap_i64 (local.get $s_carry)))
        (local.set $s_n (i32.add (local.get $s_n) (i32.const 1)))))
    (i32.store (local.get $s_dst) (local.get $s_n)))

  (func $s_wf_div_small_alias (param $s_dst i32) (param $s_a i32) (param $s_d i32)
    (local $s_n i32) (local $s_i i32) (local $s_r i64) (local $s_cur i64) (local $s_qv i64)
    (if (i32.or (i32.ne (local.get $s_dst) (local.get $s_a)) (i32.eqz (local.get $s_d))) (then unreachable))
    (local.set $s_n (i32.load (local.get $s_dst)))
    (local.set $s_i (local.get $s_n))
    (local.set $s_r (i64.const 0))
    (block $s_done (loop $s_again
      (br_if $s_done (i32.eqz (local.get $s_i)))
      (local.set $s_i (i32.sub (local.get $s_i) (i32.const 1)))
      (local.set $s_cur
        (i64.add
          (i64.shl (local.get $s_r) (i64.const 30))
          (i64.extend_i32_u (i32.load (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4))))))
      )
      (local.set $s_qv (i64.div_u (local.get $s_cur) (i64.extend_i32_u (local.get $s_d))))
      (local.set $s_r (i64.rem_u (local.get $s_cur) (i64.extend_i32_u (local.get $s_d))))
      (i32.store
        (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4)))
        (i32.wrap_i64 (local.get $s_qv)))
      (br $s_again)))
    (if (i64.ne (local.get $s_r) (i64.const 0)) (then unreachable))
    (block $s_norm (loop $s_nl
      (br_if $s_norm (i32.eqz (local.get $s_n)))
      (br_if $s_norm
        (i32.ne
          (i32.load (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (i32.sub (local.get $s_n) (i32.const 1)) (i32.const 4))))
          (i32.const 0)))
      (local.set $s_n (i32.sub (local.get $s_n) (i32.const 1)))
      (br $s_nl)))
    (i32.store (local.get $s_dst) (local.get $s_n)))

  (func $s_wf_sub_alias (param $s_dst i32) (param $s_a i32) (param $s_b i32)
    (local $s_na i32) (local $s_nb i32) (local $s_i i32)
    (local $s_borrow i64) (local $s_av i64) (local $s_bv i64) (local $s_v i64)
    (if (i32.ne (local.get $s_dst) (local.get $s_a)) (then unreachable))
    (if (i32.lt_s (call $s_cmp (local.get $s_a) (local.get $s_b)) (i32.const 0)) (then unreachable))
    (local.set $s_na (i32.load (local.get $s_dst)))
    (local.set $s_nb (i32.load (local.get $s_b)))
    (local.set $s_i (i32.const 0))
    (local.set $s_borrow (i64.const 0))
    (block $s_done (loop $s_again
      (br_if $s_done (i32.ge_u (local.get $s_i) (local.get $s_na)))
      (local.set $s_av (i64.extend_i32_u (i32.load (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4))))))
      (local.set $s_bv
        (if (result i64) (i32.lt_u (local.get $s_i) (local.get $s_nb))
          (then (i64.extend_i32_u (i32.load (i32.add (i32.add (local.get $s_b) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4))))))
          (else (i64.const 0))))
      (local.set $s_v (i64.sub (i64.sub (local.get $s_av) (local.get $s_bv)) (local.get $s_borrow)))
      (if (i64.lt_s (local.get $s_v) (i64.const 0))
        (then (local.set $s_v (i64.add (local.get $s_v) (global.get $s_BASE))) (local.set $s_borrow (i64.const 1)))
        (else (local.set $s_borrow (i64.const 0))))
      (i32.store
        (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (local.get $s_i) (i32.const 4)))
        (i32.wrap_i64 (local.get $s_v)))
      (local.set $s_i (i32.add (local.get $s_i) (i32.const 1)))
      (br $s_again)))
    (if (i64.ne (local.get $s_borrow) (i64.const 0)) (then unreachable))
    (block $s_norm (loop $s_nl
      (br_if $s_norm (i32.eqz (local.get $s_na)))
      (br_if $s_norm
        (i32.ne
          (i32.load (i32.add (i32.add (local.get $s_dst) (i32.const 4)) (i32.mul (i32.sub (local.get $s_na) (i32.const 1)) (i32.const 4))))
          (i32.const 0)))
      (local.set $s_na (i32.sub (local.get $s_na) (i32.const 1)))
      (br $s_nl)))
    (i32.store (local.get $s_dst) (local.get $s_na)))
  ;; Misma selección telescópica, expresada con control de flujo plano para evitar residuos de pila.
  (func $s_wf_unrank3 (param $s_rank i32) (result i32)
    (local $s_a i32) (local $s_b i32) (local $s_R i32) (local $s_pos i32)
    (local $s_j i32) (local $s_rj i32) (local $s_qv i32) (local $s_sum i32)
    (local $s_sCur i32) (local $s_sPrev i32) (local $s_selected i32) (local $s_hOne i32)
    (local $s_searching i32)
    (local.set $s_a (i32.const 0))
    (local.set $s_b (i32.const 0))
    (local.set $s_R (i32.const 0))
    (local.set $s_pos (i32.const 0))
    (call $s_from_u64 (global.get $s_WF_A) (i64.const 1))
    (local.set $s_j (i32.const 0))
    (block $s_zeroDone
      (loop $s_zeroLoop
        (br_if $s_zeroDone (i32.ge_u (local.get $s_j) (global.get $s_MONTH_COUNT)))
        (i32.store (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_j) (i32.const 4))) (i32.const 0))
        (local.set $s_j (i32.add (local.get $s_j) (i32.const 1)))
        (br $s_zeroLoop)))

    (block $s_allDone
      (loop $s_positions
        (br_if $s_allDone (i32.ge_u (local.get $s_pos) (global.get $s_YEAR_LENGTH)))
        (if (i32.eq (local.get $s_a) (global.get $s_MONTH_COUNT))
          (then (return (call $s_ct_finish_closure (local.get $s_rank) (local.get $s_b) (local.get $s_R) (local.get $s_pos)))))
        (local.set $s_selected (i32.const -1))

        (if (i32.gt_u (local.get $s_R) (i32.const 0))
          (then
            (local.set $s_hOne (call $s_wf_is_one (call $s_wp_at (local.get $s_a) (i32.sub (local.get $s_R) (i32.const 1)))))
            (if (call $s_wf_is_one (global.get $s_WF_A))
              (then
                (call $s_ws_copy_fast
                  (global.get $s_WF_ACTIVE_TOTAL)
                  (call $s_wp_at (local.get $s_a) (i32.sub (local.get $s_R) (i32.const 1)))))
              (else
                (if (local.get $s_hOne)
                  (then (call $s_ws_copy_fast (global.get $s_WF_ACTIVE_TOTAL) (global.get $s_WF_A)))
                  (else
                    (call $s_ws_mul_fast
                      (global.get $s_WF_ACTIVE_TOTAL)
                      (call $s_wp_at (local.get $s_a) (i32.sub (local.get $s_R) (i32.const 1)))
                      (global.get $s_WF_A))))))

            (if (i32.gt_s (call $s_cmp (local.get $s_rank) (global.get $s_WF_ACTIVE_TOTAL)) (i32.const 0))
              (then
                (call $s_wf_sub_alias (local.get $s_rank) (local.get $s_rank) (global.get $s_WF_ACTIVE_TOTAL)))
              (else
                (local.set $s_sum (call $s_wf_build_prefix (local.get $s_b) (local.get $s_a)))
                (if (i32.ne (local.get $s_sum) (local.get $s_R)) (then unreachable))
                (call $s_ws_copy_fast (global.get $s_WF_BASE_BLOCK) (global.get $s_WF_ACTIVE_TOTAL))
                (if (i32.eqz (local.get $s_hOne))
                  (then (call $s_ws_copy_fast (global.get $s_WF_BASE_A) (global.get $s_WF_A))))
                (local.set $s_j (i32.sub (local.get $s_a) (i32.const 1)))
                (local.set $s_searching (i32.const 1))
                (block $s_searchDone
                  (loop $s_searchLoop
                    (br_if $s_searchDone (i32.eqz (local.get $s_searching)))
                    (if (i32.eq (local.get $s_j) (local.get $s_b))
                      (then
                        (local.set $s_selected (local.get $s_j))
                        (if (local.get $s_hOne)
                          (then (call $s_ws_copy_fast (global.get $s_WF_A) (global.get $s_WF_BASE_BLOCK)))
                          (else (call $s_ws_copy_fast (global.get $s_WF_A) (global.get $s_WF_BASE_A))))
                        (local.set $s_searching (i32.const 0)))
                      (else
                        (local.set $s_sCur
                          (i32.load (i32.add (global.get $s_WF_PREFIX) (i32.mul (local.get $s_j) (i32.const 4)))))
                        (local.set $s_sPrev
                          (i32.load
                            (i32.add
                              (global.get $s_WF_PREFIX)
                              (i32.mul (i32.sub (local.get $s_j) (i32.const 1)) (i32.const 4)))))
                        (call $s_ws_copy_fast (global.get $s_WF_CAND_BLOCK) (global.get $s_WF_BASE_BLOCK))
                        (call $s_wf_mul_small_alias
                          (global.get $s_WF_CAND_BLOCK) (global.get $s_WF_CAND_BLOCK) (local.get $s_sPrev))
                        (call $s_wf_div_small_alias
                          (global.get $s_WF_CAND_BLOCK) (global.get $s_WF_CAND_BLOCK)
                          (i32.sub (local.get $s_sCur) (i32.const 1)))
                        (if (i32.eqz (local.get $s_hOne))
                          (then
                            (call $s_ws_copy_fast (global.get $s_WF_CAND_A) (global.get $s_WF_BASE_A))
                            (call $s_wf_mul_small_alias
                              (global.get $s_WF_CAND_A) (global.get $s_WF_CAND_A) (local.get $s_sPrev))
                            (call $s_wf_div_small_alias
                              (global.get $s_WF_CAND_A) (global.get $s_WF_CAND_A)
                              (i32.sub (local.get $s_sCur) (i32.const 1)))))
                        (if (i32.gt_s (call $s_cmp (local.get $s_rank) (global.get $s_WF_CAND_BLOCK)) (i32.const 0))
                          (then
                            (call $s_wf_sub_alias (local.get $s_rank) (local.get $s_rank) (global.get $s_WF_CAND_BLOCK))
                            (local.set $s_selected (local.get $s_j))
                            (if (local.get $s_hOne)
                              (then
                                (call $s_ws_copy_fast (global.get $s_WF_A) (global.get $s_WF_BASE_BLOCK))
                                (call $s_wf_sub_alias (global.get $s_WF_A) (global.get $s_WF_A) (global.get $s_WF_CAND_BLOCK)))
                              (else
                                (call $s_ws_copy_fast (global.get $s_WF_A) (global.get $s_WF_BASE_A))
                                (call $s_wf_sub_alias (global.get $s_WF_A) (global.get $s_WF_A) (global.get $s_WF_CAND_A))))
                            (local.set $s_searching (i32.const 0)))
                          (else
                            (call $s_ws_copy_fast (global.get $s_WF_BASE_BLOCK) (global.get $s_WF_CAND_BLOCK))
                            (if (i32.eqz (local.get $s_hOne))
                              (then (call $s_ws_copy_fast (global.get $s_WF_BASE_A) (global.get $s_WF_CAND_A))))
                            (local.set $s_j (i32.sub (local.get $s_j) (i32.const 1)))))))
                    (br $s_searchLoop)))))))

        (if (i32.ge_s (local.get $s_selected) (i32.const 0))
          (then
            (i32.store
              (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $s_pos) (i32.const 4)))
              (i32.add (local.get $s_selected) (i32.const 1)))
            (local.set $s_rj
              (i32.load (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_selected) (i32.const 4)))))
            (local.set $s_rj (i32.sub (local.get $s_rj) (i32.const 1)))
            (i32.store
              (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_selected) (i32.const 4)))
              (local.get $s_rj))
            (local.set $s_R (i32.sub (local.get $s_R) (i32.const 1)))
            (if (i32.eqz (local.get $s_rj))
              (then
                (if (i32.ne (local.get $s_selected) (local.get $s_b)) (then unreachable))
                (local.set $s_b (i32.add (local.get $s_b) (i32.const 1))))))
          (else
            (if (i32.ge_u (local.get $s_a) (global.get $s_MONTH_COUNT)) (then unreachable))
            (local.set $s_qv (call $s_ws_len (local.get $s_a)))
            (i32.store
              (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $s_pos) (i32.const 4)))
              (i32.add (local.get $s_a) (i32.const 1)))
            (call $s_wf_mul_binom_inplace
              (global.get $s_WF_A)
              (i32.add (i32.add (local.get $s_R) (local.get $s_qv)) (i32.const -2))
              (i32.sub (local.get $s_qv) (i32.const 2)))
            (i32.store
              (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_a) (i32.const 4)))
              (i32.sub (local.get $s_qv) (i32.const 1)))
            (local.set $s_R (i32.add (local.get $s_R) (i32.sub (local.get $s_qv) (i32.const 1))))
            (local.set $s_a (i32.add (local.get $s_a) (i32.const 1)))))

        (local.set $s_pos (i32.add (local.get $s_pos) (i32.const 1)))
        (br $s_positions)))

    (if (i32.or
          (i32.ne (local.get $s_a) (global.get $s_MONTH_COUNT))
          (i32.or (i32.ne (local.get $s_b) (global.get $s_MONTH_COUNT)) (i32.ne (local.get $s_R) (i32.const 0))))
      (then unreachable))
    (if (i32.eqz (call $s_wf_is_one (local.get $s_rank))) (then unreachable))
    (i32.const 1))
  (global $s_CT_SLOTS_A i32 (i32.const 1000000))
  (global $s_CT_SLOTS_B i32 (i32.const 1020000))
  (global $s_CT_Q i32 (i32.const 1040000))
  (global $s_CT_R i32 (i32.const 1044416))
  (global $s_CT_TMP i32 (i32.const 1048832))
  (global $s_CT_TOTAL i32 (i32.const 1053248))
  (global $s_CT_COUNT0 i32 (i32.const 1057664))
  (global $s_CT_PREFIX_BASE i32 (i32.const 1100000))

  (func $s_ct_prefix_at (param $s_j i32) (result i32)
    (i32.add (global.get $s_CT_PREFIX_BASE) (i32.mul (local.get $s_j) (global.get $s_CELL))))

  ;; Misma división desplazamiento/resta del selector, pero aquí el cociente está
  ;; acotado por C(4921,122), muy por debajo de 2048 bits.
  (func $s_ct_divmod_q_bounded (param $s_q i32) (param $s_r i32) (param $s_n i32) (param $s_d i32)
    (local $s_shift i32)
    (if (i32.eqz (call $s_len (local.get $s_d))) (then unreachable))
    (call $s_zero (local.get $s_q))
    (call $s_copy (local.get $s_r) (local.get $s_n))
    (if (i32.lt_s (call $s_cmp (local.get $s_r) (local.get $s_d)) (i32.const 0)) (then (return)))
    (local.set $s_shift (i32.sub (call $s_bitlen (local.get $s_r)) (call $s_bitlen (local.get $s_d))))
    (if (i32.gt_u (local.get $s_shift) (i32.const 2048)) (then unreachable))
    (block $s_done
      (loop $s_again
        (call $s_shift_left_bits (global.get $s_SHIFTED) (local.get $s_d) (local.get $s_shift))
        (if (i32.ge_s (call $s_cmp (local.get $s_r) (global.get $s_SHIFTED)) (i32.const 0))
          (then
            (call $s_sub (local.get $s_r) (local.get $s_r) (global.get $s_SHIFTED))
            (call $s_set_bit (local.get $s_q) (local.get $s_shift))))
        (br_if $s_done (i32.eqz (local.get $s_shift)))
        (local.set $s_shift (i32.sub (local.get $s_shift) (i32.const 1)))
        (br $s_again))))

  (func $s_ct_build_prefix_products (param $s_b i32)
    (local $s_j i32) (local $s_s i32) (local $s_rj i32)
    (local.set $s_j (local.get $s_b))
    (local.set $s_s (i32.const 0))
    (block $s_done
      (loop $s_again
        (br_if $s_done (i32.ge_u (local.get $s_j) (global.get $s_MONTH_COUNT)))
        (local.set $s_rj
          (i32.load (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_j) (i32.const 4)))))
        (local.set $s_s (i32.add (local.get $s_s) (local.get $s_rj)))
        (if (i32.eq (local.get $s_j) (local.get $s_b))
          (then
            (call $s_from_u64 (call $s_ct_prefix_at (local.get $s_j)) (i64.const 1)))
          (else
            (call $s_copy
              (call $s_ct_prefix_at (local.get $s_j))
              (call $s_ct_prefix_at (i32.sub (local.get $s_j) (i32.const 1))))
            (call $s_wf_mul_binom_inplace
              (call $s_ct_prefix_at (local.get $s_j))
              (i32.sub (local.get $s_s) (i32.const 1))
              (i32.sub (local.get $s_rj) (i32.const 1)))))
        (local.set $s_j (i32.add (local.get $s_j) (i32.const 1)))
        (br $s_again))))

  (func $s_ct_finish_closure
    (param $s_rank i32) (param $s_b i32) (param $s_R i32) (param $s_pos i32)
    (result i32)
    (local $s_slotBase i32) (local $s_nextBase i32) (local $s_swap i32)
    (local $s_slotCount i32) (local $s_nextCount i32)
    (local $s_i i32) (local $s_K i32) (local $s_rK i32)
    (local $s_nBits i32) (local $s_ones i32) (local $s_left i32)
    (local $s_actualPos i32) (local $s_lower i32)

    (if (i32.ne (local.get $s_R) (i32.sub (global.get $s_YEAR_LENGTH) (local.get $s_pos))) (then unreachable))
    (call $s_ct_build_prefix_products (local.get $s_b))
    (if (i32.ne (call $s_cmp (local.get $s_rank) (global.get $s_WF_A)) (i32.const 0))
      (then
        ;; El rango puede ser menor que A, pero nunca mayor.
        (if (i32.gt_s (call $s_cmp (local.get $s_rank) (global.get $s_WF_A)) (i32.const 0))
          (then unreachable))))

    ;; Las ranuras disponibles son precisamente el sufijo todavía no escrito.
    (local.set $s_slotBase (global.get $s_CT_SLOTS_A))
    (local.set $s_nextBase (global.get $s_CT_SLOTS_B))
    (local.set $s_slotCount (local.get $s_R))
    (local.set $s_i (i32.const 0))
    (block $s_sd
      (loop $s_sl
        (br_if $s_sd (i32.ge_u (local.get $s_i) (local.get $s_slotCount)))
        (i32.store
          (i32.add (local.get $s_slotBase) (i32.mul (local.get $s_i) (i32.const 4)))
          (i32.add (local.get $s_pos) (local.get $s_i)))
        (local.set $s_i (i32.add (local.get $s_i) (i32.const 1)))
        (br $s_sl)))

    (local.set $s_K (i32.sub (global.get $s_MONTH_COUNT) (i32.const 1)))
    (block $s_kd
      (loop $s_kl
        (br_if $s_kd (i32.le_s (local.get $s_K) (local.get $s_b)))
        (local.set $s_rK
          (i32.load (i32.add (global.get $s_WF_REM) (i32.mul (local.get $s_K) (i32.const 4)))))
        (if (i32.eqz (local.get $s_rK)) (then unreachable))
        (local.set $s_lower (call $s_ct_prefix_at (i32.sub (local.get $s_K) (i32.const 1))))

        ;; q=floor((rank-1)/A_lower), r=(rank-1) mod A_lower.
        (call $s_copy (global.get $s_CT_TMP) (local.get $s_rank))
        (call $s_sub_small (global.get $s_CT_TMP) (global.get $s_CT_TMP) (i32.const 1))
        (call $s_ct_divmod_q_bounded
          (global.get $s_CT_Q) (global.get $s_CT_R) (global.get $s_CT_TMP) (local.get $s_lower))
        (call $s_copy (local.get $s_rank) (global.get $s_CT_R))
        (call $s_add_small (local.get $s_rank) (local.get $s_rank) (i32.const 1))

        ;; El último hueco disponible es obligatoriamente K.
        (local.set $s_actualPos
          (i32.load
            (i32.add
              (local.get $s_slotBase)
              (i32.mul (i32.sub (local.get $s_slotCount) (i32.const 1)) (i32.const 4)))))
        (i32.store
          (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $s_actualPos) (i32.const 4)))
          (i32.add (local.get $s_K) (i32.const 1)))

        (local.set $s_nBits (i32.sub (local.get $s_slotCount) (i32.const 1)))
        (local.set $s_ones (i32.sub (local.get $s_rK) (i32.const 1)))
        (call $s_from_u64 (global.get $s_CT_TOTAL) (i64.const 1))
        (call $s_wf_mul_binom_inplace (global.get $s_CT_TOTAL) (local.get $s_nBits) (local.get $s_ones))
        (if (i32.ge_s (call $s_cmp (global.get $s_CT_Q) (global.get $s_CT_TOTAL)) (i32.const 0))
          (then unreachable))

        (local.set $s_i (i32.const 0))
        (local.set $s_nextCount (i32.const 0))
        (block $s_bitsDone
          (loop $s_bits
            (br_if $s_bitsDone (i32.ge_u (local.get $s_i) (local.get $s_nBits)))
            (local.set $s_left (i32.sub (local.get $s_nBits) (local.get $s_i)))
            (local.set $s_actualPos
              (i32.load (i32.add (local.get $s_slotBase) (i32.mul (local.get $s_i) (i32.const 4)))))
            (if (i32.eqz (local.get $s_ones))
              (then
                ;; Solo quedan ceros: todas estas ranuras pertenecen a la familia inferior.
                (i32.store
                  (i32.add (local.get $s_nextBase) (i32.mul (local.get $s_nextCount) (i32.const 4)))
                  (local.get $s_actualPos))
                (local.set $s_nextCount (i32.add (local.get $s_nextCount) (i32.const 1))))
              (else
                ;; count0=C(left-1,ones)=total*(left-ones)/left.
                (call $s_copy (global.get $s_CT_COUNT0) (global.get $s_CT_TOTAL))
                (call $s_wf_mul_small_alias
                  (global.get $s_CT_COUNT0) (global.get $s_CT_COUNT0)
                  (i32.sub (local.get $s_left) (local.get $s_ones)))
                (call $s_wf_div_small_alias
                  (global.get $s_CT_COUNT0) (global.get $s_CT_COUNT0) (local.get $s_left))
                (if (i32.lt_s (call $s_cmp (global.get $s_CT_Q) (global.get $s_CT_COUNT0)) (i32.const 0))
                  (then
                    ;; Bit 0: este hueco queda para meses inferiores.
                    (call $s_copy (global.get $s_CT_TOTAL) (global.get $s_CT_COUNT0))
                    (i32.store
                      (i32.add (local.get $s_nextBase) (i32.mul (local.get $s_nextCount) (i32.const 4)))
                      (local.get $s_actualPos))
                    (local.set $s_nextCount (i32.add (local.get $s_nextCount) (i32.const 1))))
                  (else
                    ;; Bit 1: se salta todo el bloque 0 y el hueco recibe K.
                    (call $s_sub (global.get $s_CT_Q) (global.get $s_CT_Q) (global.get $s_CT_COUNT0))
                    (call $s_sub (global.get $s_CT_TOTAL) (global.get $s_CT_TOTAL) (global.get $s_CT_COUNT0))
                    (i32.store
                      (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $s_actualPos) (i32.const 4)))
                      (i32.add (local.get $s_K) (i32.const 1)))
                    (local.set $s_ones (i32.sub (local.get $s_ones) (i32.const 1)))))))
            (local.set $s_i (i32.add (local.get $s_i) (i32.const 1)))
            (br $s_bits)))

        (if (i32.ne (local.get $s_nextCount) (i32.sub (local.get $s_slotCount) (local.get $s_rK)))
          (then unreachable))
        (local.set $s_slotCount (local.get $s_nextCount))
        (local.set $s_swap (local.get $s_slotBase))
        (local.set $s_slotBase (local.get $s_nextBase))
        (local.set $s_nextBase (local.get $s_swap))
        (local.set $s_K (i32.sub (local.get $s_K) (i32.const 1)))
        (br $s_kl)))

    ;; Solo queda el mes b; ocupa todas las ranuras inferiores restantes.
    (local.set $s_i (i32.const 0))
    (block $s_fd
      (loop $s_fl
        (br_if $s_fd (i32.ge_u (local.get $s_i) (local.get $s_slotCount)))
        (local.set $s_actualPos
          (i32.load (i32.add (local.get $s_slotBase) (i32.mul (local.get $s_i) (i32.const 4)))))
        (i32.store
          (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $s_actualPos) (i32.const 4)))
          (i32.add (local.get $s_b) (i32.const 1)))
        (local.set $s_i (i32.add (local.get $s_i) (i32.const 1)))
        (br $s_fl)))
    (if (i32.eqz (call $s_wf_is_one (local.get $s_rank))) (then unreachable))
    (i32.const 1))
  ;; Área auxiliar para la estructura real del caso fijo de Fundación.
  (global $s_FI_REMAIN i32 (i32.const 46000000))
  (global $s_FI_CUTLET_NAMES i32 (i32.const 46001000))
  (global $s_FI_MONTH_NAMES i32 (i32.const 46002000))
  (global $s_FI_PARTITION i32 (i32.const 46003000))
  (global $s_GATE_OFFSETS i32 (i32.const 46003500))
  (global $s_FI_BLOCK i32 (i32.const 46004000))
  (global $s_FI_RANK i32 (i32.const 46008416))

  (func $s_fi_set_first5 (param $s_a0 i32) (param $s_a1 i32) (param $s_a2 i32) (param $s_a3 i32) (param $s_a4 i32)
    (call $s_set_len (global.get $s_FIRST) (i32.const 5))
    (call $s_set_limb (global.get $s_FIRST) (i32.const 0) (local.get $s_a0))
    (call $s_set_limb (global.get $s_FIRST) (i32.const 1) (local.get $s_a1))
    (call $s_set_limb (global.get $s_FIRST) (i32.const 2) (local.get $s_a2))
    (call $s_set_limb (global.get $s_FIRST) (i32.const 3) (local.get $s_a3))
    (call $s_set_limb (global.get $s_FIRST) (i32.const 4) (local.get $s_a4)))

  (func $s_fi_falling_factorial (param $s_n i32) (param $s_k i32) (param $s_dst i32)
    (local $s_j i32)
    (call $s_from_u64 (local.get $s_dst) (i64.const 1))
    (local.set $s_j (i32.const 0))
    (block $s_done (loop $s_again
      (br_if $s_done (i32.ge_u (local.get $s_j) (local.get $s_k)))
      (call $s_mul_small (local.get $s_dst) (local.get $s_dst) (i32.sub (local.get $s_n) (local.get $s_j)))
      (local.set $s_j (i32.add (local.get $s_j) (i32.const 1)))
      (br $s_again))))

  (func $s_fi_cutlet_suffix_count
    (param $s_rem i32) (param $s_slots i32) (param $s_cumulative i32)
    (param $s_hit i32) (param $s_required i32) (param $s_dst i32)
    (local $s_offset i32)
    (if (i32.eqz (local.get $s_slots))
      (then
        (if (i32.and
              (i32.eqz (local.get $s_rem))
              (i32.or (i32.lt_s (local.get $s_required) (i32.const 0)) (local.get $s_hit)))
          (then (call $s_from_u64 (local.get $s_dst) (i64.const 1)))
          (else (call $s_zero (local.get $s_dst))))
        (return)))
    (if (i32.lt_s (local.get $s_rem) (local.get $s_slots))
      (then (call $s_zero (local.get $s_dst)) (return)))
    (if (i32.or (i32.lt_s (local.get $s_required) (i32.const 0)) (local.get $s_hit))
      (then
        (call $s_binomial (i32.sub (local.get $s_rem) (i32.const 1)) (i32.sub (local.get $s_slots) (i32.const 1)) (local.get $s_dst))
        (return)))
    (local.set $s_offset (i32.sub (local.get $s_required) (local.get $s_cumulative)))
    (if (i32.or (i32.le_s (local.get $s_offset) (i32.const 0)) (i32.ge_s (local.get $s_offset) (local.get $s_rem)))
      (then (call $s_zero (local.get $s_dst)) (return)))
    (if (i32.lt_u (local.get $s_slots) (i32.const 2))
      (then (call $s_zero (local.get $s_dst)) (return)))
    (call $s_binomial (i32.sub (local.get $s_rem) (i32.const 2)) (i32.sub (local.get $s_slots) (i32.const 2)) (local.get $s_dst)))
  (func $s_fi_unrank_names (param $s_master i32) (param $s_k i32) (param $s_rank i32) (param $s_out i32)
    (local $s_i i32) (local $s_pos i32) (local $s_remain i32) (local $s_suffix i32)
    (local $s_cand i32) (local $s_j i32)
    (local.set $s_i (i32.const 0))
    (block $s_idone (loop $s_init
      (br_if $s_idone (i32.ge_u (local.get $s_i) (local.get $s_master)))
      (i32.store (i32.add (global.get $s_FI_REMAIN) (i32.mul (local.get $s_i) (i32.const 4))) (i32.add (local.get $s_i) (i32.const 1)))
      (local.set $s_i (i32.add (local.get $s_i) (i32.const 1))) (br $s_init)))
    (local.set $s_remain (local.get $s_master)) (local.set $s_pos (i32.const 0))
    (block $s_done (loop $s_positions
      (br_if $s_done (i32.ge_u (local.get $s_pos) (local.get $s_k)))
      (local.set $s_suffix (i32.sub (i32.sub (local.get $s_k) (local.get $s_pos)) (i32.const 1)))
      (call $s_fi_falling_factorial (i32.sub (local.get $s_remain) (i32.const 1)) (local.get $s_suffix) (global.get $s_FI_BLOCK))
      (local.set $s_cand (i32.const 0))
      (block $s_picked (loop $s_choices
        (br_if $s_picked (i32.ge_u (local.get $s_cand) (local.get $s_remain)))
        (if (i32.gt_s (call $s_cmp (local.get $s_rank) (global.get $s_FI_BLOCK)) (i32.const 0))
          (then (call $s_sub (local.get $s_rank) (local.get $s_rank) (global.get $s_FI_BLOCK)))
          (else
            (i32.store (i32.add (local.get $s_out) (i32.mul (local.get $s_pos) (i32.const 4)))
              (i32.load (i32.add (global.get $s_FI_REMAIN) (i32.mul (local.get $s_cand) (i32.const 4)))))
            (local.set $s_j (local.get $s_cand))
            (block $s_sdone (loop $s_shift
              (br_if $s_sdone (i32.ge_u (i32.add (local.get $s_j) (i32.const 1)) (local.get $s_remain)))
              (i32.store (i32.add (global.get $s_FI_REMAIN) (i32.mul (local.get $s_j) (i32.const 4)))
                (i32.load (i32.add (global.get $s_FI_REMAIN) (i32.mul (i32.add (local.get $s_j) (i32.const 1)) (i32.const 4)))))
              (local.set $s_j (i32.add (local.get $s_j) (i32.const 1))) (br $s_shift)))
            (local.set $s_remain (i32.sub (local.get $s_remain) (i32.const 1)))
            (br $s_picked)))
        (local.set $s_cand (i32.add (local.get $s_cand) (i32.const 1))) (br $s_choices)))
      (local.set $s_pos (i32.add (local.get $s_pos) (i32.const 1))) (br $s_positions))))

  ;; Estado materializado de una estructura. Es global solo dentro del oráculo de prueba;
  ;; cada construcción lo sobrescribe por completo y ninguna decisión de producción lo consulta.
  (global $s_STRUCTURE i32 (i32.const 46100000))
  (global $s_RESULT_RECORD i32 (i32.const 46100100))

  (func $s_rank_small (param $p i32) (result i32)
    (if (i32.ne (call $s_len (local.get $p)) (i32.const 1)) (then unreachable))
    (call $s_limb (local.get $p) (i32.const 0)))

  ;; Convierte la primera respuesta de askBowl, que ya está en la misma base 2^30,
  ;; al espacio grande usado por los conteos combinatorios y aplica selección exacta por rango.
  (func $s_select_family
    (param $bowl i32) (param $seal i32) (param $familyCount i32) (param $dst i32)
    (local $direction i32)
    (if (i32.eqz (call $s_len (local.get $familyCount))) (then unreachable))
    (local.set $direction (call $ask (local.get $bowl) (local.get $seal) (global.get $TMP4)))
    (call $s_copy (global.get $s_FIRST) (global.get $TMP4))
    (call $s_choose (global.get $s_FIRST) (local.get $direction) (local.get $familyCount) (local.get $dst)))

  ;; Desempaqueta una composición de G en K partes positivas, con una frontera interna
  ;; obligatoria cuando required>=0. El orden es lexicográfico ascendente.
  (func $s_build_cutlet_partition
    (param $G i32) (param $K i32) (param $required i32) (param $rank i32)
    (local $rem i32) (local $slots i32) (local $cum i32) (local $hit i32)
    (local $pos i32) (local $x i32) (local $maxx i32) (local $nc i32) (local $nh i32)
    (local.set $rem (local.get $G))
    (local.set $slots (local.get $K))
    (local.set $cum (i32.const 0))
    (local.set $hit (i32.const 0))
    (local.set $pos (i32.const 0))
    (block $done
      (loop $positions
        (br_if $done (i32.eqz (local.get $slots)))
        (local.set $maxx (i32.sub (local.get $rem) (i32.sub (local.get $slots) (i32.const 1))))
        (local.set $x (i32.const 1))
        (block $picked
          (loop $choices
            (br_if $picked (i32.gt_u (local.get $x) (local.get $maxx)))
            (local.set $nc (i32.add (local.get $cum) (local.get $x)))
            (local.set $nh (local.get $hit))
            (if (i32.and
                  (i32.and (i32.ge_s (local.get $required) (i32.const 0)) (i32.eqz (local.get $hit)))
                  (i32.eq (local.get $nc) (local.get $required)))
              (then (local.set $nh (i32.const 1))))
            (if (i32.and
                  (i32.and (i32.ge_s (local.get $required) (i32.const 0)) (i32.eqz (local.get $hit)))
                  (i32.gt_s (local.get $nc) (local.get $required)))
              (then
                (local.set $x (i32.add (local.get $x) (i32.const 1)))
                (br $choices)))
            (call $s_fi_cutlet_suffix_count
              (i32.sub (local.get $rem) (local.get $x))
              (i32.sub (local.get $slots) (i32.const 1))
              (local.get $nc) (local.get $nh) (local.get $required)
              (global.get $s_FI_BLOCK))
            (if (i32.gt_s (call $s_cmp (local.get $rank) (global.get $s_FI_BLOCK)) (i32.const 0))
              (then (call $s_sub (local.get $rank) (local.get $rank) (global.get $s_FI_BLOCK)))
              (else
                (i32.store
                  (i32.add (global.get $s_FI_PARTITION) (i32.mul (local.get $pos) (i32.const 4)))
                  (local.get $x))
                (local.set $rem (i32.sub (local.get $rem) (local.get $x)))
                (local.set $slots (i32.sub (local.get $slots) (i32.const 1)))
                (local.set $cum (local.get $nc))
                (local.set $hit (local.get $nh))
                (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
                (br $picked)))
            (local.set $x (i32.add (local.get $x) (i32.const 1)))
            (br $choices)))
        (if (i32.gt_u (local.get $x) (local.get $maxx)) (then unreachable))
        (br $positions)))
    (if (i32.ne (local.get $rem) (i32.const 0)) (then unreachable))
    (if (i32.and (i32.ge_s (local.get $required) (i32.const 0)) (i32.eqz (local.get $hit))) (then unreachable)))

  ;; Busca si calculationDay coincide con una puerta interna del año caminando solo
  ;; dentro del propio año. Así no hay búsqueda desde Fundación ni reducción a i64.
  (func $s_required_boundary (param $cDay i32) (param $year i32) (param $G i32) (result i32)
    (local $idx i32) (local $day i32) (local $off i32) (local $gap i32)
    (if (i32.or
          (i32.le_s (call $w_cmp (local.get $cDay) (call $year_open_day (local.get $year))) (i32.const 0))
          (i32.ge_s (call $w_cmp (local.get $cDay) (call $year_close_day (local.get $year))) (i32.const 0)))
      (then (return (i32.const -1))))
    (local.set $idx (call $w_copy (call $year_open_idx (local.get $year))))
    (local.set $day (call $w_copy (call $year_open_day (local.get $year))))
    (local.set $off (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $off) (local.get $G)))
        (local.set $gap (call $forward_gap_for_index (local.get $idx)))
        (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
        (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
        (local.set $off (i32.add (local.get $off) (i32.const 1)))
        (if (i32.eqz (call $w_cmp (local.get $day) (local.get $cDay))) (then (return (local.get $off))))
        (br_if $done (i32.gt_s (call $w_cmp (local.get $day) (local.get $cDay)) (i32.const 0)))
        (br $walk)))
    (i32.const -1))


  ;; Materializa los offsets de todas las puertas del año y detecta, en la misma caminata,
  ;; si calculationDay es una puerta interna obligatoria para la partición de chuletas.
  ;; Los offsets caben en i32 porque la longitud normativa del año está limitada a 5778.
  (func $s_prepare_gate_offsets_and_required
    (param $cDay i32) (param $year i32) (param $G i32) (param $L i32) (result i32)
    (local $idx i32) (local $day i32) (local $off i32) (local $j i32)
    (local $gap i32) (local $required i32)
    (local.set $idx (call $w_copy (call $year_open_idx (local.get $year))))
    (local.set $day (call $w_copy (call $year_open_day (local.get $year))))
    (local.set $off (i32.const 0))
    (local.set $required (i32.const -1))
    (i32.store (global.get $s_GATE_OFFSETS) (i32.const 0))
    (local.set $j (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $j) (local.get $G)))
        (local.set $gap (call $forward_gap_for_index (local.get $idx)))
        (call $w_add_small_signed_inplace (local.get $idx) (i32.const 1))
        (call $w_add_small_signed_inplace (local.get $day) (local.get $gap))
        (local.set $off (i32.add (local.get $off) (local.get $gap)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (i32.store
          (i32.add (global.get $s_GATE_OFFSETS) (i32.mul (local.get $j) (i32.const 4)))
          (local.get $off))
        (if (i32.and
              (i32.lt_u (local.get $j) (local.get $G))
              (i32.eqz (call $w_cmp (local.get $day) (local.get $cDay))))
          (then (local.set $required (local.get $j))))
        (br $walk)))
    (if (i32.ne (local.get $off) (local.get $L)) (then unreachable))
    (local.get $required))

  ;; Construye todas las elecciones de estructura desde UNA única salsa(calculationDay, firstDay).
  ;; Devuelve un registro estático de punteros y metadatos; no es API de producción.
  (func $build_year_structure_wide (export "wide_build_year_structure")
    (param $cDay i32) (param $year i32) (result i32)
    (local $G i32) (local $L i32) (local $required i32)
    (local $candidateCount i32) (local $cutletCount i32)
    (local $minMonths i32) (local $maxMonths i32) (local $monthCount i32)
    (local $firstDay i32) (local $i i32)

    (call $s_init_constants)
    (local.set $G (call $w_diff_small_owned (call $year_close_idx (local.get $year)) (call $year_open_idx (local.get $year))))
    (local.set $L (call $w_diff_small_owned (call $year_close_day (local.get $year)) (call $year_open_day (local.get $year))))
    (if (i32.or (i32.lt_u (local.get $G) (i32.const 6)) (i32.or (i32.lt_u (local.get $L) (i32.const 252)) (i32.gt_u (local.get $L) (i32.const 5778)))) (then unreachable))

    ;; La comprobación de frontera y los desplazamientos de puerta se materializan antes de fijar la salsa de estructura.
    (local.set $required
      (call $s_prepare_gate_offsets_and_required
        (local.get $cDay) (local.get $year) (local.get $G) (local.get $L)))
    (local.set $firstDay (call $w_copy (call $year_open_day (local.get $year))))
    (call $w_add_small_signed_inplace (local.get $firstDay) (i32.const 1))
    (call $sauce_wide (local.get $cDay) (local.get $firstDay))

    ;; Número de chuletas: 6..min(17,G), sello 20 en la vasija 2.
    (local.set $candidateCount (i32.sub (select (i32.const 17) (local.get $G) (i32.gt_u (local.get $G) (i32.const 17))) (i32.const 5)))
    (call $s_from_u64 (global.get $s_N) (i64.extend_i32_u (local.get $candidateCount)))
    (call $s_select_family (i32.const 2) (i32.const 20) (global.get $s_N) (global.get $s_RESULT))
    (local.set $cutletCount (i32.add (i32.const 5) (call $s_rank_small (global.get $s_RESULT))))

    ;; Partición de huecos de puerta, sello 21 en la vasija 2.
    (call $s_fi_cutlet_suffix_count
      (local.get $G) (local.get $cutletCount) (i32.const 0) (i32.const 0)
      (local.get $required) (global.get $s_N))
    (call $s_select_family (i32.const 2) (i32.const 21) (global.get $s_N) (global.get $s_FI_RANK))
    (call $s_build_cutlet_partition (local.get $G) (local.get $cutletCount) (local.get $required) (global.get $s_FI_RANK))

    ;; Nombres distintos de chuletas, sello 22 en la vasija 5.
    (call $s_fi_falling_factorial (i32.const 17) (local.get $cutletCount) (global.get $s_N))
    (call $s_select_family (i32.const 5) (i32.const 22) (global.get $s_N) (global.get $s_FI_RANK))
    (call $s_fi_unrank_names (i32.const 17) (local.get $cutletCount) (global.get $s_FI_RANK) (global.get $s_FI_CUTLET_NAMES))

    ;; Número de meses y longitudes, ambos con la misma salsa de estructura.
    (local.set $minMonths (i32.div_u (i32.add (local.get $L) (i32.const 122)) (i32.const 123)))
    (local.set $maxMonths (i32.div_u (local.get $L) (i32.const 4)))
    (if (i32.gt_u (local.get $maxMonths) (i32.const 47)) (then (local.set $maxMonths (i32.const 47))))
    (if (i32.or (i32.lt_u (local.get $minMonths) (i32.const 3)) (i32.gt_u (local.get $minMonths) (local.get $maxMonths))) (then unreachable))
    (local.set $candidateCount (i32.add (i32.sub (local.get $maxMonths) (local.get $minMonths)) (i32.const 1)))
    (call $s_from_u64 (global.get $s_N) (i64.extend_i32_u (local.get $candidateCount)))
    (call $s_select_family (i32.const 3) (i32.const 30) (global.get $s_N) (global.get $s_RESULT))
    (local.set $monthCount (i32.add (i32.sub (local.get $minMonths) (i32.const 1)) (call $s_rank_small (global.get $s_RESULT))))
    (global.set $s_MONTH_COUNT (local.get $monthCount))
    (global.set $s_YEAR_LENGTH (local.get $L))

    (call $s_count_bounded (local.get $L) (local.get $monthCount) (i32.const 4) (i32.const 123) (global.get $s_N))
    (call $s_select_family (i32.const 3) (i32.const 31) (global.get $s_N) (global.get $s_BC_RANK))
    (call $s_unrank_bounded (local.get $L) (local.get $monthCount) (i32.const 4) (i32.const 123) (global.get $s_BC_RANK))
    (local.set $i (i32.const 0))
    (block $copyLengthsDone
      (loop $copyLengths
        (br_if $copyLengthsDone (i32.ge_u (local.get $i) (local.get $monthCount)))
        (i32.store
          (i32.add (global.get $s_WS_LENGTHS) (i32.mul (local.get $i) (i32.const 4)))
          (i32.load (i32.add (global.get $s_LENGTHS) (i32.mul (local.get $i) (i32.const 4)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copyLengths)))

    ;; Tejido completo: conteo empaquetado exacto y reconstrucción lexicográfica por rango, sello 32.
    (call $s_wp_build (global.get $s_N))
    (call $s_select_family (i32.const 4) (i32.const 32) (global.get $s_N) (global.get $s_RESULT))
    (drop (call $s_wf_unrank3 (global.get $s_RESULT)))

    ;; Nombres distintos de meses, sello 33 en la vasija 5.
    (call $s_fi_falling_factorial (i32.const 47) (local.get $monthCount) (global.get $s_N))
    (call $s_select_family (i32.const 5) (i32.const 33) (global.get $s_N) (global.get $s_FI_RANK))
    (call $s_fi_unrank_names (i32.const 47) (local.get $monthCount) (global.get $s_FI_RANK) (global.get $s_FI_MONTH_NAMES))

    (i32.store (global.get $s_STRUCTURE) (local.get $cutletCount))
    (i32.store offset=4 (global.get $s_STRUCTURE) (global.get $s_FI_PARTITION))
    (i32.store offset=8 (global.get $s_STRUCTURE) (global.get $s_FI_CUTLET_NAMES))
    (i32.store offset=12 (global.get $s_STRUCTURE) (local.get $monthCount))
    (i32.store offset=16 (global.get $s_STRUCTURE) (global.get $s_LENGTHS))
    (i32.store offset=20 (global.get $s_STRUCTURE) (global.get $s_WF_OUT))
    (i32.store offset=24 (global.get $s_STRUCTURE) (global.get $s_FI_MONTH_NAMES))
    (i32.store offset=28 (global.get $s_STRUCTURE) (local.get $G))
    (i32.store offset=32 (global.get $s_STRUCTURE) (local.get $L))
    (i32.store offset=36 (global.get $s_STRUCTURE) (local.get $required))
    (global.get $s_STRUCTURE))

  ;; Resuelve los cinco campos para un año ya localizado. El primer campo se guarda
  ;; como puntero a entero ancho; los cuatro restantes son índices/días i32 acotados.
  (func $resolve_year_structure_wide
    (param $cDay i32) (param $tDay i32) (param $year i32) (result i32)
    (local $structure i32) (local $cutletCount i32) (local $k i32) (local $part i32)
    (local $gateCursor i32) (local $startOffset i32) (local $endOffset i32)
    (local $cutletName i32) (local $dayInCutlet i32)
    (local $offsetFromOpen i32) (local $offset0 i32) (local $monthId i32)
    (local $monthName i32) (local $dayInMonth i32) (local $p i32)

    (if (i32.eqz (call $year_interval_contains (local.get $year) (local.get $tDay))) (then unreachable))
    (local.set $structure (call $build_year_structure_wide (local.get $cDay) (local.get $year)))
    (local.set $cutletCount (i32.load (local.get $structure)))
    (local.set $offsetFromOpen (call $w_diff_small_owned (local.get $tDay) (call $year_open_day (local.get $year))))
    (if (i32.eqz (local.get $offsetFromOpen)) (then unreachable))

    ;; La partición está expresada en huecos de puerta. Los offsets materializados durante
    ;; build_year_structure permiten resolver la chuleta sin recalcular salsa ni puertas.
    (local.set $k (i32.const 0))
    (local.set $gateCursor (i32.const 0))
    (block $cutletFound
      (loop $cutlets
        (br_if $cutletFound (i32.ge_u (local.get $k) (local.get $cutletCount)))
        (local.set $startOffset
          (i32.load (i32.add (global.get $s_GATE_OFFSETS) (i32.mul (local.get $gateCursor) (i32.const 4)))))
        (local.set $part
          (i32.load (i32.add (global.get $s_FI_PARTITION) (i32.mul (local.get $k) (i32.const 4)))))
        (local.set $gateCursor (i32.add (local.get $gateCursor) (local.get $part)))
        (local.set $endOffset
          (i32.load (i32.add (global.get $s_GATE_OFFSETS) (i32.mul (local.get $gateCursor) (i32.const 4)))))
        (if (i32.and
              (i32.gt_u (local.get $offsetFromOpen) (local.get $startOffset))
              (i32.le_u (local.get $offsetFromOpen) (local.get $endOffset)))
          (then
            (local.set $cutletName
              (i32.load (i32.add (global.get $s_FI_CUTLET_NAMES) (i32.mul (local.get $k) (i32.const 4)))))
            (local.set $dayInCutlet (i32.sub (local.get $offsetFromOpen) (local.get $startOffset)))
            (br $cutletFound)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $cutlets)))
    (if (i32.ge_u (local.get $k) (local.get $cutletCount)) (then unreachable))

    (local.set $offset0 (i32.sub (local.get $offsetFromOpen) (i32.const 1)))
    (local.set $monthId (i32.load (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $offset0) (i32.const 4)))))
    (if (i32.or (i32.eqz (local.get $monthId)) (i32.gt_u (local.get $monthId) (global.get $s_MONTH_COUNT))) (then unreachable))
    (local.set $monthName (i32.load (i32.add (global.get $s_FI_MONTH_NAMES) (i32.mul (i32.sub (local.get $monthId) (i32.const 1)) (i32.const 4)))))
    (local.set $p (i32.const 0))
    (local.set $dayInMonth (i32.const 0))
    (block $monthCountDone
      (loop $monthCountLoop
        (br_if $monthCountDone (i32.gt_u (local.get $p) (local.get $offset0)))
        (if (i32.eq
              (i32.load (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $p) (i32.const 4))))
              (local.get $monthId))
          (then (local.set $dayInMonth (i32.add (local.get $dayInMonth) (i32.const 1)))))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (br $monthCountLoop)))

    (i32.store (global.get $s_RESULT_RECORD) (call $year_number (local.get $year)))
    (i32.store offset=4 (global.get $s_RESULT_RECORD) (local.get $cutletName))
    (i32.store offset=8 (global.get $s_RESULT_RECORD) (local.get $dayInCutlet))
    (i32.store offset=12 (global.get $s_RESULT_RECORD) (local.get $monthName))
    (i32.store offset=16 (global.get $s_RESULT_RECORD) (local.get $dayInMonth))
    (global.get $s_RESULT_RECORD))

  (func $calendar_date_wide (export "wide_calendar_date") (param $cDay i32) (param $tDay i32) (result i32)
    (local $year i32)
    (local.set $year (call $find_target_year_wide (local.get $cDay) (local.get $tDay)))
    (call $resolve_year_structure_wide (local.get $cDay) (local.get $tDay) (local.get $year)))

  ;; Accesores explícitos para que las pruebas no dependan del layout privado del registro.
  (func (export "wide_calendar_result_year") (result i32) (i32.load (global.get $s_RESULT_RECORD)))
  (func (export "wide_calendar_result_cutlet") (result i32) (i32.load offset=4 (global.get $s_RESULT_RECORD)))
  (func (export "wide_calendar_result_day_in_cutlet") (result i32) (i32.load offset=8 (global.get $s_RESULT_RECORD)))
  (func (export "wide_calendar_result_month") (result i32) (i32.load offset=12 (global.get $s_RESULT_RECORD)))
  (func (export "wide_calendar_result_day_in_month") (result i32) (i32.load offset=16 (global.get $s_RESULT_RECORD)))


  (func $s_validate_structure (param $structure i32) (result i32)
    (local $m i32) (local $L i32) (local $i i32) (local $p i32)
    (local $sum i32) (local $id i32) (local $count i32)
    (local $first i32) (local $last i32) (local $prevFirst i32) (local $prevLast i32)
    (local.set $m (i32.load offset=12 (local.get $structure)))
    (local.set $L (i32.load offset=32 (local.get $structure)))
    (local.set $i (i32.const 0))
    (local.set $sum (i32.const 0))
    (block $lengthsDone
      (loop $lengths
        (br_if $lengthsDone (i32.ge_u (local.get $i) (local.get $m)))
        (local.set $count (i32.load (i32.add (global.get $s_LENGTHS) (i32.mul (local.get $i) (i32.const 4)))))
        (if (i32.or (i32.lt_u (local.get $count) (i32.const 4)) (i32.gt_u (local.get $count) (i32.const 123))) (then (return (i32.const 0))))
        (local.set $sum (i32.add (local.get $sum) (local.get $count)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lengths)))
    (if (i32.ne (local.get $sum) (local.get $L)) (then (return (i32.const 0))))

    (local.set $prevFirst (i32.const -1))
    (local.set $prevLast (i32.const -1))
    (local.set $id (i32.const 1))
    (block $monthsDone
      (loop $months
        (br_if $monthsDone (i32.gt_u (local.get $id) (local.get $m)))
        (local.set $count (i32.const 0))
        (local.set $first (i32.const -1))
        (local.set $last (i32.const -1))
        (local.set $p (i32.const 0))
        (block $scanDone
          (loop $scan
            (br_if $scanDone (i32.ge_u (local.get $p) (local.get $L)))
            (if (i32.eq (i32.load (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $p) (i32.const 4)))) (local.get $id))
              (then
                (if (i32.eq (local.get $first) (i32.const -1)) (then (local.set $first (local.get $p))))
                (local.set $last (local.get $p))
                (local.set $count (i32.add (local.get $count) (i32.const 1)))))
            (local.set $p (i32.add (local.get $p) (i32.const 1)))
            (br $scan)))
        (if (i32.ne (local.get $count) (i32.load (i32.add (global.get $s_LENGTHS) (i32.mul (i32.sub (local.get $id) (i32.const 1)) (i32.const 4))))) (then (return (i32.const 0))))
        (if (i32.or (i32.le_s (local.get $first) (local.get $prevFirst)) (i32.le_s (local.get $last) (local.get $prevLast))) (then (return (i32.const 0))))
        (local.set $prevFirst (local.get $first))
        (local.set $prevLast (local.get $last))
        (local.set $id (i32.add (local.get $id) (i32.const 1)))
        (br $months)))
    (i32.const 1))

  ;; Verificación exhaustiva pequeña e independiente del desenmallado lexicográfico.
  ;; Enumera en WAT las 3^6 secuencias sobre {1,2,3}, conserva solo las que usan
  ;; cada mes dos veces y satisfacen orden creciente de primera y última aparición,
  ;; y compara cada rango válido con la salida exacta de wf_unrank3.
  (func (export "test_general_weaving_exhaustive_3x2") (result i32)
    (local $code i32) (local $pos i32) (local $divisor i32) (local $digit i32)
    (local $c1 i32) (local $c2 i32) (local $c3 i32)
    (local $f1 i32) (local $f2 i32) (local $f3 i32)
    (local $l1 i32) (local $l2 i32) (local $l3 i32)
    (local $validRank i32) (local $expected i32)

    (call $s_init_constants)
    (global.set $s_MONTH_COUNT (i32.const 3))
    (global.set $s_YEAR_LENGTH (i32.const 6))
    (i32.store (global.get $s_LENGTHS) (i32.const 2))
    (i32.store offset=4 (global.get $s_LENGTHS) (i32.const 2))
    (i32.store offset=8 (global.get $s_LENGTHS) (i32.const 2))
    (i32.store (global.get $s_WS_LENGTHS) (i32.const 2))
    (i32.store offset=4 (global.get $s_WS_LENGTHS) (i32.const 2))
    (i32.store offset=8 (global.get $s_WS_LENGTHS) (i32.const 2))
    (call $s_wp_build (global.get $s_N))

    (local.set $validRank (i32.const 0))
    (local.set $code (i32.const 0))
    (block $allDone
      (loop $allCodes
        (br_if $allDone (i32.ge_u (local.get $code) (i32.const 729)))
        (local.set $c1 (i32.const 0))
        (local.set $c2 (i32.const 0))
        (local.set $c3 (i32.const 0))
        (local.set $f1 (i32.const -1))
        (local.set $f2 (i32.const -1))
        (local.set $f3 (i32.const -1))
        (local.set $l1 (i32.const -1))
        (local.set $l2 (i32.const -1))
        (local.set $l3 (i32.const -1))
        (local.set $pos (i32.const 0))
        (local.set $divisor (i32.const 243))
        (block $scanDone
          (loop $scan
            (br_if $scanDone (i32.ge_u (local.get $pos) (i32.const 6)))
            (local.set $digit
              (i32.add
                (i32.rem_u (i32.div_u (local.get $code) (local.get $divisor)) (i32.const 3))
                (i32.const 1)))
            (if (i32.eq (local.get $digit) (i32.const 1))
              (then
                (local.set $c1 (i32.add (local.get $c1) (i32.const 1)))
                (if (i32.eq (local.get $f1) (i32.const -1)) (then (local.set $f1 (local.get $pos))))
                (local.set $l1 (local.get $pos)))
              (else
                (if (i32.eq (local.get $digit) (i32.const 2))
                  (then
                    (local.set $c2 (i32.add (local.get $c2) (i32.const 1)))
                    (if (i32.eq (local.get $f2) (i32.const -1)) (then (local.set $f2 (local.get $pos))))
                    (local.set $l2 (local.get $pos)))
                  (else
                    (local.set $c3 (i32.add (local.get $c3) (i32.const 1)))
                    (if (i32.eq (local.get $f3) (i32.const -1)) (then (local.set $f3 (local.get $pos))))
                    (local.set $l3 (local.get $pos))))))
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
            (local.set $divisor (i32.div_u (local.get $divisor) (i32.const 3)))
            (br $scan)))

        (if
          (i32.and
            (i32.and
              (i32.and (i32.eq (local.get $c1) (i32.const 2)) (i32.eq (local.get $c2) (i32.const 2)))
              (i32.eq (local.get $c3) (i32.const 2)))
            (i32.and
              (i32.and (i32.lt_s (local.get $f1) (local.get $f2)) (i32.lt_s (local.get $f2) (local.get $f3)))
              (i32.and (i32.lt_s (local.get $l1) (local.get $l2)) (i32.lt_s (local.get $l2) (local.get $l3)))))
          (then
            (local.set $validRank (i32.add (local.get $validRank) (i32.const 1)))
            (call $s_from_u64 (global.get $s_RESULT) (i64.extend_i32_u (local.get $validRank)))
            (drop (call $s_wf_unrank3 (global.get $s_RESULT)))
            (local.set $pos (i32.const 0))
            (local.set $divisor (i32.const 243))
            (block $compareDone
              (loop $compare
                (br_if $compareDone (i32.ge_u (local.get $pos) (i32.const 6)))
                (local.set $expected
                  (i32.add
                    (i32.rem_u (i32.div_u (local.get $code) (local.get $divisor)) (i32.const 3))
                    (i32.const 1)))
                (if
                  (i32.ne
                    (i32.load (i32.add (global.get $s_WF_OUT) (i32.mul (local.get $pos) (i32.const 4))))
                    (local.get $expected))
                  (then (return (i32.const 0))))
                (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
                (local.set $divisor (i32.div_u (local.get $divisor) (i32.const 3)))
                (br $compare)))))
        (local.set $code (i32.add (local.get $code) (i32.const 1)))
        (br $allCodes)))

    ;; El recuento por programación dinámica y el recuento por enumeración deben coincidir.
    (if (i32.ne (call $s_len (global.get $s_N)) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.ne (call $s_limb (global.get $s_N) (i32.const 0)) (local.get $validRank)) (then (return (i32.const 0))))
    (i32.const 1))

  (func (export "test_general_calendar_foundation") (result i32)
    (local $c i32) (local $r i32) (local $yearp i32) (local $expectedYear i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $r (call $calendar_date_wide (local.get $c) (local.get $c)))
    (local.set $yearp (i32.load (local.get $r)))
    (local.set $expectedYear (call $w_from_i64 (i64.const 5000)))
    (if (i32.ne (call $w_cmp (local.get $yearp) (local.get $expectedYear)) (i32.const 0)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=4 (local.get $r)) (i32.const 10)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=8 (local.get $r)) (i32.const 949)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=12 (local.get $r)) (i32.const 3)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=16 (local.get $r)) (i32.const 54)) (then (return (i32.const 0))))
    (call $s_validate_structure (global.get $s_STRUCTURE)))


  (func (export "test_general_structure_preserves_wide_year_number") (result i32)
    (local $c i32) (local $year i32) (local $r i32) (local $num i32)
    ;; El número 2^90+5000 debe sobrevivir intacto a la estructura y a la resolución; las fronteras siguen siendo las del año ancla.
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $year (call $make_foundation_year_with_wide_number))
    (local.set $r (call $resolve_year_structure_wide (local.get $c) (local.get $c) (local.get $year)))
    (local.set $num (i32.load (local.get $r)))
    (i32.and
      (i32.eq (call $w_len (local.get $num)) (i32.const 4))
      (i32.and
        (i32.eq (call $w_limb (local.get $num) (i32.const 0)) (i32.const 5000))
        (i32.and
          (i32.eq (call $w_limb (local.get $num) (i32.const 1)) (i32.const 0))
          (i32.and
            (i32.eq (call $w_limb (local.get $num) (i32.const 2)) (i32.const 0))
            (i32.eq (call $w_limb (local.get $num) (i32.const 3)) (i32.const 1)))))))

  (func (export "test_general_structure_known_foundation_year") (result i32)
    (local $c i32) (local $number i32) (local $oi i32) (local $ci i32)
    (local $od i32) (local $cd i32) (local $y i32) (local $r i32)
    (local.set $c (call $w_from_i64 (i64.const -15055671)))
    (local.set $number (call $w_from_i64 (i64.const 5000)))
    (local.set $oi (call $w_from_i64 (i64.const -5)))
    (local.set $ci (call $w_from_i64 (i64.const 6)))
    (local.set $od (call $w_from_i64 (i64.const -15058333)))
    (local.set $cd (call $w_from_i64 (i64.const -15053411)))
    (local.set $y (call $year_new (local.get $number) (local.get $oi) (local.get $ci) (local.get $od) (local.get $cd)))
    (local.set $r (call $resolve_year_structure_wide (local.get $c) (local.get $c) (local.get $y)))
    (if (i32.ne (call $w_cmp (i32.load (local.get $r)) (local.get $number)) (i32.const 0)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=4 (local.get $r)) (i32.const 10)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=8 (local.get $r)) (i32.const 949)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=12 (local.get $r)) (i32.const 3)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load offset=16 (local.get $r)) (i32.const 54)) (then (return (i32.const 0))))
    (call $s_validate_structure (global.get $s_STRUCTURE)))
)
