        (if (i32.eq (memory.grow (i32.sub (local.get $s_need) (local.get $s_cur))) (i32.const -1))
          (then unreachable)))))

  (func $s_wf_build_full (param $s_dst i32)
    (local $s_a i32) (local $s_r i32) (local $s_rm i32) (local $s_qv i32)
