  (func $s_wp_build (param $s_dst i32)
    (local $s_a i32) (local $s_r i32) (local $s_rm i32) (local $s_qv i32)
    (local $s_childBase i32) (local $s_parentBase i32) (local $s_tmpBase i32) (local $s_packed i32)
    (global.set $s_WP_ARENA (global.get $s_WP_ARENA_START))
