    (if (i32.eqz (local.get $n)) (then (call $w_set_sign (local.get $p) (i32.const 0)))))
  (func $w_new (export "wide_day_new") (param $capacity i32) (result i32)
    (local $p i32)
    (if (i32.eqz (local.get $capacity)) (then (local.set $capacity (i32.const 1))))
    (local.set $p (call $w_alloc (i32.add (i32.const 12) (i32.mul (local.get $capacity) (i32.const 4)))))
    (i32.store (local.get $p) (i32.const 0)) (i32.store offset=4 (local.get $p) (i32.const 0))
    (i32.store offset=8 (local.get $p) (local.get $capacity)) (local.get $p))
  (func $w_from_i64 (export "wide_day_from_i64") (param $x i64) (result i32)
