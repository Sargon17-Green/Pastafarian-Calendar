      (i32.store offset=4 (call $s_ws_at (local.get $s_childBase) (local.get $s_r)) (i32.const 1))
      (i32.store (call $s_wp_slot (global.get $s_MONTH_COUNT) (local.get $s_r)) (global.get $s_ONE))
      (local.set $s_r (i32.add (local.get $s_r) (i32.const 1)))
