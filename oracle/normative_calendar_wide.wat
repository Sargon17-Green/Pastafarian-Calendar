  (func $s_wp_ensure (param $s_end i32)
    (local $s_curPages i32) (local $s_wantPages i32) (local $s_grow i32)
    (local.set $s_curPages (memory.size))
    (local.set $s_wantPages (i32.div_u (i32.add (local.get $s_end) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $s_wantPages) (local.get $s_curPages))
