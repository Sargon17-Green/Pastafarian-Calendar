        (call $s_ws_add_inplace_fast (global.get $s_WS_ACC) (global.get $s_WS_TERM))
        (call $s_ws_copy_fast (call $s_ws_at (local.get $s_parentBase) (local.get $s_r)) (global.get $s_WS_ACC))
        (if (i32.lt_u (local.get $s_r) (local.get $s_rm))
