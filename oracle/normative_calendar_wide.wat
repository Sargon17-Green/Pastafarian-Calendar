  (func $s_wf_prepare
    (local $s_a i32) (local $s_cursor i32) (local $s_need i32) (local $s_cur i32)
    ;; ws_prepare fija rmax[a] con la misma definición usada por el contador de dos filas.
    (call $s_ws_prepare)
