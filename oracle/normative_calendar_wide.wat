    (call $save_big (global.get $TMP0) (global.get $M))
    (i32.eq (call $cmp (global.get $TMP0) (global.get $M)) (i32.const 0)))
  (func (export "test_order_rank_1") (result i32)
    (call $order_from_rank (i32.const 1))
    (i32.and (i32.eq (call $order_id (i32.const 1)) (i32.const 1)) (i32.eq (call $order_id (i32.const 6)) (i32.const 6))))
  (func (export "test_order_rank_720") (result i32)
