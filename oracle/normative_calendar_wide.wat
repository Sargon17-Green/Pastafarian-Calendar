              (global.get $s_WS_COEFF) (global.get $s_WS_COEFF)
              (i32.add (local.get $s_r) (i32.const 1)))))
        (local.set $s_r (i32.add (local.get $s_r) (i32.const 1)))
        (br $s_cells)))
      (local.set $s_tmpBase (local.get $s_childBase))
      (local.set $s_childBase (local.get $s_parentBase))
      (local.set $s_parentBase (local.get $s_tmpBase))
      (local.set $s_a (i32.sub (local.get $s_a) (i32.const 1)))
      (br $s_rows)))
