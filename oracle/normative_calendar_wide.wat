    (call $r_square (global.get $TMP1) (global.get $TMP2))
    (call $copy_r (global.get $TMP2) (global.get $TMP1))
    (call $muladd_small (global.get $TMP2) (call $bowl (local.get $next)) (i32.const 179))
    (call $r_add_small (local.get $dstFirst) (global.get $TMP2) (local.get $seal))
    (call $copy_r (global.get $TMP2) (local.get $dstFirst))
    (call $r_add_small (global.get $TMP2) (global.get $TMP2) (i32.add (local.get $seal) (i32.const 194)))
    (call $r_square (global.get $TMP1) (global.get $TMP2))
    (call $copy_r (global.get $TMP2) (global.get $TMP1))
    (call $muladd_small (global.get $TMP2) (local.get $dstFirst) (i32.const 193))
    (call $muladd_small (global.get $TMP2) (call $bowl (i32.const 6)) (i32.const 197))
    (local.set $parity (call $r_mod_small (global.get $TMP2) (i32.const 2)))
    (if (result i32) (i32.eq (local.get $parity) (i32.const 1)) (then (i32.const 1)) (else (i32.const -1))))

  ;; -------- Exportaciones de comprobación --------
  (func (export "test_save_m") (result i32)
