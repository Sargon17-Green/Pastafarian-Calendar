    (call $w_set_len (local.get $p) (local.get $n)) (local.get $p))
  (func (export "wide_day_set_limb") (param $p i32) (param $i i32) (param $v i32)
    (if (i32.ge_u (local.get $v) (i32.const 1073741824)) (then unreachable))
    (call $w_set_limb_internal (local.get $p) (local.get $i) (local.get $v)))
  (func (export "wide_day_set_header") (param $p i32) (param $s i32) (param $n i32)
    (if (i32.gt_u (local.get $n) (call $w_cap (local.get $p))) (then unreachable))
