      (br_if $done (i32.eqz (local.get $n)))
      (br_if $done (i32.ne (call $w_limb (local.get $p) (i32.sub (local.get $n) (i32.const 1))) (i32.const 0)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1))) (br $again)))
