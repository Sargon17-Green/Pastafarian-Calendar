    "test:discovery01:red": "node --experimental-strip-types test/discovery01Red.ts",
    "test": "npm run test:stage01 && npm run test:discovery01 && npm run test:patch01 && npm run test:discovery02 && npm run test:patch02 && npm run test:discovery03 && npm run test:patch03 && npm run test:discovery04 && npm run test:patch04 && npm run test:discovery05 && npm run test:patch05 && npm run test:discovery06 && npm run test:patch06 && npm run test:discovery07 && npm run test:patch07",
    "test:patch01": "node --experimental-strip-types test/patch01.ts",
    "test:discovery02": "node --experimental-strip-types test/discovery02.ts",
    "test:discovery02:red": "node --experimental-strip-types test/discovery02Red.ts",
    "test:patch02": "node --experimental-strip-types test/patch02.ts",
    "test:discovery03": "node --experimental-strip-types test/discovery03.ts && node --experimental-strip-types test/discovery03Properties.ts && node --experimental-strip-types test/discovery03Large.ts && node --experimental-strip-types test/discovery03Errors.ts && node --experimental-strip-types test/discovery03Lifecycle.ts",
    "test:discovery03:red": "node --experimental-strip-types test/discovery03Red.ts",
    "test:patch03": "node --experimental-strip-types test/patch03.ts",
    "test:discovery04": "node --experimental-strip-types test/discovery04.ts && node --experimental-strip-types test/discovery04Properties.ts",
    "test:discovery04:red": "node --experimental-strip-types test/discovery04Red.ts",
    "test:patch04": "node --experimental-strip-types test/patch04.ts && node --experimental-strip-types test/patch04Metamorphic.ts",
    "test:discovery05": "node --experimental-strip-types test/discovery05.ts && node --experimental-strip-types test/discovery05Properties.ts",
    "test:discovery05:red": "node --experimental-strip-types test/discovery05Red.ts",
    "test:patch05": "node --experimental-strip-types test/patch05.ts && node --experimental-strip-types test/patch05Properties.ts",
    "test:discovery06": "node --experimental-strip-types test/discovery06.ts && node --experimental-strip-types test/discovery06Properties.ts",
    "test:discovery06:red": "node --experimental-strip-types test/discovery06Red.ts",
    "test:patch06": "node --experimental-strip-types test/patch06.ts && node --experimental-strip-types test/patch06Properties.ts",
    "test:discovery07": "node --experimental-strip-types test/discovery07.ts && node --experimental-strip-types test/discovery07Properties.ts",
    "test:discovery07:red": "node --experimental-strip-types test/discovery07Red.ts",
    "test:patch07": "node --experimental-strip-types test/patch07.ts && node --experimental-strip-types test/patch07Properties.ts"
