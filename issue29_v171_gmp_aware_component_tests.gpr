with "gnatcoll_gmp.gpr";

-- QA-only project for executing only low-level Stage01/03/05 test mains.
-- Each main is selected independently with -XNATIVE_MAIN=<unit>.adb.
-- No Calendar_Date call is present in the three test units or their audited
-- Normative_Oracle/Monster_Bootstrap source package bodies.
project Issue29_V171_GMP_Aware_Component_Tests is
   Main_Unit := external ("NATIVE_MAIN", "stage01_tests.adb");

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj_v171";
   for Exec_Dir use "bin_v171";
   for Main use (Main_Unit);

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnata", "-gnatwa");
   end Compiler;
end Issue29_V171_GMP_Aware_Component_Tests;
